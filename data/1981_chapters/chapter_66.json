[
  {
    "global_index": 5290,
    "verse_index": 5291,
    "chapter_number": 66,
    "verse_id": "66:0",
    "verse_id_arabic": "\u0660:\u0666\u0666",
    "verse_number": 0,
    "verse_text_english": "In the name of GOD, Most Gracious, Most Merciful.",
    "verse_text_arabic": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "bis'mi l-lahi l-ra\u1e25m\u0101ni l-ra\u1e25\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5291,
    "verse_index": 5292,
    "chapter_number": 66,
    "verse_id": "66:1",
    "verse_id_arabic": "\u0661:\u0666\u0666",
    "verse_number": 1,
    "verse_text_english": "O you prophet, why do you prohibit what GOD has made lawful for you, just to please your wives? GOD is Forgiver, Merciful.*",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0628\u0650\u0649\u0651\u064f \u0644\u0650\u0645\u064e \u062a\u064f\u062d\u064e\u0631\u0651\u0650\u0645\u064f \u0645\u064e\u0627\u0653 \u0623\u064e\u062d\u064e\u0644\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0643\u064e \u062a\u064e\u0628\u0652\u062a\u064e\u063a\u0650\u0649 \u0645\u064e\u0631\u0652\u0636\u064e\u0627\u062a\u064e \u0623\u064e\u0632\u0652\u0648\u064e\u0670\u062c\u0650\u0643\u064e \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u063a\u064e\u0641\u064f\u0648\u0631\u064c \u0631\u0651\u064e\u062d\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 l-nabiyu lima tu\u1e25arrimu m\u0101 a\u1e25alla l-lahu laka tabtagh\u012b mar\u1e0d\u0101ta azw\u0101jika wal-lahu ghaf\u016brun ra\u1e25\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": "*66:1 Mohammedans around the world believe that Muhammad was infallible. This verse teaches us that he was indeed a fallible human being (18:110, 33:37, 40:66, 80:1).",
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0628\u0649 \u0644\u0645 \u062a\u062d\u0631\u0645 \u0645\u0627 \u0623\u062d\u0644 \u0627\u0644\u0644\u0647 \u0644\u0643 \u062a\u0628\u062a\u063a\u0649 \u0645\u0631\u0636\u0627\u062a \u0623\u0632\u0648\u062c\u0643 \u0648\u0627\u0644\u0644\u0647 \u063a\u0641\u0648\u0631 \u0631\u062d\u064a\u0645",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5292,
    "verse_index": 5293,
    "chapter_number": 66,
    "verse_id": "66:2",
    "verse_id_arabic": "\u0662:\u0666\u0666",
    "verse_number": 2,
    "verse_text_english": "GOD has decreed for you the laws dealing with your oaths. GOD is your Lord, and He is the Omniscient, Most Wise.",
    "verse_text_arabic": "\u0642\u064e\u062f\u0652 \u0641\u064e\u0631\u064e\u0636\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0643\u064f\u0645\u0652 \u062a\u064e\u062d\u0650\u0644\u0651\u064e\u0629\u064e \u0623\u064e\u064a\u0652\u0645\u064e\u0670\u0646\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0648\u0652\u0644\u064e\u0649\u0670\u0643\u064f\u0645\u0652 \u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0645\u064f \u0671\u0644\u0652\u062d\u064e\u0643\u0650\u064a\u0645\u064f",
    "verse_text_transliterated": "qad fara\u1e0da l-lahu lakum ta\u1e25illata aym\u0101nikum wal-lahu mawl\u0101kum wahuwa l-\u02bfal\u012bmu l-\u1e25ak\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0642\u062f \u0641\u0631\u0636 \u0627\u0644\u0644\u0647 \u0644\u0643\u0645 \u062a\u062d\u0644\u0629 \u0623\u064a\u0645\u0646\u0643\u0645 \u0648\u0627\u0644\u0644\u0647 \u0645\u0648\u0644\u0649\u0643\u0645 \u0648\u0647\u0648 \u0627\u0644\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0643\u064a\u0645",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5293,
    "verse_index": 5294,
    "chapter_number": 66,
    "verse_id": "66:3",
    "verse_id_arabic": "\u0663:\u0666\u0666",
    "verse_number": 3,
    "verse_text_english": "The prophet had trusted some of his wives with a certain statement, then one of them spread it, and GOD let him know about it. He then informed his wife of part of the issue, and disregarded part. She asked him, \"Who informed you of this?\" He said, \"I was informed by the Omniscient, Most Cognizant.\"",
    "verse_text_arabic": "\u0648\u064e\u0625\u0650\u0630\u0652 \u0623\u064e\u0633\u064e\u0631\u0651\u064e \u0671\u0644\u0646\u0651\u064e\u0628\u0650\u0649\u0651\u064f \u0625\u0650\u0644\u064e\u0649\u0670 \u0628\u064e\u0639\u0652\u0636\u0650 \u0623\u064e\u0632\u0652\u0648\u064e\u0670\u062c\u0650\u0647\u0650\u06e6 \u062d\u064e\u062f\u0650\u064a\u062b\u064b\u0627 \u0641\u064e\u0644\u064e\u0645\u0651\u064e\u0627 \u0646\u064e\u0628\u0651\u064e\u0623\u064e\u062a\u0652 \u0628\u0650\u0647\u0650\u06e6 \u0648\u064e\u0623\u064e\u0638\u0652\u0647\u064e\u0631\u064e\u0647\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0639\u064e\u0631\u0651\u064e\u0641\u064e \u0628\u064e\u0639\u0652\u0636\u064e\u0647\u064f\u06e5 \u0648\u064e\u0623\u064e\u0639\u0652\u0631\u064e\u0636\u064e \u0639\u064e\u0646\u06e2 \u0628\u064e\u0639\u0652\u0636\u064d \u0641\u064e\u0644\u064e\u0645\u0651\u064e\u0627 \u0646\u064e\u0628\u0651\u064e\u0623\u064e\u0647\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6 \u0642\u064e\u0627\u0644\u064e\u062a\u0652 \u0645\u064e\u0646\u0652 \u0623\u064e\u0646\u06e2\u0628\u064e\u0623\u064e\u0643\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0642\u064e\u0627\u0644\u064e \u0646\u064e\u0628\u0651\u064e\u0623\u064e\u0646\u0650\u0649\u064e \u0671\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0645\u064f \u0671\u0644\u0652\u062e\u064e\u0628\u0650\u064a\u0631\u064f",
    "verse_text_transliterated": "wa-idh asarra l-nabiyu il\u0101 ba\u02bf\u1e0di azw\u0101jihi \u1e25ad\u012bthan falamm\u0101 nabba-at bihi wa-a\u1e93harahu l-lahu \u02bfalayhi \u02bfarrafa ba\u02bf\u1e0dahu wa-a\u02bfra\u1e0da \u02bfan ba\u02bf\u1e0din falamm\u0101 nabba-ah\u0101 bihi q\u0101lat man anba-aka h\u0101dh\u0101 q\u0101la nabba-aniya l-\u02bfal\u012bmu l-khab\u012br",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0648\u0625\u0630 \u0623\u0633\u0631 \u0627\u0644\u0646\u0628\u0649 \u0625\u0644\u0649 \u0628\u0639\u0636 \u0623\u0632\u0648\u062c\u0647 \u062d\u062f\u064a\u062b\u0627 \u0641\u0644\u0645\u0627 \u0646\u0628\u0623\u062a \u0628\u0647 \u0648\u0623\u0638\u0647\u0631\u0647 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0639\u0631\u0641 \u0628\u0639\u0636\u0647 \u0648\u0623\u0639\u0631\u0636 \u0639\u0646 \u0628\u0639\u0636 \u0641\u0644\u0645\u0627 \u0646\u0628\u0623\u0647\u0627 \u0628\u0647 \u0642\u0627\u0644\u062a \u0645\u0646 \u0623\u0646\u0628\u0623\u0643 \u0647\u0630\u0627 \u0642\u0627\u0644 \u0646\u0628\u0623\u0646\u0649 \u0627\u0644\u0639\u0644\u064a\u0645 \u0627\u0644\u062e\u0628\u064a\u0631",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5294,
    "verse_index": 5295,
    "chapter_number": 66,
    "verse_id": "66:4",
    "verse_id_arabic": "\u0664:\u0666\u0666",
    "verse_number": 4,
    "verse_text_english": "If the two of you repent to GOD, then your hearts have listened. But if you band together against him, then GOD is his ally, and so is Gabriel and the righteous believers. Also, the angels are his helpers.",
    "verse_text_arabic": "\u0625\u0650\u0646 \u062a\u064e\u062a\u064f\u0648\u0628\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0641\u064e\u0642\u064e\u062f\u0652 \u0635\u064e\u063a\u064e\u062a\u0652 \u0642\u064f\u0644\u064f\u0648\u0628\u064f\u0643\u064f\u0645\u064e\u0627 \u0648\u064e\u0625\u0650\u0646 \u062a\u064e\u0638\u064e\u0670\u0647\u064e\u0631\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0647\u064f\u0648\u064e \u0645\u064e\u0648\u0652\u0644\u064e\u0649\u0670\u0647\u064f \u0648\u064e\u062c\u0650\u0628\u0652\u0631\u0650\u064a\u0644\u064f \u0648\u064e\u0635\u064e\u0670\u0644\u0650\u062d\u064f \u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u0652\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0628\u064e\u0639\u0652\u062f\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0638\u064e\u0647\u0650\u064a\u0631\u064c",
    "verse_text_transliterated": "in tat\u016bb\u0101 il\u0101 l-lahi faqad \u1e63aghat qul\u016bbukum\u0101 wa-in ta\u1e93\u0101har\u0101 \u02bfalayhi fa-inna l-laha huwa mawl\u0101hu wajib'r\u012blu wa\u1e63\u0101li\u1e25u l-mu'min\u012bna wal-mal\u0101ikatu ba\u02bfda dh\u0101lika \u1e93ah\u012bru",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0625\u0646 \u062a\u062a\u0648\u0628\u0627 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u0641\u0642\u062f \u0635\u063a\u062a \u0642\u0644\u0648\u0628\u0643\u0645\u0627 \u0648\u0625\u0646 \u062a\u0638\u0647\u0631\u0627 \u0639\u0644\u064a\u0647 \u0641\u0625\u0646 \u0627\u0644\u0644\u0647 \u0647\u0648 \u0645\u0648\u0644\u0649\u0647 \u0648\u062c\u0628\u0631\u064a\u0644 \u0648\u0635\u0644\u062d \u0627\u0644\u0645\u0624\u0645\u0646\u064a\u0646 \u0648\u0627\u0644\u0645\u0644\u0626\u0643\u0629 \u0628\u0639\u062f \u0630\u0644\u0643 \u0638\u0647\u064a\u0631",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5295,
    "verse_index": 5296,
    "chapter_number": 66,
    "verse_id": "66:5",
    "verse_id_arabic": "\u0665:\u0666\u0666",
    "verse_number": 5,
    "verse_text_english": "If he divorces you, his Lord will substitute other wives in your place who are better than you; submitters (Muslims), believers (Mu'mins), obedient, repentant, worshipers, pious, either previously married, or virgins.",
    "verse_text_arabic": "\u0639\u064e\u0633\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0646 \u0637\u064e\u0644\u0651\u064e\u0642\u064e\u0643\u064f\u0646\u0651\u064e \u0623\u064e\u0646 \u064a\u064f\u0628\u0652\u062f\u0650\u0644\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0632\u0652\u0648\u064e\u0670\u062c\u064b\u0627 \u062e\u064e\u064a\u0652\u0631\u064b\u0627 \u0645\u0651\u0650\u0646\u0643\u064f\u0646\u0651\u064e \u0645\u064f\u0633\u0652\u0644\u0650\u0645\u064e\u0670\u062a\u064d \u0645\u0651\u064f\u0624\u0652\u0645\u0650\u0646\u064e\u0670\u062a\u064d \u0642\u064e\u0670\u0646\u0650\u062a\u064e\u0670\u062a\u064d \u062a\u064e\u0670\u0653\u0626\u0650\u0628\u064e\u0670\u062a\u064d \u0639\u064e\u0670\u0628\u0650\u062f\u064e\u0670\u062a\u064d \u0633\u064e\u0670\u0653\u0626\u0650\u062d\u064e\u0670\u062a\u064d \u062b\u064e\u064a\u0651\u0650\u0628\u064e\u0670\u062a\u064d \u0648\u064e\u0623\u064e\u0628\u0652\u0643\u064e\u0627\u0631\u064b\u0627",
    "verse_text_transliterated": "Aasa rabbuhu in tallaqakunnaan yubdilahu azwajan khayran minkunna muslimatinmu/minatin qanitatin ta-ibatinAAabidatin sa-ihatin thayyibatinwaabkaran",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0639\u0633\u0649 \u0631\u0628\u0647 \u0625\u0646 \u0637\u0644\u0642\u0643\u0646 \u0623\u0646 \u064a\u0628\u062f\u0644\u0647 \u0623\u0632\u0648\u062c\u0627 \u062e\u064a\u0631\u0627 \u0645\u0646\u0643\u0646 \u0645\u0633\u0644\u0645\u062a \u0645\u0624\u0645\u0646\u062a \u0642\u0646\u062a\u062a \u062a\u0626\u0628\u062a \u0639\u0628\u062f\u062a \u0633\u0626\u062d\u062a \u062b\u064a\u0628\u062a \u0648\u0623\u0628\u0643\u0627\u0631\u0627",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5296,
    "verse_index": 5297,
    "chapter_number": 66,
    "verse_id": "66:6",
    "verse_id_arabic": "\u0666:\u0666\u0666",
    "verse_number": 6,
    "verse_text_english": "O you who believe, protect yourselves and your families from the Hellfire whose fuel is people and rocks. Guarding it are stern and powerful angels who never disobey GOD; they do whatever they are commanded to do.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0642\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u0646\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0647\u0652\u0644\u0650\u064a\u0643\u064f\u0645\u0652 \u0646\u064e\u0627\u0631\u064b\u0627 \u0648\u064e\u0642\u064f\u0648\u062f\u064f\u0647\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0627\u0633\u064f \u0648\u064e\u0671\u0644\u0652\u062d\u0650\u062c\u064e\u0627\u0631\u064e\u0629\u064f \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u064e\u0627 \u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064c \u063a\u0650\u0644\u064e\u0627\u0638\u064c \u0634\u0650\u062f\u064e\u0627\u062f\u064c \u0644\u0651\u064e\u0627 \u064a\u064e\u0639\u0652\u0635\u064f\u0648\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0645\u064e\u0627\u0653 \u0623\u064e\u0645\u064e\u0631\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u064a\u064e\u0641\u0652\u0639\u064e\u0644\u064f\u0648\u0646\u064e \u0645\u064e\u0627 \u064a\u064f\u0624\u0652\u0645\u064e\u0631\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna \u0101man\u016b q\u016b anfusakum wa-ahl\u012bkum n\u0101ran waq\u016bduh\u0101 l-n\u0101su wal-\u1e25ij\u0101ratu \u02bfalayh\u0101 mal\u0101ikatun ghil\u0101\u1e93un shid\u0101dun l\u0101 ya\u02bf\u1e63\u016bna l-laha m\u0101 amarahum wayaf\u02bfal\u016bna m\u0101 yu'mar\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0642\u0648\u0627 \u0623\u0646\u0641\u0633\u0643\u0645 \u0648\u0623\u0647\u0644\u064a\u0643\u0645 \u0646\u0627\u0631\u0627 \u0648\u0642\u0648\u062f\u0647\u0627 \u0627\u0644\u0646\u0627\u0633 \u0648\u0627\u0644\u062d\u062c\u0627\u0631\u0629 \u0639\u0644\u064a\u0647\u0627 \u0645\u0644\u0626\u0643\u0629 \u063a\u0644\u0627\u0638 \u0634\u062f\u0627\u062f \u0644\u0627 \u064a\u0639\u0635\u0648\u0646 \u0627\u0644\u0644\u0647 \u0645\u0627 \u0623\u0645\u0631\u0647\u0645 \u0648\u064a\u0641\u0639\u0644\u0648\u0646 \u0645\u0627 \u064a\u0624\u0645\u0631\u0648\u0646",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
