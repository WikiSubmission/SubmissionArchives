  },
  {
    "global_index": 5297,
    "verse_index": 5298,
    "chapter_number": 66,
    "verse_id": "66:7",
    "verse_id_arabic": "\u0667:\u0666\u0666",
    "verse_number": 7,
    "verse_text_english": "O you who disbelieved, do not apologize today. You are being requited only for what you did.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u06df \u0644\u064e\u0627 \u062a\u064e\u0639\u0652\u062a\u064e\u0630\u0650\u0631\u064f\u0648\u0627\u06df \u0671\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u064e \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u062a\u064f\u062c\u0652\u0632\u064e\u0648\u0652\u0646\u064e \u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u0652 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna kafar\u016b l\u0101 ta\u02bftadhir\u016b l-yawma innam\u0101 tuj'zawna m\u0101 kuntum ta\u02bfmal\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0643\u0641\u0631\u0648\u0627 \u0644\u0627 \u062a\u0639\u062a\u0630\u0631\u0648\u0627 \u0627\u0644\u064a\u0648\u0645 \u0625\u0646\u0645\u0627 \u062a\u062c\u0632\u0648\u0646 \u0645\u0627 \u0643\u0646\u062a\u0645 \u062a\u0639\u0645\u0644\u0648\u0646",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5298,
    "verse_index": 5299,
    "chapter_number": 66,
    "verse_id": "66:8",
    "verse_id_arabic": "\u0668:\u0666\u0666",
    "verse_number": 8,
    "verse_text_english": "O you who believe, you shall repent to GOD a firm repentance. Your Lord will then remit your sins and admit you into gardens with flowing streams. On that day, GOD will not disappoint the prophet and those who believed with him. Their light will radiate in front of them and to their right. They will say, \"Our Lord, perfect our light for us, and forgive us; You are Omnipotent.\"",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u062a\u064f\u0648\u0628\u064f\u0648\u0653\u0627\u06df \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u062a\u064e\u0648\u0652\u0628\u064e\u0629\u064b \u0646\u0651\u064e\u0635\u064f\u0648\u062d\u064b\u0627 \u0639\u064e\u0633\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u064f\u0643\u064f\u0645\u0652 \u0623\u064e\u0646 \u064a\u064f\u0643\u064e\u0641\u0651\u0650\u0631\u064e \u0639\u064e\u0646\u0643\u064f\u0645\u0652 \u0633\u064e\u064a\u0651\u0650\u0640\u0654\u064e\u0627\u062a\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u064a\u064f\u062f\u0652\u062e\u0650\u0644\u064e\u0643\u064f\u0645\u0652 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u064d \u062a\u064e\u062c\u0652\u0631\u0650\u0649 \u0645\u0650\u0646 \u062a\u064e\u062d\u0652\u062a\u0650\u0647\u064e\u0627 \u0671\u0644\u0652\u0623\u064e\u0646\u0652\u0647\u064e\u0670\u0631\u064f \u064a\u064e\u0648\u0652\u0645\u064e \u0644\u064e\u0627 \u064a\u064f\u062e\u0652\u0632\u0650\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0671\u0644\u0646\u0651\u064e\u0628\u0650\u0649\u0651\u064e \u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0645\u064e\u0639\u064e\u0647\u064f\u06e5 \u0646\u064f\u0648\u0631\u064f\u0647\u064f\u0645\u0652 \u064a\u064e\u0633\u0652\u0639\u064e\u0649\u0670 \u0628\u064e\u064a\u0652\u0646\u064e \u0623\u064e\u064a\u0652\u062f\u0650\u064a\u0647\u0650\u0645\u0652 \u0648\u064e\u0628\u0650\u0623\u064e\u064a\u0652\u0645\u064e\u0670\u0646\u0650\u0647\u0650\u0645\u0652 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0631\u064e\u0628\u0651\u064e\u0646\u064e\u0627\u0653 \u0623\u064e\u062a\u0652\u0645\u0650\u0645\u0652 \u0644\u064e\u0646\u064e\u0627 \u0646\u064f\u0648\u0631\u064e\u0646\u064e\u0627 \u0648\u064e\u0671\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u064e\u0646\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u0650\u064a\u0631\u064c",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna \u0101man\u016b t\u016bb\u016b il\u0101 l-lahi tawbatan na\u1e63\u016b\u1e25an \u02bfas\u0101 rabbukum an yukaffira \u02bfankum sayyi\u0101tikum wayud'khilakum jann\u0101tin tajr\u012b min ta\u1e25tih\u0101 l-anh\u0101ru yawma l\u0101 yukh'z\u012b l-lahu l-nabiya wa-alladh\u012bna \u0101man\u016b ma\u02bfahu n\u016bruhum yas\u02bf\u0101 bayna ayd\u012bhim wabi-aym\u0101nihim yaq\u016bl\u016bna rabban\u0101 atmim lan\u0101 n\u016bran\u0101 wa-igh'fir lan\u0101 innaka \u02bfal\u0101 kulli shayin qad\u012bru",
    "verse_subtitle_english": "The Believers Repent",
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u062a\u0648\u0628\u0648\u0627 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u062a\u0648\u0628\u0629 \u0646\u0635\u0648\u062d\u0627 \u0639\u0633\u0649 \u0631\u0628\u0643\u0645 \u0623\u0646 \u064a\u0643\u0641\u0631 \u0639\u0646\u0643\u0645 \u0633\u064a\u0640\u0654\u0627\u062a\u0643\u0645 \u0648\u064a\u062f\u062e\u0644\u0643\u0645 \u062c\u0646\u062a \u062a\u062c\u0631\u0649 \u0645\u0646 \u062a\u062d\u062a\u0647\u0627 \u0627\u0644\u0623\u0646\u0647\u0631 \u064a\u0648\u0645 \u0644\u0627 \u064a\u062e\u0632\u0649 \u0627\u0644\u0644\u0647 \u0627\u0644\u0646\u0628\u0649 \u0648\u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0645\u0639\u0647 \u0646\u0648\u0631\u0647\u0645 \u064a\u0633\u0639\u0649 \u0628\u064a\u0646 \u0623\u064a\u062f\u064a\u0647\u0645 \u0648\u0628\u0623\u064a\u0645\u0646\u0647\u0645 \u064a\u0642\u0648\u0644\u0648\u0646 \u0631\u0628\u0646\u0627 \u0623\u062a\u0645\u0645 \u0644\u0646\u0627 \u0646\u0648\u0631\u0646\u0627 \u0648\u0627\u063a\u0641\u0631 \u0644\u0646\u0627 \u0625\u0646\u0643 \u0639\u0644\u0649 \u0643\u0644 \u0634\u0649\u0621 \u0642\u062f\u064a\u0631",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5299,
    "verse_index": 5300,
    "chapter_number": 66,
    "verse_id": "66:9",
    "verse_id_arabic": "\u0669:\u0666\u0666",
    "verse_number": 9,
    "verse_text_english": "O prophet, struggle against the disbelievers and the hypocrites and be stern with them. Their abode is Gehenna, and a miserable destiny.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0628\u0650\u0649\u0651\u064f \u062c\u064e\u0670\u0647\u0650\u062f\u0650 \u0671\u0644\u0652\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u064e \u0648\u064e\u0671\u0644\u0652\u0645\u064f\u0646\u064e\u0670\u0641\u0650\u0642\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u063a\u0652\u0644\u064f\u0638\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0648\u064e\u0645\u064e\u0623\u0652\u0648\u064e\u0649\u0670\u0647\u064f\u0645\u0652 \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064f \u0648\u064e\u0628\u0650\u0626\u0652\u0633\u064e \u0671\u0644\u0652\u0645\u064e\u0635\u0650\u064a\u0631\u064f",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 l-nabiyu j\u0101hidi l-kuf\u0101ra wal-mun\u0101fiq\u012bna wa-ugh'lu\u1e93 \u02bfalayhim wamaw\u0101hum jahannamu wabi'sa l-ma\u1e63\u012br",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0628\u0649 \u062c\u0647\u062f \u0627\u0644\u0643\u0641\u0627\u0631 \u0648\u0627\u0644\u0645\u0646\u0641\u0642\u064a\u0646 \u0648\u0627\u063a\u0644\u0638 \u0639\u0644\u064a\u0647\u0645 \u0648\u0645\u0623\u0648\u0649\u0647\u0645 \u062c\u0647\u0646\u0645 \u0648\u0628\u0626\u0633 \u0627\u0644\u0645\u0635\u064a\u0631",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
    "chapter_revelation_order": 107,
    "chapter_verses": 12
  },
  {
    "global_index": 5300,
    "verse_index": 5301,
    "chapter_number": 66,
    "verse_id": "66:10",
    "verse_id_arabic": "\u0661\u0660:\u0666\u0666",
    "verse_number": 10,
    "verse_text_english": "GOD cites as examples of those who disbelieved the wife of Noah and the wife of Lot. They were married to two of our righteous servants, but they betrayed them and, consequently, they could not help them at all against GOD. The two of them were told, \"Enter the Hellfire with those who deserved it.\"",
    "verse_text_arabic": "\u0636\u064e\u0631\u064e\u0628\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u062b\u064e\u0644\u064b\u0627 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u06df \u0671\u0645\u0652\u0631\u064e\u0623\u064e\u062a\u064e \u0646\u064f\u0648\u062d\u064d \u0648\u064e\u0671\u0645\u0652\u0631\u064e\u0623\u064e\u062a\u064e \u0644\u064f\u0648\u0637\u064d \u0643\u064e\u0627\u0646\u064e\u062a\u064e\u0627 \u062a\u064e\u062d\u0652\u062a\u064e \u0639\u064e\u0628\u0652\u062f\u064e\u064a\u0652\u0646\u0650 \u0645\u0650\u0646\u0652 \u0639\u0650\u0628\u064e\u0627\u062f\u0650\u0646\u064e\u0627 \u0635\u064e\u0670\u0644\u0650\u062d\u064e\u064a\u0652\u0646\u0650 \u0641\u064e\u062e\u064e\u0627\u0646\u064e\u062a\u064e\u0627\u0647\u064f\u0645\u064e\u0627 \u0641\u064e\u0644\u064e\u0645\u0652 \u064a\u064f\u063a\u0652\u0646\u0650\u064a\u064e\u0627 \u0639\u064e\u0646\u0652\u0647\u064f\u0645\u064e\u0627 \u0645\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0634\u064e\u064a\u0652\u0640\u0654\u064b\u0627 \u0648\u064e\u0642\u0650\u064a\u0644\u064e \u0671\u062f\u0652\u062e\u064f\u0644\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u064e \u0645\u064e\u0639\u064e \u0671\u0644\u062f\u0651\u064e\u0670\u062e\u0650\u0644\u0650\u064a\u0646\u064e",
    "verse_text_transliterated": "\u1e0daraba l-lahu mathalan lilladh\u012bna kafar\u016b im'ra-ata n\u016b\u1e25in wa-im'ra-ata l\u016b\u1e6din k\u0101nat\u0101 ta\u1e25ta \u02bfabdayni min \u02bfib\u0101din\u0101 \u1e63\u0101li\u1e25ayni fakh\u0101nat\u0101hum\u0101 falam yugh'niy\u0101 \u02bfanhum\u0101 mina l-lahi shayan waq\u012bla ud'khul\u0101 l-n\u0101ra ma\u02bfa l-d\u0101khil\u012bn",
    "verse_subtitle_english": "The Myth of Intercession Shattered",
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0636\u0631\u0628 \u0627\u0644\u0644\u0647 \u0645\u062b\u0644\u0627 \u0644\u0644\u0630\u064a\u0646 \u0643\u0641\u0631\u0648\u0627 \u0627\u0645\u0631\u0623\u062a \u0646\u0648\u062d \u0648\u0627\u0645\u0631\u0623\u062a \u0644\u0648\u0637 \u0643\u0627\u0646\u062a\u0627 \u062a\u062d\u062a \u0639\u0628\u062f\u064a\u0646 \u0645\u0646 \u0639\u0628\u0627\u062f\u0646\u0627 \u0635\u0644\u062d\u064a\u0646 \u0641\u062e\u0627\u0646\u062a\u0627\u0647\u0645\u0627 \u0641\u0644\u0645 \u064a\u063a\u0646\u064a\u0627 \u0639\u0646\u0647\u0645\u0627 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0634\u064a\u0640\u0654\u0627 \u0648\u0642\u064a\u0644 \u0627\u062f\u062e\u0644\u0627 \u0627\u0644\u0646\u0627\u0631 \u0645\u0639 \u0627\u0644\u062f\u062e\u0644\u064a\u0646",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
