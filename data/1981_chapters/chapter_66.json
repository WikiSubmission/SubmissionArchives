  },
  {
    "global_index": 5301,
    "verse_index": 5302,
    "chapter_number": 66,
    "verse_id": "66:11",
    "verse_id_arabic": "\u0661\u0661:\u0666\u0666",
    "verse_number": 11,
    "verse_text_english": "And GOD cites as an example of those who believed the wife of Pharaoh. She said, \"My Lord, build a home for me at You in Paradise, and save me from Pharaoh and his works; save me from the transgressing people.\"",
    "verse_text_arabic": "\u0648\u064e\u0636\u064e\u0631\u064e\u0628\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u062b\u064e\u0644\u064b\u0627 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0671\u0645\u0652\u0631\u064e\u0623\u064e\u062a\u064e \u0641\u0650\u0631\u0652\u0639\u064e\u0648\u0652\u0646\u064e \u0625\u0650\u0630\u0652 \u0642\u064e\u0627\u0644\u064e\u062a\u0652 \u0631\u064e\u0628\u0651\u0650 \u0671\u0628\u0652\u0646\u0650 \u0644\u0650\u0649 \u0639\u0650\u0646\u062f\u064e\u0643\u064e \u0628\u064e\u064a\u0652\u062a\u064b\u0627 \u0641\u0650\u0649 \u0671\u0644\u0652\u062c\u064e\u0646\u0651\u064e\u0629\u0650 \u0648\u064e\u0646\u064e\u062c\u0651\u0650\u0646\u0650\u0649 \u0645\u0650\u0646 \u0641\u0650\u0631\u0652\u0639\u064e\u0648\u0652\u0646\u064e \u0648\u064e\u0639\u064e\u0645\u064e\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0646\u064e\u062c\u0651\u0650\u0646\u0650\u0649 \u0645\u0650\u0646\u064e \u0671\u0644\u0652\u0642\u064e\u0648\u0652\u0645\u0650 \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e",
    "verse_text_transliterated": "wa\u1e0daraba l-lahu mathalan lilladh\u012bna \u0101man\u016b im'ra-ata fir'\u02bfawna idh q\u0101lat rabbi ib'ni l\u012b \u02bfindaka baytan f\u012b l-janati wanajjin\u012b min fir'\u02bfawna wa\u02bfamalihi wanajjin\u012b mina l-qawmi l-\u1e93\u0101lim\u012bn",
    "verse_subtitle_english": "Examples of the Believers Pharaoh's Wife",
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0648\u0636\u0631\u0628 \u0627\u0644\u0644\u0647 \u0645\u062b\u0644\u0627 \u0644\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0627\u0645\u0631\u0623\u062a \u0641\u0631\u0639\u0648\u0646 \u0625\u0630 \u0642\u0627\u0644\u062a \u0631\u0628 \u0627\u0628\u0646 \u0644\u0649 \u0639\u0646\u062f\u0643 \u0628\u064a\u062a\u0627 \u0641\u0649 \u0627\u0644\u062c\u0646\u0629 \u0648\u0646\u062c\u0646\u0649 \u0645\u0646 \u0641\u0631\u0639\u0648\u0646 \u0648\u0639\u0645\u0644\u0647 \u0648\u0646\u062c\u0646\u0649 \u0645\u0646 \u0627\u0644\u0642\u0648\u0645 \u0627\u0644\u0638\u0644\u0645\u064a\u0646",
    "chapter_title_english": "Prohibition",
    "chapter_title_arabic": "\u0627\u0644\u062a\u062d\u0631\u064a\u0645",
    "chapter_title_transliterated": "Al-Tahreem",
