  },
  {
    "global_index": 5783,
    "verse_index": 5784,
    "chapter_number": 78,
    "verse_id": "78:38",
    "verse_id_arabic": "\u0663\u0668:\u0667\u0668",
    "verse_number": 38,
    "verse_text_english": "The day will come when the Spirit and the angels will stand in a row. None will speak except those permitted by the Most Gracious, and they will utter only what is right.",
    "verse_text_arabic": "\u064a\u064e\u0648\u0652\u0645\u064e \u064a\u064e\u0642\u064f\u0648\u0645\u064f \u0671\u0644\u0631\u0651\u064f\u0648\u062d\u064f \u0648\u064e\u0671\u0644\u0652\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0635\u064e\u0641\u0651\u064b\u0627 \u0644\u0651\u064e\u0627 \u064a\u064e\u062a\u064e\u0643\u064e\u0644\u0651\u064e\u0645\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646\u0652 \u0623\u064e\u0630\u0650\u0646\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u064f \u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0635\u064e\u0648\u064e\u0627\u0628\u064b\u0627",
    "verse_text_transliterated": "yawma yaq\u016bmu l-r\u016b\u1e25u wal-mal\u0101ikatu \u1e63affan l\u0101 yatakallam\u016bna ill\u0101 man adhina lahu l-ra\u1e25m\u0101nu waq\u0101la \u1e63aw\u0101ba",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0648\u0645 \u064a\u0642\u0648\u0645 \u0627\u0644\u0631\u0648\u062d \u0648\u0627\u0644\u0645\u0644\u0626\u0643\u0629 \u0635\u0641\u0627 \u0644\u0627 \u064a\u062a\u0643\u0644\u0645\u0648\u0646 \u0625\u0644\u0627 \u0645\u0646 \u0623\u0630\u0646 \u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0648\u0642\u0627\u0644 \u0635\u0648\u0627\u0628\u0627",
    "chapter_title_english": "The Event",
    "chapter_title_arabic": "\u0627\u0644\u0646\u0628\u0623",
    "chapter_title_transliterated": "Al-Naba\u2019",
    "chapter_revelation_order": 80,
