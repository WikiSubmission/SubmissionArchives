    "chapter_number": 78,
    "verse_id": "78:39",
    "verse_id_arabic": "\u0663\u0669:\u0667\u0668",
    "verse_number": 39,
    "verse_text_english": "Such is the inevitable day. Whoever wills let him take refuge in his Lord.",
    "verse_text_arabic": "\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u064f \u0671\u0644\u0652\u062d\u064e\u0642\u0651\u064f \u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0645\u064e\u0640\u0654\u064e\u0627\u0628\u064b\u0627",
    "verse_text_transliterated": "dh\u0101lika l-yawmu l-\u1e25aqu faman sh\u0101a ittakhadha il\u0101 rabbihi ma\u0101ba",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0630\u0644\u0643 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062d\u0642 \u0641\u0645\u0646 \u0634\u0627\u0621 \u0627\u062a\u062e\u0630 \u0625\u0644\u0649 \u0631\u0628\u0647 \u0645\u0640\u0654\u0627\u0628\u0627",
