    "verse_id_arabic": "\u0663\u0667:\u0667\u0668",
    "verse_number": 37,
    "verse_text_english": "Lord of the heavens and the earth, and everything between them. The Most Gracious. No one can abrogate His decisions.",
    "verse_text_arabic": "\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0644\u064e\u0627 \u064a\u064e\u0645\u0652\u0644\u0650\u0643\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u0652\u0647\u064f \u062e\u0650\u0637\u064e\u0627\u0628\u064b\u0627",
    "verse_text_transliterated": "rabbi l-sam\u0101w\u0101ti wal-ar\u1e0di wam\u0101 baynahum\u0101 l-ra\u1e25m\u0101ni l\u0101 yamlik\u016bna min'hu khi\u1e6d\u0101ba",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0631\u0628 \u0627\u0644\u0633\u0645\u0648\u062a \u0648\u0627\u0644\u0623\u0631\u0636 \u0648\u0645\u0627 \u0628\u064a\u0646\u0647\u0645\u0627 \u0627\u0644\u0631\u062d\u0645\u0646 \u0644\u0627 \u064a\u0645\u0644\u0643\u0648\u0646 \u0645\u0646\u0647 \u062e\u0637\u0627\u0628\u0627",
    "chapter_title_english": "The Event",
    "chapter_title_arabic": "\u0627\u0644\u0646\u0628\u0623",
    "chapter_title_transliterated": "Al-Naba\u2019",
    "chapter_revelation_order": 80,
