  {
    "global_index": 5526,
    "verse_index": 5527,
    "chapter_number": 72,
    "verse_id": "72:12",
    "verse_id_arabic": "\u0661\u0662:\u0667\u0662",
    "verse_number": 12,
    "verse_text_english": "\u2018We know that we can never escape from God or flee from Him.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0638\u064e\u0646\u064e\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u0646\u0651\u064f\u0639\u0652\u062c\u0650\u0632\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0644\u064e\u0646 \u0646\u0651\u064f\u0639\u0652\u062c\u0650\u0632\u064e\u0647\u064f\u06e5 \u0647\u064e\u0631\u064e\u0628\u064b\u0627",
    "verse_text_transliterated": "wa-ann\u0101 \u1e93anann\u0101 an lan nu\u02bf'jiza l-laha f\u012b l-ar\u1e0di walan nu\u02bf'jizahu haraba",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0638\u0646\u0646\u0627 \u0623\u0646 \u0644\u0646 \u0646\u0639\u062c\u0632 \u0627\u0644\u0644\u0647 \u0641\u0649 \u0627\u0644\u0623\u0631\u0636 \u0648\u0644\u0646 \u0646\u0639\u062c\u0632\u0647 \u0647\u0631\u0628\u0627",
