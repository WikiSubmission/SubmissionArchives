    "verse_id_arabic": "\u0661\u0663:\u0667\u0662",
    "verse_number": 13,
    "verse_text_english": "\u2018When we heard the guidance, we believed therein.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u0651\u064e\u0627 \u0633\u064e\u0645\u0650\u0639\u0652\u0646\u064e\u0627 \u0671\u0644\u0652\u0647\u064f\u062f\u064e\u0649\u0670\u0653 \u0621\u064e\u0627\u0645\u064e\u0646\u0651\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6 \u0641\u064e\u0645\u064e\u0646 \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u06e2 \u0628\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0641\u064e\u0644\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f \u0628\u064e\u062e\u0652\u0633\u064b\u0627 \u0648\u064e\u0644\u064e\u0627 \u0631\u064e\u0647\u064e\u0642\u064b\u0627",
    "verse_text_transliterated": "wa-ann\u0101 lamm\u0101 sami\u02bf'n\u0101 l-hud\u0101 \u0101mann\u0101 bihi faman yu'min birabbihi fal\u0101 yakh\u0101fu bakhsan wal\u0101 rahaqa",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0644\u0645\u0627 \u0633\u0645\u0639\u0646\u0627 \u0627\u0644\u0647\u062f\u0649 \u0621\u0627\u0645\u0646\u0627 \u0628\u0647 \u0641\u0645\u0646 \u064a\u0624\u0645\u0646 \u0628\u0631\u0628\u0647 \u0641\u0644\u0627 \u064a\u062e\u0627\u0641 \u0628\u062e\u0633\u0627 \u0648\u0644\u0627 \u0631\u0647\u0642\u0627",
    "chapter_title_english": "Jinns",
