  {
    "global_index": 5528,
    "verse_index": 5529,
    "chapter_number": 72,
    "verse_id": "72:14",
    "verse_id_arabic": "\u0661\u0664:\u0667\u0662",
    "verse_number": 14,
    "verse_text_english": "\u2018Among us are Muslims, and among us are compromisers.\u2019 \u201d Those who submit are the ones who found guidance.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0645\u0650\u0646\u0651\u064e\u0627 \u0671\u0644\u0652\u0645\u064f\u0633\u0652\u0644\u0650\u0645\u064f\u0648\u0646\u064e \u0648\u064e\u0645\u0650\u0646\u0651\u064e\u0627 \u0671\u0644\u0652\u0642\u064e\u0670\u0633\u0650\u0637\u064f\u0648\u0646\u064e \u0641\u064e\u0645\u064e\u0646\u0652 \u0623\u064e\u0633\u0652\u0644\u064e\u0645\u064e \u0641\u064e\u0623\u064f\u0648\u06df\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u062a\u064e\u062d\u064e\u0631\u0651\u064e\u0648\u0652\u0627\u06df \u0631\u064e\u0634\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "wa-ann\u0101 minn\u0101 l-mus'lim\u016bna waminn\u0101 l-q\u0101si\u1e6d\u016bna faman aslama fa-ul\u0101ika ta\u1e25arraw rashada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0645\u0646\u0627 \u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646 \u0648\u0645\u0646\u0627 \u0627\u0644\u0642\u0633\u0637\u0648\u0646 \u0641\u0645\u0646 \u0623\u0633\u0644\u0645 \u0641\u0623\u0648\u0644\u0626\u0643 \u062a\u062d\u0631\u0648\u0627 \u0631\u0634\u062f\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5529,
    "verse_index": 5530,
    "chapter_number": 72,
    "verse_id": "72:15",
    "verse_id_arabic": "\u0661\u0665:\u0667\u0662",
    "verse_number": 15,
    "verse_text_english": "As for the compromisers, they will be fuel for hell. 16.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0671\u0644\u0652\u0642\u064e\u0670\u0633\u0650\u0637\u064f\u0648\u0646\u064e \u0641\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u06df \u0644\u0650\u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u062d\u064e\u0637\u064e\u0628\u064b\u0627",
    "verse_text_transliterated": "wa-amm\u0101 l-q\u0101si\u1e6d\u016bna fak\u0101n\u016b lijahannama \u1e25a\u1e6daba",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0645\u0627 \u0627\u0644\u0642\u0633\u0637\u0648\u0646 \u0641\u0643\u0627\u0646\u0648\u0627 \u0644\u062c\u0647\u0646\u0645 \u062d\u0637\u0628\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
