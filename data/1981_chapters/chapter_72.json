[
  {
    "global_index": 5514,
    "verse_index": 5515,
    "chapter_number": 72,
    "verse_id": "72:0",
    "verse_id_arabic": "\u0660:\u0667\u0662",
    "verse_number": 0,
    "verse_text_english": "In the name of GOD, Most Gracious, Most Merciful.",
    "verse_text_arabic": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "bis'mi l-lahi l-ra\u1e25m\u0101ni l-ra\u1e25\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5515,
    "verse_index": 5516,
    "chapter_number": 72,
    "verse_id": "72:1",
    "verse_id_arabic": "\u0661:\u0667\u0662",
    "verse_number": 1,
    "verse_text_english": "Say, \"I was inspired that a group of jinns listened, then said, 'We have heard a wonderful Quran.*",
    "verse_text_arabic": "\u0642\u064f\u0644\u0652 \u0623\u064f\u0648\u062d\u0650\u0649\u064e \u0625\u0650\u0644\u064e\u0649\u0651\u064e \u0623\u064e\u0646\u0651\u064e\u0647\u064f \u0671\u0633\u0652\u062a\u064e\u0645\u064e\u0639\u064e \u0646\u064e\u0641\u064e\u0631\u064c \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0652\u062c\u0650\u0646\u0651\u0650 \u0641\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u06df \u0625\u0650\u0646\u0651\u064e\u0627 \u0633\u064e\u0645\u0650\u0639\u0652\u0646\u064e\u0627 \u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u064b\u0627 \u0639\u064e\u062c\u064e\u0628\u064b\u0627",
    "verse_text_transliterated": "qul \u016b\u1e25iya ilayya annahu is'tama\u02bfa nafarun mina l-jini faq\u0101l\u016b inn\u0101 sami\u02bf'n\u0101 qur'\u0101nan \u02bfajaba",
    "verse_subtitle_english": null,
    "verse_footnote_english": "*72:1-28 The messenger here is named, mathematically, as \"Rashad Khalifa,\" to whom God revealed the end of the world (Appendix 25). The number of verses from 1:1 to 72:27, where the messenger is mentioned, is 5472, 19x72x4. The word \"Rashada\" occurs 4 times in Sura 72. The value of \"Rashada\" is 504, and 504+28 (verses of Sura 72) is 532, 19x28. The value of \"Rashad Khalifa\" (1230)+72+28=1330 =19x70. The digits of Sura 72 and its number of verses (28) add up to 7+2+2+8=19. Also, the crucial expression, \"only to a messenger that He chooses\" has a value of 1919, 19x101.",
    "verse_text_arabic_clean": "\u0642\u0644 \u0623\u0648\u062d\u0649 \u0625\u0644\u0649 \u0623\u0646\u0647 \u0627\u0633\u062a\u0645\u0639 \u0646\u0641\u0631 \u0645\u0646 \u0627\u0644\u062c\u0646 \u0641\u0642\u0627\u0644\u0648\u0627 \u0625\u0646\u0627 \u0633\u0645\u0639\u0646\u0627 \u0642\u0631\u0621\u0627\u0646\u0627 \u0639\u062c\u0628\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5516,
    "verse_index": 5517,
    "chapter_number": 72,
    "verse_id": "72:2",
    "verse_id_arabic": "\u0662:\u0667\u0662",
    "verse_number": 2,
    "verse_text_english": "\u2018It guides to righteousness, so we believed in it and will never set up idols besides our Lord.",
    "verse_text_arabic": "\u064a\u064e\u0647\u0652\u062f\u0650\u0649\u0653 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0631\u0651\u064f\u0634\u0652\u062f\u0650 \u0641\u064e\u0640\u0654\u064e\u0627\u0645\u064e\u0646\u0651\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6 \u0648\u064e\u0644\u064e\u0646 \u0646\u0651\u064f\u0634\u0652\u0631\u0650\u0643\u064e \u0628\u0650\u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627\u0653 \u0623\u064e\u062d\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "yahd\u012b il\u0101 l-rush'di fa\u0101mann\u0101 bihi walan nush'rika birabbin\u0101 a\u1e25ada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u0647\u062f\u0649 \u0625\u0644\u0649 \u0627\u0644\u0631\u0634\u062f \u0641\u0640\u0654\u0627\u0645\u0646\u0627 \u0628\u0647 \u0648\u0644\u0646 \u0646\u0634\u0631\u0643 \u0628\u0631\u0628\u0646\u0627 \u0623\u062d\u062f\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5517,
    "verse_index": 5518,
    "chapter_number": 72,
    "verse_id": "72:3",
    "verse_id_arabic": "\u0663:\u0667\u0662",
    "verse_number": 3,
    "verse_text_english": "\u2018He is the most high; our one and only Lord; never did He have a spouse, nor a son.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0639\u064e\u0670\u0644\u064e\u0649\u0670 \u062c\u064e\u062f\u0651\u064f \u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627 \u0645\u064e\u0627 \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0635\u064e\u0670\u062d\u0650\u0628\u064e\u0629\u064b \u0648\u064e\u0644\u064e\u0627 \u0648\u064e\u0644\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "wa-annahu ta\u02bf\u0101l\u0101 jaddu rabbin\u0101 m\u0101 ittakhadha \u1e63\u0101\u1e25ibatan wal\u0101 walada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0647 \u062a\u0639\u0644\u0649 \u062c\u062f \u0631\u0628\u0646\u0627 \u0645\u0627 \u0627\u062a\u062e\u0630 \u0635\u062d\u0628\u0629 \u0648\u0644\u0627 \u0648\u0644\u062f\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5518,
    "verse_index": 5519,
    "chapter_number": 72,
    "verse_id": "72:4",
    "verse_id_arabic": "\u0664:\u0667\u0662",
    "verse_number": 4,
    "verse_text_english": "\u2018It was the fool among us who used to utter such blasphemies about God.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0633\u064e\u0641\u0650\u064a\u0647\u064f\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0634\u064e\u0637\u064e\u0637\u064b\u0627",
    "verse_text_transliterated": "wa-annahu k\u0101na yaq\u016blu saf\u012bhun\u0101 \u02bfal\u0101 l-lahi sha\u1e6da\u1e6da",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0647 \u0643\u0627\u0646 \u064a\u0642\u0648\u0644 \u0633\u0641\u064a\u0647\u0646\u0627 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0634\u0637\u0637\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5519,
    "verse_index": 5520,
    "chapter_number": 72,
    "verse_id": "72:5",
    "verse_id_arabic": "\u0665:\u0667\u0662",
    "verse_number": 5,
    "verse_text_english": "\u2018We never thought that the humans and the jinns could utter lies about God.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0638\u064e\u0646\u064e\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u062a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0652\u0625\u0650\u0646\u0633\u064f \u0648\u064e\u0671\u0644\u0652\u062c\u0650\u0646\u0651\u064f \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0643\u064e\u0630\u0650\u0628\u064b\u0627",
    "verse_text_transliterated": "wa-ann\u0101 \u1e93anann\u0101 an lan taq\u016bla l-insu wal-jinu \u02bfal\u0101 l-lahi kadhiba",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0638\u0646\u0646\u0627 \u0623\u0646 \u0644\u0646 \u062a\u0642\u0648\u0644 \u0627\u0644\u0625\u0646\u0633 \u0648\u0627\u0644\u062c\u0646 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0643\u0630\u0628\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5520,
    "verse_index": 5521,
    "chapter_number": 72,
    "verse_id": "72:6",
    "verse_id_arabic": "\u0666:\u0667\u0662",
    "verse_number": 6,
    "verse_text_english": "\u2018Some human beings used to seek benefits from jinn beings, but they only gave them problems.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0631\u0650\u062c\u064e\u0627\u0644\u064c \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0652\u0625\u0650\u0646\u0633\u0650 \u064a\u064e\u0639\u064f\u0648\u0630\u064f\u0648\u0646\u064e \u0628\u0650\u0631\u0650\u062c\u064e\u0627\u0644\u064d \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0652\u062c\u0650\u0646\u0651\u0650 \u0641\u064e\u0632\u064e\u0627\u062f\u064f\u0648\u0647\u064f\u0645\u0652 \u0631\u064e\u0647\u064e\u0642\u064b\u0627",
    "verse_text_transliterated": "wa-annahu k\u0101na rij\u0101lun mina l-insi ya\u02bf\u016bdh\u016bna birij\u0101lin mina l-jini faz\u0101d\u016bhum rahaqa",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0647 \u0643\u0627\u0646 \u0631\u062c\u0627\u0644 \u0645\u0646 \u0627\u0644\u0625\u0646\u0633 \u064a\u0639\u0648\u0630\u0648\u0646 \u0628\u0631\u062c\u0627\u0644 \u0645\u0646 \u0627\u0644\u062c\u0646 \u0641\u0632\u0627\u062f\u0648\u0647\u0645 \u0631\u0647\u0642\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5521,
    "verse_index": 5522,
    "chapter_number": 72,
    "verse_id": "72:7",
    "verse_id_arabic": "\u0667:\u0667\u0662",
    "verse_number": 7,
    "verse_text_english": "\u2018They thought, just like you thought, that God will not resurrect anyone.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u0638\u064e\u0646\u0651\u064f\u0648\u0627\u06df \u0643\u064e\u0645\u064e\u0627 \u0638\u064e\u0646\u064e\u0646\u062a\u064f\u0645\u0652 \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064e\u0628\u0652\u0639\u064e\u062b\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u062d\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "wa-annahum \u1e93ann\u016b kam\u0101 \u1e93anantum an lan yab\u02bfatha l-lahu a\u1e25ada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0647\u0645 \u0638\u0646\u0648\u0627 \u0643\u0645\u0627 \u0638\u0646\u0646\u062a\u0645 \u0623\u0646 \u0644\u0646 \u064a\u0628\u0639\u062b \u0627\u0644\u0644\u0647 \u0623\u062d\u062f\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5522,
    "verse_index": 5523,
    "chapter_number": 72,
    "verse_id": "72:8",
    "verse_id_arabic": "\u0668:\u0667\u0662",
    "verse_number": 8,
    "verse_text_english": "\u2018And we tried to touch the heaven, but we find it full of mighty guards and projectiles.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064e\u0633\u0652\u0646\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064e \u0641\u064e\u0648\u064e\u062c\u064e\u062f\u0652\u0646\u064e\u0670\u0647\u064e\u0627 \u0645\u064f\u0644\u0650\u0626\u064e\u062a\u0652 \u062d\u064e\u0631\u064e\u0633\u064b\u0627 \u0634\u064e\u062f\u0650\u064a\u062f\u064b\u0627 \u0648\u064e\u0634\u064f\u0647\u064f\u0628\u064b\u0627",
    "verse_text_transliterated": "wa-ann\u0101 lamasn\u0101 l-sam\u0101a fawajadn\u0101h\u0101 muli-at \u1e25arasan shad\u012bdan washuhuba",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0644\u0645\u0633\u0646\u0627 \u0627\u0644\u0633\u0645\u0627\u0621 \u0641\u0648\u062c\u062f\u0646\u0647\u0627 \u0645\u0644\u0626\u062a \u062d\u0631\u0633\u0627 \u0634\u062f\u064a\u062f\u0627 \u0648\u0634\u0647\u0628\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5523,
    "verse_index": 5524,
    "chapter_number": 72,
    "verse_id": "72:9",
    "verse_id_arabic": "\u0669:\u0667\u0662",
    "verse_number": 9,
    "verse_text_english": "\u2018We used to sneak therein to listen; now, anyone who listens is immedi\u00ac ately pursued by a projectile.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u0642\u0652\u0639\u064f\u062f\u064f \u0645\u0650\u0646\u0652\u0647\u064e\u0627 \u0645\u064e\u0642\u064e\u0670\u0639\u0650\u062f\u064e \u0644\u0650\u0644\u0633\u0651\u064e\u0645\u0652\u0639\u0650 \u0641\u064e\u0645\u064e\u0646 \u064a\u064e\u0633\u0652\u062a\u064e\u0645\u0650\u0639\u0650 \u0671\u0644\u0652\u0621\u064e\u0627\u0646\u064e \u064a\u064e\u062c\u0650\u062f\u0652 \u0644\u064e\u0647\u064f\u06e5 \u0634\u0650\u0647\u064e\u0627\u0628\u064b\u0627 \u0631\u0651\u064e\u0635\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "wa-ann\u0101 kunn\u0101 naq\u02bfudu min'h\u0101 maq\u0101\u02bfida lilssam\u02bfi faman yastami\u02bfi l-\u0101na yajid lahu shih\u0101ban ra\u1e63ada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0643\u0646\u0627 \u0646\u0642\u0639\u062f \u0645\u0646\u0647\u0627 \u0645\u0642\u0639\u062f \u0644\u0644\u0633\u0645\u0639 \u0641\u0645\u0646 \u064a\u0633\u062a\u0645\u0639 \u0627\u0644\u0621\u0627\u0646 \u064a\u062c\u062f \u0644\u0647 \u0634\u0647\u0627\u0628\u0627 \u0631\u0635\u062f\u0627",
    "chapter_title_english": "Jinns",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0646",
    "chapter_title_transliterated": "Al-Jinn",
    "chapter_revelation_order": 40,
    "chapter_verses": 28
  },
  {
    "global_index": 5524,
    "verse_index": 5525,
    "chapter_number": 72,
    "verse_id": "72:10",
    "verse_id_arabic": "\u0661\u0660:\u0667\u0662",
    "verse_number": 10,
    "verse_text_english": "\u2018And we have no idea whether those on earth are destined for disaster or if their Lord plans something good for them.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0644\u064e\u0627 \u0646\u064e\u062f\u0652\u0631\u0650\u0649\u0653 \u0623\u064e\u0634\u064e\u0631\u0651\u064c \u0623\u064f\u0631\u0650\u064a\u062f\u064e \u0628\u0650\u0645\u064e\u0646 \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0623\u064e\u0645\u0652 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0628\u0650\u0647\u0650\u0645\u0652 \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u0645\u0652 \u0631\u064e\u0634\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "wa-ann\u0101 l\u0101 nadr\u012b asharrun ur\u012bda biman f\u012b l-ar\u1e0di am ar\u0101da bihim rabbuhum rashada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0644\u0627 \u0646\u062f\u0631\u0649 \u0623\u0634\u0631 \u0623\u0631\u064a\u062f \u0628\u0645\u0646 \u0641\u0649 \u0627\u0644\u0623\u0631\u0636 \u0623\u0645 \u0623\u0631\u0627\u062f \u0628\u0647\u0645 \u0631\u0628\u0647\u0645 \u0631\u0634\u062f\u0627",
