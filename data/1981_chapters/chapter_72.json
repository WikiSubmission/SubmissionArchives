    "verse_number": 11,
    "verse_text_english": "\u2018Some of us are righteous and some are less than righteous.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0645\u0650\u0646\u0651\u064e\u0627 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064f\u0648\u0646\u064e \u0648\u064e\u0645\u0650\u0646\u0651\u064e\u0627 \u062f\u064f\u0648\u0646\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0643\u064f\u0646\u0651\u064e\u0627 \u0637\u064e\u0631\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u0642\u0650\u062f\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "wa-ann\u0101 minn\u0101 l-\u1e63\u0101li\u1e25\u016bna waminn\u0101 d\u016bna dh\u0101lika kunn\u0101 \u1e6dar\u0101iqa qidada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0645\u0646\u0627 \u0627\u0644\u0635\u0644\u062d\u0648\u0646 \u0648\u0645\u0646\u0627 \u062f\u0648\u0646 \u0630\u0644\u0643 \u0643\u0646\u0627 \u0637\u0631\u0627\u0626\u0642 \u0642\u062f\u062f\u0627",
