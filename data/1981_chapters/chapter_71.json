    "verse_number": 27,
    "verse_text_english": "\u201cIf You leave any of them, they only mislead Your servants and give birth to evil disbelievers.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0625\u0650\u0646 \u062a\u064e\u0630\u064e\u0631\u0652\u0647\u064f\u0645\u0652 \u064a\u064f\u0636\u0650\u0644\u0651\u064f\u0648\u0627\u06df \u0639\u0650\u0628\u064e\u0627\u062f\u064e\u0643\u064e \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0644\u0650\u062f\u064f\u0648\u0653\u0627\u06df \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u064e\u0627\u062c\u0650\u0631\u064b\u0627 \u0643\u064e\u0641\u0651\u064e\u0627\u0631\u064b\u0627",
    "verse_text_transliterated": "innaka in tadharhum yu\u1e0dill\u016b \u02bfib\u0101daka wal\u0101 yalid\u016b ill\u0101 f\u0101jiran kaff\u0101ra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646\u0643 \u0625\u0646 \u062a\u0630\u0631\u0647\u0645 \u064a\u0636\u0644\u0648\u0627 \u0639\u0628\u0627\u062f\u0643 \u0648\u0644\u0627 \u064a\u0644\u062f\u0648\u0627 \u0625\u0644\u0627 \u0641\u0627\u062c\u0631\u0627 \u0643\u0641\u0627\u0631\u0627",
    "chapter_title_english": "Noah",
