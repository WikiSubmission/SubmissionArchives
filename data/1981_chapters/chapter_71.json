    "verse_number": 10,
    "verse_text_english": "\u201cI said, \u2018Ask forgiveness from your Lord; He is forgiving.",
    "verse_text_arabic": "\u0641\u064e\u0642\u064f\u0644\u0652\u062a\u064f \u0671\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u064f\u0648\u0627\u06df \u0631\u064e\u0628\u0651\u064e\u0643\u064f\u0645\u0652 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u063a\u064e\u0641\u0651\u064e\u0627\u0631\u064b\u0627",
    "verse_text_transliterated": "faqul'tu is'taghfir\u016b rabbakum innahu k\u0101na ghaff\u0101ra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0641\u0642\u0644\u062a \u0627\u0633\u062a\u063a\u0641\u0631\u0648\u0627 \u0631\u0628\u0643\u0645 \u0625\u0646\u0647 \u0643\u0627\u0646 \u063a\u0641\u0627\u0631\u0627",
