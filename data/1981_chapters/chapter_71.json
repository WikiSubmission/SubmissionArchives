    "verse_number": 24,
    "verse_text_english": "\u201cThey misguided many people. (My Lord,) do not increase the wicked except in straying.\u201d",
    "verse_text_arabic": "\u0648\u064e\u0642\u064e\u062f\u0652 \u0623\u064e\u0636\u064e\u0644\u0651\u064f\u0648\u0627\u06df \u0643\u064e\u062b\u0650\u064a\u0631\u064b\u0627 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0632\u0650\u062f\u0650 \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0636\u064e\u0644\u064e\u0670\u0644\u064b\u0627",
    "verse_text_transliterated": "waqad a\u1e0dall\u016b kath\u012bran wal\u0101 tazidi l-\u1e93\u0101lim\u012bna ill\u0101 \u1e0dal\u0101la",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0642\u062f \u0623\u0636\u0644\u0648\u0627 \u0643\u062b\u064a\u0631\u0627 \u0648\u0644\u0627 \u062a\u0632\u062f \u0627\u0644\u0638\u0644\u0645\u064a\u0646 \u0625\u0644\u0627 \u0636\u0644\u0644\u0627",
    "chapter_title_english": "Noah",
