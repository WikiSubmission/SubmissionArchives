    "verse_id_arabic": "\u0662\u0666:\u0667\u0661",
    "verse_number": 26,
    "verse_text_english": "Noah said, \u201cLord, do not leave on earth a single disbeliever.",
    "verse_text_arabic": "\u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0646\u064f\u0648\u062d\u064c \u0631\u0651\u064e\u0628\u0651\u0650 \u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u0652 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u0652\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u062f\u064e\u064a\u0651\u064e\u0627\u0631\u064b\u0627",
    "verse_text_transliterated": "waq\u0101la n\u016b\u1e25un rabbi l\u0101 tadhar \u02bfal\u0101 l-ar\u1e0di mina l-k\u0101fir\u012bna dayy\u0101ra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0642\u0627\u0644 \u0646\u0648\u062d \u0631\u0628 \u0644\u0627 \u062a\u0630\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u0636 \u0645\u0646 \u0627\u0644\u0643\u0641\u0631\u064a\u0646 \u062f\u064a\u0627\u0631\u0627",
