    "verse_number": 9,
    "verse_text_english": "\u201c1 preached to them publicly, and I preached to them privately.",
    "verse_text_arabic": "\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u0650\u0649\u0653 \u0623\u064e\u0639\u0652\u0644\u064e\u0646\u062a\u064f \u0644\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0633\u0652\u0631\u064e\u0631\u0652\u062a\u064f \u0644\u064e\u0647\u064f\u0645\u0652 \u0625\u0650\u0633\u0652\u0631\u064e\u0627\u0631\u064b\u0627",
    "verse_text_transliterated": "thumma inn\u012b a\u02bflantu lahum wa-asrartu lahum is'r\u0101ra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
