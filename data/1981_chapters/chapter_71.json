    "verse_number": 28,
    "verse_text_english": "\u201cMy Lord, forgive me, and my parents, and anyone who enters my home as a believer, and all the believing men and women.",
    "verse_text_arabic": "\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u0650\u0649 \u0648\u064e\u0644\u0650\u0648\u064e\u0670\u0644\u0650\u062f\u064e\u0649\u0651\u064e \u0648\u064e\u0644\u0650\u0645\u064e\u0646 \u062f\u064e\u062e\u064e\u0644\u064e \u0628\u064e\u064a\u0652\u062a\u0650\u0649\u064e \u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064b\u0627 \u0648\u064e\u0644\u0650\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064e\u0670\u062a\u0650 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0632\u0650\u062f\u0650 \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u062a\u064e\u0628\u064e\u0627\u0631\u064b\u06e2\u0627",
    "verse_text_transliterated": "rabbi igh'fir l\u012b waliw\u0101lidayya waliman dakhala baytiya mu'minan walil'mu'min\u012bna wal-mu'min\u0101ti wal\u0101 tazidi l-\u1e93\u0101lim\u012bna ill\u0101 tab\u0101ra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0631\u0628 \u0627\u063a\u0641\u0631 \u0644\u0649 \u0648\u0644\u0648\u0644\u062f\u0649 \u0648\u0644\u0645\u0646 \u062f\u062e\u0644 \u0628\u064a\u062a\u0649 \u0645\u0624\u0645\u0646\u0627 \u0648\u0644\u0644\u0645\u0624\u0645\u0646\u064a\u0646 \u0648\u0627\u0644\u0645\u0624\u0645\u0646\u062a \u0648\u0644\u0627 \u062a\u0632\u062f \u0627\u0644\u0638\u0644\u0645\u064a\u0646 \u0625\u0644\u0627 \u062a\u0628\u0627\u0631\u0627",
