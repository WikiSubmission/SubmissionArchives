    "chapter_number": 71,
    "verse_id": "71:1",
    "verse_id_arabic": "\u0661:\u0667\u0661",
    "verse_number": 1,
    "verse_text_english": "We sent Noah to his people: \"You shall warn your people before a painful retribution afflicts them.\"",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0631\u0652\u0633\u064e\u0644\u0652\u0646\u064e\u0627 \u0646\u064f\u0648\u062d\u064b\u0627 \u0625\u0650\u0644\u064e\u0649\u0670 \u0642\u064e\u0648\u0652\u0645\u0650\u0647\u0650\u06e6\u0653 \u0623\u064e\u0646\u0652 \u0623\u064e\u0646\u0630\u0650\u0631\u0652 \u0642\u064e\u0648\u0652\u0645\u064e\u0643\u064e \u0645\u0650\u0646 \u0642\u064e\u0628\u0652\u0644\u0650 \u0623\u064e\u0646 \u064a\u064e\u0623\u0652\u062a\u0650\u064a\u064e\u0647\u064f\u0645\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u064c \u0623\u064e\u0644\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "inn\u0101 arsaln\u0101 n\u016b\u1e25an il\u0101 qawmihi an andhir qawmaka min qabli an yatiyahum \u02bfadh\u0101bun al\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0625\u0646\u0627 \u0623\u0631\u0633\u0644\u0646\u0627 \u0646\u0648\u062d\u0627 \u0625\u0644\u0649 \u0642\u0648\u0645\u0647 \u0623\u0646 \u0623\u0646\u0630\u0631 \u0642\u0648\u0645\u0643 \u0645\u0646 \u0642\u0628\u0644 \u0623\u0646 \u064a\u0623\u062a\u064a\u0647\u0645 \u0639\u0630\u0627\u0628 \u0623\u0644\u064a\u0645",
    "chapter_title_english": "Noah",
    "chapter_title_arabic": "\u0646\u0648\u062d",
    "chapter_title_transliterated": "Nuh",
    "chapter_revelation_order": 71,
    "chapter_verses": 28
  },
  {
    "global_index": 5487,
    "verse_index": 5488,
    "chapter_number": 71,
    "verse_id": "71:2",
    "verse_id_arabic": "\u0662:\u0667\u0661",
    "verse_number": 2,
    "verse_text_english": "He said, \u201cO my people, I come to you as a warner.",
    "verse_text_arabic": "\u0642\u064e\u0627\u0644\u064e \u064a\u064e\u0670\u0642\u064e\u0648\u0652\u0645\u0650 \u0625\u0650\u0646\u0651\u0650\u0649 \u0644\u064e\u0643\u064f\u0645\u0652 \u0646\u064e\u0630\u0650\u064a\u0631\u064c \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u064c",
    "verse_text_transliterated": "q\u0101la y\u0101qawmi inn\u012b lakum nadh\u012brun mub\u012bnu",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0642\u0627\u0644 \u064a\u0642\u0648\u0645 \u0625\u0646\u0649 \u0644\u0643\u0645 \u0646\u0630\u064a\u0631 \u0645\u0628\u064a\u0646",
    "chapter_title_english": "Noah",
    "chapter_title_arabic": "\u0646\u0648\u062d",
    "chapter_title_transliterated": "Nuh",
    "chapter_revelation_order": 71,
    "chapter_verses": 28
  },
  {
    "global_index": 5488,
    "verse_index": 5489,
    "chapter_number": 71,
    "verse_id": "71:3",
    "verse_id_arabic": "\u0663:\u0667\u0661",
    "verse_number": 3,
    "verse_text_english": "\u201cYou shall worship God, work righteousness, and obey me.",
    "verse_text_arabic": "\u0623\u064e\u0646\u0650 \u0671\u0639\u0652\u0628\u064f\u062f\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0671\u062a\u0651\u064e\u0642\u064f\u0648\u0647\u064f \u0648\u064e\u0623\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0646\u0650",
    "verse_text_transliterated": "ani u\u02bf'bud\u016b l-laha wa-ittaq\u016bhu wa-a\u1e6d\u012b\u02bf\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0623\u0646 \u0627\u0639\u0628\u062f\u0648\u0627 \u0627\u0644\u0644\u0647 \u0648\u0627\u062a\u0642\u0648\u0647 \u0648\u0623\u0637\u064a\u0639\u0648\u0646",
    "chapter_title_english": "Noah",
    "chapter_title_arabic": "\u0646\u0648\u062d",
    "chapter_title_transliterated": "Nuh",
    "chapter_revelation_order": 71,
    "chapter_verses": 28
  },
  {
    "global_index": 5489,
    "verse_index": 5490,
    "chapter_number": 71,
    "verse_id": "71:4",
    "verse_id_arabic": "\u0664:\u0667\u0661",
    "verse_number": 4,
    "verse_text_english": "\u201cGod will then forgive your sins and respite you for a predetermined life span.",
    "verse_text_arabic": "\u064a\u064e\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646 \u0630\u064f\u0646\u064f\u0648\u0628\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u064a\u064f\u0624\u064e\u062e\u0651\u0650\u0631\u0652\u0643\u064f\u0645\u0652 \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u062c\u064e\u0644\u064d \u0645\u0651\u064f\u0633\u064e\u0645\u0651\u064b\u0649 \u0625\u0650\u0646\u0651\u064e \u0623\u064e\u062c\u064e\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u064e\u062e\u0651\u064e\u0631\u064f \u0644\u064e\u0648\u0652 \u0643\u064f\u0646\u062a\u064f\u0645\u0652 \u062a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "yaghfir lakum min dhun\u016bbikum wayu-akhir'kum il\u0101 ajalin musamman inna ajala l-lahi idh\u0101 j\u0101a l\u0101 yu-akharu law kuntum ta\u02bflam\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u063a\u0641\u0631 \u0644\u0643\u0645 \u0645\u0646 \u0630\u0646\u0648\u0628\u0643\u0645 \u0648\u064a\u0624\u062e\u0631\u0643\u0645 \u0625\u0644\u0649 \u0623\u062c\u0644 \u0645\u0633\u0645\u0649 \u0625\u0646 \u0623\u062c\u0644 \u0627\u0644\u0644\u0647 \u0625\u0630\u0627 \u062c\u0627\u0621 \u0644\u0627 \u064a\u0624\u062e\u0631 \u0644\u0648 \u0643\u0646\u062a\u0645 \u062a\u0639\u0644\u0645\u0648\u0646",
    "chapter_title_english": "Noah",
    "chapter_title_arabic": "\u0646\u0648\u062d",
    "chapter_title_transliterated": "Nuh",
    "chapter_revelation_order": 71,
    "chapter_verses": 28
  },
  {
    "global_index": 5490,
    "verse_index": 5491,
    "chapter_number": 71,
    "verse_id": "71:5",
    "verse_id_arabic": "\u0665:\u0667\u0661",
    "verse_number": 5,
    "verse_text_english": "He later said, \u201cLord, I have preached to my people night and day.",
    "verse_text_arabic": "\u0642\u064e\u0627\u0644\u064e \u0631\u064e\u0628\u0651\u0650 \u0625\u0650\u0646\u0651\u0650\u0649 \u062f\u064e\u0639\u064e\u0648\u0652\u062a\u064f \u0642\u064e\u0648\u0652\u0645\u0650\u0649 \u0644\u064e\u064a\u0652\u0644\u064b\u0627 \u0648\u064e\u0646\u064e\u0647\u064e\u0627\u0631\u064b\u0627",
    "verse_text_transliterated": "q\u0101la rabbi inn\u012b da\u02bfawtu qawm\u012b laylan wanah\u0101ra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0642\u0627\u0644 \u0631\u0628 \u0625\u0646\u0649 \u062f\u0639\u0648\u062a \u0642\u0648\u0645\u0649 \u0644\u064a\u0644\u0627 \u0648\u0646\u0647\u0627\u0631\u0627",
    "chapter_title_english": "Noah",
    "chapter_title_arabic": "\u0646\u0648\u062d",
    "chapter_title_transliterated": "Nuh",
    "chapter_revelation_order": 71,
    "chapter_verses": 28
  },
  {
