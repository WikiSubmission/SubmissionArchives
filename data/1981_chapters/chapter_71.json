    "verse_id_arabic": "\u0667:\u0667\u0661",
    "verse_number": 7,
    "verse_text_english": "\u201cWhenever I exhorted them to seek Your forgiveness, they placed their fingers in their ears, covered themselves with their clothes, and insisted on their arrogance.",
    "verse_text_arabic": "\u0648\u064e\u0625\u0650\u0646\u0651\u0650\u0649 \u0643\u064f\u0644\u0651\u064e\u0645\u064e\u0627 \u062f\u064e\u0639\u064e\u0648\u0652\u062a\u064f\u0647\u064f\u0645\u0652 \u0644\u0650\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u064e \u0644\u064e\u0647\u064f\u0645\u0652 \u062c\u064e\u0639\u064e\u0644\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u0635\u064e\u0670\u0628\u0650\u0639\u064e\u0647\u064f\u0645\u0652 \u0641\u0650\u0649\u0653 \u0621\u064e\u0627\u0630\u064e\u0627\u0646\u0650\u0647\u0650\u0645\u0652 \u0648\u064e\u0671\u0633\u0652\u062a\u064e\u063a\u0652\u0634\u064e\u0648\u0652\u0627\u06df \u062b\u0650\u064a\u064e\u0627\u0628\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0635\u064e\u0631\u0651\u064f\u0648\u0627\u06df \u0648\u064e\u0671\u0633\u0652\u062a\u064e\u0643\u0652\u0628\u064e\u0631\u064f\u0648\u0627\u06df \u0671\u0633\u0652\u062a\u0650\u0643\u0652\u0628\u064e\u0627\u0631\u064b\u0627",
    "verse_text_transliterated": "wa-inn\u012b kullam\u0101 da\u02bfawtuhum litaghfira lahum ja\u02bfal\u016b a\u1e63\u0101bi\u02bfahum f\u012b \u0101dh\u0101nihim wa-is'taghshaw thiy\u0101bahum wa-a\u1e63arr\u016b wa-is'takbar\u016b is'tik'b\u0101ra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0625\u0646\u0649 \u0643\u0644\u0645\u0627 \u062f\u0639\u0648\u062a\u0647\u0645 \u0644\u062a\u063a\u0641\u0631 \u0644\u0647\u0645 \u062c\u0639\u0644\u0648\u0627 \u0623\u0635\u0628\u0639\u0647\u0645 \u0641\u0649 \u0621\u0627\u0630\u0627\u0646\u0647\u0645 \u0648\u0627\u0633\u062a\u063a\u0634\u0648\u0627 \u062b\u064a\u0627\u0628\u0647\u0645 \u0648\u0623\u0635\u0631\u0648\u0627 \u0648\u0627\u0633\u062a\u0643\u0628\u0631\u0648\u0627 \u0627\u0633\u062a\u0643\u0628\u0627\u0631\u0627",
    "chapter_title_english": "Noah",
    "chapter_title_arabic": "\u0646\u0648\u062d",
