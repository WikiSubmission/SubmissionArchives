  {
    "global_index": 5510,
    "verse_index": 5511,
    "chapter_number": 71,
    "verse_id": "71:25",
    "verse_id_arabic": "\u0662\u0665:\u0667\u0661",
    "verse_number": 25,
    "verse_text_english": "Because of their transgressions, they were drowned and destined for hell. They had none to help them against God.",
    "verse_text_arabic": "\u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u062e\u064e\u0637\u0650\u064a\u0653\u0640\u0654\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u0652 \u0623\u064f\u063a\u0652\u0631\u0650\u0642\u064f\u0648\u0627\u06df \u0641\u064e\u0623\u064f\u062f\u0652\u062e\u0650\u0644\u064f\u0648\u0627\u06df \u0646\u064e\u0627\u0631\u064b\u0627 \u0641\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u062c\u0650\u062f\u064f\u0648\u0627\u06df \u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u064b\u0627",
    "verse_text_transliterated": "mimm\u0101 kha\u1e6d\u012b\u0101tihim ugh'riq\u016b fa-ud'khil\u016b n\u0101ran falam yajid\u016b lahum min d\u016bni l-lahi an\u1e63\u0101ra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0645\u0645\u0627 \u062e\u0637\u064a\u0640\u0654\u062a\u0647\u0645 \u0623\u063a\u0631\u0642\u0648\u0627 \u0641\u0623\u062f\u062e\u0644\u0648\u0627 \u0646\u0627\u0631\u0627 \u0641\u0644\u0645 \u064a\u062c\u062f\u0648\u0627 \u0644\u0647\u0645 \u0645\u0646 \u062f\u0648\u0646 \u0627\u0644\u0644\u0647 \u0623\u0646\u0635\u0627\u0631\u0627",
    "chapter_title_english": "Noah",
    "chapter_title_arabic": "\u0646\u0648\u062d",
    "chapter_title_transliterated": "Nuh",
    "chapter_revelation_order": 71,
