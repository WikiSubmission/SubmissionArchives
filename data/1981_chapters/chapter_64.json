  {
    "global_index": 5274,
    "verse_index": 5275,
    "chapter_number": 64,
    "verse_id": "64:16",
    "verse_id_arabic": "\u0661\u0666:\u0666\u0664",
    "verse_number": 16,
    "verse_text_english": "Therefore, you shall reverence GOD as much as you can, and listen, and obey, and give (to charity) for your own good. Anyone who is protected from his own stinginess, these are the successful ones.",
    "verse_text_arabic": "\u0641\u064e\u0671\u062a\u0651\u064e\u0642\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0645\u064e\u0627 \u0671\u0633\u0652\u062a\u064e\u0637\u064e\u0639\u0652\u062a\u064f\u0645\u0652 \u0648\u064e\u0671\u0633\u0652\u0645\u064e\u0639\u064f\u0648\u0627\u06df \u0648\u064e\u0623\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0627\u06df \u0648\u064e\u0623\u064e\u0646\u0641\u0650\u0642\u064f\u0648\u0627\u06df \u062e\u064e\u064a\u0652\u0631\u064b\u0627 \u0644\u0651\u0650\u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0648\u0642\u064e \u0634\u064f\u062d\u0651\u064e \u0646\u064e\u0641\u0652\u0633\u0650\u0647\u0650\u06e6 \u0641\u064e\u0623\u064f\u0648\u06df\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u0652\u0645\u064f\u0641\u0652\u0644\u0650\u062d\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "fa-ittaq\u016b l-laha m\u0101 is'ta\u1e6da\u02bftum wa-is'ma\u02bf\u016b wa-a\u1e6d\u012b\u02bf\u016b wa-anfiq\u016b khayran li-anfusikum waman y\u016bqa shu\u1e25\u1e25a nafsihi fa-ul\u0101ika humu l-muf'li\u1e25\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0641\u0627\u062a\u0642\u0648\u0627 \u0627\u0644\u0644\u0647 \u0645\u0627 \u0627\u0633\u062a\u0637\u0639\u062a\u0645 \u0648\u0627\u0633\u0645\u0639\u0648\u0627 \u0648\u0623\u0637\u064a\u0639\u0648\u0627 \u0648\u0623\u0646\u0641\u0642\u0648\u0627 \u062e\u064a\u0631\u0627 \u0644\u0623\u0646\u0641\u0633\u0643\u0645 \u0648\u0645\u0646 \u064a\u0648\u0642 \u0634\u062d \u0646\u0641\u0633\u0647 \u0641\u0623\u0648\u0644\u0626\u0643 \u0647\u0645 \u0627\u0644\u0645\u0641\u0644\u062d\u0648\u0646",
    "chapter_title_english": "Mutual Blaming",
