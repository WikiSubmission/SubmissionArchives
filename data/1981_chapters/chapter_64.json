    "verse_id_arabic": "\u0661\u0665:\u0666\u0664",
    "verse_number": 15,
    "verse_text_english": "Your money and children are a test, and GOD possesses a great recompense.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0645\u0652\u0648\u064e\u0670\u0644\u064f\u0643\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0648\u0652\u0644\u064e\u0670\u062f\u064f\u0643\u064f\u0645\u0652 \u0641\u0650\u062a\u0652\u0646\u064e\u0629\u064c \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062c\u0652\u0631\u064c \u0639\u064e\u0638\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "innam\u0101 amw\u0101lukum wa-awl\u0101dukum fit'natun wal-lahu \u02bfindahu ajrun \u02bfa\u1e93\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0625\u0646\u0645\u0627 \u0623\u0645\u0648\u0644\u0643\u0645 \u0648\u0623\u0648\u0644\u062f\u0643\u0645 \u0641\u062a\u0646\u0629 \u0648\u0627\u0644\u0644\u0647 \u0639\u0646\u062f\u0647 \u0623\u062c\u0631 \u0639\u0638\u064a\u0645",
