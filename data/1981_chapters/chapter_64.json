[
  {
    "global_index": 5258,
    "verse_index": 5259,
    "chapter_number": 64,
    "verse_id": "64:0",
    "verse_id_arabic": "\u0660:\u0666\u0664",
    "verse_number": 0,
    "verse_text_english": "In the name of GOD, Most Gracious, Most Merciful.",
    "verse_text_arabic": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "bis'mi l-lahi l-ra\u1e25m\u0101ni l-ra\u1e25\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5259,
    "verse_index": 5260,
    "chapter_number": 64,
    "verse_id": "64:1",
    "verse_id_arabic": "\u0661:\u0666\u0664",
    "verse_number": 1,
    "verse_text_english": "Glorifying GOD is everything in the heavens and everything on earth. To Him belongs all kingship, and to Him belongs all praise, and He is Omnipotent.",
    "verse_text_arabic": "\u064a\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0644\u064e\u0647\u064f \u0671\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0671\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0648\u064e\u0647\u064f\u0648\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u0650\u064a\u0631\u064c",
    "verse_text_transliterated": "yusabbi\u1e25u lillahi m\u0101 f\u012b l-sam\u0101w\u0101ti wam\u0101 f\u012b l-ar\u1e0di lahu l-mul'ku walahu l-\u1e25amdu wahuwa \u02bfal\u0101 kulli shayin qad\u012bru",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0633\u0628\u062d \u0644\u0644\u0647 \u0645\u0627 \u0641\u0649 \u0627\u0644\u0633\u0645\u0648\u062a \u0648\u0645\u0627 \u0641\u0649 \u0627\u0644\u0623\u0631\u0636 \u0644\u0647 \u0627\u0644\u0645\u0644\u0643 \u0648\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0648\u0647\u0648 \u0639\u0644\u0649 \u0643\u0644 \u0634\u0649\u0621 \u0642\u062f\u064a\u0631",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5260,
    "verse_index": 5261,
    "chapter_number": 64,
    "verse_id": "64:2",
    "verse_id_arabic": "\u0662:\u0666\u0664",
    "verse_number": 2,
    "verse_text_english": "He is the One who created you, then among you there is the disbeliever, and the believer. GOD is fully Seer of everything you do.",
    "verse_text_arabic": "\u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u062e\u064e\u0644\u064e\u0642\u064e\u0643\u064f\u0645\u0652 \u0641\u064e\u0645\u0650\u0646\u0643\u064f\u0645\u0652 \u0643\u064e\u0627\u0641\u0650\u0631\u064c \u0648\u064e\u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u064f\u0624\u0652\u0645\u0650\u0646\u064c \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e \u0628\u064e\u0635\u0650\u064a\u0631\u064c",
    "verse_text_transliterated": "huwa alladh\u012b khalaqakum faminkum k\u0101firun waminkum mu'minun wal-lahu bim\u0101 ta\u02bfmal\u016bna ba\u1e63\u012bru",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0647\u0648 \u0627\u0644\u0630\u0649 \u062e\u0644\u0642\u0643\u0645 \u0641\u0645\u0646\u0643\u0645 \u0643\u0627\u0641\u0631 \u0648\u0645\u0646\u0643\u0645 \u0645\u0624\u0645\u0646 \u0648\u0627\u0644\u0644\u0647 \u0628\u0645\u0627 \u062a\u0639\u0645\u0644\u0648\u0646 \u0628\u0635\u064a\u0631",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5261,
    "verse_index": 5262,
    "chapter_number": 64,
    "verse_id": "64:3",
    "verse_id_arabic": "\u0663:\u0666\u0664",
    "verse_number": 3,
    "verse_text_english": "He created the heavens and the earth for a specific purpose,* designed you and perfected your design, then to Him is the final destiny.",
    "verse_text_arabic": "\u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u064e \u0628\u0650\u0671\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0648\u064e\u0635\u064e\u0648\u0651\u064e\u0631\u064e\u0643\u064f\u0645\u0652 \u0641\u064e\u0623\u064e\u062d\u0652\u0633\u064e\u0646\u064e \u0635\u064f\u0648\u064e\u0631\u064e\u0643\u064f\u0645\u0652 \u0648\u064e\u0625\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u0671\u0644\u0652\u0645\u064e\u0635\u0650\u064a\u0631\u064f",
    "verse_text_transliterated": "khalaqa l-sam\u0101w\u0101ti wal-ar\u1e0da bil-\u1e25aqi wa\u1e63awwarakum fa-a\u1e25sana \u1e63uwarakum wa-ilayhi l-ma\u1e63\u012br",
    "verse_subtitle_english": null,
    "verse_footnote_english": "*64:3 We are in this world due to God's immense mercy. The Most Gracious has given us a chance to redeem ourselves. See the Introduction & Appendix 7.",
    "verse_text_arabic_clean": "\u062e\u0644\u0642 \u0627\u0644\u0633\u0645\u0648\u062a \u0648\u0627\u0644\u0623\u0631\u0636 \u0628\u0627\u0644\u062d\u0642 \u0648\u0635\u0648\u0631\u0643\u0645 \u0641\u0623\u062d\u0633\u0646 \u0635\u0648\u0631\u0643\u0645 \u0648\u0625\u0644\u064a\u0647 \u0627\u0644\u0645\u0635\u064a\u0631",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5262,
    "verse_index": 5263,
    "chapter_number": 64,
    "verse_id": "64:4",
    "verse_id_arabic": "\u0664:\u0666\u0664",
    "verse_number": 4,
    "verse_text_english": "He knows everything in the heavens and the earth, and He knows everything you conceal and everything you declare. GOD is fully aware of the innermost thoughts.",
    "verse_text_arabic": "\u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u062a\u064f\u0633\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0648\u064e\u0645\u064e\u0627 \u062a\u064f\u0639\u0652\u0644\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u0650\u064a\u0645\u064c\u06e2 \u0628\u0650\u0630\u064e\u0627\u062a\u0650 \u0671\u0644\u0635\u0651\u064f\u062f\u064f\u0648\u0631\u0650",
    "verse_text_transliterated": "ya\u02bflamu m\u0101 f\u012b l-sam\u0101w\u0101ti wal-ar\u1e0di waya\u02bflamu m\u0101 tusirr\u016bna wam\u0101 tu\u02bf'lin\u016bna wal-lahu \u02bfal\u012bmun bidh\u0101ti l-\u1e63ud\u016br",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0639\u0644\u0645 \u0645\u0627 \u0641\u0649 \u0627\u0644\u0633\u0645\u0648\u062a \u0648\u0627\u0644\u0623\u0631\u0636 \u0648\u064a\u0639\u0644\u0645 \u0645\u0627 \u062a\u0633\u0631\u0648\u0646 \u0648\u0645\u0627 \u062a\u0639\u0644\u0646\u0648\u0646 \u0648\u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0645 \u0628\u0630\u0627\u062a \u0627\u0644\u0635\u062f\u0648\u0631",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5263,
    "verse_index": 5264,
    "chapter_number": 64,
    "verse_id": "64:5",
    "verse_id_arabic": "\u0665:\u0666\u0664",
    "verse_number": 5,
    "verse_text_english": "Have you noted those who disbelieved in the past, then suffered the consequences of their decision? They incurred a painful retribution.",
    "verse_text_arabic": "\u0623\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0623\u0652\u062a\u0650\u0643\u064f\u0645\u0652 \u0646\u064e\u0628\u064e\u0624\u064f\u0627\u06df \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u06df \u0645\u0650\u0646 \u0642\u064e\u0628\u0652\u0644\u064f \u0641\u064e\u0630\u064e\u0627\u0642\u064f\u0648\u0627\u06df \u0648\u064e\u0628\u064e\u0627\u0644\u064e \u0623\u064e\u0645\u0652\u0631\u0650\u0647\u0650\u0645\u0652 \u0648\u064e\u0644\u064e\u0647\u064f\u0645\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u064c \u0623\u064e\u0644\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "alam yatikum naba-u alladh\u012bna kafar\u016b min qablu fadh\u0101q\u016b wab\u0101la amrihim walahum \u02bfadh\u0101bun al\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0623\u0644\u0645 \u064a\u0623\u062a\u0643\u0645 \u0646\u0628\u0624\u0627 \u0627\u0644\u0630\u064a\u0646 \u0643\u0641\u0631\u0648\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0641\u0630\u0627\u0642\u0648\u0627 \u0648\u0628\u0627\u0644 \u0623\u0645\u0631\u0647\u0645 \u0648\u0644\u0647\u0645 \u0639\u0630\u0627\u0628 \u0623\u0644\u064a\u0645",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5264,
    "verse_index": 5265,
    "chapter_number": 64,
    "verse_id": "64:6",
    "verse_id_arabic": "\u0666:\u0666\u0664",
    "verse_number": 6,
    "verse_text_english": "This is because their messengers went to them with clear proofs, but they said, \"Shall we follow humans like us?\" They disbelieved and turned away. GOD does not need them; GOD is in no need, Praiseworthy.",
    "verse_text_arabic": "\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0628\u0650\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e\u062a \u062a\u0651\u064e\u0623\u0652\u062a\u0650\u064a\u0647\u0650\u0645\u0652 \u0631\u064f\u0633\u064f\u0644\u064f\u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u0652\u0628\u064e\u064a\u0651\u0650\u0646\u064e\u0670\u062a\u0650 \u0641\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u0628\u064e\u0634\u064e\u0631\u064c \u064a\u064e\u0647\u0652\u062f\u064f\u0648\u0646\u064e\u0646\u064e\u0627 \u0641\u064e\u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u06df \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0648\u0627\u06df \u0648\u0651\u064e\u0671\u0633\u0652\u062a\u064e\u063a\u0652\u0646\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u063a\u064e\u0646\u0650\u0649\u0651\u064c \u062d\u064e\u0645\u0650\u064a\u062f\u064c",
    "verse_text_transliterated": "dh\u0101lika bi-annahu k\u0101nat tat\u012bhim rusuluhum bil-bayin\u0101ti faq\u0101l\u016b abasharun yahd\u016bnan\u0101 fakafar\u016b watawallaw wa-is'taghn\u0101 l-lahu wal-lahu ghaniyyun \u1e25am\u012bdu",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0630\u0644\u0643 \u0628\u0623\u0646\u0647 \u0643\u0627\u0646\u062a \u062a\u0623\u062a\u064a\u0647\u0645 \u0631\u0633\u0644\u0647\u0645 \u0628\u0627\u0644\u0628\u064a\u0646\u062a \u0641\u0642\u0627\u0644\u0648\u0627 \u0623\u0628\u0634\u0631 \u064a\u0647\u062f\u0648\u0646\u0646\u0627 \u0641\u0643\u0641\u0631\u0648\u0627 \u0648\u062a\u0648\u0644\u0648\u0627 \u0648\u0627\u0633\u062a\u063a\u0646\u0649 \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0644\u0647 \u063a\u0646\u0649 \u062d\u0645\u064a\u062f",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5265,
    "verse_index": 5266,
    "chapter_number": 64,
    "verse_id": "64:7",
    "verse_id_arabic": "\u0667:\u0666\u0664",
    "verse_number": 7,
    "verse_text_english": "Those who disbelieved claim that they will not be resurrected! Yes indeed, by my Lord, you will be resurrected, and you will be held accountable for everything you have done. This is easy for GOD to do.",
    "verse_text_arabic": "\u0632\u064e\u0639\u064e\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064f\u0628\u0652\u0639\u064e\u062b\u064f\u0648\u0627\u06df \u0642\u064f\u0644\u0652 \u0628\u064e\u0644\u064e\u0649\u0670 \u0648\u064e\u0631\u064e\u0628\u0651\u0650\u0649 \u0644\u064e\u062a\u064f\u0628\u0652\u0639\u064e\u062b\u064f\u0646\u0651\u064e \u062b\u064f\u0645\u0651\u064e \u0644\u064e\u062a\u064f\u0646\u064e\u0628\u0651\u064e\u0624\u064f\u0646\u0651\u064e \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u0652\u062a\u064f\u0645\u0652 \u0648\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064e\u0633\u0650\u064a\u0631\u064c",
    "verse_text_transliterated": "za\u02bfama alladh\u012bna kafar\u016b an lan yub'\u02bfath\u016b qul bal\u0101 warabb\u012b latub'\u02bfathunna thumma latunabba-unna bim\u0101 \u02bfamil'tum wadh\u0101lika \u02bfal\u0101 l-lahi yas\u012bru",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0632\u0639\u0645 \u0627\u0644\u0630\u064a\u0646 \u0643\u0641\u0631\u0648\u0627 \u0623\u0646 \u0644\u0646 \u064a\u0628\u0639\u062b\u0648\u0627 \u0642\u0644 \u0628\u0644\u0649 \u0648\u0631\u0628\u0649 \u0644\u062a\u0628\u0639\u062b\u0646 \u062b\u0645 \u0644\u062a\u0646\u0628\u0624\u0646 \u0628\u0645\u0627 \u0639\u0645\u0644\u062a\u0645 \u0648\u0630\u0644\u0643 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u064a\u0633\u064a\u0631",
    "chapter_title_english": "Mutual Blaming",
