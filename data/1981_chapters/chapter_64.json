    "chapter_verses": 18
  },
  {
    "global_index": 5266,
    "verse_index": 5267,
    "chapter_number": 64,
    "verse_id": "64:8",
    "verse_id_arabic": "\u0668:\u0666\u0664",
    "verse_number": 8,
    "verse_text_english": "Therefore, you shall believe in GOD and His messenger, and the light that we have revealed herein. GOD is fully Cognizant of everything you do.",
    "verse_text_arabic": "\u0641\u064e\u0640\u0654\u064e\u0627\u0645\u0650\u0646\u064f\u0648\u0627\u06df \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0671\u0644\u0646\u0651\u064f\u0648\u0631\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u0649\u0653 \u0623\u064e\u0646\u0632\u064e\u0644\u0652\u0646\u064e\u0627 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e \u062e\u064e\u0628\u0650\u064a\u0631\u064c",
    "verse_text_transliterated": "fa\u0101min\u016b bil-lahi waras\u016blihi wal-n\u016bri alladh\u012b anzaln\u0101 wal-lahu bim\u0101 ta\u02bfmal\u016bna khab\u012bru",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0641\u0640\u0654\u0627\u0645\u0646\u0648\u0627 \u0628\u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u0648\u0627\u0644\u0646\u0648\u0631 \u0627\u0644\u0630\u0649 \u0623\u0646\u0632\u0644\u0646\u0627 \u0648\u0627\u0644\u0644\u0647 \u0628\u0645\u0627 \u062a\u0639\u0645\u0644\u0648\u0646 \u062e\u0628\u064a\u0631",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5267,
    "verse_index": 5268,
    "chapter_number": 64,
    "verse_id": "64:9",
    "verse_id_arabic": "\u0669:\u0666\u0664",
    "verse_number": 9,
    "verse_text_english": "The day will come when He summons you to the Day of Summoning. That is the Day of Mutual Blaming. Anyone who believes in GOD and leads a righteous life, He will remit his sins, and will admit him into gardens with flowing streams. They abide therein forever. This is the greatest triumph.",
    "verse_text_arabic": "\u064a\u064e\u0648\u0652\u0645\u064e \u064a\u064e\u062c\u0652\u0645\u064e\u0639\u064f\u0643\u064f\u0645\u0652 \u0644\u0650\u064a\u064e\u0648\u0652\u0645\u0650 \u0671\u0644\u0652\u062c\u064e\u0645\u0652\u0639\u0650 \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064e\u0648\u0652\u0645\u064f \u0671\u0644\u062a\u0651\u064e\u063a\u064e\u0627\u0628\u064f\u0646\u0650 \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u06e2 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u064a\u064e\u0639\u0652\u0645\u064e\u0644\u0652 \u0635\u064e\u0670\u0644\u0650\u062d\u064b\u0627 \u064a\u064f\u0643\u064e\u0641\u0651\u0650\u0631\u0652 \u0639\u064e\u0646\u0652\u0647\u064f \u0633\u064e\u064a\u0651\u0650\u0640\u0654\u064e\u0627\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u064a\u064f\u062f\u0652\u062e\u0650\u0644\u0652\u0647\u064f \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u064d \u062a\u064e\u062c\u0652\u0631\u0650\u0649 \u0645\u0650\u0646 \u062a\u064e\u062d\u0652\u062a\u0650\u0647\u064e\u0627 \u0671\u0644\u0652\u0623\u064e\u0646\u0652\u0647\u064e\u0670\u0631\u064f \u062e\u064e\u0670\u0644\u0650\u062f\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627\u0653 \u0623\u064e\u0628\u064e\u062f\u064b\u0627 \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u0652\u0641\u064e\u0648\u0652\u0632\u064f \u0671\u0644\u0652\u0639\u064e\u0638\u0650\u064a\u0645\u064f",
    "verse_text_transliterated": "yawma yajma\u02bfukum liyawmi l-jam\u02bfi dh\u0101lika yawmu l-tagh\u0101buni waman yu'min bil-lahi waya\u02bfmal \u1e63\u0101li\u1e25an yukaffir \u02bfanhu sayyi\u0101tihi wayud'khil'hu jann\u0101tin tajr\u012b min ta\u1e25tih\u0101 l-anh\u0101ru kh\u0101lid\u012bna f\u012bh\u0101 abadan dh\u0101lika l-fawzu l-\u02bfa\u1e93\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0648\u0645 \u064a\u062c\u0645\u0639\u0643\u0645 \u0644\u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639 \u0630\u0644\u0643 \u064a\u0648\u0645 \u0627\u0644\u062a\u063a\u0627\u0628\u0646 \u0648\u0645\u0646 \u064a\u0624\u0645\u0646 \u0628\u0627\u0644\u0644\u0647 \u0648\u064a\u0639\u0645\u0644 \u0635\u0644\u062d\u0627 \u064a\u0643\u0641\u0631 \u0639\u0646\u0647 \u0633\u064a\u0640\u0654\u0627\u062a\u0647 \u0648\u064a\u062f\u062e\u0644\u0647 \u062c\u0646\u062a \u062a\u062c\u0631\u0649 \u0645\u0646 \u062a\u062d\u062a\u0647\u0627 \u0627\u0644\u0623\u0646\u0647\u0631 \u062e\u0644\u062f\u064a\u0646 \u0641\u064a\u0647\u0627 \u0623\u0628\u062f\u0627 \u0630\u0644\u0643 \u0627\u0644\u0641\u0648\u0632 \u0627\u0644\u0639\u0638\u064a\u0645",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5268,
    "verse_index": 5269,
    "chapter_number": 64,
    "verse_id": "64:10",
    "verse_id_arabic": "\u0661\u0660:\u0666\u0664",
    "verse_number": 10,
    "verse_text_english": "As for those who disbelieve and reject our revelations, they are the dwellers of the Hellfire; they abide therein forever. What a miserable destiny!",
    "verse_text_arabic": "\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u06df \u0648\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0627\u06df \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627\u0653 \u0623\u064f\u0648\u06df\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0623\u064e\u0635\u0652\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u062e\u064e\u0670\u0644\u0650\u062f\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0648\u064e\u0628\u0650\u0626\u0652\u0633\u064e \u0671\u0644\u0652\u0645\u064e\u0635\u0650\u064a\u0631\u064f",
    "verse_text_transliterated": "wa-alladh\u012bna kafar\u016b wakadhab\u016b bi\u0101y\u0101tin\u0101 ul\u0101ika a\u1e63\u1e25\u0101bu l-n\u0101ri kh\u0101lid\u012bna f\u012bh\u0101 wabi'sa l-ma\u1e63\u012br",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0648\u0627\u0644\u0630\u064a\u0646 \u0643\u0641\u0631\u0648\u0627 \u0648\u0643\u0630\u0628\u0648\u0627 \u0628\u0640\u0654\u0627\u064a\u062a\u0646\u0627 \u0623\u0648\u0644\u0626\u0643 \u0623\u0635\u062d\u0628 \u0627\u0644\u0646\u0627\u0631 \u062e\u0644\u062f\u064a\u0646 \u0641\u064a\u0647\u0627 \u0648\u0628\u0626\u0633 \u0627\u0644\u0645\u0635\u064a\u0631",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5269,
    "verse_index": 5270,
    "chapter_number": 64,
    "verse_id": "64:11",
    "verse_id_arabic": "\u0661\u0661:\u0666\u0664",
    "verse_number": 11,
    "verse_text_english": "Nothing happens to you except in accordance with GOD's will. Anyone who believes in GOD, He will guide his heart. GOD is fully aware of all things.",
    "verse_text_arabic": "\u0645\u064e\u0627\u0653 \u0623\u064e\u0635\u064e\u0627\u0628\u064e \u0645\u0650\u0646 \u0645\u0651\u064f\u0635\u0650\u064a\u0628\u064e\u0629\u064d \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0625\u0650\u0630\u0652\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u06e2 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064e\u0647\u0652\u062f\u0650 \u0642\u064e\u0644\u0652\u0628\u064e\u0647\u064f\u06e5 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0639\u064e\u0644\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "m\u0101 a\u1e63\u0101ba min mu\u1e63\u012bbatin ill\u0101 bi-idh'ni l-lahi waman yu'min bil-lahi yahdi qalbahu wal-lahu bikulli shayin \u02bfal\u012bmu",
    "verse_subtitle_english": "Divine Law",
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0645\u0627 \u0623\u0635\u0627\u0628 \u0645\u0646 \u0645\u0635\u064a\u0628\u0629 \u0625\u0644\u0627 \u0628\u0625\u0630\u0646 \u0627\u0644\u0644\u0647 \u0648\u0645\u0646 \u064a\u0624\u0645\u0646 \u0628\u0627\u0644\u0644\u0647 \u064a\u0647\u062f \u0642\u0644\u0628\u0647 \u0648\u0627\u0644\u0644\u0647 \u0628\u0643\u0644 \u0634\u0649\u0621 \u0639\u0644\u064a\u0645",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5270,
    "verse_index": 5271,
    "chapter_number": 64,
    "verse_id": "64:12",
    "verse_id_arabic": "\u0661\u0662:\u0666\u0664",
    "verse_number": 12,
    "verse_text_english": "You shall obey GOD and you shall obey the messenger. If you turn away, then the sole mission of our messenger is to deliver the message.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0623\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0627\u06df \u0671\u0644\u0631\u0651\u064e\u0633\u064f\u0648\u0644\u064e \u0641\u064e\u0625\u0650\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u064a\u0652\u062a\u064f\u0645\u0652 \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0639\u064e\u0644\u064e\u0649\u0670 \u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0646\u064e\u0627 \u0671\u0644\u0652\u0628\u064e\u0644\u064e\u0670\u063a\u064f \u0671\u0644\u0652\u0645\u064f\u0628\u0650\u064a\u0646\u064f",
    "verse_text_transliterated": "wa-a\u1e6d\u012b\u02bf\u016b l-laha wa-a\u1e6d\u012b\u02bf\u016b l-ras\u016bla fa-in tawallaytum fa-innam\u0101 \u02bfal\u0101 ras\u016blin\u0101 l-bal\u0101ghu l-mub\u012bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0648\u0623\u0637\u064a\u0639\u0648\u0627 \u0627\u0644\u0644\u0647 \u0648\u0623\u0637\u064a\u0639\u0648\u0627 \u0627\u0644\u0631\u0633\u0648\u0644 \u0641\u0625\u0646 \u062a\u0648\u0644\u064a\u062a\u0645 \u0641\u0625\u0646\u0645\u0627 \u0639\u0644\u0649 \u0631\u0633\u0648\u0644\u0646\u0627 \u0627\u0644\u0628\u0644\u063a \u0627\u0644\u0645\u0628\u064a\u0646",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5271,
    "verse_index": 5272,
    "chapter_number": 64,
    "verse_id": "64:13",
    "verse_id_arabic": "\u0661\u0663:\u0666\u0664",
    "verse_number": 13,
    "verse_text_english": "GOD: there is no other god besides Him. In GOD the believers shall trust.",
    "verse_text_arabic": "\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u0670\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u0648\u064e\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0641\u064e\u0644\u0652\u064a\u064e\u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u0650 \u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "al-lahu l\u0101 il\u0101ha ill\u0101 huwa wa\u02bfal\u0101 l-lahi falyatawakkali l-mu'min\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0627\u0644\u0644\u0647 \u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0647\u0648 \u0648\u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0641\u0644\u064a\u062a\u0648\u0643\u0644 \u0627\u0644\u0645\u0624\u0645\u0646\u0648\u0646",
    "chapter_title_english": "Mutual Blaming",
    "chapter_title_arabic": "\u0627\u0644\u062a\u063a\u0627\u0628\u0646",
    "chapter_title_transliterated": "Al-Taghaabun",
    "chapter_revelation_order": 108,
    "chapter_verses": 18
  },
  {
    "global_index": 5272,
    "verse_index": 5273,
    "chapter_number": 64,
    "verse_id": "64:14",
    "verse_id_arabic": "\u0661\u0664:\u0666\u0664",
    "verse_number": 14,
    "verse_text_english": "O you who believe, your spouses and your children can be your enemies; beware. If you pardon, forget, and forgive, then GOD is Forgiver, Most Merciful.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u06df \u0625\u0650\u0646\u0651\u064e \u0645\u0650\u0646\u0652 \u0623\u064e\u0632\u0652\u0648\u064e\u0670\u062c\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0648\u0652\u0644\u064e\u0670\u062f\u0650\u0643\u064f\u0645\u0652 \u0639\u064e\u062f\u064f\u0648\u0651\u064b\u0627 \u0644\u0651\u064e\u0643\u064f\u0645\u0652 \u0641\u064e\u0671\u062d\u0652\u0630\u064e\u0631\u064f\u0648\u0647\u064f\u0645\u0652 \u0648\u064e\u0625\u0650\u0646 \u062a\u064e\u0639\u0652\u0641\u064f\u0648\u0627\u06df \u0648\u064e\u062a\u064e\u0635\u0652\u0641\u064e\u062d\u064f\u0648\u0627\u06df \u0648\u064e\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u064f\u0648\u0627\u06df \u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u063a\u064e\u0641\u064f\u0648\u0631\u064c \u0631\u0651\u064e\u062d\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna \u0101man\u016b inna min azw\u0101jikum wa-awl\u0101dikum \u02bfaduwwan lakum fa-i\u1e25'dhar\u016bhum wa-in ta\u02bff\u016b wata\u1e63fa\u1e25\u016b wataghfir\u016b fa-inna l-laha ghaf\u016brun ra\u1e25\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0625\u0646 \u0645\u0646 \u0623\u0632\u0648\u062c\u0643\u0645 \u0648\u0623\u0648\u0644\u062f\u0643\u0645 \u0639\u062f\u0648\u0627 \u0644\u0643\u0645 \u0641\u0627\u062d\u0630\u0631\u0648\u0647\u0645 \u0648\u0625\u0646 \u062a\u0639\u0641\u0648\u0627 \u0648\u062a\u0635\u0641\u062d\u0648\u0627 \u0648\u062a\u063a\u0641\u0631\u0648\u0627 \u0641\u0625\u0646 \u0627\u0644\u0644\u0647 \u063a\u0641\u0648\u0631 \u0631\u062d\u064a\u0645",
