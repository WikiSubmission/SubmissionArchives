  },
  {
    "global_index": 5275,
    "verse_index": 5276,
    "chapter_number": 64,
    "verse_id": "64:17",
    "verse_id_arabic": "\u0661\u0667:\u0666\u0664",
    "verse_number": 17,
    "verse_text_english": "If you lend GOD a loan of righteousness, He will multiply the reward for you manifold, and forgive you. GOD is Appreciative, Clement.",
    "verse_text_arabic": "\u0625\u0650\u0646 \u062a\u064f\u0642\u0652\u0631\u0650\u0636\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0642\u064e\u0631\u0652\u0636\u064b\u0627 \u062d\u064e\u0633\u064e\u0646\u064b\u0627 \u064a\u064f\u0636\u064e\u0670\u0639\u0650\u0641\u0652\u0647\u064f \u0644\u064e\u0643\u064f\u0645\u0652 \u0648\u064e\u064a\u064e\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u064e\u0643\u064f\u0645\u0652 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0634\u064e\u0643\u064f\u0648\u0631\u064c \u062d\u064e\u0644\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "in tuq'ri\u1e0d\u016b l-laha qar\u1e0dan \u1e25asanan yu\u1e0d\u0101\u02bfif'hu lakum wayaghfir lakum wal-lahu shak\u016brun \u1e25al\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0625\u0646 \u062a\u0642\u0631\u0636\u0648\u0627 \u0627\u0644\u0644\u0647 \u0642\u0631\u0636\u0627 \u062d\u0633\u0646\u0627 \u064a\u0636\u0639\u0641\u0647 \u0644\u0643\u0645 \u0648\u064a\u063a\u0641\u0631 \u0644\u0643\u0645 \u0648\u0627\u0644\u0644\u0647 \u0634\u0643\u0648\u0631 \u062d\u0644\u064a\u0645",
