    "verse_id_arabic": "\u0660:\u0661\u0661\u0661",
    "verse_number": 0,
    "verse_text_english": "In the name of GOD, Most Gracious, Most Merciful.",
    "verse_text_arabic": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "bis'mi l-lahi l-ra\u1e25m\u0101ni l-ra\u1e25\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645",
    "chapter_title_english": "Thorns",
    "chapter_title_arabic": "\u0627\u0644\u0645\u0633\u062f",
    "chapter_title_transliterated": "Al-Masad",
    "chapter_revelation_order": 6,
    "chapter_verses": 5
  },
  {
    "global_index": 6323,
    "verse_index": 6324,
    "chapter_number": 111,
    "verse_id": "111:1",
    "verse_id_arabic": "\u0661:\u0661\u0661\u0661",
    "verse_number": 1,
    "verse_text_english": "Condemned are the works of Abee Lahab, and he is condemned.*",
    "verse_text_arabic": "\u062a\u064e\u0628\u0651\u064e\u062a\u0652 \u064a\u064e\u062f\u064e\u0627\u0653 \u0623\u064e\u0628\u0650\u0649 \u0644\u064e\u0647\u064e\u0628\u064d \u0648\u064e\u062a\u064e\u0628\u0651\u064e",
    "verse_text_transliterated": "tabbat yad\u0101 ab\u012b lahabin watabb",
    "verse_subtitle_english": null,
    "verse_footnote_english": "*111:1 Abee Lahab was Muhammad's uncle and the leader of the opposition. His wife carried out a campaign of persecution against Muhammad and the believers. Like all descriptions of Heaven and Hell, the rope of thorns is an allegory.",
    "verse_text_arabic_clean": "\u062a\u0628\u062a \u064a\u062f\u0627 \u0623\u0628\u0649 \u0644\u0647\u0628 \u0648\u062a\u0628",
    "chapter_title_english": "Thorns",
    "chapter_title_arabic": "\u0627\u0644\u0645\u0633\u062f",
    "chapter_title_transliterated": "Al-Masad",
    "chapter_revelation_order": 6,
    "chapter_verses": 5
  },
  {
    "global_index": 6324,
    "verse_index": 6325,
    "chapter_number": 111,
    "verse_id": "111:2",
    "verse_id_arabic": "\u0662:\u0661\u0661\u0661",
    "verse_number": 2,
    "verse_text_english": "His money and whatever he has accomplished will never help him.",
    "verse_text_arabic": "\u0645\u064e\u0627\u0653 \u0623\u064e\u063a\u0652\u0646\u064e\u0649\u0670 \u0639\u064e\u0646\u0652\u0647\u064f \u0645\u064e\u0627\u0644\u064f\u0647\u064f\u06e5 \u0648\u064e\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e",
    "verse_text_transliterated": "m\u0101 aghn\u0101 \u02bfanhu m\u0101luhu wam\u0101 kasab",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0645\u0627 \u0623\u063a\u0646\u0649 \u0639\u0646\u0647 \u0645\u0627\u0644\u0647 \u0648\u0645\u0627 \u0643\u0633\u0628",
    "chapter_title_english": "Thorns",
    "chapter_title_arabic": "\u0627\u0644\u0645\u0633\u062f",
    "chapter_title_transliterated": "Al-Masad",
    "chapter_revelation_order": 6,
    "chapter_verses": 5
  },
  {
