    "chapter_number": 76,
    "verse_id": "76:0",
    "verse_id_arabic": "\u0660:\u0667\u0666",
    "verse_number": 0,
    "verse_text_english": "In the name of GOD, Most Gracious, Most Merciful.",
    "verse_text_arabic": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "bis'mi l-lahi l-ra\u1e25m\u0101ni l-ra\u1e25\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5663,
    "verse_index": 5664,
    "chapter_number": 76,
    "verse_id": "76:1",
    "verse_id_arabic": "\u0661:\u0667\u0666",
    "verse_number": 1,
    "verse_text_english": "Did the human being go through a period of time when he was nothing? 2.",
    "verse_text_arabic": "\u0647\u064e\u0644\u0652 \u0623\u064e\u062a\u064e\u0649\u0670 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0652\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u062d\u0650\u064a\u0646\u064c \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u062f\u0651\u064e\u0647\u0652\u0631\u0650 \u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646 \u0634\u064e\u064a\u0652\u0640\u0654\u064b\u0627 \u0645\u0651\u064e\u0630\u0652\u0643\u064f\u0648\u0631\u064b\u0627",
    "verse_text_transliterated": "hal at\u0101 \u02bfal\u0101 l-ins\u0101ni \u1e25\u012bnun mina l-dahri lam yakun shayan madhk\u016bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0647\u0644 \u0623\u062a\u0649 \u0639\u0644\u0649 \u0627\u0644\u0625\u0646\u0633\u0646 \u062d\u064a\u0646 \u0645\u0646 \u0627\u0644\u062f\u0647\u0631 \u0644\u0645 \u064a\u0643\u0646 \u0634\u064a\u0640\u0654\u0627 \u0645\u0630\u0643\u0648\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5664,
    "verse_index": 5665,
    "chapter_number": 76,
    "verse_id": "76:2",
    "verse_id_arabic": "\u0662:\u0667\u0666",
    "verse_number": 2,
    "verse_text_english": "We created the human from a liquid mixture, from two parents, in order to test him. Thus, we made him a hearer and a seer.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u0652\u0646\u064e\u0627 \u0671\u0644\u0652\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u0652\u0641\u064e\u0629\u064d \u0623\u064e\u0645\u0652\u0634\u064e\u0627\u062c\u064d \u0646\u0651\u064e\u0628\u0652\u062a\u064e\u0644\u0650\u064a\u0647\u0650 \u0641\u064e\u062c\u064e\u0639\u064e\u0644\u0652\u0646\u064e\u0670\u0647\u064f \u0633\u064e\u0645\u0650\u064a\u0639\u064b\u06e2\u0627 \u0628\u064e\u0635\u0650\u064a\u0631\u064b\u0627",
    "verse_text_transliterated": "inn\u0101 khalaqn\u0101 l-ins\u0101na min nu\u1e6d'fatin amsh\u0101jin nabtal\u012bhi faja\u02bfaln\u0101hu sam\u012b\u02bfan ba\u1e63\u012bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0625\u0646\u0627 \u062e\u0644\u0642\u0646\u0627 \u0627\u0644\u0625\u0646\u0633\u0646 \u0645\u0646 \u0646\u0637\u0641\u0629 \u0623\u0645\u0634\u0627\u062c \u0646\u0628\u062a\u0644\u064a\u0647 \u0641\u062c\u0639\u0644\u0646\u0647 \u0633\u0645\u064a\u0639\u0627 \u0628\u0635\u064a\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5665,
    "verse_index": 5666,
    "chapter_number": 76,
    "verse_id": "76:3",
    "verse_id_arabic": "\u0663:\u0667\u0666",
    "verse_number": 3,
    "verse_text_english": "We showed him the path, then he is either appreciative or unappreciative.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0627 \u0647\u064e\u062f\u064e\u064a\u0652\u0646\u064e\u0670\u0647\u064f \u0671\u0644\u0633\u0651\u064e\u0628\u0650\u064a\u0644\u064e \u0625\u0650\u0645\u0651\u064e\u0627 \u0634\u064e\u0627\u0643\u0650\u0631\u064b\u0627 \u0648\u064e\u0625\u0650\u0645\u0651\u064e\u0627 \u0643\u064e\u0641\u064f\u0648\u0631\u064b\u0627",
    "verse_text_transliterated": "inn\u0101 hadayn\u0101hu l-sab\u012bla imm\u0101 sh\u0101kiran wa-imm\u0101 kaf\u016bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646\u0627 \u0647\u062f\u064a\u0646\u0647 \u0627\u0644\u0633\u0628\u064a\u0644 \u0625\u0645\u0627 \u0634\u0627\u0643\u0631\u0627 \u0648\u0625\u0645\u0627 \u0643\u0641\u0648\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5666,
    "verse_index": 5667,
    "chapter_number": 76,
    "verse_id": "76:4",
    "verse_id_arabic": "\u0664:\u0667\u0666",
    "verse_number": 4,
    "verse_text_english": "We have prepared for the disbelievers chains, and shackles, and hell.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0639\u0652\u062a\u064e\u062f\u0652\u0646\u064e\u0627 \u0644\u0650\u0644\u0652\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u0633\u064e\u0644\u064e\u0670\u0633\u0650\u0644\u064e\u0627\u06df \u0648\u064e\u0623\u064e\u063a\u0652\u0644\u064e\u0670\u0644\u064b\u0627 \u0648\u064e\u0633\u064e\u0639\u0650\u064a\u0631\u064b\u0627",
    "verse_text_transliterated": "inn\u0101 a\u02bftadn\u0101 lil'k\u0101fir\u012bna sal\u0101sil\u0101 wa-aghl\u0101lan wasa\u02bf\u012bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646\u0627 \u0623\u0639\u062a\u062f\u0646\u0627 \u0644\u0644\u0643\u0641\u0631\u064a\u0646 \u0633\u0644\u0633\u0644\u0627 \u0648\u0623\u063a\u0644\u0644\u0627 \u0648\u0633\u0639\u064a\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5667,
    "verse_index": 5668,
    "chapter_number": 76,
    "verse_id": "76:5",
    "verse_id_arabic": "\u0665:\u0667\u0666",
    "verse_number": 5,
    "verse_text_english": "As for the righteous, they will drink from cups wherein balm is mixed.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0652\u0623\u064e\u0628\u0652\u0631\u064e\u0627\u0631\u064e \u064a\u064e\u0634\u0652\u0631\u064e\u0628\u064f\u0648\u0646\u064e \u0645\u0650\u0646 \u0643\u064e\u0623\u0652\u0633\u064d \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0632\u064e\u0627\u062c\u064f\u0647\u064e\u0627 \u0643\u064e\u0627\u0641\u064f\u0648\u0631\u064b\u0627",
    "verse_text_transliterated": "inna l-abr\u0101ra yashrab\u016bna min kasin k\u0101na miz\u0101juh\u0101 k\u0101f\u016bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646 \u0627\u0644\u0623\u0628\u0631\u0627\u0631 \u064a\u0634\u0631\u0628\u0648\u0646 \u0645\u0646 \u0643\u0623\u0633 \u0643\u0627\u0646 \u0645\u0632\u0627\u062c\u0647\u0627 \u0643\u0627\u0641\u0648\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5668,
    "verse_index": 5669,
    "chapter_number": 76,
    "verse_id": "76:6",
    "verse_id_arabic": "\u0666:\u0667\u0666",
    "verse_number": 6,
    "verse_text_english": "From a spring that the servants of God fully control.",
    "verse_text_arabic": "\u0639\u064e\u064a\u0652\u0646\u064b\u0627 \u064a\u064e\u0634\u0652\u0631\u064e\u0628\u064f \u0628\u0650\u0647\u064e\u0627 \u0639\u0650\u0628\u064e\u0627\u062f\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064f\u0641\u064e\u062c\u0651\u0650\u0631\u064f\u0648\u0646\u064e\u0647\u064e\u0627 \u062a\u064e\u0641\u0652\u062c\u0650\u064a\u0631\u064b\u0627",
    "verse_text_transliterated": "aaynan yashrabu biha 'aibaduAllahi yufajjiroonaha tafjeeran",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0639\u064a\u0646\u0627 \u064a\u0634\u0631\u0628 \u0628\u0647\u0627 \u0639\u0628\u0627\u062f \u0627\u0644\u0644\u0647 \u064a\u0641\u062c\u0631\u0648\u0646\u0647\u0627 \u062a\u0641\u062c\u064a\u0631\u0627",
    "chapter_title_english": "The Human",
