    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5669,
    "verse_index": 5670,
    "chapter_number": 76,
    "verse_id": "76:7",
    "verse_id_arabic": "\u0667:\u0667\u0666",
    "verse_number": 7,
    "verse_text_english": "They fullfill their vows and reverence a day that is extremely difficult. 8.",
    "verse_text_arabic": "\u064a\u064f\u0648\u0641\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u0646\u0651\u064e\u0630\u0652\u0631\u0650 \u0648\u064e\u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u064a\u064e\u0648\u0652\u0645\u064b\u0627 \u0643\u064e\u0627\u0646\u064e \u0634\u064e\u0631\u0651\u064f\u0647\u064f\u06e5 \u0645\u064f\u0633\u0652\u062a\u064e\u0637\u0650\u064a\u0631\u064b\u0627",
    "verse_text_transliterated": "y\u016bf\u016bna bil-nadhri wayakh\u0101f\u016bna yawman k\u0101na sharruhu mus'ta\u1e6d\u012bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u0648\u0641\u0648\u0646 \u0628\u0627\u0644\u0646\u0630\u0631 \u0648\u064a\u062e\u0627\u0641\u0648\u0646 \u064a\u0648\u0645\u0627 \u0643\u0627\u0646 \u0634\u0631\u0647 \u0645\u0633\u062a\u0637\u064a\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5670,
    "verse_index": 5671,
    "chapter_number": 76,
    "verse_id": "76:8",
    "verse_id_arabic": "\u0668:\u0667\u0666",
    "verse_number": 8,
    "verse_text_english": "They donate their favorite food to the poor, the orphan, and the captive.",
    "verse_text_arabic": "\u0648\u064e\u064a\u064f\u0637\u0652\u0639\u0650\u0645\u064f\u0648\u0646\u064e \u0671\u0644\u0637\u0651\u064e\u0639\u064e\u0627\u0645\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u062d\u064f\u0628\u0651\u0650\u0647\u0650\u06e6 \u0645\u0650\u0633\u0652\u0643\u0650\u064a\u0646\u064b\u0627 \u0648\u064e\u064a\u064e\u062a\u0650\u064a\u0645\u064b\u0627 \u0648\u064e\u0623\u064e\u0633\u0650\u064a\u0631\u064b\u0627",
    "verse_text_transliterated": "wayu\u1e6d'\u02bfim\u016bna l-\u1e6da\u02bf\u0101ma \u02bfal\u0101 \u1e25ubbihi mis'k\u012bnan wayat\u012bman wa-as\u012bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0648\u064a\u0637\u0639\u0645\u0648\u0646 \u0627\u0644\u0637\u0639\u0627\u0645 \u0639\u0644\u0649 \u062d\u0628\u0647 \u0645\u0633\u0643\u064a\u0646\u0627 \u0648\u064a\u062a\u064a\u0645\u0627 \u0648\u0623\u0633\u064a\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5671,
    "verse_index": 5672,
    "chapter_number": 76,
    "verse_id": "76:9",
    "verse_id_arabic": "\u0669:\u0667\u0666",
    "verse_number": 9,
    "verse_text_english": "\"We feed you for the sake of GOD; we expect no reward from you, nor thanks.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0646\u064f\u0637\u0652\u0639\u0650\u0645\u064f\u0643\u064f\u0645\u0652 \u0644\u0650\u0648\u064e\u062c\u0652\u0647\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0644\u064e\u0627 \u0646\u064f\u0631\u0650\u064a\u062f\u064f \u0645\u0650\u0646\u0643\u064f\u0645\u0652 \u062c\u064e\u0632\u064e\u0627\u0653\u0621\u064b \u0648\u064e\u0644\u064e\u0627 \u0634\u064f\u0643\u064f\u0648\u0631\u064b\u0627",
    "verse_text_transliterated": "innam\u0101 nu\u1e6d'\u02bfimukum liwajhi l-lahi l\u0101 nur\u012bdu minkum jaz\u0101an wal\u0101 shuk\u016bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": null,
    "verse_text_arabic_clean": "\u0625\u0646\u0645\u0627 \u0646\u0637\u0639\u0645\u0643\u0645 \u0644\u0648\u062c\u0647 \u0627\u0644\u0644\u0647 \u0644\u0627 \u0646\u0631\u064a\u062f \u0645\u0646\u0643\u0645 \u062c\u0632\u0627\u0621 \u0648\u0644\u0627 \u0634\u0643\u0648\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5672,
    "verse_index": 5673,
    "chapter_number": 76,
    "verse_id": "76:10",
    "verse_id_arabic": "\u0661\u0660:\u0667\u0666",
    "verse_number": 10,
    "verse_text_english": "We fear from our Lord a day that is full of trouble and misery. 11.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064e\u0627\u0641\u064f \u0645\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0646\u064e\u0627 \u064a\u064e\u0648\u0652\u0645\u064b\u0627 \u0639\u064e\u0628\u064f\u0648\u0633\u064b\u0627 \u0642\u064e\u0645\u0652\u0637\u064e\u0631\u0650\u064a\u0631\u064b\u0627",
    "verse_text_transliterated": "inn\u0101 nakh\u0101fu min rabbin\u0101 yawman \u02bfab\u016bsan qam\u1e6dar\u012bra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646\u0627 \u0646\u062e\u0627\u0641 \u0645\u0646 \u0631\u0628\u0646\u0627 \u064a\u0648\u0645\u0627 \u0639\u0628\u0648\u0633\u0627 \u0642\u0645\u0637\u0631\u064a\u0631\u0627",
    "chapter_title_english": "The Human",
    "chapter_title_arabic": "\u0627\u0644\u0627\u0646\u0633\u0627\u0646",
    "chapter_title_transliterated": "Al-Insaan",
    "chapter_revelation_order": 98,
    "chapter_verses": 31
  },
  {
    "global_index": 5673,
    "verse_index": 5674,
    "chapter_number": 76,
    "verse_id": "76:11",
    "verse_id_arabic": "\u0661\u0661:\u0667\u0666",
    "verse_number": 11,
    "verse_text_english": "Consequently, GOD protects them from the evils of that day, and rewards them with joy and contentment.",
    "verse_text_arabic": "\u0641\u064e\u0648\u064e\u0642\u064e\u0649\u0670\u0647\u064f\u0645\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0634\u064e\u0631\u0651\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u0650 \u0648\u064e\u0644\u064e\u0642\u0651\u064e\u0649\u0670\u0647\u064f\u0645\u0652 \u0646\u064e\u0636\u0652\u0631\u064e\u0629\u064b \u0648\u064e\u0633\u064f\u0631\u064f\u0648\u0631\u064b\u0627",
    "verse_text_transliterated": "fawaq\u0101humu l-lahu sharra dh\u0101lika l-yawmi walaqq\u0101hum na\u1e0dratan wasur\u016bra",
