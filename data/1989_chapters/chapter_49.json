    "verse_id": "49:0",
    "verse_id_arabic": "\u0660:\u0664\u0669",
    "verse_number": 0,
    "verse_text_english": "In the name of God, Most Gracious,",
    "verse_text_arabic": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "bis'mi l-lahi l-ra\u1e25m\u0101ni l-ra\u1e25\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645",
    "chapter_title_english": "The Walls",
    "chapter_title_arabic": "\u0627\u0644\u062d\u062c\u0631\u0627\u062a",
    "chapter_title_transliterated": "Al-Hujur\u00e3t",
    "chapter_revelation_order": 106,
    "chapter_verses": 18
  },
  {
    "global_index": 4657,
    "verse_index": 4658,
    "chapter_number": 49,
    "verse_id": "49:1",
    "verse_id_arabic": "\u0661:\u0664\u0669",
    "verse_number": 1,
    "verse_text_english": "O you who believe, do not place your opinion above that of GOD and His messenger. reverence GOD. Omniscient.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0644\u064e\u0627 \u062a\u064f\u0642\u064e\u062f\u0651\u0650\u0645\u064f\u0648\u0627\u06df \u0628\u064e\u064a\u0652\u0646\u064e \u064a\u064e\u062f\u064e\u0649\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0671\u062a\u0651\u064e\u0642\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0633\u064e\u0645\u0650\u064a\u0639\u064c \u0639\u064e\u0644\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna \u0101man\u016b l\u0101 tuqaddim\u016b bayna yadayi l-lahi waras\u016blihi wa-ittaq\u016b l-laha inna l-laha sam\u012b\u02bfun \u02bfal\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0644\u0627 \u062a\u0642\u062f\u0645\u0648\u0627 \u0628\u064a\u0646 \u064a\u062f\u0649 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u0648\u0627\u062a\u0642\u0648\u0627 \u0627\u0644\u0644\u0647 \u0625\u0646 \u0627\u0644\u0644\u0647 \u0633\u0645\u064a\u0639 \u0639\u0644\u064a\u0645",
    "chapter_title_english": "The Walls",
    "chapter_title_arabic": "\u0627\u0644\u062d\u062c\u0631\u0627\u062a",
    "chapter_title_transliterated": "Al-Hujur\u00e3t",
    "chapter_revelation_order": 106,
