    "verse_id_arabic": "\u0661\u0660:\u0664\u0669",
    "verse_number": 10,
    "verse_text_english": "The believers are brethren. and reverence GOD, that you may attain mercy. 11.0 you who believe, no people shall ridicule other people, for they may be better than they. for they may be better than they. or make fun of your names. attaining faith. these are the transgressors. 8 2390 r 517",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0625\u0650\u062e\u0652\u0648\u064e\u0629\u064c \u0641\u064e\u0623\u064e\u0635\u0652\u0644\u0650\u062d\u064f\u0648\u0627\u06df \u0628\u064e\u064a\u0652\u0646\u064e \u0623\u064e\u062e\u064e\u0648\u064e\u064a\u0652\u0643\u064f\u0645\u0652 \u0648\u064e\u0671\u062a\u0651\u064e\u0642\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u0652 \u062a\u064f\u0631\u0652\u062d\u064e\u0645\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "innam\u0101 l-mu'min\u016bna ikh'watun fa-a\u1e63li\u1e25\u016b bayna akhawaykum wa-ittaq\u016b l-laha la\u02bfallakum tur'\u1e25am\u016bn",
    "verse_subtitle_english": "The Real Family",
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646\u0645\u0627 \u0627\u0644\u0645\u0624\u0645\u0646\u0648\u0646 \u0625\u062e\u0648\u0629 \u0641\u0623\u0635\u0644\u062d\u0648\u0627 \u0628\u064a\u0646 \u0623\u062e\u0648\u064a\u0643\u0645 \u0648\u0627\u062a\u0642\u0648\u0627 \u0627\u0644\u0644\u0647 \u0644\u0639\u0644\u0643\u0645 \u062a\u0631\u062d\u0645\u0648\u0646",
