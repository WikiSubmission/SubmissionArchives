  },
  {
    "global_index": 4658,
    "verse_index": 4659,
    "chapter_number": 49,
    "verse_id": "49:2",
    "verse_id_arabic": "\u0662:\u0664\u0669",
    "verse_number": 2,
    "verse_text_english": "O you who believe, do not raise your voice above the voice of the prophet,* nor shall you shout at him as you shout at each other, lest your works become nullified while you do not perceive.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0644\u064e\u0627 \u062a\u064e\u0631\u0652\u0641\u064e\u0639\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u0635\u0652\u0648\u064e\u0670\u062a\u064e\u0643\u064f\u0645\u0652 \u0641\u064e\u0648\u0652\u0642\u064e \u0635\u064e\u0648\u0652\u062a\u0650 \u0671\u0644\u0646\u0651\u064e\u0628\u0650\u0649\u0651\u0650 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u062c\u0652\u0647\u064e\u0631\u064f\u0648\u0627\u06df \u0644\u064e\u0647\u064f\u06e5 \u0628\u0650\u0671\u0644\u0652\u0642\u064e\u0648\u0652\u0644\u0650 \u0643\u064e\u062c\u064e\u0647\u0652\u0631\u0650 \u0628\u064e\u0639\u0652\u0636\u0650\u0643\u064f\u0645\u0652 \u0644\u0650\u0628\u064e\u0639\u0652\u0636\u064d \u0623\u064e\u0646 \u062a\u064e\u062d\u0652\u0628\u064e\u0637\u064e \u0623\u064e\u0639\u0652\u0645\u064e\u0670\u0644\u064f\u0643\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u0652 \u0644\u064e\u0627 \u062a\u064e\u0634\u0652\u0639\u064f\u0631\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna \u0101man\u016b l\u0101 tarfa\u02bf\u016b a\u1e63w\u0101takum fawqa \u1e63awti l-nabiyi wal\u0101 tajhar\u016b lahu bil-qawli kajahri ba\u02bf\u1e0dikum liba\u02bf\u1e0din an ta\u1e25ba\u1e6da a\u02bfm\u0101lukum wa-antum l\u0101 tash\u02bfur\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "*49:2 Whenever the word \u201cprophet\u201d (Nabi) is used in reference to Muhammad, it in\u00ad variably refers to him during his life, not after his death. Obviously, we cannot possibly raise our voices above Muhammad\u2019s voice, now that he is dead. See also 33:56. 8 2382 The Walls (Al-Hujuraat) 49:5-11 516 r------------------------------------------------------------------------------------------------------",
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0644\u0627 \u062a\u0631\u0641\u0639\u0648\u0627 \u0623\u0635\u0648\u062a\u0643\u0645 \u0641\u0648\u0642 \u0635\u0648\u062a \u0627\u0644\u0646\u0628\u0649 \u0648\u0644\u0627 \u062a\u062c\u0647\u0631\u0648\u0627 \u0644\u0647 \u0628\u0627\u0644\u0642\u0648\u0644 \u0643\u062c\u0647\u0631 \u0628\u0639\u0636\u0643\u0645 \u0644\u0628\u0639\u0636 \u0623\u0646 \u062a\u062d\u0628\u0637 \u0623\u0639\u0645\u0644\u0643\u0645 \u0648\u0623\u0646\u062a\u0645 \u0644\u0627 \u062a\u0634\u0639\u0631\u0648\u0646",
    "chapter_title_english": "The Walls",
    "chapter_title_arabic": "\u0627\u0644\u062d\u062c\u0631\u0627\u062a",
    "chapter_title_transliterated": "Al-Hujur\u00e3t",
    "chapter_revelation_order": 106,
    "chapter_verses": 18
  },
  {
    "global_index": 4659,
    "verse_index": 4660,
    "chapter_number": 49,
    "verse_id": "49:3",
    "verse_id_arabic": "\u0663:\u0664\u0669",
    "verse_number": 3,
    "verse_text_english": "Surely, those who lower their voices at the messenger of GOD are the ones whose hearts are prepared by GOD to become righteous. They deserve forgiveness and a great recompense.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u063a\u064f\u0636\u0651\u064f\u0648\u0646\u064e \u0623\u064e\u0635\u0652\u0648\u064e\u0670\u062a\u064e\u0647\u064f\u0645\u0652 \u0639\u0650\u0646\u062f\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064f\u0648\u06df\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0671\u0645\u0652\u062a\u064e\u062d\u064e\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0642\u064f\u0644\u064f\u0648\u0628\u064e\u0647\u064f\u0645\u0652 \u0644\u0650\u0644\u062a\u0651\u064e\u0642\u0652\u0648\u064e\u0649\u0670 \u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u064e\u063a\u0652\u0641\u0650\u0631\u064e\u0629\u064c \u0648\u064e\u0623\u064e\u062c\u0652\u0631\u064c \u0639\u064e\u0638\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "inna alladh\u012bna yaghu\u1e0d\u1e0d\u016bna a\u1e63w\u0101tahum \u02bfinda ras\u016bli l-lahi ul\u0101ika alladh\u012bna im'ta\u1e25ana l-lahu qul\u016bbahum lilttaqw\u0101 lahum maghfiratun wa-ajrun \u02bfa\u1e93\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u063a\u0636\u0648\u0646 \u0623\u0635\u0648\u062a\u0647\u0645 \u0639\u0646\u062f \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0630\u064a\u0646 \u0627\u0645\u062a\u062d\u0646 \u0627\u0644\u0644\u0647 \u0642\u0644\u0648\u0628\u0647\u0645 \u0644\u0644\u062a\u0642\u0648\u0649 \u0644\u0647\u0645 \u0645\u063a\u0641\u0631\u0629 \u0648\u0623\u062c\u0631 \u0639\u0638\u064a\u0645",
    "chapter_title_english": "The Walls",
    "chapter_title_arabic": "\u0627\u0644\u062d\u062c\u0631\u0627\u062a",
    "chapter_title_transliterated": "Al-Hujur\u00e3t",
    "chapter_revelation_order": 106,
    "chapter_verses": 18
  },
  {
    "global_index": 4660,
    "verse_index": 4661,
    "chapter_number": 49,
    "verse_id": "49:4",
    "verse_id_arabic": "\u0664:\u0664\u0669",
    "verse_number": 4,
    "verse_text_english": "As for those who call on you from outside the walls, most of them do not understand.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u0646\u064e\u0627\u062f\u064f\u0648\u0646\u064e\u0643\u064e \u0645\u0650\u0646 \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u0650 \u0671\u0644\u0652\u062d\u064f\u062c\u064f\u0631\u064e\u0670\u062a\u0650 \u0623\u064e\u0643\u0652\u062b\u064e\u0631\u064f\u0647\u064f\u0645\u0652 \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u0642\u0650\u0644\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "inna alladh\u012bna yun\u0101d\u016bnaka min war\u0101i l-\u1e25ujur\u0101ti aktharuhum l\u0101 ya\u02bfqil\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0646\u0627\u062f\u0648\u0646\u0643 \u0645\u0646 \u0648\u0631\u0627\u0621 \u0627\u0644\u062d\u062c\u0631\u062a \u0623\u0643\u062b\u0631\u0647\u0645 \u0644\u0627 \u064a\u0639\u0642\u0644\u0648\u0646",
    "chapter_title_english": "The Walls",
    "chapter_title_arabic": "\u0627\u0644\u062d\u062c\u0631\u0627\u062a",
    "chapter_title_transliterated": "Al-Hujur\u00e3t",
    "chapter_revelation_order": 106,
    "chapter_verses": 18
  },
  {
    "global_index": 4661,
    "verse_index": 4662,
    "chapter_number": 49,
    "verse_id": "49:5",
    "verse_id_arabic": "\u0665:\u0664\u0669",
    "verse_number": 5,
    "verse_text_english": "Had they been patient until you came out to them, it would have been better for them. GOD is Forgiver, Most Merciful.",
    "verse_text_arabic": "\u0648\u064e\u0644\u064e\u0648\u0652 \u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u0635\u064e\u0628\u064e\u0631\u064f\u0648\u0627\u06df \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u062a\u064e\u062e\u0652\u0631\u064f\u062c\u064e \u0625\u0650\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0644\u064e\u0643\u064e\u0627\u0646\u064e \u062e\u064e\u064a\u0652\u0631\u064b\u0627 \u0644\u0651\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u063a\u064e\u0641\u064f\u0648\u0631\u064c \u0631\u0651\u064e\u062d\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "walaw annahum \u1e63abar\u016b \u1e25att\u0101 takhruja ilayhim lak\u0101na khayran lahum wal-lahu ghaf\u016brun ra\u1e25\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0644\u0648 \u0623\u0646\u0647\u0645 \u0635\u0628\u0631\u0648\u0627 \u062d\u062a\u0649 \u062a\u062e\u0631\u062c \u0625\u0644\u064a\u0647\u0645 \u0644\u0643\u0627\u0646 \u062e\u064a\u0631\u0627 \u0644\u0647\u0645 \u0648\u0627\u0644\u0644\u0647 \u063a\u0641\u0648\u0631 \u0631\u062d\u064a\u0645",
    "chapter_title_english": "The Walls",
    "chapter_title_arabic": "\u0627\u0644\u062d\u062c\u0631\u0627\u062a",
    "chapter_title_transliterated": "Al-Hujur\u00e3t",
    "chapter_revelation_order": 106,
    "chapter_verses": 18
  },
  {
    "global_index": 4662,
    "verse_index": 4663,
    "chapter_number": 49,
    "verse_id": "49:6",
    "verse_id_arabic": "\u0666:\u0664\u0669",
    "verse_number": 6,
    "verse_text_english": "O you who believe, if a wicked person brings news to you, you shall first investigate, lest you commit injustice towards some people, out of ignorance, then become sorry for what you have done.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u06df \u0625\u0650\u0646 \u062c\u064e\u0627\u0653\u0621\u064e\u0643\u064f\u0645\u0652 \u0641\u064e\u0627\u0633\u0650\u0642\u064c\u06e2 \u0628\u0650\u0646\u064e\u0628\u064e\u0625\u064d \u0641\u064e\u062a\u064e\u0628\u064e\u064a\u0651\u064e\u0646\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u0646 \u062a\u064f\u0635\u0650\u064a\u0628\u064f\u0648\u0627\u06df \u0642\u064e\u0648\u0652\u0645\u064b\u06e2\u0627 \u0628\u0650\u062c\u064e\u0647\u064e\u0670\u0644\u064e\u0629\u064d \u0641\u064e\u062a\u064f\u0635\u0652\u0628\u0650\u062d\u064f\u0648\u0627\u06df \u0639\u064e\u0644\u064e\u0649\u0670 \u0645\u064e\u0627 \u0641\u064e\u0639\u064e\u0644\u0652\u062a\u064f\u0645\u0652 \u0646\u064e\u0670\u062f\u0650\u0645\u0650\u064a\u0646\u064e",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna \u0101man\u016b in j\u0101akum f\u0101siqun binaba-in fatabayyan\u016b an tu\u1e63\u012bb\u016b qawman bijah\u0101latin fatu\u1e63'bi\u1e25\u016b \u02bfal\u0101 m\u0101 fa\u02bfaltum n\u0101dim\u012bn",
    "verse_subtitle_english": "Investigate Rumors Before Believing Them",
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0625\u0646 \u062c\u0627\u0621\u0643\u0645 \u0641\u0627\u0633\u0642 \u0628\u0646\u0628\u0625 \u0641\u062a\u0628\u064a\u0646\u0648\u0627 \u0623\u0646 \u062a\u0635\u064a\u0628\u0648\u0627 \u0642\u0648\u0645\u0627 \u0628\u062c\u0647\u0644\u0629 \u0641\u062a\u0635\u0628\u062d\u0648\u0627 \u0639\u0644\u0649 \u0645\u0627 \u0641\u0639\u0644\u062a\u0645 \u0646\u062f\u0645\u064a\u0646",
    "chapter_title_english": "The Walls",
    "chapter_title_arabic": "\u0627\u0644\u062d\u062c\u0631\u0627\u062a",
    "chapter_title_transliterated": "Al-Hujur\u00e3t",
    "chapter_revelation_order": 106,
    "chapter_verses": 18
  },
  {
    "global_index": 4663,
    "verse_index": 4664,
    "chapter_number": 49,
    "verse_id": "49:7",
    "verse_id_arabic": "\u0667:\u0664\u0669",
    "verse_number": 7,
    "verse_text_english": "And know that when GOD\u2019s messenger is in your midst, if he obeys you in many things, you will make everything more difficult for yourselves. faith and adorned it in your hearts, and He made you abhor disbelief, wickedness, and disobedience. These are the guided ones.",
    "verse_text_arabic": "\u0648\u064e\u0671\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u0646\u0651\u064e \u0641\u0650\u064a\u0643\u064f\u0645\u0652 \u0631\u064e\u0633\u064f\u0648\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0644\u064e\u0648\u0652 \u064a\u064f\u0637\u0650\u064a\u0639\u064f\u0643\u064f\u0645\u0652 \u0641\u0650\u0649 \u0643\u064e\u062b\u0650\u064a\u0631\u064d \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0652\u0623\u064e\u0645\u0652\u0631\u0650 \u0644\u064e\u0639\u064e\u0646\u0650\u062a\u0651\u064f\u0645\u0652 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u062d\u064e\u0628\u0651\u064e\u0628\u064e \u0625\u0650\u0644\u064e\u064a\u0652\u0643\u064f\u0645\u064f \u0671\u0644\u0652\u0625\u0650\u064a\u0645\u064e\u0670\u0646\u064e \u0648\u064e\u0632\u064e\u064a\u0651\u064e\u0646\u064e\u0647\u064f\u06e5 \u0641\u0650\u0649 \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0643\u064e\u0631\u0651\u064e\u0647\u064e \u0625\u0650\u0644\u064e\u064a\u0652\u0643\u064f\u0645\u064f \u0671\u0644\u0652\u0643\u064f\u0641\u0652\u0631\u064e \u0648\u064e\u0671\u0644\u0652\u0641\u064f\u0633\u064f\u0648\u0642\u064e \u0648\u064e\u0671\u0644\u0652\u0639\u0650\u0635\u0652\u064a\u064e\u0627\u0646\u064e \u0623\u064f\u0648\u06df\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u0631\u0651\u064e\u0670\u0634\u0650\u062f\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "wa-i\u02bf'lam\u016b anna f\u012bkum ras\u016bla l-lahi law yu\u1e6d\u012b\u02bfukum f\u012b kath\u012brin mina l-amri la\u02bfanittum wal\u0101kinna l-laha \u1e25abbaba ilaykumu l-\u012bm\u0101na wazayyanahu f\u012b qul\u016bbikum wakarraha ilaykumu l-kuf'ra wal-fus\u016bqa wal-\u02bfi\u1e63'y\u0101na ul\u0101ika humu l-r\u0101shid\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0627\u0639\u0644\u0645\u0648\u0627 \u0623\u0646 \u0641\u064a\u0643\u0645 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0644\u0648 \u064a\u0637\u064a\u0639\u0643\u0645 \u0641\u0649 \u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0623\u0645\u0631 \u0644\u0639\u0646\u062a\u0645 \u0648\u0644\u0643\u0646 \u0627\u0644\u0644\u0647 \u062d\u0628\u0628 \u0625\u0644\u064a\u0643\u0645 \u0627\u0644\u0625\u064a\u0645\u0646 \u0648\u0632\u064a\u0646\u0647 \u0641\u0649 \u0642\u0644\u0648\u0628\u0643\u0645 \u0648\u0643\u0631\u0647 \u0625\u0644\u064a\u0643\u0645 \u0627\u0644\u0643\u0641\u0631 \u0648\u0627\u0644\u0641\u0633\u0648\u0642 \u0648\u0627\u0644\u0639\u0635\u064a\u0627\u0646 \u0623\u0648\u0644\u0626\u0643 \u0647\u0645 \u0627\u0644\u0631\u0634\u062f\u0648\u0646",
