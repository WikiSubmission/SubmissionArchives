    "verse_text_arabic": "\u0642\u064f\u0644\u0652 \u0623\u064e\u062a\u064f\u0639\u064e\u0644\u0651\u0650\u0645\u064f\u0648\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0628\u0650\u062f\u0650\u064a\u0646\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0639\u064e\u0644\u0650\u064a\u0645\u064c",
    "verse_text_transliterated": "qul atu\u02bfallim\u016bna l-laha bid\u012bnikum wal-lahu ya\u02bflamu m\u0101 f\u012b l-sam\u0101w\u0101ti wam\u0101 f\u012b l-ar\u1e0di wal-lahu bikulli shayin \u02bfal\u012bmu",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
