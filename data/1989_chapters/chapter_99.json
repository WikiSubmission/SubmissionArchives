    "verse_id_arabic": "\u0666:\u0669\u0669",
    "verse_number": 6,
    "verse_text_english": "On that day, the people will issue from every direction, to be shown their works.",
    "verse_text_arabic": "\u064a\u064e\u0648\u0652\u0645\u064e\u0626\u0650\u0630\u064d \u064a\u064e\u0635\u0652\u062f\u064f\u0631\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0633\u064f \u0623\u064e\u0634\u0652\u062a\u064e\u0627\u062a\u064b\u0627 \u0644\u0651\u0650\u064a\u064f\u0631\u064e\u0648\u0652\u0627\u06df \u0623\u064e\u0639\u0652\u0645\u064e\u0670\u0644\u064e\u0647\u064f\u0645\u0652",
    "verse_text_transliterated": "yawma-idhin ya\u1e63duru l-n\u0101su asht\u0101tan liyuraw a\u02bfm\u0101lahu",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
