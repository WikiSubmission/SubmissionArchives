    "verse_text_transliterated": "wa-ann\u0101 \u1e93anann\u0101 an lan taq\u016bla l-insu wal-jinu \u02bfal\u0101 l-lahi kadhiba",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0627 \u0638\u0646\u0646\u0627 \u0623\u0646 \u0644\u0646 \u062a\u0642\u0648\u0644 \u0627\u0644\u0625\u0646\u0633 \u0648\u0627\u0644\u062c\u0646 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0643\u0630\u0628\u0627",
