    "verse_id": "72:25",
    "verse_id_arabic": "\u0662\u0665:\u0667\u0662",
    "verse_number": 25,
    "verse_text_english": "Say, \u201cI do not know if what is pro\u00ad mised to you will happen soon, or if my Lord will delay it for awhile.\u201d",
    "verse_text_arabic": "\u0642\u064f\u0644\u0652 \u0625\u0650\u0646\u0652 \u0623\u064e\u062f\u0652\u0631\u0650\u0649\u0653 \u0623\u064e\u0642\u064e\u0631\u0650\u064a\u0628\u064c \u0645\u0651\u064e\u0627 \u062a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e \u0623\u064e\u0645\u0652 \u064a\u064e\u062c\u0652\u0639\u064e\u0644\u064f \u0644\u064e\u0647\u064f\u06e5 \u0631\u064e\u0628\u0651\u0650\u0649\u0653 \u0623\u064e\u0645\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "qul in adr\u012b aqar\u012bbun m\u0101 t\u016b\u02bfad\u016bna am yaj\u02bfalu lahu rabb\u012b amada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0642\u0644 \u0625\u0646 \u0623\u062f\u0631\u0649 \u0623\u0642\u0631\u064a\u0628 \u0645\u0627 \u062a\u0648\u0639\u062f\u0648\u0646 \u0623\u0645 \u064a\u062c\u0639\u0644 \u0644\u0647 \u0631\u0628\u0649 \u0623\u0645\u062f\u0627",
