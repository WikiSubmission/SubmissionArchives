  },
  {
    "global_index": 5538,
    "verse_index": 5539,
    "chapter_number": 72,
    "verse_id": "72:24",
    "verse_id_arabic": "\u0662\u0664:\u0667\u0662",
    "verse_number": 24,
    "verse_text_english": "Once they see what is awaiting them, they will find out who is really weake in power, and fewer in number.",
    "verse_text_arabic": "\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u0652\u0627\u06df \u0645\u064e\u0627 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e \u0641\u064e\u0633\u064e\u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0645\u064e\u0646\u0652 \u0623\u064e\u0636\u0652\u0639\u064e\u0641\u064f \u0646\u064e\u0627\u0635\u0650\u0631\u064b\u0627 \u0648\u064e\u0623\u064e\u0642\u064e\u0644\u0651\u064f \u0639\u064e\u062f\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "\u1e25att\u0101 idh\u0101 ra-aw m\u0101 y\u016b\u02bfad\u016bna fasaya\u02bflam\u016bna man a\u1e0d\u02bfafu n\u0101\u1e63iran wa-aqallu \u02bfadada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
