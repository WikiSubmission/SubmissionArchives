    "verse_id_arabic": "\u0663:\u0667\u0662",
    "verse_number": 3,
    "verse_text_english": "\u201c \u2018The Most High is our only Lord. He never had a mate, nor a son.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0639\u064e\u0670\u0644\u064e\u0649\u0670 \u062c\u064e\u062f\u0651\u064f \u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627 \u0645\u064e\u0627 \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0635\u064e\u0670\u062d\u0650\u0628\u064e\u0629\u064b \u0648\u064e\u0644\u064e\u0627 \u0648\u064e\u0644\u064e\u062f\u064b\u0627",
    "verse_text_transliterated": "wa-annahu ta\u02bf\u0101l\u0101 jaddu rabbin\u0101 m\u0101 ittakhadha \u1e63\u0101\u1e25ibatan wal\u0101 walada",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0647 \u062a\u0639\u0644\u0649 \u062c\u062f \u0631\u0628\u0646\u0627 \u0645\u0627 \u0627\u062a\u062e\u0630 \u0635\u062d\u0628\u0629 \u0648\u0644\u0627 \u0648\u0644\u062f\u0627",
