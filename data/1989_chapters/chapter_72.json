    "verse_number": 2,
    "verse_text_english": "\u201c \u2018It guides to righteousness, and we ha we will never set up any idols besides",
    "verse_text_arabic": "\u064a\u064e\u0647\u0652\u062f\u0650\u0649\u0653 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0631\u0651\u064f\u0634\u0652\u062f\u0650 \u0641\u064e\u0640\u0654\u064e\u0627\u0645\u064e\u0646\u0651\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6 \u0648\u064e\u0644\u064e\u0646 \u0646\u0651\u064f\u0634\u0652\u0631\u0650\u0643\u064e \u0628\u0650\u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627\u0653 \u0623\u064e\u062d\u064e\u062f\u064b\u0627",
