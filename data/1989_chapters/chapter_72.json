    "verse_number": 4,
    "verse_text_english": "\u201c \u2018It is the foolish among us who used to utter such nonsense about GOD.",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0633\u064e\u0641\u0650\u064a\u0647\u064f\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0634\u064e\u0637\u064e\u0637\u064b\u0627",
    "verse_text_transliterated": "wa-annahu k\u0101na yaq\u016blu saf\u012bhun\u0101 \u02bfal\u0101 l-lahi sha\u1e6da\u1e6da",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
