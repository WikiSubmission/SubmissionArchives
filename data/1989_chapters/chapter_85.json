    "verse_id_arabic": "\u0669:\u0668\u0665",
    "verse_number": 9,
    "verse_text_english": "To Him belongs the kingship of the heavens and the earth. And GOD witnesses all things.",
    "verse_text_arabic": "\u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u0644\u064e\u0647\u064f\u06e5 \u0645\u064f\u0644\u0652\u0643\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0634\u064e\u0647\u0650\u064a\u062f\u064c",
    "verse_text_transliterated": "alladh\u012b lahu mul'ku l-sam\u0101w\u0101ti wal-ar\u1e0di wal-lahu \u02bfal\u0101 kulli shayin shah\u012bdu",
