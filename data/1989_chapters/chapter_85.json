    "chapter_number": 85,
    "verse_id": "85:10",
    "verse_id_arabic": "\u0661\u0660:\u0668\u0665",
    "verse_number": 10,
    "verse_text_english": "Surely, those who persecute the believing men and women, then fail to repent, have incurred the retribu\u00ad tion of Gehenna; they have incurred the retribution of burning.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u064e\u062a\u064e\u0646\u064f\u0648\u0627\u06df \u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064e\u0670\u062a\u0650 \u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0645\u0652 \u064a\u064e\u062a\u064f\u0648\u0628\u064f\u0648\u0627\u06df \u0641\u064e\u0644\u064e\u0647\u064f\u0645\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u064f \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u0648\u064e\u0644\u064e\u0647\u064f\u0645\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u064f \u0671\u0644\u0652\u062d\u064e\u0631\u0650\u064a\u0642\u0650",
    "verse_text_transliterated": "inna alladh\u012bna fatan\u016b l-mu'min\u012bna wal-mu'min\u0101ti thumma lam yat\u016bb\u016b falahum \u02bfadh\u0101bu jahannama walahum \u02bfadh\u0101bu l-\u1e25ar\u012bq",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646 \u0627\u0644\u0630\u064a\u0646 \u0641\u062a\u0646\u0648\u0627 \u0627\u0644\u0645\u0624\u0645\u0646\u064a\u0646 \u0648\u0627\u0644\u0645\u0624\u0645\u0646\u062a \u062b\u0645 \u0644\u0645 \u064a\u062a\u0648\u0628\u0648\u0627 \u0641\u0644\u0647\u0645 \u0639\u0630\u0627\u0628 \u062c\u0647\u0646\u0645 \u0648\u0644\u0647\u0645 \u0639\u0630\u0627\u0628 \u0627\u0644\u062d\u0631\u064a\u0642",
    "chapter_title_english": "The Galaxies",
    "chapter_title_arabic": "\u0627\u0644\u0628\u0631\u0648\u062c",
    "chapter_title_transliterated": "Al-Burooj",
