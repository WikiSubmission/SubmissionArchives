    "verse_id_arabic": "\u0661\u0661:\u0667\u0663",
    "verse_number": 11,
    "verse_text_english": "And let Me deal with the rejectors, who have been generously blessed; just give them a little time.",
    "verse_text_arabic": "\u0648\u064e\u0630\u064e\u0631\u0652\u0646\u0650\u0649 \u0648\u064e\u0671\u0644\u0652\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u06df\u0644\u0650\u0649 \u0671\u0644\u0646\u0651\u064e\u0639\u0652\u0645\u064e\u0629\u0650 \u0648\u064e\u0645\u064e\u0647\u0651\u0650\u0644\u0652\u0647\u064f\u0645\u0652 \u0642\u064e\u0644\u0650\u064a\u0644\u064b\u0627",
    "verse_text_transliterated": "wadharn\u012b wal-mukadhib\u012bna ul\u012b l-na\u02bfmati wamahhil'hum qal\u012bla",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
