    "verse_text_transliterated": "wa-udh'kuri is'ma rabbika watabattal ilayhi tabt\u012bla",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0627\u0630\u0643\u0631 \u0627\u0633\u0645 \u0631\u0628\u0643 \u0648\u062a\u0628\u062a\u0644 \u0625\u0644\u064a\u0647 \u062a\u0628\u062a\u064a\u0644\u0627",
