    "verse_number": 6,
    "verse_text_english": "The meditation at night is more effective, and more righteous.",
    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e \u0646\u064e\u0627\u0634\u0650\u0626\u064e\u0629\u064e \u0671\u0644\u0651\u064e\u064a\u0652\u0644\u0650 \u0647\u0650\u0649\u064e \u0623\u064e\u0634\u064e\u062f\u0651\u064f \u0648\u064e\u0637\u0652\u0640\u0654\u064b\u0627 \u0648\u064e\u0623\u064e\u0642\u0652\u0648\u064e\u0645\u064f \u0642\u0650\u064a\u0644\u064b\u0627",
    "verse_text_transliterated": "inna n\u0101shi-ata al-layli hiya ashaddu wa\u1e6dan wa-aqwamu q\u012bla",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646 \u0646\u0627\u0634\u0626\u0629 \u0627\u0644\u064a\u0644 \u0647\u0649 \u0623\u0634\u062f \u0648\u0637\u0640\u0654\u0627 \u0648\u0623\u0642\u0648\u0645 \u0642\u064a\u0644\u0627",
