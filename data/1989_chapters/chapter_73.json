    "verse_id_arabic": "\u0669:\u0667\u0663",
    "verse_number": 9,
    "verse_text_english": "Lord of the east and the west; there is no other god besides Him. You should choose Him as your advocate.",
    "verse_text_arabic": "\u0631\u0651\u064e\u0628\u0651\u064f \u0671\u0644\u0652\u0645\u064e\u0634\u0652\u0631\u0650\u0642\u0650 \u0648\u064e\u0671\u0644\u0652\u0645\u064e\u063a\u0652\u0631\u0650\u0628\u0650 \u0644\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u0670\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u0641\u064e\u0671\u062a\u0651\u064e\u062e\u0650\u0630\u0652\u0647\u064f \u0648\u064e\u0643\u0650\u064a\u0644\u064b\u0627",
    "verse_text_transliterated": "rabbu l-mashriqi wal-maghribi l\u0101 il\u0101ha ill\u0101 huwa fa-ittakhidh'hu wak\u012bla",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0631\u0628 \u0627\u0644\u0645\u0634\u0631\u0642 \u0648\u0627\u0644\u0645\u063a\u0631\u0628 \u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0647\u0648 \u0641\u0627\u062a\u062e\u0630\u0647 \u0648\u0643\u064a\u0644\u0627",
