    "verse_id": "73:10",
    "verse_id_arabic": "\u0661\u0660:\u0667\u0663",
    "verse_number": 10,
    "verse_text_english": "And remain steadfast in the face of their utterances, and disregard them in a nice manner.",
    "verse_text_arabic": "\u0648\u064e\u0671\u0635\u0652\u0628\u0650\u0631\u0652 \u0639\u064e\u0644\u064e\u0649\u0670 \u0645\u064e\u0627 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0648\u064e\u0671\u0647\u0652\u062c\u064f\u0631\u0652\u0647\u064f\u0645\u0652 \u0647\u064e\u062c\u0652\u0631\u064b\u0627 \u062c\u064e\u0645\u0650\u064a\u0644\u064b\u0627",
