    "verse_number": 4,
    "verse_text_english": "Or a little more. And read the Quran f",
    "verse_text_arabic": "\u0623\u064e\u0648\u0652 \u0632\u0650\u062f\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0631\u064e\u062a\u0651\u0650\u0644\u0650 \u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u064e \u062a\u064e\u0631\u0652\u062a\u0650\u064a\u0644\u064b\u0627",
    "verse_text_transliterated": "aw zid \u02bfalayhi warattili l-qur'\u0101na tart\u012bla",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
