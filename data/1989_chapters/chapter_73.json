    "verse_text_arabic": "\u0625\u0650\u0646\u0651\u064e \u0644\u064e\u0643\u064e \u0641\u0650\u0649 \u0671\u0644\u0646\u0651\u064e\u0647\u064e\u0627\u0631\u0650 \u0633\u064e\u0628\u0652\u062d\u064b\u0627 \u0637\u064e\u0648\u0650\u064a\u0644\u064b\u0627",
    "verse_text_transliterated": "inna laka f\u012b l-nah\u0101ri sab\u1e25an \u1e6daw\u012bla",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646 \u0644\u0643 \u0641\u0649 \u0627\u0644\u0646\u0647\u0627\u0631 \u0633\u0628\u062d\u0627 \u0637\u0648\u064a\u0644\u0627",
