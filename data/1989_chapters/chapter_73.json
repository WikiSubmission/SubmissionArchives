    "verse_text_arabic_clean": "\u0625\u0646 \u0631\u0628\u0643 \u064a\u0639\u0644\u0645 \u0623\u0646\u0643 \u062a\u0642\u0648\u0645 \u0623\u062f\u0646\u0649 \u0645\u0646 \u062b\u0644\u062b\u0649 \u0627\u0644\u064a\u0644 \u0648\u0646\u0635\u0641\u0647 \u0648\u062b\u0644\u062b\u0647 \u0648\u0637\u0627\u0626\u0641\u0629 \u0645\u0646 \u0627\u0644\u0630\u064a\u0646 \u0645\u0639\u0643 \u0648\u0627\u0644\u0644\u0647 \u064a\u0642\u062f\u0631 \u0627\u0644\u064a\u0644 \u0648\u0627\u0644\u0646\u0647\u0627\u0631 \u0639\u0644\u0645 \u0623\u0646 \u0644\u0646 \u062a\u062d\u0635\u0648\u0647 \u0641\u062a\u0627\u0628 \u0639\u0644\u064a\u0643\u0645 \u0641\u0627\u0642\u0631\u0621\u0648\u0627 \u0645\u0627 \u062a\u064a\u0633\u0631 \u0645\u0646 \u0627\u0644\u0642\u0631\u0621\u0627\u0646 \u0639\u0644\u0645 \u0623\u0646 \u0633\u064a\u0643\u0648\u0646 \u0645\u0646\u0643\u0645 \u0645\u0631\u0636\u0649 \u0648\u0621\u0627\u062e\u0631\u0648\u0646 \u064a\u0636\u0631\u0628\u0648\u0646 \u0641\u0649 \u0627\u0644\u0623\u0631\u0636 \u064a\u0628\u062a\u063a\u0648\u0646 \u0645\u0646 \u0641\u0636\u0644 \u0627\u0644\u0644\u0647 \u0648\u0621\u0627\u062e\u0631\u0648\u0646 \u064a\u0642\u062a\u0644\u0648\u0646 \u0641\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0644\u0647 \u0641\u0627\u0642\u0631\u0621\u0648\u0627 \u0645\u0627 \u062a\u064a\u0633\u0631 \u0645\u0646\u0647 \u0648\u0623\u0642\u064a\u0645\u0648\u0627 \u0627\u0644\u0635\u0644\u0648\u0629 \u0648\u0621\u0627\u062a\u0648\u0627 \u0627\u0644\u0632\u0643\u0648\u0629 \u0648\u0623\u0642\u0631\u0636\u0648\u0627 \u0627\u0644\u0644\u0647 \u0642\u0631\u0636\u0627 \u062d\u0633\u0646\u0627 \u0648\u0645\u0627 \u062a\u0642\u062f\u0645\u0648\u0627 \u0644\u0623\u0646\u0641\u0633\u0643\u0645 \u0645\u0646 \u062e\u064a\u0631 \u062a\u062c\u062f\u0648\u0647 \u0639\u0646\u062f \u0627\u0644\u0644\u0647 \u0647\u0648 \u062e\u064a\u0631\u0627 \u0648\u0623\u0639\u0638\u0645 \u0623\u062c\u0631\u0627 \u0648\u0627\u0633\u062a\u063a\u0641\u0631\u0648\u0627 \u0627\u0644\u0644\u064