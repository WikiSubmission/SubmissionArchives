    "verse_text_arabic": "\u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0648\u064e\u062a\u064e\u0648\u064e\u0627\u0635\u064e\u0648\u0652\u0627\u06df \u0628\u0650\u0671\u0644\u0635\u0651\u064e\u0628\u0652\u0631\u0650 \u0648\u064e\u062a\u064e\u0648\u064e\u0627\u0635\u064e\u0648\u0652\u0627\u06df \u0628\u0650\u0671\u0644\u0652\u0645\u064e\u0631\u0652\u062d\u064e\u0645\u064e\u0629\u0650",
    "verse_text_transliterated": "thumma k\u0101na mina alladh\u012bna \u0101man\u016b wataw\u0101\u1e63aw bil-\u1e63abri wataw\u0101\u1e63aw bil-mar\u1e25amat",
    "verse_subtitle_english": null,
