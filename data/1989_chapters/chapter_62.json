  {
    "global_index": 5243,
    "verse_index": 5244,
    "chapter_number": 62,
    "verse_id": "62:9",
    "verse_id_arabic": "\u0669:\u0666\u0662",
    "verse_number": 9,
    "verse_text_english": "O you who believe, when the Congregational Prayer (Salat Al-Jumu'ah) is announced on Friday, you shall hasten to the commemoration of GOD, and drop all business. This is better for you, if you only knew.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u06df \u0625\u0650\u0630\u064e\u0627 \u0646\u064f\u0648\u062f\u0650\u0649\u064e \u0644\u0650\u0644\u0635\u0651\u064e\u0644\u064e\u0648\u0670\u0629\u0650 \u0645\u0650\u0646 \u064a\u064e\u0648\u0652\u0645\u0650 \u0671\u0644\u0652\u062c\u064f\u0645\u064f\u0639\u064e\u0629\u0650 \u0641\u064e\u0671\u0633\u0652\u0639\u064e\u0648\u0652\u0627\u06df \u0625\u0650\u0644\u064e\u0649\u0670 \u0630\u0650\u0643\u0652\u0631\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0630\u064e\u0631\u064f\u0648\u0627\u06df \u0671\u0644\u0652\u0628\u064e\u064a\u0652\u0639\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u0652 \u062e\u064e\u064a\u0652\u0631\u064c \u0644\u0651\u064e\u0643\u064f\u0645\u0652 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u0652 \u062a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna \u0101man\u016b idh\u0101 n\u016bdiya lil\u1e63\u1e63alati min yawmi l-jumu\u02bfati fa-is'\u02bfaw il\u0101 dhik'ri l-lahi wadhar\u016b l-bay\u02bfa dh\u0101likum khayrun lakum in kuntum ta\u02bflam\u016bn",
    "verse_subtitle_english": "Important Commandments to All Believers",
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0625\u0630\u0627 \u0646\u0648\u062f\u0649 \u0644\u0644\u0635\u0644\u0648\u0629 \u0645\u0646 \u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629 \u0641\u0627\u0633\u0639\u0648\u0627 \u0625\u0644\u0649 \u0630\u0643\u0631 \u0627\u0644\u0644\u0647 \u0648\u0630\u0631\u0648\u0627 \u0627\u0644\u0628\u064a\u0639 \u0630\u0644\u0643\u0645 \u062e\u064a\u0631 \u0644\u0643\u0645 \u0625\u0646 \u0643\u0646\u062a\u0645 \u062a\u0639\u0644\u0645\u0648\u0646",
