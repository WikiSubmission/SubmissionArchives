    "chapter_number": 62,
    "verse_id": "62:8",
    "verse_id_arabic": "\u0668:\u0666\u0662",
    "verse_number": 8,
    "verse_text_english": "Say, \u201cThe death that you are trying to evade will catch up with you sooner or later. of all secrets and declarations, then He will inform you of everything you had done.\u201d 7 2563 554 r",
    "verse_text_arabic": "\u0642\u064f\u0644\u0652 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0652\u0645\u064e\u0648\u0652\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u062a\u064e\u0641\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u0652\u0647\u064f \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0645\u064f\u0644\u064e\u0670\u0642\u0650\u064a\u0643\u064f\u0645\u0652 \u062b\u064f\u0645\u0651\u064e \u062a\u064f\u0631\u064e\u062f\u0651\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0639\u064e\u0670\u0644\u0650\u0645\u0650 \u0671\u0644\u0652\u063a\u064e\u064a\u0652\u0628\u0650 \u0648\u064e\u0671\u0644\u0634\u0651\u064e\u0647\u064e\u0670\u062f\u064e\u0629\u0650 \u0641\u064e\u064a\u064f\u0646\u064e\u0628\u0651\u0650\u0626\u064f\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u0652 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "qul inna l-mawta alladh\u012b tafirr\u016bna min'hu fa-innahu mul\u0101q\u012bkum thumma turadd\u016bna il\u0101 \u02bf\u0101limi l-ghaybi wal-shah\u0101dati fayunabbi-ukum bim\u0101 kuntum ta\u02bfmal\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0642\u0644 \u0625\u0646 \u0627\u0644\u0645\u0648\u062a \u0627\u0644\u0630\u0649 \u062a\u0641\u0631\u0648\u0646 \u0645\u0646\u0647 \u0641\u0625\u0646\u0647 \u0645\u0644\u0642\u064a\u0643\u0645 \u062b\u0645 \u062a\u0631\u062f\u0648\u0646 \u0625\u0644\u0649 \u0639\u0644\u0645 \u0627\u0644\u063a\u064a\u0628 \u0648\u0627\u0644\u0634\u0647\u062f\u0629 \u0641\u064a\u0646\u0628\u0626\u0643\u0645 \u0628\u0645\u0627 \u0643\u0646\u062a\u0645 \u062a\u0639\u0645\u0644\u0648\u0646",
