    "verse_id_arabic": "\u0660:\u0666\u0662",
    "verse_number": 0,
    "verse_text_english": "In the name of God, Most Gracious, Most Merciful",
    "verse_text_arabic": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "bis'mi l-lahi l-ra\u1e25m\u0101ni l-ra\u1e25\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645",
    "chapter_title_english": "Friday",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0645\u0639\u0629",
    "chapter_title_transliterated": "Al-Jumu\u2018ah",
    "chapter_revelation_order": 110,
    "chapter_verses": 11
  },
  {
    "global_index": 5235,
    "verse_index": 5236,
    "chapter_number": 62,
    "verse_id": "62:1",
    "verse_id_arabic": "\u0661:\u0666\u0662",
    "verse_number": 1,
    "verse_text_english": "Glorifying GOD is everything in the heavens and everything on earth; the King, the Most Sacred, the Almighty, the Most Wise.",
    "verse_text_arabic": "\u064a\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0671\u0644\u0652\u0645\u064e\u0644\u0650\u0643\u0650 \u0671\u0644\u0652\u0642\u064f\u062f\u0651\u064f\u0648\u0633\u0650 \u0671\u0644\u0652\u0639\u064e\u0632\u0650\u064a\u0632\u0650 \u0671\u0644\u0652\u062d\u064e\u0643\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "yusabbi\u1e25u lillahi m\u0101 f\u012b l-sam\u0101w\u0101ti wam\u0101 f\u012b l-ar\u1e0di l-maliki l-qud\u016bsi l-\u02bfaz\u012bzi l-\u1e25ak\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u0633\u0628\u062d \u0644\u0644\u0647 \u0645\u0627 \u0641\u0649 \u0627\u0644\u0633\u0645\u0648\u062a \u0648\u0645\u0627 \u0641\u0649 \u0627\u0644\u0623\u0631\u0636 \u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0642\u062f\u0648\u0633 \u0627\u0644\u0639\u0632\u064a\u0632 \u0627\u0644\u062d\u0643\u064a\u0645",
    "chapter_title_english": "Friday",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0645\u0639\u0629",
    "chapter_title_transliterated": "Al-Jumu\u2018ah",
    "chapter_revelation_order": 110,
    "chapter_verses": 11
  },
  {
    "global_index": 5236,
    "verse_index": 5237,
    "chapter_number": 62,
    "verse_id": "62:2",
    "verse_id_arabic": "\u0662:\u0666\u0662",
    "verse_number": 2,
    "verse_text_english": "He is the One who sent to the gentiles a messenger from among them, to recite to them and teach them the scripture and wisdom. they had gone far astray.",
    "verse_text_arabic": "\u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u0628\u064e\u0639\u064e\u062b\u064e \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064f\u0645\u0651\u0650\u064a\u0651\u0650\u06e6\u0646\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u064b\u0627 \u0645\u0651\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u064a\u064e\u062a\u0652\u0644\u064f\u0648\u0627\u06df \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0621\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u064a\u064f\u0632\u064e\u0643\u0651\u0650\u064a\u0647\u0650\u0645\u0652 \u0648\u064e\u064a\u064f\u0639\u064e\u0644\u0651\u0650\u0645\u064f\u0647\u064f\u0645\u064f \u0671\u0644\u0652\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u0652\u062d\u0650\u0643\u0652\u0645\u064e\u0629\u064e \u0648\u064e\u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u06df \u0645\u0650\u0646 \u0642\u064e\u0628\u0652\u0644\u064f \u0644\u064e\u0641\u0650\u0649 \u0636\u064e\u0644\u064e\u0670\u0644\u064d \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u064d",
    "verse_text_transliterated": "huwa alladh\u012b ba\u02bfatha f\u012b l-umiy\u012bna ras\u016blan min'hum yatl\u016b \u02bfalayhim \u0101y\u0101tihi wayuzakk\u012bhim wayu\u02bfallimuhumu l-kit\u0101ba wal-\u1e25ik'mata wa-in k\u0101n\u016b min qablu laf\u012b \u1e0dal\u0101lin mub\u012bni",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0647\u0648 \u0627\u0644\u0630\u0649 \u0628\u0639\u062b \u0641\u0649 \u0627\u0644\u0623\u0645\u064a\u0646 \u0631\u0633\u0648\u0644\u0627 \u0645\u0646\u0647\u0645 \u064a\u062a\u0644\u0648\u0627 \u0639\u0644\u064a\u0647\u0645 \u0621\u0627\u064a\u062a\u0647 \u0648\u064a\u0632\u0643\u064a\u0647\u0645 \u0648\u064a\u0639\u0644\u0645\u0647\u0645 \u0627\u0644\u0643\u062a\u0628 \u0648\u0627\u0644\u062d\u0643\u0645\u0629 \u0648\u0625\u0646 \u0643\u0627\u0646\u0648\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0644\u0641\u0649 \u0636\u0644\u0644 \u0645\u0628\u064a\u0646",
    "chapter_title_english": "Friday",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0645\u0639\u0629",
    "chapter_title_transliterated": "Al-Jumu\u2018ah",
    "chapter_revelation_order": 110,
    "chapter_verses": 11
  },
  {
    "global_index": 5237,
    "verse_index": 5238,
    "chapter_number": 62,
    "verse_id": "62:3",
    "verse_id_arabic": "\u0663:\u0666\u0662",
    "verse_number": 3,
    "verse_text_english": "And to many generations subsequent to them. Most Wise.",
    "verse_text_arabic": "\u0648\u064e\u0621\u064e\u0627\u062e\u064e\u0631\u0650\u064a\u0646\u064e \u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0644\u064e\u0645\u0651\u064e\u0627 \u064a\u064e\u0644\u0652\u062d\u064e\u0642\u064f\u0648\u0627\u06df \u0628\u0650\u0647\u0650\u0645\u0652 \u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u0652\u0639\u064e\u0632\u0650\u064a\u0632\u064f \u0671\u0644\u0652\u062d\u064e\u0643\u0650\u064a\u0645\u064f",
    "verse_text_transliterated": "wa\u0101khar\u012bna min'hum lamm\u0101 yal\u1e25aq\u016b bihim wahuwa l-\u02bfaz\u012bzu l-\u1e25ak\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0621\u0627\u062e\u0631\u064a\u0646 \u0645\u0646\u0647\u0645 \u0644\u0645\u0627 \u064a\u0644\u062d\u0642\u0648\u0627 \u0628\u0647\u0645 \u0648\u0647\u0648 \u0627\u0644\u0639\u0632\u064a\u0632 \u0627\u0644\u062d\u0643\u064a\u0645",
    "chapter_title_english": "Friday",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0645\u0639\u0629",
    "chapter_title_transliterated": "Al-Jumu\u2018ah",
    "chapter_revelation_order": 110,
    "chapter_verses": 11
  },
  {
    "global_index": 5238,
    "verse_index": 5239,
    "chapter_number": 62,
    "verse_id": "62:4",
    "verse_id_arabic": "\u0664:\u0666\u0662",
    "verse_number": 4,
    "verse_text_english": "Such is GOD\u2019s grace that He bestows upon whomever He wills. GOD is Possessor of Infinite Grace.",
    "verse_text_arabic": "\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0641\u064e\u0636\u0652\u0644\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064f\u0624\u0652\u062a\u0650\u064a\u0647\u0650 \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0630\u064f\u0648 \u0671\u0644\u0652\u0641\u064e\u0636\u0652\u0644\u0650 \u0671\u0644\u0652\u0639\u064e\u0638\u0650\u064a\u0645\u0650",
    "verse_text_transliterated": "dh\u0101lika fa\u1e0dlu l-lahi yu't\u012bhi man yash\u0101u wal-lahu dh\u016b l-fa\u1e0dli l-\u02bfa\u1e93\u012bm",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0630\u0644\u0643 \u0641\u0636\u0644 \u0627\u0644\u0644\u0647 \u064a\u0624\u062a\u064a\u0647 \u0645\u0646 \u064a\u0634\u0627\u0621 \u0648\u0627\u0644\u0644\u0647 \u0630\u0648 \u0627\u0644\u0641\u0636\u0644 \u0627\u0644\u0639\u0638\u064a\u0645",
    "chapter_title_english": "Friday",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0645\u0639\u0629",
    "chapter_title_transliterated": "Al-Jumu\u2018ah",
    "chapter_revelation_order": 110,
    "chapter_verses": 11
  },
  {
    "global_index": 5239,
    "verse_index": 5240,
    "chapter_number": 62,
    "verse_id": "62:5",
    "verse_id_arabic": "\u0665:\u0666\u0662",
    "verse_number": 5,
    "verse_text_english": "The example of those who were given the Torah then failed to uphold it is like the donkey carrying great works of literature. indeed is the example of people who rejected GOD\u2019s revelations. does not guide the wicked people.",
    "verse_text_arabic": "\u0645\u064e\u062b\u064e\u0644\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u062d\u064f\u0645\u0651\u0650\u0644\u064f\u0648\u0627\u06df \u0671\u0644\u062a\u0651\u064e\u0648\u0652\u0631\u064e\u0649\u0670\u0629\u064e \u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0645\u0652 \u064a\u064e\u062d\u0652\u0645\u0650\u0644\u064f\u0648\u0647\u064e\u0627 \u0643\u064e\u0645\u064e\u062b\u064e\u0644\u0650 \u0671\u0644\u0652\u062d\u0650\u0645\u064e\u0627\u0631\u0650 \u064a\u064e\u062d\u0652\u0645\u0650\u0644\u064f \u0623\u064e\u0633\u0652\u0641\u064e\u0627\u0631\u064b\u06e2\u0627 \u0628\u0650\u0626\u0652\u0633\u064e \u0645\u064e\u062b\u064e\u0644\u064f \u0671\u0644\u0652\u0642\u064e\u0648\u0652\u0645\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0627\u06df \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627 \u064a\u064e\u0647\u0652\u062f\u0650\u0649 \u0671\u0644\u0652\u0642\u064e\u0648\u0652\u0645\u064e \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e",
    "verse_text_transliterated": "mathalu alladh\u012bna \u1e25ummil\u016b l-tawr\u0101ta thumma lam ya\u1e25mil\u016bh\u0101 kamathali l-\u1e25im\u0101ri ya\u1e25milu asf\u0101ran bi'sa mathalu l-qawmi alladh\u012bna kadhab\u016b bi\u0101y\u0101ti l-lahi wal-lahu l\u0101 yahd\u012b l-qawma l-\u1e93\u0101lim\u012bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0645\u062b\u0644 \u0627\u0644\u0630\u064a\u0646 \u062d\u0645\u0644\u0648\u0627 \u0627\u0644\u062a\u0648\u0631\u0649\u0629 \u062b\u0645 \u0644\u0645 \u064a\u062d\u0645\u0644\u0648\u0647\u0627 \u0643\u0645\u062b\u0644 \u0627\u0644\u062d\u0645\u0627\u0631 \u064a\u062d\u0645\u0644 \u0623\u0633\u0641\u0627\u0631\u0627 \u0628\u0626\u0633 \u0645\u062b\u0644 \u0627\u0644\u0642\u0648\u0645 \u0627\u0644\u0630\u064a\u0646 \u0643\u0630\u0628\u0648\u0627 \u0628\u0640\u0654\u0627\u064a\u062a \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0647\u062f\u0649 \u0627\u0644\u0642\u0648\u0645 \u0627\u0644\u0638\u0644\u0645\u064a\u0646",
    "chapter_title_english": "Friday",
    "chapter_title_arabic": "\u0627\u0644\u062c\u0645\u0639\u0629",
