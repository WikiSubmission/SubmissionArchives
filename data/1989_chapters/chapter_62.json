  {
    "global_index": 5244,
    "verse_index": 5245,
    "chapter_number": 62,
    "verse_id": "62:10",
    "verse_id_arabic": "\u0661\u0660:\u0666\u0662",
    "verse_number": 10,
    "verse_text_english": "Once the prayer is completed, you may spread through the land to seek GOD\u2019s bounties, and continue to remember GOD frequently, that you may succeed.",
    "verse_text_arabic": "\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064f\u0636\u0650\u064a\u064e\u062a\u0650 \u0671\u0644\u0635\u0651\u064e\u0644\u064e\u0648\u0670\u0629\u064f \u0641\u064e\u0671\u0646\u062a\u064e\u0634\u0650\u0631\u064f\u0648\u0627\u06df \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0671\u0628\u0652\u062a\u064e\u063a\u064f\u0648\u0627\u06df \u0645\u0650\u0646 \u0641\u064e\u0636\u0652\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0671\u0630\u0652\u0643\u064f\u0631\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0643\u064e\u062b\u0650\u064a\u0631\u064b\u0627 \u0644\u0651\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u0652 \u062a\u064f\u0641\u0652\u0644\u0650\u062d\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "fa-idh\u0101 qu\u1e0diyati l-\u1e63alatu fa-intashir\u016b f\u012b l-ar\u1e0di wa-ib'tagh\u016b min fa\u1e0dli l-lahi wa-udh'kur\u016b l-laha kath\u012bran la\u02bfallakum tuf'li\u1e25\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0641\u0625\u0630\u0627 \u0642\u0636\u064a\u062a \u0627\u0644\u0635\u0644\u0648\u0629 \u0641\u0627\u0646\u062a\u0634\u0631\u0648\u0627 \u0641\u0649 \u0627\u0644\u0623\u0631\u0636 \u0648\u0627\u0628\u062a\u063a\u0648\u0627 \u0645\u0646 \u0641\u0636\u0644 \u0627\u0644\u0644\u0647 \u0648\u0627\u0630\u0643\u0631\u0648\u0627 \u0627\u0644\u0644\u0647 \u0643\u062b\u064a\u0631\u0627 \u0644\u0639\u0644\u0643\u0645 \u062a\u0641\u0644\u062d\u0648\u0646",
