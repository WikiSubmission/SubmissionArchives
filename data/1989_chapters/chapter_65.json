  {
    "global_index": 5280,
    "verse_index": 5281,
    "chapter_number": 65,
    "verse_id": "65:3",
    "verse_id_arabic": "\u0663:\u0666\u0665",
    "verse_number": 3,
    "verse_text_english": "And will provide for him whence he never expected. GOD, He suffices him. commands are done. decreed for everything its fate.",
    "verse_text_arabic": "\u0648\u064e\u064a\u064e\u0631\u0652\u0632\u064f\u0642\u0652\u0647\u064f \u0645\u0650\u0646\u0652 \u062d\u064e\u064a\u0652\u062b\u064f \u0644\u064e\u0627 \u064a\u064e\u062d\u0652\u062a\u064e\u0633\u0650\u0628\u064f \u0648\u064e\u0645\u064e\u0646 \u064a\u064e\u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u0652 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0641\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0633\u0652\u0628\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0628\u064e\u0670\u0644\u0650\u063a\u064f \u0623\u064e\u0645\u0652\u0631\u0650\u0647\u0650\u06e6 \u0642\u064e\u062f\u0652 \u062c\u064e\u0639\u064e\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u0652\u0631\u064b\u0627",
    "verse_text_transliterated": "wayarzuq'hu min \u1e25aythu l\u0101 ya\u1e25tasibu waman yatawakkal \u02bfal\u0101 l-lahi fahuwa \u1e25asbuhu inna l-laha b\u0101lighu amrihi qad ja\u02bfala l-lahu likulli shayin qadra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u064a\u0631\u0632\u0642\u0647 \u0645\u0646 \u062d\u064a\u062b \u0644\u0627 \u064a\u062d\u062a\u0633\u0628 \u0648\u0645\u0646 \u064a\u062a\u0648\u0643\u0644 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0641\u0647\u0648 \u062d\u0633\u0628\u0647 \u0625\u0646 \u0627\u0644\u0644\u0647 \u0628\u0644\u063a \u0623\u0645\u0631\u0647 \u0642\u062f \u062c\u0639\u0644 \u0627\u0644\u0644\u0647 \u0644\u0643\u0644 \u0634\u0649\u0621 \u0642\u062f\u0631\u0627",
    "chapter_title_english": "Divorce",
