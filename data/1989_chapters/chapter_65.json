  {
    "global_index": 5279,
    "verse_index": 5280,
    "chapter_number": 65,
    "verse_id": "65:2",
    "verse_id_arabic": "\u0662:\u0666\u0665",
    "verse_number": 2,
    "verse_text_english": "Once the interim is fulfilled, you may reconcile with them equitably, or go through with the separation equitably. able witnesses witness the divorce before GOD. those who believe in GOD and the Last Day. GOD, He will create an exit for him.",
    "verse_text_arabic": "\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0644\u064e\u063a\u0652\u0646\u064e \u0623\u064e\u062c\u064e\u0644\u064e\u0647\u064f\u0646\u0651\u064e \u0641\u064e\u0623\u064e\u0645\u0652\u0633\u0650\u0643\u064f\u0648\u0647\u064f\u0646\u0651\u064e \u0628\u0650\u0645\u064e\u0639\u0652\u0631\u064f\u0648\u0641\u064d \u0623\u064e\u0648\u0652 \u0641\u064e\u0627\u0631\u0650\u0642\u064f\u0648\u0647\u064f\u0646\u0651\u064e \u0628\u0650\u0645\u064e\u0639\u0652\u0631\u064f\u0648\u0641\u064d \u0648\u064e\u0623\u064e\u0634\u0652\u0647\u0650\u062f\u064f\u0648\u0627\u06df \u0630\u064e\u0648\u064e\u0649\u0652 \u0639\u064e\u062f\u0652\u0644\u064d \u0645\u0651\u0650\u0646\u0643\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0642\u0650\u064a\u0645\u064f\u0648\u0627\u06df \u0671\u0644\u0634\u0651\u064e\u0647\u064e\u0670\u062f\u064e\u0629\u064e \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0630\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u0652 \u064a\u064f\u0648\u0639\u064e\u0638\u064f \u0628\u0650\u0647\u0650\u06e6 \u0645\u064e\u0646 \u0643\u064e\u0627\u0646\u064e \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0671\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u0650 \u0671\u0644\u0652\u0621\u064e\u0627\u062e\u0650\u0631\u0650 \u0648\u064e\u0645\u064e\u0646 \u064a\u064e\u062a\u0651\u064e\u0642\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u064a\u064e\u062c\u0652\u0639\u064e\u0644 \u0644\u0651\u064e\u0647\u064f\u06e5 \u0645\u064e\u062e\u0652\u0631\u064e\u062c\u064b\u0627",
    "verse_text_transliterated": "fa-idh\u0101 balaghna ajalahunna fa-amsik\u016bhunna bima\u02bfr\u016bfin aw f\u0101riq\u016bhunna bima\u02bfr\u016bfin wa-ashhid\u016b dhaway \u02bfadlin minkum wa-aq\u012bm\u016b l-shah\u0101data lillahi dh\u0101likum y\u016b\u02bfa\u1e93u bihi man k\u0101na yu'minu bil-lahi wal-yawmi l-\u0101khiri waman yattaqi l-laha yaj\u02bfal lahu makhraja",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0641\u0625\u0630\u0627 \u0628\u0644\u063a\u0646 \u0623\u062c\u0644\u0647\u0646 \u0641\u0623\u0645\u0633\u0643\u0648\u0647\u0646 \u0628\u0645\u0639\u0631\u0648\u0641 \u0623\u0648 \u0641\u0627\u0631\u0642\u0648\u0647\u0646 \u0628\u0645\u0639\u0631\u0648\u0641 \u0648\u0623\u0634\u0647\u062f\u0648\u0627 \u0630\u0648\u0649 \u0639\u062f\u0644 \u0645\u0646\u0643\u0645 \u0648\u0623\u0642\u064a\u0645\u0648\u0627 \u0627\u0644\u0634\u0647\u062f\u0629 \u0644\u0644\u0647 \u0630\u0644\u0643\u0645 \u064a\u0648\u0639\u0638 \u0628\u0647 \u0645\u0646 \u0643\u0627\u0646 \u064a\u0624\u0645\u0646 \u0628\u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0621\u0627\u062e\u0631 \u0648\u0645\u0646 \u064a\u062a\u0642 \u0627\u0644\u0644\u0647 \u064a\u062c\u0639\u0644 \u0644\u0647 \u0645\u062e\u0631\u062c\u0627",
    "chapter_title_english": "Divorce",
