  },
  {
    "global_index": 5282,
    "verse_index": 5283,
    "chapter_number": 65,
    "verse_id": "65:5",
    "verse_id_arabic": "\u0665:\u0666\u0665",
    "verse_number": 5,
    "verse_text_english": "This is GOD\u2019s command that He sends down to you. Anyone who reverences GOD, He remits his sins, and rewards him generously.",
    "verse_text_arabic": "\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0623\u064e\u0645\u0652\u0631\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u0646\u0632\u064e\u0644\u064e\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u064e\u064a\u0652\u0643\u064f\u0645\u0652 \u0648\u064e\u0645\u064e\u0646 \u064a\u064e\u062a\u0651\u064e\u0642\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u064a\u064f\u0643\u064e\u0641\u0651\u0650\u0631\u0652 \u0639\u064e\u0646\u0652\u0647\u064f \u0633\u064e\u064a\u0651\u0650\u0640\u0654\u064e\u0627\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u064a\u064f\u0639\u0652\u0638\u0650\u0645\u0652 \u0644\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062c\u0652\u0631\u064b\u0627",
    "verse_text_transliterated": "dh\u0101lika amru l-lahi anzalahu ilaykum waman yattaqi l-laha yukaffir \u02bfanhu sayyi\u0101tihi wayu\u02bf'\u1e93im lahu ajra",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0630\u0644\u0643 \u0623\u0645\u0631 \u0627\u0644\u0644\u0647 \u0623\u0646\u0632\u0644\u0647 \u0625\u0644\u064a\u0643\u0645 \u0648\u0645\u0646 \u064a\u062a\u0642 \u0627\u0644\u0644\u0647 \u064a\u0643\u0641\u0631 \u0639\u0646\u0647 \u0633\u064a\u0640\u0654\u0627\u062a\u0647 \u0648\u064a\u0639\u0638\u0645 \u0644\u0647 \u0623\u062c\u0631\u0627",
    "chapter_title_english": "Divorce",
    "chapter_title_arabic": "\u0627\u0644\u0637\u0644\u0627\u0642",
    "chapter_title_transliterated": "Al-Talaaq",
    "chapter_revelation_order": 99,
    "chapter_verses": 12
  },
  {
    "global_index": 5283,
    "verse_index": 5284,
    "chapter_number": 65,
    "verse_id": "65:6",
    "verse_id_arabic": "\u0666:\u0666\u0665",
    "verse_number": 6,
    "verse_text_english": "You shall allow them to live in the same home in which they lived with you, and do not make life so miserable for them that they leave on their own. pregnant, you shall spend on them until they give birth. you shall pay them for this service. among you. If you disagree, you may hire another woman to nurse the child.",
    "verse_text_arabic": "\u0623\u064e\u0633\u0652\u0643\u0650\u0646\u064f\u0648\u0647\u064f\u0646\u0651\u064e \u0645\u0650\u0646\u0652 \u062d\u064e\u064a\u0652\u062b\u064f \u0633\u064e\u0643\u064e\u0646\u062a\u064f\u0645 \u0645\u0651\u0650\u0646 \u0648\u064f\u062c\u0652\u062f\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0644\u064e\u0627 \u062a\u064f\u0636\u064e\u0627\u0653\u0631\u0651\u064f\u0648\u0647\u064f\u0646\u0651\u064e \u0644\u0650\u062a\u064f\u0636\u064e\u064a\u0651\u0650\u0642\u064f\u0648\u0627\u06df \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0646\u0651\u064e \u0648\u064e\u0625\u0650\u0646 \u0643\u064f\u0646\u0651\u064e \u0623\u064f\u0648\u06df\u0644\u064e\u0670\u062a\u0650 \u062d\u064e\u0645\u0652\u0644\u064d \u0641\u064e\u0623\u064e\u0646\u0641\u0650\u0642\u064f\u0648\u0627\u06df \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0646\u0651\u064e \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064e\u0636\u064e\u0639\u0652\u0646\u064e \u062d\u064e\u0645\u0652\u0644\u064e\u0647\u064f\u0646\u0651\u064e \u0641\u064e\u0625\u0650\u0646\u0652 \u0623\u064e\u0631\u0652\u0636\u064e\u0639\u0652\u0646\u064e \u0644\u064e\u0643\u064f\u0645\u0652 \u0641\u064e\u0640\u0654\u064e\u0627\u062a\u064f\u0648\u0647\u064f\u0646\u0651\u064e \u0623\u064f\u062c\u064f\u0648\u0631\u064e\u0647\u064f\u0646\u0651\u064e \u0648\u064e\u0623\u0652\u062a\u064e\u0645\u0650\u0631\u064f\u0648\u0627\u06df \u0628\u064e\u064a\u0652\u0646\u064e\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u0639\u0652\u0631\u064f\u0648\u0641\u064d \u0648\u064e\u0625\u0650\u0646 \u062a\u064e\u0639\u064e\u0627\u0633\u064e\u0631\u0652\u062a\u064f\u0645\u0652 \u0641\u064e\u0633\u064e\u062a\u064f\u0631\u0652\u0636\u0650\u0639\u064f \u0644\u064e\u0647\u064f\u06e5\u0653 \u0623\u064f\u062e\u0652\u0631\u064e\u0649\u0670",
    "verse_text_transliterated": "askin\u016bhunna min \u1e25aythu sakantum min wuj'dikum wal\u0101 tu\u1e0d\u0101rr\u016bhunna litu\u1e0dayyiq\u016b \u02bfalayhinna wa-in kunna ul\u0101ti \u1e25amlin fa-anfiq\u016b \u02bfalayhinna \u1e25att\u0101 ya\u1e0da\u02bfna \u1e25amlahunna fa-in ar\u1e0da\u02bfna lakum fa\u0101t\u016bhunna uj\u016brahunna watamir\u016b baynakum bima\u02bfr\u016bfin wa-in ta\u02bf\u0101sartum fasatur'\u1e0di\u02bfu lahu ukh'r",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0623\u0633\u0643\u0646\u0648\u0647\u0646 \u0645\u0646 \u062d\u064a\u062b \u0633\u0643\u0646\u062a\u0645 \u0645\u0646 \u0648\u062c\u062f\u0643\u0645 \u0648\u0644\u0627 \u062a\u0636\u0627\u0631\u0648\u0647\u0646 \u0644\u062a\u0636\u064a\u0642\u0648\u0627 \u0639\u0644\u064a\u0647\u0646 \u0648\u0625\u0646 \u0643\u0646 \u0623\u0648\u0644\u062a \u062d\u0645\u0644 \u0641\u0623\u0646\u0641\u0642\u0648\u0627 \u0639\u0644\u064a\u0647\u0646 \u062d\u062a\u0649 \u064a\u0636\u0639\u0646 \u062d\u0645\u0644\u0647\u0646 \u0641\u0625\u0646 \u0623\u0631\u0636\u0639\u0646 \u0644\u0643\u0645 \u0641\u0640\u0654\u0627\u062a\u0648\u0647\u0646 \u0623\u062c\u0648\u0631\u0647\u0646 \u0648\u0623\u062a\u0645\u0631\u0648\u0627 \u0628\u064a\u0646\u0643\u0645 \u0628\u0645\u0639\u0631\u0648\u0641 \u0648\u0625\u0646 \u062a\u0639\u0627\u0633\u0631\u062a\u0645 \u0641\u0633\u062a\u0631\u0636\u0639 \u0644\u0647 \u0623\u062e\u0631\u0649",
    "chapter_title_english": "Divorce",
    "chapter_title_arabic": "\u0627\u0644\u0637\u0644\u0627\u0642",
    "chapter_title_transliterated": "Al-Talaaq",
