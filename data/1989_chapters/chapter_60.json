  },
  {
    "global_index": 5208,
    "verse_index": 5209,
    "chapter_number": 60,
    "verse_id": "60:3",
    "verse_id_arabic": "\u0663:\u0666\u0660",
    "verse_number": 3,
    "verse_text_english": "Your relatives and your money can never help you. surrection, He will judge among you. GOD Seer of everything you do.",
    "verse_text_arabic": "\u0644\u064e\u0646 \u062a\u064e\u0646\u0641\u064e\u0639\u064e\u0643\u064f\u0645\u0652 \u0623\u064e\u0631\u0652\u062d\u064e\u0627\u0645\u064f\u0643\u064f\u0645\u0652 \u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064e\u0648\u0652\u0644\u064e\u0670\u062f\u064f\u0643\u064f\u0645\u0652 \u064a\u064e\u0648\u0652\u0645\u064e \u0671\u0644\u0652\u0642\u0650\u064a\u064e\u0670\u0645\u064e\u0629\u0650 \u064a\u064e\u0641\u0652\u0635\u0650\u0644\u064f \u0628\u064e\u064a\u0652\u0646\u064e\u0643\u064f\u0645\u0652 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e \u0628\u064e\u0635\u0650\u064a\u0631\u064c",
    "verse_text_transliterated": "lan tanfa\u02bfakum ar\u1e25\u0101mukum wal\u0101 awl\u0101dukum yawma l-qiy\u0101mati yaf\u1e63ilu baynakum wal-lahu bim\u0101 ta\u02bfmal\u016bna ba\u1e63\u012bru",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0644\u0646 \u062a\u0646\u0641\u0639\u0643\u0645 \u0623\u0631\u062d\u0627\u0645\u0643\u0645 \u0648\u0644\u0627 \u0623\u0648\u0644\u062f\u0643\u0645 \u064a\u0648\u0645 \u0627\u0644\u0642\u064a\u0645\u0629 \u064a\u0641\u0635\u0644 \u0628\u064a\u0646\u0643\u0645 \u0648\u0627\u0644\u0644\u0647 \u0628\u0645\u0627 \u062a\u0639\u0645\u0644\u0648\u0646 \u0628\u0635\u064a\u0631",
    "chapter_title_english": "The Test",
    "chapter_title_arabic": "\u0627\u0644\u0645\u0645\u062a\u062d\u0646\u0629",
    "chapter_title_transliterated": "Al-Mumtahanah",
