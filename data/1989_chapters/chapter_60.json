  {
    "global_index": 5216,
    "verse_index": 5217,
    "chapter_number": 60,
    "verse_id": "60:11",
    "verse_id_arabic": "\u0661\u0661:\u0666\u0660",
    "verse_number": 11,
    "verse_text_english": "If any of your wives join the enemies\u2019 camp, and you are forced to fight, you shall force the enemy to compensate the men who lost their wives, by giving them what they spent on their wives. You shall reverence GOD, in whom you believe. 12 2535 r",
    "verse_text_arabic": "\u0648\u064e\u0625\u0650\u0646 \u0641\u064e\u0627\u062a\u064e\u0643\u064f\u0645\u0652 \u0634\u064e\u0649\u0652\u0621\u064c \u0645\u0651\u0650\u0646\u0652 \u0623\u064e\u0632\u0652\u0648\u064e\u0670\u062c\u0650\u0643\u064f\u0645\u0652 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0652\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u0650 \u0641\u064e\u0639\u064e\u0627\u0642\u064e\u0628\u0652\u062a\u064f\u0645\u0652 \u0641\u064e\u0640\u0654\u064e\u0627\u062a\u064f\u0648\u0627\u06df \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0630\u064e\u0647\u064e\u0628\u064e\u062a\u0652 \u0623\u064e\u0632\u0652\u0648\u064e\u0670\u062c\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u062b\u0652\u0644\u064e \u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u0641\u064e\u0642\u064f\u0648\u0627\u06df \u0648\u064e\u0671\u062a\u0651\u064e\u0642\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u0649\u0653 \u0623\u064e\u0646\u062a\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "wa-in f\u0101takum shayon min azw\u0101jikum il\u0101 l-kuf\u0101ri fa\u02bf\u0101qabtum fa\u0101t\u016b alladh\u012bna dhahabat azw\u0101juhum mith'la m\u0101 anfaq\u016b wa-ittaq\u016b l-laha alladh\u012b antum bihi mu'min\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0625\u0646 \u0641\u0627\u062a\u0643\u0645 \u0634\u0649\u0621 \u0645\u0646 \u0623\u0632\u0648\u062c\u0643\u0645 \u0625\u0644\u0649 \u0627\u0644\u0643\u0641\u0627\u0631 \u0641\u0639\u0627\u0642\u0628\u062a\u0645 \u0641\u0640\u0654\u0627\u062a\u0648\u0627 \u0627\u0644\u0630\u064a\u0646 \u0630\u0647\u0628\u062a \u0623\u0632\u0648\u062c\u0647\u0645 \u0645\u062b\u0644 \u0645\u0627 \u0623\u0646\u0641\u0642\u0648\u0627 \u0648\u0627\u062a\u0642\u0648\u0627 \u0627\u0644\u0644\u0647 \u0627\u0644\u0630\u0649 \u0623\u0646\u062a\u0645 \u0628\u0647 \u0645\u0624\u0645\u0646\u0648\u0646",
