  },
  {
    "global_index": 5207,
    "verse_index": 5208,
    "chapter_number": 60,
    "verse_id": "60:2",
    "verse_id_arabic": "\u0662:\u0666\u0660",
    "verse_number": 2,
    "verse_text_english": "Whenever they encounter you, they treat you as enemies, and hurt you with their hands and tongues. They want you to disbelieve.",
    "verse_text_arabic": "\u0625\u0650\u0646 \u064a\u064e\u062b\u0652\u0642\u064e\u0641\u064f\u0648\u0643\u064f\u0645\u0652 \u064a\u064e\u0643\u064f\u0648\u0646\u064f\u0648\u0627\u06df \u0644\u064e\u0643\u064f\u0645\u0652 \u0623\u064e\u0639\u0652\u062f\u064e\u0627\u0653\u0621\u064b \u0648\u064e\u064a\u064e\u0628\u0652\u0633\u064f\u0637\u064f\u0648\u0653\u0627\u06df \u0625\u0650\u0644\u064e\u064a\u0652\u0643\u064f\u0645\u0652 \u0623\u064e\u064a\u0652\u062f\u0650\u064a\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0644\u0652\u0633\u0650\u0646\u064e\u062a\u064e\u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u0633\u0651\u064f\u0648\u0653\u0621\u0650 \u0648\u064e\u0648\u064e\u062f\u0651\u064f\u0648\u0627\u06df \u0644\u064e\u0648\u0652 \u062a\u064e\u0643\u0652\u0641\u064f\u0631\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "in yathqaf\u016bkum yak\u016bn\u016b lakum a\u02bfd\u0101an wayabsu\u1e6d\u016b ilaykum aydiyahum wa-alsinatahum bil-s\u016bi wawadd\u016b law takfur\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0625\u0646 \u064a\u062b\u0642\u0641\u0648\u0643\u0645 \u064a\u0643\u0648\u0646\u0648\u0627 \u0644\u0643\u0645 \u0623\u0639\u062f\u0627\u0621 \u0648\u064a\u0628\u0633\u0637\u0648\u0627 \u0625\u0644\u064a\u0643\u0645 \u0623\u064a\u062f\u064a\u0647\u0645 \u0648\u0623\u0644\u0633\u0646\u062a\u0647\u0645 \u0628\u0627\u0644\u0633\u0648\u0621 \u0648\u0648\u062f\u0648\u0627 \u0644\u0648 \u062a\u0643\u0641\u0631\u0648\u0646",
    "chapter_title_english": "The Test",
    "chapter_title_arabic": "\u0627\u0644\u0645\u0645\u062a\u062d\u0646\u0629",
    "chapter_title_transliterated": "Al-Mumtahanah",
