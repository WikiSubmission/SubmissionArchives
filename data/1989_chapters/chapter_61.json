    "verse_id_arabic": "\u0661\u0661:\u0666\u0661",
    "verse_number": 11,
    "verse_text_english": "Believe in GOD and His messenger and strive in the cause of GOD with your money and your lives. This is the best deal for you, if you only knew.",
    "verse_text_arabic": "\u062a\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u062a\u064f\u062c\u064e\u0670\u0647\u0650\u062f\u064f\u0648\u0646\u064e \u0641\u0650\u0649 \u0633\u064e\u0628\u0650\u064a\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0628\u0650\u0623\u064e\u0645\u0652\u0648\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u0652 \u0630\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u0652 \u062e\u064e\u064a\u0652\u0631\u064c \u0644\u0651\u064e\u0643\u064f\u0645\u0652 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u0652 \u062a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "tu'min\u016bna bil-lahi waras\u016blihi watuj\u0101hid\u016bna f\u012b sab\u012bli l-lahi bi-amw\u0101likum wa-anfusikum dh\u0101likum khayrun lakum in kuntum ta\u02bflam\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u062a\u0624\u0645\u0646\u0648\u0646 \u0628\u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u0648\u062a\u062c\u0647\u062f\u0648\u0646 \u0641\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0644\u0647 \u0628\u0623\u0645\u0648\u0644\u0643\u0645 \u0648\u0623\u0646\u0641\u0633\u0643\u0645 \u0630\u0644\u0643\u0645 \u062e\u064a\u0631 \u0644\u0643\u0645 \u0625\u0646 \u0643\u0646\u062a\u0645 \u062a\u0639\u0644\u0645\u0648\u0646",
