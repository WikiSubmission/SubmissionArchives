    "verse_number": 10,
    "verse_text_english": "O you who believe, let Me inform you of a trade that will save you from painful retribution.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0647\u064e\u0644\u0652 \u0623\u064e\u062f\u064f\u0644\u0651\u064f\u0643\u064f\u0645\u0652 \u0639\u064e\u0644\u064e\u0649\u0670 \u062a\u0650\u062c\u064e\u0670\u0631\u064e\u0629\u064d \u062a\u064f\u0646\u062c\u0650\u064a\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u064d",
