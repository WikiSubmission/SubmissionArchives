    "verse_text_arabic": "\u0648\u064e\u0623\u064f\u062e\u0652\u0631\u064e\u0649\u0670 \u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e\u0647\u064e\u0627 \u0646\u064e\u0635\u0652\u0631\u064c \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0641\u064e\u062a\u0652\u062d\u064c \u0642\u064e\u0631\u0650\u064a\u0628\u064c \u0648\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u0650 \u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e",
    "verse_text_transliterated": "wa-ukh'r\u0101 tu\u1e25ibb\u016bnah\u0101 na\u1e63run mina l-lahi wafat\u1e25un qar\u012bbun wabashiri l-mu'min\u012bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
