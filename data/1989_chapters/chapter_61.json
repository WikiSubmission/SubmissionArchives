    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0647\u0644 \u0623\u062f\u0644\u0643\u0645 \u0639\u0644\u0649 \u062a\u062c\u0631\u0629 \u062a\u0646\u062c\u064a\u0643\u0645 \u0645\u0646 \u0639\u0630\u0627\u0628 \u0623\u0644\u064a\u0645",
