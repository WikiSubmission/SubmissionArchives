  {
    "global_index": 5250,
    "verse_index": 5251,
    "chapter_number": 63,
    "verse_id": "63:4",
    "verse_id_arabic": "\u0664:\u0666\u0663",
    "verse_number": 4,
    "verse_text_english": "When you see them, you may be impressed by their looks. And when they speak, you may listen to their eloquence. They are like standing logs. They think that every call is intended against them. enemies; beware of them. GOD condemns them; they have deviated.",
    "verse_text_arabic": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u064a\u0652\u062a\u064e\u0647\u064f\u0645\u0652 \u062a\u064f\u0639\u0652\u062c\u0650\u0628\u064f\u0643\u064e \u0623\u064e\u062c\u0652\u0633\u064e\u0627\u0645\u064f\u0647\u064f\u0645\u0652 \u0648\u064e\u0625\u0650\u0646 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0627\u06df \u062a\u064e\u0633\u0652\u0645\u064e\u0639\u0652 \u0644\u0650\u0642\u064e\u0648\u0652\u0644\u0650\u0647\u0650\u0645\u0652 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u062e\u064f\u0634\u064f\u0628\u064c \u0645\u0651\u064f\u0633\u064e\u0646\u0651\u064e\u062f\u064e\u0629\u064c \u064a\u064e\u062d\u0652\u0633\u064e\u0628\u064f\u0648\u0646\u064e \u0643\u064f\u0644\u0651\u064e \u0635\u064e\u064a\u0652\u062d\u064e\u0629\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0647\u064f\u0645\u064f \u0671\u0644\u0652\u0639\u064e\u062f\u064f\u0648\u0651\u064f \u0641\u064e\u0671\u062d\u0652\u0630\u064e\u0631\u0652\u0647\u064f\u0645\u0652 \u0642\u064e\u0670\u062a\u064e\u0644\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u0646\u0651\u064e\u0649\u0670 \u064a\u064f\u0624\u0652\u0641\u064e\u0643\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "wa-idh\u0101 ra-aytahum tu\u02bf'jibuka ajs\u0101muhum wa-in yaq\u016bl\u016b tasma\u02bf liqawlihim ka-annahum khushubun musannadatun ya\u1e25sab\u016bna kulla \u1e63ay\u1e25atin \u02bfalayhim humu l-\u02bfaduwu fa-i\u1e25'dharhum q\u0101talahumu l-lahu ann\u0101 yu'fak\u016bn",
    "verse_subtitle_english": "A Chip On Their Shoulders",
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0625\u0630\u0627 \u0631\u0623\u064a\u062a\u0647\u0645 \u062a\u0639\u062c\u0628\u0643 \u0623\u062c\u0633\u0627\u0645\u0647\u0645 \u0648\u0625\u0646 \u064a\u0642\u0648\u0644\u0648\u0627 \u062a\u0633\u0645\u0639 \u0644\u0642\u0648\u0644\u0647\u0645 \u0643\u0623\u0646\u0647\u0645 \u062e\u0634\u0628 \u0645\u0633\u0646\u062f\u0629 \u064a\u062d\u0633\u0628\u0648\u0646 \u0643\u0644 \u0635\u064a\u062d\u0629 \u0639\u0644\u064a\u0647\u0645 \u0647\u0645 \u0627\u0644\u0639\u062f\u0648 \u0641\u0627\u062d\u0630\u0631\u0647\u0645 \u0642\u062a\u0644\u0647\u0645 \u0627\u0644\u0644\u0647 \u0623\u0646\u0649 \u064a\u0624\u0641\u0643\u0648\u0646",
    "chapter_title_english": "The Hypocrites",
