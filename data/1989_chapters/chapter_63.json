    "verse_number": 3,
    "verse_text_english": "This is because they believed then disbelieved. blocked; they do not understand.",
    "verse_text_arabic": "\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0628\u0650\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u06df \u0641\u064e\u0637\u064f\u0628\u0650\u0639\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645\u0652 \u0641\u064e\u0647\u064f\u0645\u0652 \u0644\u064e\u0627 \u064a\u064e\u0641\u0652\u0642\u064e\u0647\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "dh\u0101lika bi-annahum \u0101man\u016b thumma kafar\u016b fa\u1e6dubi\u02bfa \u02bfal\u0101 qul\u016bbihim fahum l\u0101 yafqah\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0630\u0644\u0643 \u0628\u0623\u0646\u0647\u0645 \u0621\u0627\u0645\u0646\u0648\u0627 \u062b\u0645 \u0643\u0641\u0631\u0648\u0627 \u0641\u0637\u0628\u0639 \u0639\u0644\u0649 \u0642\u0644\u0648\u0628\u0647\u0645 \u0641\u0647\u0645 \u0644\u0627 \u064a\u0641\u0642\u0647\u0648\u0646",
