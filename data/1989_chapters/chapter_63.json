    "chapter_number": 63,
    "verse_id": "63:11",
    "verse_id_arabic": "\u0661\u0661:\u0666\u0663",
    "verse_number": 11,
    "verse_text_english": "GOD never delays the appointed time of death for any soul. GOD is fully Cognizant of everything you do.",
    "verse_text_arabic": "\u0648\u064e\u0644\u064e\u0646 \u064a\u064f\u0624\u064e\u062e\u0651\u0650\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0646\u064e\u0641\u0652\u0633\u064b\u0627 \u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e \u0623\u064e\u062c\u064e\u0644\u064f\u0647\u064e\u0627 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u062e\u064e\u0628\u0650\u064a\u0631\u064c\u06e2 \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "walan yu-akhira l-lahu nafsan idh\u0101 j\u0101a ajaluh\u0101 wal-lahu khab\u012brun bim\u0101 ta\u02bfmal\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0644\u0646 \u064a\u0624\u062e\u0631 \u0627\u0644\u0644\u0647 \u0646\u0641\u0633\u0627 \u0625\u0630\u0627 \u062c\u0627\u0621 \u0623\u062c\u0644\u0647\u0627 \u0648\u0627\u0644\u0644\u0647 \u062e\u0628\u064a\u0631 \u0628\u0645\u0627 \u062a\u0639\u0645\u0644\u0648\u0646",
