  {
    "global_index": 5256,
    "verse_index": 5257,
    "chapter_number": 63,
    "verse_id": "63:10",
    "verse_id_arabic": "\u0661\u0660:\u0666\u0663",
    "verse_number": 10,
    "verse_text_english": "You shall give from our provisions to you before death comes to you, then you say, \u201cMy Lord, if only You could delay this for a short while! and join the righteous!\u201d",
    "verse_text_arabic": "\u0648\u064e\u0623\u064e\u0646\u0641\u0650\u0642\u064f\u0648\u0627\u06df \u0645\u0650\u0646 \u0645\u0651\u064e\u0627 \u0631\u064e\u0632\u064e\u0642\u0652\u0646\u064e\u0670\u0643\u064f\u0645 \u0645\u0651\u0650\u0646 \u0642\u064e\u0628\u0652\u0644\u0650 \u0623\u064e\u0646 \u064a\u064e\u0623\u0652\u062a\u0650\u0649\u064e \u0623\u064e\u062d\u064e\u062f\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u0652\u0645\u064e\u0648\u0652\u062a\u064f \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0631\u064e\u0628\u0651\u0650 \u0644\u064e\u0648\u0652\u0644\u064e\u0627\u0653 \u0623\u064e\u062e\u0651\u064e\u0631\u0652\u062a\u064e\u0646\u0650\u0649\u0653 \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u062c\u064e\u0644\u064d \u0642\u064e\u0631\u0650\u064a\u0628\u064d \u0641\u064e\u0623\u064e\u0635\u0651\u064e\u062f\u0651\u064e\u0642\u064e \u0648\u064e\u0623\u064e\u0643\u064f\u0646 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u0650\u064a\u0646\u064e",
    "verse_text_transliterated": "wa-anfiq\u016b min m\u0101 razaqn\u0101kum min qabli an yatiya a\u1e25adakumu l-mawtu fayaq\u016bla rabbi lawl\u0101 akhartan\u012b il\u0101 ajalin qar\u012bbin fa-a\u1e63\u1e63addaqa wa-akun mina l-\u1e63\u0101li\u1e25\u012bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0623\u0646\u0641\u0642\u0648\u0627 \u0645\u0646 \u0645\u0627 \u0631\u0632\u0642\u0646\u0643\u0645 \u0645\u0646 \u0642\u0628\u0644 \u0623\u0646 \u064a\u0623\u062a\u0649 \u0623\u062d\u062f\u0643\u0645 \u0627\u0644\u0645\u0648\u062a \u0641\u064a\u0642\u0648\u0644 \u0631\u0628 \u0644\u0648\u0644\u0627 \u0623\u062e\u0631\u062a\u0646\u0649 \u0625\u0644\u0649 \u0623\u062c\u0644 \u0642\u0631\u064a\u0628 \u0641\u0623\u0635\u062f\u0642 \u0648\u0623\u0643\u0646 \u0645\u0646 \u0627\u0644\u0635\u0644\u062d\u064a\u0646",
    "chapter_title_english": "The Hypocrites",
