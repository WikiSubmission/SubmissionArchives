  },
  {
    "global_index": 5255,
    "verse_index": 5256,
    "chapter_number": 63,
    "verse_id": "63:9",
    "verse_id_arabic": "\u0669:\u0666\u0663",
    "verse_number": 9,
    "verse_text_english": "O you who believe, do not be distracted by your money and your children from remembering GOD. the losers.",
    "verse_text_arabic": "\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0644\u064e\u0627 \u062a\u064f\u0644\u0652\u0647\u0650\u0643\u064f\u0645\u0652 \u0623\u064e\u0645\u0652\u0648\u064e\u0670\u0644\u064f\u0643\u064f\u0645\u0652 \u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064e\u0648\u0652\u0644\u064e\u0670\u062f\u064f\u0643\u064f\u0645\u0652 \u0639\u064e\u0646 \u0630\u0650\u0643\u0652\u0631\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0645\u064e\u0646 \u064a\u064e\u0641\u0652\u0639\u064e\u0644\u0652 \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0641\u064e\u0623\u064f\u0648\u06df\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u0652\u062e\u064e\u0670\u0633\u0650\u0631\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "y\u0101ayyuh\u0101 alladh\u012bna \u0101man\u016b l\u0101 tul'hikum amw\u0101lukum wal\u0101 awl\u0101dukum \u02bfan dhik'ri l-lahi waman yaf\u02bfal dh\u0101lika fa-ul\u0101ika humu l-kh\u0101sir\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0621\u0627\u0645\u0646\u0648\u0627 \u0644\u0627 \u062a\u0644\u0647\u0643\u0645 \u0623\u0645\u0648\u0644\u0643\u0645 \u0648\u0644\u0627 \u0623\u0648\u0644\u062f\u0643\u0645 \u0639\u0646 \u0630\u0643\u0631 \u0627\u0644\u0644\u0647 \u0648\u0645\u0646 \u064a\u0641\u0639\u0644 \u0630\u0644\u0643 \u0641\u0623\u0648\u0644\u0626\u0643 \u0647\u0645 \u0627\u0644\u062e\u0633\u0631\u0648\u0646",
    "chapter_title_english": "The Hypocrites",
    "chapter_title_arabic": "\u0627\u0644\u0645\u0646\u0627\u0641\u0642\u0648\u0646",
    "chapter_title_transliterated": "Al-Munaafeqoon",
