  {
    "global_index": 5253,
    "verse_index": 5254,
    "chapter_number": 63,
    "verse_id": "63:7",
    "verse_id_arabic": "\u0667:\u0666\u0663",
    "verse_number": 7,
    "verse_text_english": "They are the ones who say, \u201cDo not give any money to those who followed the messenger of the treasures of the heavens and the earth, but the hypocrites do not comprehend.",
    "verse_text_arabic": "\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0644\u064e\u0627 \u062a\u064f\u0646\u0641\u0650\u0642\u064f\u0648\u0627\u06df \u0639\u064e\u0644\u064e\u0649\u0670 \u0645\u064e\u0646\u0652 \u0639\u0650\u0646\u062f\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064e\u0646\u0641\u064e\u0636\u0651\u064f\u0648\u0627\u06df \u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u062e\u064e\u0632\u064e\u0627\u0653\u0626\u0650\u0646\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646\u0651\u064e \u0671\u0644\u0652\u0645\u064f\u0646\u064e\u0670\u0641\u0650\u0642\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064e\u0641\u0652\u0642\u064e\u0647\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "humu alladh\u012bna yaq\u016bl\u016bna l\u0101 tunfiq\u016b \u02bfal\u0101 man \u02bfinda ras\u016bli l-lahi \u1e25att\u0101 yanfa\u1e0d\u1e0d\u016b walillahi khaz\u0101inu l-sam\u0101w\u0101ti wal-ar\u1e0di wal\u0101kinna l-mun\u0101fiq\u012bna l\u0101 yafqah\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0647\u0645 \u0627\u0644\u0630\u064a\u0646 \u064a\u0642\u0648\u0644\u0648\u0646 \u0644\u0627 \u062a\u0646\u0641\u0642\u0648\u0627 \u0639\u0644\u0649 \u0645\u0646 \u0639\u0646\u062f \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u062d\u062a\u0649 \u064a\u0646\u0641\u0636\u0648\u0627 \u0648\u0644\u0644\u0647 \u062e\u0632\u0627\u0626\u0646 \u0627\u0644\u0633\u0645\u0648\u062a \u0648\u0627\u0644\u0623\u0631\u0636 \u0648\u0644\u0643\u0646 \u0627\u0644\u0645\u0646\u0641\u0642\u064a\u0646 \u0644\u0627 \u064a\u0641\u0642\u0647\u0648\u0646",
    "chapter_title_english": "The Hypocrites",
    "chapter_title_arabic": "\u0627\u0644\u0645\u0646\u0627\u0641\u0642\u0648\u0646",
    "chapter_title_transliterated": "Al-Munaafeqoon",
    "chapter_revelation_order": 104,
