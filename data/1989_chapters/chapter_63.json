  },
  {
    "global_index": 5254,
    "verse_index": 5255,
    "chapter_number": 63,
    "verse_id": "63:8",
    "verse_id_arabic": "\u0668:\u0666\u0663",
    "verse_number": 8,
    "verse_text_english": "They say, \u201cIf we go back to the city, the powerful therein will evict the weak (and we will be victimized).\u201d (They should know that) all dignity belongs to GOD and His messenger, and the believers. hypocrites do not know.",
    "verse_text_arabic": "\u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0644\u064e\u0626\u0650\u0646 \u0631\u0651\u064e\u062c\u064e\u0639\u0652\u0646\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0652\u0645\u064e\u062f\u0650\u064a\u0646\u064e\u0629\u0650 \u0644\u064e\u064a\u064f\u062e\u0652\u0631\u0650\u062c\u064e\u0646\u0651\u064e \u0671\u0644\u0652\u0623\u064e\u0639\u064e\u0632\u0651\u064f \u0645\u0650\u0646\u0652\u0647\u064e\u0627 \u0671\u0644\u0652\u0623\u064e\u0630\u064e\u0644\u0651\u064e \u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0652\u0639\u0650\u0632\u0651\u064e\u0629\u064f \u0648\u064e\u0644\u0650\u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0644\u0650\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646\u0651\u064e \u0671\u0644\u0652\u0645\u064f\u0646\u064e\u0670\u0641\u0650\u0642\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "yaq\u016bl\u016bna la-in raja\u02bfn\u0101 il\u0101 l-mad\u012bnati layukh'rijanna l-a\u02bfazu min'h\u0101 l-adhala walillahi l-\u02bfizatu waliras\u016blihi walil'mu'min\u012bna wal\u0101kinna l-mun\u0101fiq\u012bna l\u0101 ya\u02bflam\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u064a\u0642\u0648\u0644\u0648\u0646 \u0644\u0626\u0646 \u0631\u062c\u0639\u0646\u0627 \u0625\u0644\u0649 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0644\u064a\u062e\u0631\u062c\u0646 \u0627\u0644\u0623\u0639\u0632 \u0645\u0646\u0647\u0627 \u0627\u0644\u0623\u0630\u0644 \u0648\u0644\u0644\u0647 \u0627\u0644\u0639\u0632\u0629 \u0648\u0644\u0631\u0633\u0648\u0644\u0647 \u0648\u0644\u0644\u0645\u0624\u0645\u0646\u064a\u0646 \u0648\u0644\u0643\u0646 \u0627\u0644\u0645\u0646\u0641\u0642\u064a\u0646 \u0644\u0627 \u064a\u0639\u0644\u0645\u0648\u0646",
    "chapter_title_english": "The Hypocrites",
