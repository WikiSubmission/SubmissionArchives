  {
    "global_index": 5251,
    "verse_index": 5252,
    "chapter_number": 63,
    "verse_id": "63:5",
    "verse_id_arabic": "\u0665:\u0666\u0663",
    "verse_number": 5,
    "verse_text_english": "When they are told, \u201cCome let the messenger of GOD pray for your forgiveness,\u201d they mockingly turn their heads, and you see them repel others and act arrogantly. 555",
    "verse_text_arabic": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u0652 \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u0648\u0652\u0627\u06df \u064a\u064e\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u064e\u0643\u064f\u0645\u0652 \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0644\u064e\u0648\u0651\u064e\u0648\u0652\u0627\u06df \u0631\u064f\u0621\u064f\u0648\u0633\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u0631\u064e\u0623\u064e\u064a\u0652\u062a\u064e\u0647\u064f\u0645\u0652 \u064a\u064e\u0635\u064f\u062f\u0651\u064f\u0648\u0646\u064e \u0648\u064e\u0647\u064f\u0645 \u0645\u0651\u064f\u0633\u0652\u062a\u064e\u0643\u0652\u0628\u0650\u0631\u064f\u0648\u0646\u064e",
    "verse_text_transliterated": "wa-idh\u0101 q\u012bla lahum ta\u02bf\u0101law yastaghfir lakum ras\u016blu l-lahi lawwaw ru\u016bsahum wara-aytahum ya\u1e63udd\u016bna wahum mus'takbir\u016bn",
    "verse_subtitle_english": null,
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0648\u0625\u0630\u0627 \u0642\u064a\u0644 \u0644\u0647\u0645 \u062a\u0639\u0627\u0644\u0648\u0627 \u064a\u0633\u062a\u063a\u0641\u0631 \u0644\u0643\u0645 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0644\u0648\u0648\u0627 \u0631\u0621\u0648\u0633\u0647\u0645 \u0648\u0631\u0623\u064a\u062a\u0647\u0645 \u064a\u0635\u062f\u0648\u0646 \u0648\u0647\u0645 \u0645\u0633\u062a\u0643\u0628\u0631\u0648\u0646",
    "chapter_title_english": "The Hypocrites",
    "chapter_title_arabic": "\u0627\u0644\u0645\u0646\u0627\u0641\u0642\u0648\u0646",
    "chapter_title_transliterated": "Al-Munaafeqoon",
    "chapter_revelation_order": 104,
