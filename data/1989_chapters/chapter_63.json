  },
  {
    "global_index": 5252,
    "verse_index": 5253,
    "chapter_number": 63,
    "verse_id": "63:6",
    "verse_id_arabic": "\u0666:\u0666\u0663",
    "verse_number": 6,
    "verse_text_english": "It is the same for them, whether you pray for their forgiveness, or not pray for their forgiveness; GOD will not forgive them. For GOD does not guide the wicked people.",
    "verse_text_arabic": "\u0633\u064e\u0648\u064e\u0627\u0653\u0621\u064c \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0623\u064e\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u064e\u0631\u0652\u062a\u064e \u0644\u064e\u0647\u064f\u0645\u0652 \u0623\u064e\u0645\u0652 \u0644\u064e\u0645\u0652 \u062a\u064e\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u064e\u0647\u064f\u0645\u0652 \u0644\u064e\u0646 \u064a\u064e\u063a\u0652\u0641\u0650\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0647\u064f\u0645\u0652 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0644\u064e\u0627 \u064a\u064e\u0647\u0652\u062f\u0650\u0649 \u0671\u0644\u0652\u0642\u064e\u0648\u0652\u0645\u064e \u0671\u0644\u0652\u0641\u064e\u0670\u0633\u0650\u0642\u0650\u064a\u0646\u064e",
    "verse_text_transliterated": "saw\u0101on \u02bfalayhim astaghfarta lahum am lam tastaghfir lahum lan yaghfira l-lahu lahum inna l-laha l\u0101 yahd\u012b l-qawma l-f\u0101siq\u012bn",
    "verse_subtitle_english": "The Myth of Intercession Shattered*",
    "verse_footnote_english": "",
    "verse_text_arabic_clean": "\u0633\u0648\u0627\u0621 \u0639\u0644\u064a\u0647\u0645 \u0623\u0633\u062a\u063a\u0641\u0631\u062a \u0644\u0647\u0645 \u0623\u0645 \u0644\u0645 \u062a\u0633\u062a\u063a\u0641\u0631 \u0644\u0647\u0645 \u0644\u0646 \u064a\u063a\u0641\u0631 \u0627\u0644\u0644\u0647 \u0644\u0647\u0645 \u0625\u0646 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0647\u062f\u0649 \u0627\u0644\u0642\u0648\u0645 \u0627\u0644\u0641\u0633\u0642\u064a\u0646",
