{
  "name": "submission-archives",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run prepare:standalone && node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\" \"tests/integration/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify:catalog": "node scripts/validate/verify_catalog_reproducibility.mjs",
    "verify:deploy": "npm ci --dry-run && npm run lint && npm run typecheck && npm test && npm run verify:catalog && npm run verify:studio-media && npm run validate:catalog-schemas && npm run validate:speakers && npm run enrich:audio-catalog && npm run validate:book-previews && npm run verify:thumbnails && npm audit --omit=dev --audit-level=high && npm run build",
    "analyze": "next experimental-analyze --output",
    "generate:catalog": "node scripts/generate/generate_catalog_search_indices.mjs",
    "generate:catalog-incremental": "node scripts/generate/generate_catalog_search_indices.mjs --incremental",
    "validate:catalog": "node scripts/validate/validate_catalog.mjs",
    "validate:speakers": "node scripts/validate/validate_speaker_prefixes.mjs",
    "generate:audio-descriptions": "node scripts/generate/generate_audio_descriptions.mjs",
    "enrich:audio-catalog": "node scripts/generate/enrich_audio_catalog.mjs",
    "generate:book-previews": "node scripts/generate/generate_book_previews.mjs",
    "validate:book-previews": "node scripts/validate/validate_book_previews.mjs",
    "validate:catalog-schemas": "node --import tsx scripts/validate/validate_catalog_schemas.ts",
    "generate:book-thumbnails": "node scripts/generate/generate_book_thumbnails.mjs",
    "generate:newsletter-thumbnails": "node scripts/generate/generate_newsletter_thumbnails.mjs",
    "generate:apocrypha": "node scripts/generate/build-apocrypha-index.mjs",
    "generate:pdf-assets": "node scripts/generate/copy_pdf_assets.mjs",
    "generate:video-chunks": "node scripts/generate/build_video_transcript_chunks.mjs",
    "enrich:media-years": "node scripts/generate/enrich_media_years.mjs",
    "verify:thumbnails": "node scripts/generate/generate_book_thumbnails.mjs --check",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "audit:assets": "node scripts/assets/audit-assets.mjs",
    "ocr:books": "node scripts/generate/ocr_books_gemini.mjs",
    "ocr:monitor": "node scripts/generate/monitor_ocr.mjs",
    "generate:bible": "node scripts/generate/build-bible-index.mjs",
    "generate:sp-segments": "node scripts/generate/build_sp_web_segments.mjs",
    "prepare": "husky",
    "generate:studio-media": "node scripts/generate/build_studio_media_index.mjs",
    "verify:studio-media": "node scripts/generate/build_studio_media_index.mjs --check"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "lru-cache": "^11.5.1",
    "lucide-react": "^0.561.0",
    "motion": "^13.1.0",
    "next": "^16.2.6",
    "pino": "^10.3.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-pdf": "^10.4.1",
    "react-player": "^2.16.0",
    "react-use-measure": "^2.1.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "pdf-parse": "1.1.4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.3",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
