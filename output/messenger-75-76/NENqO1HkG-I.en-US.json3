  }, {
    "tStartMs": 844468,
    "dDurationMs": 1532,
    "segs": [ {
      "utf8": "Dr. Khalifa: We have to know who the father is."
    } ]
  }, {
    "tStartMs": 846912,
    "dDurationMs": 2088,
    "segs": [ {
      "utf8": "A man: I thought it was about the mourning."
    } ]
  }, {
    "tStartMs": 850557,
    "dDurationMs": 1554,
    "segs": [ {
