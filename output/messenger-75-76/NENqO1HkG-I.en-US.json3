    "dDurationMs": 1685,
    "segs": [ {
      "utf8": "they're only deceiving themselves."
    } ]
  }, {
    "tStartMs": 890311,
    "dDurationMs": 6603,
    "segs": [ {
      "utf8": "Because you must follow God's commandments out of conviction, not try to get around it."
    } ]
  }, {
