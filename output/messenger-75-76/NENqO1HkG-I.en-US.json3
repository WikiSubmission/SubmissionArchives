    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "she should give up her feelings"
    } ]
  }, {
    "tStartMs": 185311,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "and force herself to reconcile for the sake of the baby."
    } ]
  }, {
    "tStartMs": 190734,
    "dDurationMs": 2311,
    "segs": [ {
      "utf8": "And God will make it up to her. And that's it."
