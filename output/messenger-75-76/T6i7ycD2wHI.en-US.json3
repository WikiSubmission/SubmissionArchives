    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "and believes in the Day of Judgment,"
    } ]
  }, {
    "tStartMs": 2734880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "accountability, resurrection,"
    } ]
  }, {
    "tStartMs": 2736880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and leads a righteous life,"
    } ]
  }, {
