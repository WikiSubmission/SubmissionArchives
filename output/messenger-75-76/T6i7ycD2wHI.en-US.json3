  }, {
    "tStartMs": 2647100,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "This is a very important doctrine in Islam."
    } ]
  }, {
    "tStartMs": 2651373,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Because people will come to you and ask,"
    } ]
  }, {
    "tStartMs": 2652840,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "\"Can a Christian make it to Heaven?\""
    } ]
  }, {
    "tStartMs": 2656220,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "\"Can a Jew make it to Heaven?\""
    } ]
  }, {
    "tStartMs": 2658720,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "Can a person who converted from Christianity to Judaism, Judaism to Islam, or Islam to Christianity,"
    } ]
  }, {
    "tStartMs": 2665260,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "Dr. Khalifa: can this person make it to Heaven?"
    } ]
  }, {
    "tStartMs": 2668708,
    "dDurationMs": 848,
    "segs": [ {
      "utf8": "A man: 62."
    } ]
  }, {
    "tStartMs": 2669556,
    "dDurationMs": 989,
    "segs": [ {
      "utf8": "Dr. Khalifa: Very good question."
    } ]
  }, {
    "tStartMs": 2671107,
    "dDurationMs": 2332,
    "segs": [ {
      "utf8": "Are the Muslims the only people who will make it to Heaven?"
    } ]
  }, {
    "tStartMs": 2675156,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "So, the answer is in this verse."
    } ]
  }, {
    "tStartMs": 2678269,
    "dDurationMs": 18727,
    "segs": [ {
      "utf8": "[2:62] ... those who believe, those who are Jewish, the Christians, and the converts; any of them who (1) believes in GOD, and (2) the Last Day, and (3) leads a righteous life, shall receive their recompense from their Lord. They have nothing to fear, nor will they grieve."
    } ]
  }, {
    "tStartMs": 2697840,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "So, I hope you added this part that dropped in the translation."
    } ]
  }, {
    "tStartMs": 2701100,
    "dDurationMs": 6135,
    "segs": [ {
      "utf8": "[2:62] ... shall receive their recompense from their Lord. And they have nothing to fear, nor will they grieve."
    } ]
  }, {
    "tStartMs": 2708520,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "If you join any other religion,"
    } ]
  }, {
    "tStartMs": 2711586,
    "dDurationMs": 1744,
    "segs": [ {
      "utf8": "in the past or in the future,"
    } ]
  }, {
    "tStartMs": 2713330,
    "dDurationMs": 3152,
    "segs": [ {
      "utf8": "and they tell you this, these are the only people who will go to Heaven,"
    } ]
  }, {
    "tStartMs": 2716482,
    "dDurationMs": 1398,
    "segs": [ {
      "utf8": "you take off."
    } ]
  }, {
    "tStartMs": 2719636,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "Just flee. Because they are wrong."
    } ]
  }, {
    "tStartMs": 2723380,
    "dDurationMs": 5199,
    "segs": [ {
      "utf8": "What this verse is telling us, that anybody who believes in God,"
    } ]
  }, {
    "tStartMs": 2728579,
    "dDurationMs": 4007,
    "segs": [ {
      "utf8": "the Creator of this universe, the Ruler of this universe,"
    } ]
  }, {
