          "start": 594.12,
          "end": 594.28,
          "speaker": "Catherine"
        },
        {
          "word": " that.",
          "start": 594.28,
          "end": 594.52,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "And yet, He sends messengers, consistently sends messengers, spends 1,400 years purifying His final message.",
      "start": 595.92,
      "end": 605.32,
      "speaker": "Catherine",
      "words": [
        {
          "word": " And",
          "start": 595.92,
          "end": 595.92,
          "speaker": "Catherine"
        },
        {
          "word": " yet,",
          "start": 595.92,
          "end": 596.32,
          "speaker": "Catherine"
        },
        {
          "word": " He",
          "start": 596.96,
          "end": 596.96,
          "speaker": "Catherine"
        },
        {
          "word": " sends",
          "start": 597.1,
          "end": 597.2,
          "speaker": "Catherine"
        },
        {
          "word": " messengers,",
          "start": 597.2,
