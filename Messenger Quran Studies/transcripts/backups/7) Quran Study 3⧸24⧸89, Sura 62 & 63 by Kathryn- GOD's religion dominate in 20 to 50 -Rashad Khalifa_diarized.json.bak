        },
        {
          "word": " that",
          "start": 775.4,
          "end": 775.64,
          "speaker": "Catherine"
        },
        {
          "word": " verse,",
          "start": 775.64,
          "end": 776.24,
          "speaker": "Catherine"
        },
        {
          "word": " which",
          "start": 776.66,
          "end": 776.68,
