        },
        {
          "word": " is",
          "start": 3522.4,
          "end": 3522.78,
          "speaker": "Catherine"
        },
        {
          "word": " some",
          "start": 3522.78,
          "end": 3523.4,
          "speaker": "Catherine"
        },
        {
          "word": " truth,",
          "start": 3523.4,
          "end": 3523.84,
          "speaker": "Catherine"
        },
        {
