          "start": 575.48,
          "end": 575.58,
          "speaker": "Catherine"
        },
        {
          "word": " around.",
          "start": 575.58,
          "end": 575.68,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "We just totally blew it. We missed.",
      "start": 577.08,
      "end": 579.0,
      "speaker": "Catherine",
      "words": [
        {
          "word": " We",
          "start": 577.08,
          "end": 577.18,
          "speaker": "Catherine"
        },
        {
          "word": " just",
          "start": 577.18,
          "end": 577.38,
          "speaker": "Catherine"
        },
        {
          "word": " totally",
          "start": 577.38,
          "end": 577.94,
          "speaker": "Catherine"
        },
        {
          "word": " blew",
          "start": 577.94,
          "end": 578.2,
          "speaker": "Catherine"
        },
        {
          "word": " it.",
          "start": 578.2,
          "end": 578.46,
          "speaker": "Catherine"
        },
        {
          "word": " We",
