        },
        {
          "word": " articulate",
          "start": 3543.38,
          "end": 3543.66,
          "speaker": "Catherine"
        },
        {
          "word": " as",
          "start": 3543.7,
          "end": 3544.02,
          "speaker": "Catherine"
        },
        {
          "word": " they",
          "start": 3544.02,
          "end": 3544.14,
          "speaker": "Catherine"
        },
        {
          "word": " are",
          "start": 3544.14,
          "end": 3544.28,
          "speaker": "Catherine"
        },
        {
          "word": " for",
          "start": 3544.28,
          "end": 3544.46,
          "speaker": "Catherine"
        },
        {
          "word": " instance.",
          "start": 3544.46,
          "end": 3544.81,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "Some people are very articulate, very well versed with the words and very good abstract thinkers if I can use that phrase. And I'm not.",
      "start": 3544.92,
      "end": 3552.32,
      "speaker": "Catherine",
      "words": [
