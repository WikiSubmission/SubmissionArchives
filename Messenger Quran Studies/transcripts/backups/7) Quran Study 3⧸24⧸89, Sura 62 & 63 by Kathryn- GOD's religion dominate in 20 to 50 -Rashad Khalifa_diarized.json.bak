          "speaker": "Catherine"
        },
        {
          "word": " they're",
          "start": 3536.4,
          "end": 3536.76,
          "speaker": "Catherine"
        },
        {
          "word": " so",
          "start": 3536.76,
          "end": 3537.02,
          "speaker": "Catherine"
        },
        {
          "word": " well",
          "start": 3537.02,
          "end": 3537.32,
          "speaker": "Catherine"
        },
        {
