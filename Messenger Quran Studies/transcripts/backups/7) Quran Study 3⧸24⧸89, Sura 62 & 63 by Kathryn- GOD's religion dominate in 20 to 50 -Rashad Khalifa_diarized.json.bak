          "speaker": "Catherine"
        },
        {
          "word": " consistently",
          "start": 598.82,
          "end": 598.82,
          "speaker": "Catherine"
        },
        {
          "word": " sends",
          "start": 598.82,
          "end": 599.32,
          "speaker": "Catherine"
        },
        {
          "word": " messengers,",
          "start": 599.32,
          "end": 600.44,
          "speaker": "Catherine"
        },
        {
          "word": " spends",
          "start": 601.26,
          "end": 601.42,
          "speaker": "Catherine"
        },
        {
          "word": " 1,400",
          "start": 601.42,
          "end": 602.38,
