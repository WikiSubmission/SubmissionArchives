          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "It comes from God. It's not ours to start with. And if we give it in charity, we give it only where it was meant to go.",
      "start": 4137.76,
      "end": 4143.22,
      "speaker": "Catherine",
      "words": [
        {
          "word": " It",
          "start": 4137.76,
          "end": 4137.76,
          "speaker": "Catherine"
