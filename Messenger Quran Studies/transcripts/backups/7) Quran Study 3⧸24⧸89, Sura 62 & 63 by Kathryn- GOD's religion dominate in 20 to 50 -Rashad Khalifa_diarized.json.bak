          "speaker": "Catherine"
        },
        {
          "word": " not.",
          "start": 3552.06,
          "end": 3552.32,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I just know what the truth is, thank God.",
      "start": 3553.1,
      "end": 3555.28,
      "speaker": "Catherine",
      "words": [
        {
          "word": " I",
          "start": 3553.1,
          "end": 3553.1,
          "speaker": "Catherine"
        },
        {
          "word": " just",
          "start": 3553.1,
          "end": 3553.24,
          "speaker": "Catherine"
        },
        {
          "word": " know",
          "start": 3553.36,
          "end": 3553.46,
          "speaker": "Catherine"
        },
        {
          "word": " what",
          "start": 3553.46,
          "end": 3553.62,
          "speaker": "Catherine"
        },
        {
          "word": " the",
          "start": 3553.62,
          "end": 3553.76,
          "speaker": "Catherine"
        },
        {
          "word": " truth",
          "start": 3553.76,
          "end": 3553.96,
          "speaker": "Catherine"
        },
        {
          "word": " is,",
          "start": 3553.96,
          "end": 3554.31,
          "speaker": "Catherine"
        },
        {
          "word": " thank",
          "start": 3554.4,
          "end": 3554.48,
          "speaker": "Catherine"
        },
        {
          "word": " God.",
          "start": 3554.48,
          "end": 3555.28,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "And when it starts, it's so complicated that it's hard to find it in, in what I'm hearing,",
      "start": 3555.28,
      "end": 3560.17,
      "speaker": "Catherine",
      "words": [
        {
          "word": " And",
          "start": 3555.28,
          "end": 3555.42,
          "speaker": "Catherine"
        },
        {
          "word": " when",
          "start": 3555.54,
          "end": 3555.64,
          "speaker": "Catherine"
        },
        {
          "word": " it",
          "start": 3555.64,
          "end": 3555.8,
          "speaker": "Catherine"
        },
        {
          "word": " starts,",
          "start": 3555.8,
          "end": 3556.04,
          "speaker": "Catherine"
        },
        {
          "word": " it's",
          "start": 3556.2,
          "end": 3556.34,
          "speaker": "Catherine"
        },
        {
          "word": " so",
          "start": 3556.34,
          "end": 3556.48,
          "speaker": "Catherine"
        },
        {
          "word": " complicated",
          "start": 3556.5,
          "end": 3556.98,
          "speaker": "Catherine"
        },
        {
          "word": " that",
          "start": 3556.98,
          "end": 3557.26,
          "speaker": "Catherine"
        },
        {
          "word": " it's",
          "start": 3557.26,
          "end": 3557.52,
          "speaker": "Catherine"
        },
        {
          "word": " hard",
          "start": 3557.72,
          "end": 3557.82,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 3557.82,
          "end": 3557.98,
          "speaker": "Catherine"
        },
        {
          "word": " find",
          "start": 3558.1,
          "end": 3558.3,
          "speaker": "Catherine"
        },
        {
          "word": " it",
          "start": 3558.3,
          "end": 3558.56,
          "speaker": "Catherine"
        },
        {
          "word": " in,",
          "start": 3558.56,
          "end": 3558.66,
          "speaker": "Catherine"
        },
        {
          "word": " in",
          "start": 3559.16,
          "end": 3559.24,
          "speaker": "Catherine"
        },
        {
          "word": " what",
          "start": 3559.3,
          "end": 3559.4,
          "speaker": "Catherine"
        },
        {
          "word": " I'm",
          "start": 3559.4,
          "end": 3559.62,
          "speaker": "Catherine"
        },
        {
          "word": " hearing,",
          "start": 3559.62,
          "end": 3560.17,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I have to stop that and I have to say \"no.\" There is a bottom line here.",
      "start": 3560.56,
      "end": 3563.98,
      "speaker": "Catherine",
      "words": [
        {
          "word": " I",
          "start": 3560.56,
          "end": 3560.62,
          "speaker": "Catherine"
        },
        {
          "word": " have",
          "start": 3560.68,
          "end": 3560.8,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 3560.8,
          "end": 3560.98,
          "speaker": "Catherine"
        },
        {
          "word": " stop",
          "start": 3561.12,
          "end": 3561.24,
          "speaker": "Catherine"
        },
        {
          "word": " that",
          "start": 3561.24,
          "end": 3561.56,
          "speaker": "Catherine"
        },
        {
          "word": " and",
          "start": 3561.56,
          "end": 3561.9,
          "speaker": "Catherine"
        },
        {
          "word": " I",
          "start": 3561.9,
          "end": 3562.02,
          "speaker": "Catherine"
        },
        {
          "word": " have",
          "start": 3562.02,
          "end": 3562.14,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 3562.14,
          "end": 3562.32,
          "speaker": "Catherine"
        },
        {
          "word": " say",
          "start": 3562.32,
          "end": 3562.5,
          "speaker": "Catherine"
        },
        {
          "word": " \"no.\"",
          "start": 3562.5,
          "end": 3562.86,
          "speaker": "Catherine"
        },
        {
          "word": " There",
          "start": 3562.86,
          "end": 3562.96,
          "speaker": "Catherine"
        },
        {
          "word": " is",
          "start": 3562.96,
          "end": 3563.12,
          "speaker": "Catherine"
        },
        {
          "word": " a",
          "start": 3563.12,
          "end": 3563.22,
          "speaker": "Catherine"
        },
        {
          "word": " bottom",
          "start": 3563.24,
          "end": 3563.42,
          "speaker": "Catherine"
        },
        {
          "word": " line",
          "start": 3563.42,
          "end": 3563.78,
          "speaker": "Catherine"
        },
        {
          "word": " here.",
          "start": 3563.78,
          "end": 3563.98,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "God says, even if there's truth in what we hear mixed in with the distortion, we're to discard all of it because it is a game",
      "start": 3565.48,
      "end": 3573.38,
      "speaker": "Catherine",
      "words": [
        {
          "word": " God",
          "start": 3565.48,
          "end": 3565.6,
          "speaker": "Catherine"
        },
        {
          "word": " says,",
          "start": 3565.6,
          "end": 3566.18,
          "speaker": "Catherine"
        },
        {
          "word": " even",
          "start": 3566.58,
          "end": 3566.6,
          "speaker": "Catherine"
        },
        {
          "word": " if",
          "start": 3566.6,
          "end": 3566.76,
          "speaker": "Catherine"
        },
        {
          "word": " there's",
          "start": 3566.76,
          "end": 3567.02,
          "speaker": "Catherine"
        },
        {
          "word": " truth",
          "start": 3567.02,
          "end": 3567.34,
          "speaker": "Catherine"
        },
        {
          "word": " in",
          "start": 3567.34,
          "end": 3567.76,
