          "end": 1113.8,
          "speaker": "Catherine"
        },
        {
          "word": " once.",
          "start": 1113.8,
          "end": 1114.35,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "\"What happened?\" \"He did this to me.\" \"No, he did that to me.\"",
      "start": 1114.42,
      "end": 1116.62,
      "speaker": "Catherine",
      "words": [
        {
          "word": " \"What",
          "start": 1114.42,
          "end": 1114.46,
          "speaker": "Catherine"
        },
        {
          "word": " happened?\"",
          "start": 1114.46,
          "end": 1114.76,
          "speaker": "Catherine"
        },
        {
          "word": " \"He",
          "start": 1115.1,
          "end": 1115.1,
          "speaker": "Catherine"
        },
        {
          "word": " did",
          "start": 1115.1,
          "end": 1115.22,
          "speaker": "Catherine"
        },
        {
          "word": " this",
          "start": 1115.22,
          "end": 1115.44,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 1115.44,
          "end": 1115.52,
          "speaker": "Catherine"
        },
        {
          "word": " me.\"",
          "start": 1115.52,
          "end": 1115.68,
          "speaker": "Catherine"
        },
        {
          "word": " \"No,",
          "start": 1115.68,
          "end": 1115.76,
          "speaker": "Catherine"
        },
        {
          "word": " he",
          "start": 1115.86,
          "end": 1115.88,
          "speaker": "Catherine"
        },
        {
          "word": " did",
          "start": 1115.88,
          "end": 1115.96,
          "speaker": "Catherine"
        },
        {
          "word": " that",
          "start": 1115.96,
          "end": 1116.14,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 1116.14,
          "end": 1116.28,
          "speaker": "Catherine"
        },
        {
          "word": " me.\"",
          "start": 1116.28,
          "end": 1116.62,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "And if you just waited for five minutes, you'd have the whole story.",
      "start": 1116.62,
      "end": 1118.96,
      "speaker": "Catherine",
      "words": [
        {
          "word": " And",
          "start": 1116.62,
          "end": 1116.7,
          "speaker": "Catherine"
        },
        {
          "word": " if",
          "start": 1116.7,
          "end": 1116.78,
          "speaker": "Catherine"
        },
        {
          "word": " you",
          "start": 1116.78,
          "end": 1116.86,
          "speaker": "Catherine"
        },
        {
          "word": " just",
          "start": 1116.86,
          "end": 1117.04,
          "speaker": "Catherine"
        },
        {
          "word": " waited",
