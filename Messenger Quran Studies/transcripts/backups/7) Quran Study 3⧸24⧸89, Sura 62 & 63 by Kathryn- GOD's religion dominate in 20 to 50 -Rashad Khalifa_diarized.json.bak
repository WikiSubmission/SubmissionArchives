        }
      ]
    },
    {
      "text": "I see it like that.",
      "start": 1130.8,
      "end": 1131.69,
      "speaker": "Catherine",
      "words": [
        {
          "word": " I",
          "start": 1130.8,
          "end": 1130.8,
          "speaker": "Catherine"
        },
        {
          "word": " see",
          "start": 1130.94,
          "end": 1131.04,
          "speaker": "Catherine"
        },
        {
          "word": " it",
          "start": 1131.04,
          "end": 1131.2,
          "speaker": "Catherine"
        },
        {
          "word": " like",
          "start": 1131.2,
          "end": 1131.34,
          "speaker": "Catherine"
        },
        {
          "word": " that.",
          "start": 1131.34,
          "end": 1131.69,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "We don't know when our death is going to come.",
      "start": 1132.8,
      "end": 1134.56,
      "speaker": "Catherine",
      "words": [
        {
          "word": " We",
          "start": 1132.8,
          "end": 1132.8,
          "speaker": "Catherine"
        },
        {
          "word": " don't",
          "start": 1132.8,
          "end": 1132.96,
          "speaker": "Catherine"
        },
        {
          "word": " know",
          "start": 1132.96,
          "end": 1133.12,
          "speaker": "Catherine"
        },
        {
          "word": " when",
          "start": 1133.12,
          "end": 1133.28,
          "speaker": "Catherine"
        },
        {
          "word": " our",
          "start": 1133.32,
          "end": 1133.44,
          "speaker": "Catherine"
        },
        {
          "word": " death",
          "start": 1133.52,
          "end": 1133.62,
          "speaker": "Catherine"
        },
        {
          "word": " is",
          "start": 1133.62,
          "end": 1133.84,
          "speaker": "Catherine"
        },
        {
          "word": " going",
          "start": 1133.9,
          "end": 1134.04,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 1134.04,
          "end": 1134.16,
          "speaker": "Catherine"
        },
        {
          "word": " come.",
          "start": 1134.16,
          "end": 1134.56,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "And when it comes, the Quran tells us many of us won't even know that we died. We'll wake and, and be with God. Without God.",
      "start": 1135.08,
      "end": 1144.7,
      "speaker": "Catherine",
      "words": [
