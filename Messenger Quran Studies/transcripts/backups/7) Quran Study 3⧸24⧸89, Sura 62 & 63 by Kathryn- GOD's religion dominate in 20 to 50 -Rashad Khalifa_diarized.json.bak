        }
      ]
    },
    {
      "text": "Verse 8 says,",
      "start": 1049.48,
      "end": 1050.38,
      "speaker": "Catherine",
      "words": [
        {
          "word": " Verse",
          "start": 1049.48,
          "end": 1049.64,
