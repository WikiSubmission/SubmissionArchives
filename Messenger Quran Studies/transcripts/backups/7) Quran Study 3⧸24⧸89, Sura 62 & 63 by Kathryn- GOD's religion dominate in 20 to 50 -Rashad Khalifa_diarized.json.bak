      "words": [
        {
          "word": " You",
          "start": 978.84,
          "end": 978.92,
          "speaker": "Catherine"
        },
        {
          "word": " don't",
          "start": 978.92,
          "end": 979.14,
          "speaker": "Catherine"
        },
        {
          "word": " have",
          "start": 979.22,
          "end": 979.32,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 979.32,
          "end": 979.54,
          "speaker": "Catherine"
        },
        {
          "word": " be",
          "start": 979.54,
          "end": 979.68,
