          "speaker": "Catherine"
        },
        {
          "word": " This",
          "start": 584.18,
          "end": 584.24,
          "speaker": "Catherine"
        },
        {
          "word": " is",
          "start": 584.24,
          "end": 584.4,
          "speaker": "Catherine"
        },
        {
          "word": " a",
