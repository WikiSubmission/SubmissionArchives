          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "This three voices at once.",
      "start": 1113.18,
      "end": 1114.35,
      "speaker": "Catherine",
      "words": [
        {
          "word": " This",
          "start": 1113.18,
          "end": 1113.18,
          "speaker": "Catherine"
        },
        {
          "word": " three",
          "start": 1113.18,
          "end": 1113.26,
          "speaker": "Catherine"
        },
        {
          "word": " voices",
          "start": 1113.36,
          "end": 1113.58,
          "speaker": "Catherine"
        },
        {
          "word": " at",
