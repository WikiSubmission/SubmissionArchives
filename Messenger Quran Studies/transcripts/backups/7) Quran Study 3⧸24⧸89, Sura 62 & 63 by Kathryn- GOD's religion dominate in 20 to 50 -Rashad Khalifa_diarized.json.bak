    },
    {
      "text": "All of us are in the same boat.",
      "start": 1028.1,
      "end": 1029.41,
      "speaker": "Catherine",
      "words": [
        {
          "word": " All",
          "start": 1028.1,
          "end": 1028.22,
          "speaker": "Catherine"
        },
        {
          "word": " of",
          "start": 1028.22,
          "end": 1028.36,
          "speaker": "Catherine"
        },
        {
          "word": " us",
          "start": 1028.36,
          "end": 1028.52,
          "speaker": "Catherine"
        },
        {
          "word": " are",
          "start": 1028.52,
          "end": 1028.64,
          "speaker": "Catherine"
        },
        {
          "word": " in",
          "start": 1028.64,
          "end": 1028.76,
          "speaker": "Catherine"
        },
        {
          "word": " the",
          "start": 1028.76,
          "end": 1028.84,
          "speaker": "Catherine"
        },
        {
          "word": " same",
          "start": 1028.84,
          "end": 1029.06,
          "speaker": "Catherine"
        },
        {
          "word": " boat.",
          "start": 1029.06,
          "end": 1029.41,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "We're all responsible for our own necks, no matter whether we're Jewish, Christian, Muslim, or anything else.",
      "start": 1029.52,
      "end": 1036.32,
      "speaker": "Catherine",
      "words": [
