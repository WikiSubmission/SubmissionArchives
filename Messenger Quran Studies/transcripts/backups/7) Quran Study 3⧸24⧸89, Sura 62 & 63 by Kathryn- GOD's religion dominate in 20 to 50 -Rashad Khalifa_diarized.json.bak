          "word": " comes",
          "start": 4137.76,
          "end": 4137.96,
          "speaker": "Catherine"
        },
        {
          "word": " from",
          "start": 4137.96,
          "end": 4138.2,
          "speaker": "Catherine"
        },
        {
          "word": " God.",
          "start": 4138.2,
          "end": 4138.62,
