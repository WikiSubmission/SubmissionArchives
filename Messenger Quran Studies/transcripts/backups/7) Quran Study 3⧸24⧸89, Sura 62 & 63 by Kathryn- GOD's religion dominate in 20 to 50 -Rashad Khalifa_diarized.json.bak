          "word": " originally.",
          "start": 3520.36,
          "end": 3520.86,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "There is some truth, some veracity to what we hear in all things.",
      "start": 3522.4,
      "end": 3526.58,
      "speaker": "Catherine",
      "words": [
        {
          "word": " There",
