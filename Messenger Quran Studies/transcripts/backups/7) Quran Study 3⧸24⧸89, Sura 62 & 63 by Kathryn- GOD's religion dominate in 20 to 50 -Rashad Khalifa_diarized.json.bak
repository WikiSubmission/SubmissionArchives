          "speaker": "Catherine"
        },
        {
          "word": " you're",
          "start": 3540.74,
          "end": 3540.96,
          "speaker": "Catherine"
        },
        {
          "word": " not",
          "start": 3540.96,
          "end": 3541.08,
          "speaker": "Catherine"
        },
        {
          "word": " as",
