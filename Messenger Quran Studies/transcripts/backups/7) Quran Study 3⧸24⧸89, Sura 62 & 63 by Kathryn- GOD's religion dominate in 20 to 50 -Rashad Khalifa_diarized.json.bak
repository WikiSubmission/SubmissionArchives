          "speaker": "Catherine"
        },
        {
          "word": " hard",
          "start": 3538.48,
          "end": 3538.58,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 3538.58,
          "end": 3538.74,
          "speaker": "Catherine"
        },
        {
          "word": " argue",
          "start": 3538.74,
          "end": 3539.06,
          "speaker": "Catherine"
        },
        {
          "word": " with",
          "start": 3539.06,
          "end": 3539.28,
          "speaker": "Catherine"
        },
        {
          "word": " people.",
          "start": 3539.28,
          "end": 3540.03,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "Because you're not as well, you're not as articulate as they are for instance.",
