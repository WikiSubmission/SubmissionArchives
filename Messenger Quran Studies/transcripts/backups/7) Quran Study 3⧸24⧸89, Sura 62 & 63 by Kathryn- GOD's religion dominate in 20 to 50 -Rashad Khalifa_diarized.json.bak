        },
        {
          "word": " the",
          "start": 574.88,
          "end": 575.08,
          "speaker": "Catherine"
        },
        {
          "word": " first",
          "start": 575.08,
          "end": 575.3,
          "speaker": "Catherine"
        },
        {
