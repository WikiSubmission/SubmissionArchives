        },
        {
          "word": " years",
          "start": 602.38,
          "end": 602.78,
          "speaker": "Catherine"
        },
        {
          "word": " purifying",
          "start": 602.78,
          "end": 603.66,
          "speaker": "Catherine"
        },
        {
          "word": " His",
          "start": 603.68,
          "end": 603.96,
          "speaker": "Catherine"
        },
        {
          "word": " final",
          "start": 603.96,
          "end": 604.32,
          "speaker": "Catherine"
        },
        {
          "word": " message.",
