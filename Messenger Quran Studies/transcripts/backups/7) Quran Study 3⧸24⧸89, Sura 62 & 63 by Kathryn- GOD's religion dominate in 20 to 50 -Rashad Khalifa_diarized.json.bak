          "speaker": "Catherine"
        },
        {
          "word": " real",
          "start": 584.56,
          "end": 584.76,
          "speaker": "Catherine"
        },
        {
          "word": " big",
          "start": 584.76,
          "end": 585.0,
          "speaker": "Catherine"
        },
        {
          "word": " miss.",
          "start": 585.0,
          "end": 585.48,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "God has no reason to do anything for us. He doesn't need us for anything. He doesn't need us to know Him. He doesn't need that.",
      "start": 586.16,
      "end": 594.52,
      "speaker": "Catherine",
      "words": [
        {
          "word": " God",
          "start": 586.16,
          "end": 586.26,
          "speaker": "Catherine"
        },
        {
          "word": " has",
          "start": 586.26,
          "end": 586.54,
          "speaker": "Catherine"
        },
        {
          "word": " no",
          "start": 586.54,
          "end": 587.06,
          "speaker": "Catherine"
        },
        {
          "word": " reason",
          "start": 587.06,
          "end": 587.5,
          "speaker": "Catherine"
        },
        {
