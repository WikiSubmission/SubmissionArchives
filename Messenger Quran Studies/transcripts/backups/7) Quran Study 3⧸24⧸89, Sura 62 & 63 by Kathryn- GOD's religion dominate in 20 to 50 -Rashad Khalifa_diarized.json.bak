          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "He didn't have to do that.",
      "start": 606.16,
      "end": 607.18,
      "speaker": "Catherine",
      "words": [
        {
          "word": " He",
          "start": 606.16,
          "end": 606.16,
          "speaker": "Catherine"
        },
        {
          "word": " didn't",
          "start": 606.18,
          "end": 606.3,
          "speaker": "Catherine"
        },
        {
          "word": " have",
          "start": 606.3,
          "end": 606.46,
          "speaker": "Catherine"
        },
        {
          "word": " to",
          "start": 606.46,
          "end": 606.72,
          "speaker": "Catherine"
        },
        {
          "word": " do",
          "start": 606.72,
          "end": 606.86,
          "speaker": "Catherine"
        },
        {
          "word": " that.",
          "start": 606.86,
          "end": 607.18,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I mean, He gave it once.",
      "start": 607.9,
      "end": 609.31,
      "speaker": "Catherine",
      "words": [
        {
          "word": " I",
          "start": 607.9,
          "end": 607.96,
          "speaker": "Catherine"
        },
        {
          "word": " mean,",
          "start": 607.96,
          "end": 608.14,
          "speaker": "Catherine"
        },
        {
          "word": " He",
          "start": 608.42,
          "end": 608.52,
          "speaker": "Catherine"
        },
        {
          "word": " gave",
          "start": 608.52,
          "end": 608.68,
          "speaker": "Catherine"
        },
        {
          "word": " it",
          "start": 608.68,
          "end": 608.86,
          "speaker": "Catherine"
        },
        {
          "word": " once.",
          "start": 608.86,
          "end": 609.31,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "Why spend 1,400 years sending even more messengers and purifying the message?",
      "start": 609.86,
      "end": 615.46,
      "speaker": "Catherine",
      "words": [
        {
          "word": " Why",
          "start": 609.86,
          "end": 609.94,
          "speaker": "Catherine"
        },
        {
          "word": " spend",
          "start": 609.94,
          "end": 610.34,
          "speaker": "Catherine"
        },
        {
          "word": " 1,400",
          "start": 610.34,
          "end": 610.98,
          "speaker": "Catherine"
        },
        {
          "word": " years",
          "start": 611.24,
          "end": 611.42,
          "speaker": "Catherine"
        },
        {
          "word": " sending",
          "start": 611.42,
          "end": 611.72,
          "speaker": "Catherine"
