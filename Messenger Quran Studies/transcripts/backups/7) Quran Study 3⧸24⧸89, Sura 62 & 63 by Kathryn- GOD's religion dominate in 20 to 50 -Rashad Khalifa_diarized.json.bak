          "end": 3824.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 3824.04,
          "end": 3824.18,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " us,",
          "start": 3824.18,
          "end": 3824.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
