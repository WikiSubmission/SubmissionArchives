          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And this is SHAFA'AT.",
      "start": 3832.44,
      "end": 3833.24,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 3832.44,
          "end": 3832.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " this",
          "start": 3832.52,
          "end": 3832.68,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3832.68,
          "end": 3832.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " SHAFA'AT.",
          "start": 3832.8,
          "end": 3833.24,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You will say it. I will say it. Everybody will say it, IN SHAA ALLAH, in Heaven.",
