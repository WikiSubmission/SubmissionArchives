        },
        {
          "word": " important,",
          "start": 4329.28,
          "end": 4330.22,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "every single one of them.",
      "start": 4330.64,
      "end": 4331.4,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " every",
          "start": 4330.64,
