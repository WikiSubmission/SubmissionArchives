    },
    {
      "text": "This is incredible mercy from, from God. He did not have to do this for us. We blew it the first time around.",
      "start": 570.02,
      "end": 575.68,
      "speaker": "Catherine",
      "words": [
        {
          "word": " This",
          "start": 570.02,
          "end": 570.12,
          "speaker": "Catherine"
        },
        {
          "word": " is",
