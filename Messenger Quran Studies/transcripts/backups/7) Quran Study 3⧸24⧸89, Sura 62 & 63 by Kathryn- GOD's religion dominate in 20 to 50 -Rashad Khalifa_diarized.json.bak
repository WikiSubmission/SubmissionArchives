          "end": 4331.4,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "For example, can you say Salat is more important than Zakat?",
      "start": 4334.04,
      "end": 4337.51,
      "speaker": "Farhad",
      "words": [
        {
          "word": " For",
          "start": 4334.04,
          "end": 4334.04,
          "speaker": "Farhad"
        },
        {
          "word": " example,",
          "start": 4334.04,
          "end": 4334.42,
          "speaker": "Farhad"
        },
        {
          "word": " can",
          "start": 4334.42,
          "end": 4334.42,
          "speaker": "Farhad"
        },
        {
          "word": " you",
          "start": 4334.42,
          "end": 4334.42,
          "speaker": "Farhad"
        },
        {
          "word": " say",
          "start": 4334.42,
          "end": 4334.92,
          "speaker": "Farhad"
        },
        {
          "word": " Salat",
          "start": 4335.2,
          "end": 4335.96,
          "speaker": "Farhad"
        },
        {
          "word": " is",
          "start": 4336.06,
          "end": 4336.16,
          "speaker": "Farhad"
        },
        {
          "word": " more",
          "start": 4336.16,
          "end": 4336.3,
          "speaker": "Farhad"
        },
        {
          "word": " important",
          "start": 4336.3,
          "end": 4336.66,
          "speaker": "Farhad"
        },
        {
          "word": " than",
          "start": 4336.88,
          "end": 4337.06,
          "speaker": "Farhad"
        },
        {
          "word": " Zakat?",
          "start": 4337.06,
          "end": 4337.51,
          "speaker": "Farhad"
        }
      ]
    },
    {
      "text": "No.",
      "start": 4339.08,
      "end": 4339.28,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " No.",
          "start": 4339.08,
          "end": 4339.28,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because it's mentioned more than...",
      "start": 4340.3,
      "end": 4341.72,
      "speaker": "Farhad",
      "words": [
        {
          "word": " Because",
          "start": 4340.3,
          "end": 4340.48,
          "speaker": "Farhad"
        },
        {
          "word": " it's",
          "start": 4340.48,
          "end": 4340.9,
          "speaker": "Farhad"
        },
        {
          "word": " mentioned",
          "start": 4340.9,
          "end": 4340.96,
          "speaker": "Farhad"
        },
        {
          "word": " more",
          "start": 4340.96,
          "end": 4341.58,
          "speaker": "Farhad"
        },
        {
          "word": " than...",
          "start": 4341.58,
          "end": 4341.72,
          "speaker": "Farhad"
        }
      ]
    },
    {
      "text": "Actually, they are both usually mentioned together, Salat and Zakat.",
      "start": 4342.26,
      "end": 4347.32,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Actually,",
