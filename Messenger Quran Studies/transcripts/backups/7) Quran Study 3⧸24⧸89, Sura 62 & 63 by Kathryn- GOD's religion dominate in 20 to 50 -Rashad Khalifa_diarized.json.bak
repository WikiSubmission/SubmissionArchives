          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mentioned",
          "start": 4344.64,
          "end": 4345.48,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " together,",
          "start": 4345.48,
          "end": 4346.46,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Salat",
          "start": 4346.48,
          "end": 4346.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 4346.78,
          "end": 4346.96,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Zakat.",
          "start": 4346.96,
          "end": 4347.32,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Or Fasting.",
      "start": 4347.7,
      "end": 4347.9,
      "speaker": "Farhad",
      "words": [
        {
          "word": " Or",
          "start": 4347.7,
          "end": 4347.8,
          "speaker": "Farhad"
        },
        {
          "word": " Fasting.",
          "start": 4347.8,
          "end": 4347.9,
          "speaker": "Farhad"
        }
      ]
    },
    {
      "text": "Fasting is very important.",
      "start": 4350.22,
      "end": 4351.29,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Fasting",
          "start": 4350.22,
          "end": 4350.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 4350.48,
          "end": 4350.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " very",
          "start": 4350.58,
          "end": 4350.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " important.",
          "start": 4350.74,
          "end": 4351.29,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
