          "speaker": "Catherine"
        },
        {
          "word": " said",
          "start": 735.3,
          "end": 735.7,
          "speaker": "Catherine"
        },
        {
          "word": " \"God",
          "start": 735.7,
          "end": 735.98,
          "speaker": "Catherine"
        },
