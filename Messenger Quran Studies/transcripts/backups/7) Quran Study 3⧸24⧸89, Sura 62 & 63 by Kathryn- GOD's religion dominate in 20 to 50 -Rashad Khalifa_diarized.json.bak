          "speaker": "Catherine"
        },
        {
          "word": " for",
          "start": 1117.34,
          "end": 1117.62,
          "speaker": "Catherine"
        },
        {
          "word": " five",
          "start": 1117.78,
          "end": 1117.88,
          "speaker": "Catherine"
        },
        {
          "word": " minutes,",
          "start": 1117.88,
          "end": 1118.12,
          "speaker": "Catherine"
        },
        {
          "word": " you'd",
          "start": 1118.28,
          "end": 1118.32,
          "speaker": "Catherine"
        },
        {
          "word": " have",
          "start": 1118.32,
          "end": 1118.38,
          "speaker": "Catherine"
        },
        {
          "word": " the",
          "start": 1118.38,
          "end": 1118.54,
          "speaker": "Catherine"
        },
        {
          "word": " whole",
          "start": 1118.54,
          "end": 1118.66,
          "speaker": "Catherine"
        },
        {
          "word": " story.",
          "start": 1118.66,
          "end": 1118.96,
          "speaker": "Catherine"
        }
      ]
    },
    {
