          "end": 1033.34,
          "speaker": "Catherine"
        },
        {
          "word": " matter",
          "start": 1033.34,
          "end": 1033.54,
          "speaker": "Catherine"
        },
        {
          "word": " whether",
          "start": 1033.54,
          "end": 1033.74,
          "speaker": "Catherine"
        },
        {
          "word": " we're",
          "start": 1033.8,
          "end": 1033.9,
          "speaker": "Catherine"
        },
        {
          "word": " Jewish,",
          "start": 1033.94,
          "end": 1034.26,
          "speaker": "Catherine"
        },
        {
