          "word": " missed.",
          "start": 578.62,
          "end": 579.0,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "And, and this is a time when closest is only good in worship. This is a real big miss.",
      "start": 580.12,
      "end": 585.48,
      "speaker": "Catherine",
      "words": [
        {
