          "end": 4357.27,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You're disobeying God if you lie or cheat.",
      "start": 4358.06,
      "end": 4359.88,
      "speaker": "Dr. Khalifa",
      "words": [
