          "word": " We",
          "start": 941.0,
          "end": 941.0,
          "speaker": "Catherine"
        },
        {
          "word": " get",
          "start": 941.0,
          "end": 941.14,
          "speaker": "Catherine"
        },
        {
          "word": " impatient.",
