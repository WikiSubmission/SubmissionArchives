          "speaker": "Catherine"
        },
        {
          "word": " it",
          "start": 1135.22,
          "end": 1135.36,
          "speaker": "Catherine"
        },
        {
          "word": " comes,",
          "start": 1135.36,
          "end": 1135.46,
