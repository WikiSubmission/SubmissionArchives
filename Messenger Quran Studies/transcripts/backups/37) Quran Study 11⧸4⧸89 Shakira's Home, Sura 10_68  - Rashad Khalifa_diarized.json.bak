        }
      ]
    },
    {
      "text": "I'm sorry, forgive me.",
      "start": 2369.29,
      "end": 2369.49,
      "speaker": "A woman",
      "words": [
        {
          "word": " I'm",
          "start": 2369.29,
          "end": 2369.29,
          "speaker": "A woman"
        },
