          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Bism Allah Arrahman Arraheem (1:1)",
      "start": 2883.27,
      "end": 2889.31,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Bism",
          "start": 2883.27,
          "end": 2883.27,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Allah",
          "start": 2883.27,
          "end": 2886.25,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Arrahman",
          "start": 2886.25,
          "end": 2888.29,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Arraheem",
          "start": 2888.29,
          "end": 2888.37,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " (1:1)",
          "start": 2888.37,
          "end": 2889.31,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You don't hear it when you pray in Mecca or in most mosques.",
