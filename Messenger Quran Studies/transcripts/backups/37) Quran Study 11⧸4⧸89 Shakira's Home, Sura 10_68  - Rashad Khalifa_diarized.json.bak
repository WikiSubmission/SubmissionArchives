          "speaker": "Dr. Khalifa"
        },
        {
          "word": " all",
          "start": 168.56,
          "end": 168.64,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " he",
          "start": 168.64,
          "end": 168.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " was",
          "start": 168.74,
          "end": 168.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " doing.",
          "start": 168.9,
          "end": 169.6,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"I'm asking you, so, God will forgive you and to be redeemed by God.\"",
      "start": 169.72,
      "end": 174.52,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"I'm",
          "start": 169.72,
          "end": 169.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " asking",
          "start": 169.88,
          "end": 170.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you,",
          "start": 170.14,
          "end": 170.68,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " so,",
