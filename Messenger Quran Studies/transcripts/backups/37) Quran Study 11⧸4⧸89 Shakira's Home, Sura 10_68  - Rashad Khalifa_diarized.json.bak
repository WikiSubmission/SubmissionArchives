          "start": 2897.17,
          "end": 2897.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " hear",
          "start": 2897.17,
          "end": 2897.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 2897.17,
