      "end": 2897.17,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 2891.62,
          "end": 2892.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " don't",
          "start": 2892.17,
          "end": 2892.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " hear",
          "start": 2892.39,
          "end": 2892.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 2892.39,
          "end": 2894.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " when",
          "start": 2894.11,
