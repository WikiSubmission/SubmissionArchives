          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": " [23:85] Say, \"Why then do you not take heed?\"",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "  [23:85]",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Say,",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"Why",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " then",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " do",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
