          "end": 4135.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Wa",
          "start": 4135.33,
          "end": 4135.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Eyyaka",
