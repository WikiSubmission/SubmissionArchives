    },
    {
      "text": "(108:1) \u0625\u0650\u0646\u064e\u0651\u0622 \u0623\u064e\u0639\u0652\u0637\u064e\u064a\u0652\u0646\u064e\u0640\u0670\u0643\u064e \u0671\u0644\u0652\u0643\u064e\u0648\u0652\u062b\u064e\u0631\u064e",
      "start": 4163.25,
