        },
        {
          "word": " by",
          "start": 173.4,
          "end": 173.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God.\"",
          "start": 173.6,
          "end": 174.52,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"So, why are you persecuting me? Why are you against me?\"",
      "start": 174.52,
      "end": 177.08,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"So,",
          "start": 174.52,
          "end": 174.72,
          "speaker": "Dr. Khalifa"
        },
        {
