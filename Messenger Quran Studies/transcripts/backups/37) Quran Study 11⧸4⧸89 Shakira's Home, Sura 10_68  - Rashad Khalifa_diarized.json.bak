          "word": " said",
          "start": 2750.62,
          "end": 2752.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"No,",
          "start": 2752.76,
          "end": 2753.26,
          "speaker": "Dr. Khalifa"
        },
