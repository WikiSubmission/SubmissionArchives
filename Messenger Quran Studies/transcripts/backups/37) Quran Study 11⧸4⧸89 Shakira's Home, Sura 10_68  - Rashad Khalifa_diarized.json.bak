          "speaker": "Dr. Khalifa"
        },
        {
          "word": " all.",
          "start": 2897.17,
          "end": 2897.17,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Satan talked them into cancelling it.",
      "start": 2897.17,
      "end": 2900.35,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Satan",
          "start": 2897.17,
          "end": 2897.17,
          "speaker": "Dr. Khalifa"
