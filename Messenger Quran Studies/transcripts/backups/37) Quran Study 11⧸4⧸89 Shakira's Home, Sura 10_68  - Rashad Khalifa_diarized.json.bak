          "end": 2345.19,
          "speaker": "Shakira"
        },
        {
          "word": " (1:1).\"",
          "start": 2345.19,
          "end": 2345.57,
          "speaker": "Shakira"
        }
      ]
    },
    {
      "text": "This is why they do not say \"Bism Allah Arrahman Arraheem (1:1).\"",
