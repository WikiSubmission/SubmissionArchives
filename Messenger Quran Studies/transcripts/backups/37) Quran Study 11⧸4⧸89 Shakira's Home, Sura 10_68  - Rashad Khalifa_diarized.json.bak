        },
        {
          "word": " Allah",
          "start": 2347.83,
          "end": 2347.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Arrahman",
          "start": 2347.83,
          "end": 2349.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Arraheem",
          "start": 2349.05,
          "end": 2349.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " (1:1).\"",
          "start": 2349.05,
          "end": 2349.23,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Now, they don't really mean to say that it is hated.",
