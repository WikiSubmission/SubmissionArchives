        },
        {
          "word": " she's",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " not",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " taking",
          "start": 5559.22,
          "end": 5559.22,
