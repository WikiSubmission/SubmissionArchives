          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Parivash, these are the creatures who insisted on seeing a demonstration whether Sheytan (Satan) can make it or not.",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Parivash,",
          "start": 5559.22,
