        },
        {
          "word": " heed",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " because...",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        }
      ]
    },
    {
      "text": "Because the Quran... God says... Shakira: if you ask her, if you ask somebody...",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Because",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Quran...",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 5559.22,
