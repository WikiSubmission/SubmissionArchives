        },
        {
          "word": " Paradise.",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "All these creatures are dead.",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " All",
          "start": 5559.22,
