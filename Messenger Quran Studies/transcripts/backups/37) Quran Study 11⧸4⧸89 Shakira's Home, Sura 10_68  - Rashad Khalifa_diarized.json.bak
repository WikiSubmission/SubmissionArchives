        },
        {
          "word": " \u0671\u0644\u0652\u0643\u064e\u0648\u0652\u062b\u064e\u0631\u064e",
          "start": 4167.67,
          "end": 4169.75,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We gave you a lot of bounty.",
      "start": 4172.71,
      "end": 4174.23,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " We",
          "start": 4172.71,
          "end": 4172.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " gave",
          "start": 4172.83,
          "end": 4172.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 4172.83,
          "end": 4172.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 4172.83,
          "end": 4173.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " lot",
          "start": 4173.03,
          "end": 4173.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 4173.03,
          "end": 4173.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " bounty.",
          "start": 4173.93,
          "end": 4174.23,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It doesn't make sense.",
      "start": 4175.15,
      "end": 4180.73,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " It",
          "start": 4175.15,
          "end": 4175.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " doesn't",
          "start": 4175.15,
          "end": 4175.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " make",
          "start": 4179.21,
          "end": 4180.09,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " sense.",
          "start": 4180.09,
          "end": 4180.73,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, it's only The Key that is required.",
      "start": 4183.61,
      "end": 4185.43,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " So,",
          "start": 4183.61,
          "end": 4184.11,
          "speaker": "Dr. Khalifa"
        },
