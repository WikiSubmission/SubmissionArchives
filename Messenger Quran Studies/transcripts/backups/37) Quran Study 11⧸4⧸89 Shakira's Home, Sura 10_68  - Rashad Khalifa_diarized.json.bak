        },
        {
          "word": " God",
          "start": 3139.2,
          "end": 3139.35,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " says",
          "start": 3139.35,
          "end": 3140.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"I",
          "start": 3140.23,
          "end": 3140.39,
          "speaker": "Dr. Khalifa"
        },
