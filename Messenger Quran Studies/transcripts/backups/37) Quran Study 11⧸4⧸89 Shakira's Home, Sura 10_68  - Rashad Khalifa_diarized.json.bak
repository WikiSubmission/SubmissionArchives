          "speaker": "Dr. Khalifa"
        },
        {
          "word": " heed?\"",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "She says \"I am taking heed.\"",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Shakira",
      "words": [
        {
          "word": " She",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " says",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " \"I",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " am",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " taking",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " heed.\"",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        }
      ]
    },
    {
      "text": "No, then, she's not taking heed. It doesn't matter what she says.",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
