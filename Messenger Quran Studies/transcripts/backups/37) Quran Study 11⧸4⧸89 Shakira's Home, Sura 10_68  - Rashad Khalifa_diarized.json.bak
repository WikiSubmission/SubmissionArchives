          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 2749.6,
          "end": 2749.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"I",
          "start": 2749.6,
          "end": 2749.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " say",
          "start": 2749.8,
          "end": 2750.36,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
