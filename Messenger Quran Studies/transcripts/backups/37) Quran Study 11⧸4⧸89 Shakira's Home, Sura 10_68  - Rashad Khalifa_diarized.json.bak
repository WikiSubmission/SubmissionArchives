          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Satan.",
          "start": 2313.75,
          "end": 2314.19,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The name of God.",
      "start": 2314.63,
      "end": 2314.75,
      "speaker": "Dr. Khalifa",
      "words": [
