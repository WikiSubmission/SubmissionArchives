        },
        {
          "word": " you",
          "start": 176.36,
          "end": 176.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " against",
          "start": 176.6,
          "end": 176.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " me?\"",
          "start": 176.82,
          "end": 177.08,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They considered him an enemy, just for doing that.",
      "start": 178.16,
      "end": 181.59,
      "speaker": "Dr. Khalifa",
      "words": [
