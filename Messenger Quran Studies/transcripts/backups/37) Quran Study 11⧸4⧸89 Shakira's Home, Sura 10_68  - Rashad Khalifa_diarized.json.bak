          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God,",
          "start": 4155.63,
          "end": 4155.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " we",
          "start": 4155.65,
          "end": 4155.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " worship;",
          "start": 4155.65,
          "end": 4155.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Only",
