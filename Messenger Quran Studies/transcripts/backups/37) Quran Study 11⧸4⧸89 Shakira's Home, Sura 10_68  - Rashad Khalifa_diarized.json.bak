          "speaker": "Dr. Khalifa"
        },
        {
          "word": " then,",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " she's",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
