        },
        {
          "word": " people",
          "start": 185.16,
          "end": 185.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " who...",
          "start": 185.92,
          "end": 186.56,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
