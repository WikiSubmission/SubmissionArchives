          "start": 2750.38,
          "end": 2750.62,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And I said \"No, you don't, because you say, and I tend to say,",
      "start": 2750.62,
      "end": 2762.5,
      "speaker": "Dr. Khalifa",
      "words": [
