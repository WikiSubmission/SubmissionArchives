        },
        {
          "word": " you",
          "start": 2894.11,
          "end": 2894.55,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " pray",
          "start": 2894.55,
          "end": 2894.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 2894.73,
          "end": 2895.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Mecca",
          "start": 2895.01,
          "end": 2895.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " or",
          "start": 2895.45,
          "end": 2895.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 2895.45,
          "end": 2897.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " most",
          "start": 2897.17,
          "end": 2897.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mosques.",
          "start": 2897.17,
          "end": 2897.17,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You don't hear it at all.",
      "start": 2897.17,
      "end": 2897.17,
      "speaker": "Dr. Khalifa",
