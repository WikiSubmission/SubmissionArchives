        },
        {
          "word": " ask",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " somebody...",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Go ahead.",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Shakira",
      "words": [
        {
          "word": " Go",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        },
        {
          "word": " ahead.",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Shakira"
        }
      ]
    },
    {
      "text": "The Quran, God says \"your testimony shall be 'I testify that God alone is god.'\" This is it. But they don't do that.",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " The",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Quran,",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        },
