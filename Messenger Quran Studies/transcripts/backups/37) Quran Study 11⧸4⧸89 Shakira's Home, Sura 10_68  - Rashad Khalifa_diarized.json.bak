          "end": 2325.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 2325.21,
          "end": 2325.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2325.21,
