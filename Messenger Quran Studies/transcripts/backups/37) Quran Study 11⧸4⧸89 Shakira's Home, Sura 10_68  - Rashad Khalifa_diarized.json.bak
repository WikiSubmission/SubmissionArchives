          "speaker": "Dr. Khalifa"
        },
        {
          "word": " waiting",
          "start": 2369.49,
          "end": 2369.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " for",
          "start": 2369.49,
          "end": 2369.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you.",
