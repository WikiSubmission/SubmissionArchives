          "word": " (1:5)",
          "start": 4135.55,
          "end": 4135.73,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Only You, we worship; Only You, we ask for help.",
      "start": 4141.81,
      "end": 4151.35,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Only",
          "start": 4141.81,
          "end": 4141.81,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " You,",
          "start": 4141.81,
          "end": 4142.47,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " we",
          "start": 4142.95,
          "end": 4142.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " worship;",
          "start": 4142.95,
          "end": 4143.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Only",
