        },
        {
          "word": " angels.",
          "start": 5559.22,
          "end": 5559.22,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Fall prostrate. Shakira: No, no, no. Ok. Now,",
      "start": 5559.22,
      "end": 5559.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
