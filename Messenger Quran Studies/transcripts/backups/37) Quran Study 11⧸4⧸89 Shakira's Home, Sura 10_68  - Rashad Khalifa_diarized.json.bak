          "end": 2326.49,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The books of jurisprudence.",
      "start": 2328.23,
      "end": 2330.75,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " The",
          "start": 2328.23,
          "end": 2328.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " books",
          "start": 2328.33,
          "end": 2329.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
