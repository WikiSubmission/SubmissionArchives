          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They called him \"crazy.\" They persecuted him.",
      "start": 157.44,
      "end": 159.72,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " They",
