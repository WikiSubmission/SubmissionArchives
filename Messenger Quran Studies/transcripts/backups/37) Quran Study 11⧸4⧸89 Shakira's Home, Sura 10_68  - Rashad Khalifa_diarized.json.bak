        },
        {
          "word": " human",
          "start": 189.4,
          "end": 189.68,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " beings.",
          "start": 189.68,
          "end": 190.38,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
