      "end": 4163.25,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " We're",
          "start": 4154.65,
          "end": 4154.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " calling",
          "start": 4154.65,
          "end": 4154.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 4154.65,
          "end": 4155.29,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"Only",
          "start": 4155.31,
          "end": 4155.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " You,",
          "start": 4155.49,
