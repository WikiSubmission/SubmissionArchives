        },
        {
          "word": "mentioned,",
          "start": 3428.949,
          "end": 3429.179,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 3429.179,
          "end": 3429.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "don't",
          "start": 3429.41,
          "end": 3429.64,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "like",
