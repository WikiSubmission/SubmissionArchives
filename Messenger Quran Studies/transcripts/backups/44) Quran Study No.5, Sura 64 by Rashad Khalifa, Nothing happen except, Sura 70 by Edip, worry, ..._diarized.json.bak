          "end": 3427.335,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 3427.335,
          "end": 3427.566,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "them",
          "start": 3427.566,
          "end": 3427.796,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 3427.796,
          "end": 3428.027,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "when",
