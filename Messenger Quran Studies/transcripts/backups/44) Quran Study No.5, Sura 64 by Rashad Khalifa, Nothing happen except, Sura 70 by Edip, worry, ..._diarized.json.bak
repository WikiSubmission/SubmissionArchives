          "speaker": "Dr. Khalifa"
        },
        {
          "word": "prophets.",
          "start": 732.944,
          "end": 733.309,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The vast majority of people fall in that trap.",
      "start": 735.537,
      "end": 738.019,
      "speaker": "Dr. Khalifa",
