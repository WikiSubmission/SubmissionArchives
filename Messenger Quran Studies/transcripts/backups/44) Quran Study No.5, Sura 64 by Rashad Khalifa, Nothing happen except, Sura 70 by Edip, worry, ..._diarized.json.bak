      "end": 3423.758,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "So,",
          "start": 3420.762,
          "end": 3420.992,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "here's",
          "start": 3420.992,
          "end": 3421.223,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 3421.223,
          "end": 3421.453,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "person",
