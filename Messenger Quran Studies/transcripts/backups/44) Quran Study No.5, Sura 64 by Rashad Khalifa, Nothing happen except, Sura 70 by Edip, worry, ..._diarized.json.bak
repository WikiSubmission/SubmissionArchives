    },
    {
      "text": "They say \"Who am I? God doesn't pay attention to me.\"",
      "start": 1150.517,
      "end": 1152.517,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "They",
          "start": 1150.517,
          "end": 1150.699,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "say",
          "start": 1150.699,
          "end": 1150.881,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"Who",
          "start": 1150.881,
          "end": 1151.062,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "am",
          "start": 1151.062,
