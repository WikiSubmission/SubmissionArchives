          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It only makes sense.",
      "start": 761.742,
      "end": 762.922,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "It",
          "start": 761.742,
          "end": 762.037,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "only",
