          "speaker": "Dr. Khalifa"
        },
        {
          "word": "understand",
          "start": 659.336,
          "end": 659.593,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "why",
          "start": 659.593,
          "end": 659.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 659.85,
          "end": 660.107,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "are",
          "start": 660.107,
          "end": 660.364,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "here.",
          "start": 660.364,
          "end": 660.621,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "If they read the Quran, they will know why we are here.",
