          "start": 3454.222,
          "end": 3454.518,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 3454.518,
          "end": 3454.815,
          "speaker": "Dr. Khalifa"
        },
        {
