          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's true.",
      "start": 174.334,
      "end": 175.17,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "It's",
          "start": 174.334,
