          "end": 346.888,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this.",
          "start": 346.888,
          "end": 347.344,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"The most righteous among you is the most miserable.\" This is a very famous Hadith.",
      "start": 348.047,
      "end": 351.992,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"The",
          "start": 348.047,
          "end": 348.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "most",
          "start": 348.31,
          "end": 348.573,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "righteous",
          "start": 348.573,
          "end": 348.836,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "among",
          "start": 348.836,
          "end": 349.099,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "you",
          "start": 349.099,
          "end": 349.362,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 349.362,
          "end": 349.625,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 349.625,
          "end": 349.888,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "most",
          "start": 349.888,
          "end": 350.151,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "miserable.\"",
          "start": 350.151,
          "end": 350.414,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "This",
          "start": 350.414,
          "end": 350.677,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 350.677,
          "end": 350.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 350.94,
          "end": 351.203,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "very",
          "start": 351.203,
          "end": 351.466,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "famous",
          "start": 351.466,
          "end": 351.729,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Hadith.",
          "start": 351.729,
          "end": 351.992,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because Satan knows that he cannot give them happiness.",
      "start": 352.887,
      "end": 355.583,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Because",
          "start": 352.887,
          "end": 353.187,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Satan",
          "start": 353.187,
          "end": 353.486,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "knows",
          "start": 353.486,
          "end": 353.786,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 353.786,
          "end": 354.085,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "he",
          "start": 354.085,
          "end": 354.385,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "cannot",
          "start": 354.385,
          "end": 354.684,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "give",
          "start": 354.684,
          "end": 354.984,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "them",
          "start": 354.984,
          "end": 355.283,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "happiness.",
          "start": 355.283,
          "end": 355.583,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And actually, the Hadith goes on and says \"the most miserable are the prophets, and then the saints, and then the believers.\"",
      "start": 357.341,
      "end": 362.976,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 357.341,
          "end": 357.597,
          "speaker": "Dr. Khalifa"
        },
        {
