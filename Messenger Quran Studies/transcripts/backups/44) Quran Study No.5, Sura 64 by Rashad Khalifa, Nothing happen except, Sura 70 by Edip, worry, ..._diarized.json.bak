          "word": "not.",
          "start": 3444.311,
          "end": 3444.655,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, the definition of a disbeliever is one who says he doesn't believe. That's a disbeliever.",
      "start": 3445.124,
      "end": 3450.698,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "So,",
          "start": 3445.124,
          "end": 3445.472,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3445.472,
          "end": 3445.821,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "definition",
