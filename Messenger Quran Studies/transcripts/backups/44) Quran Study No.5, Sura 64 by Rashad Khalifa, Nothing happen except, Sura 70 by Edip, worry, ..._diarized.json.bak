          "start": 655.074,
          "end": 655.286,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"why",
          "start": 655.286,
          "end": 655.498,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "did",
          "start": 655.498,
          "end": 655.71,
