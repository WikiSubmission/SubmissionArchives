          "end": 4095.236,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Oh,",
          "start": 4095.236,
          "end": 4095.673,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "oh,",
          "start": 4095.673,
          "end": 4096.109,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "well,",
