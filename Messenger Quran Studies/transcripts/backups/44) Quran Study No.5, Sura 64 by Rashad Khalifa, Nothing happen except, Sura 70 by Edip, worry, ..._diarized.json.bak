    {
      "text": "You know, a lot of people say \"why did God bring me here? I didn't wanna come here.\"",
      "start": 653.802,
      "end": 657.618,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "You",
          "start": 653.802,
          "end": 654.014,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "know,",
          "start": 654.014,
          "end": 654.226,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 654.226,
