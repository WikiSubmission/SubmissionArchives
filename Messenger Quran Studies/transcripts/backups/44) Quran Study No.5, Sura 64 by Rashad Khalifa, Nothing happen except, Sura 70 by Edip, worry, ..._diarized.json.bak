        }
      ]
    },
    {
      "text": "Their number one Hadith goes like this.",
      "start": 344.151,
      "end": 347.344,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Their",
          "start": 344.151,
          "end": 344.607,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "number",
          "start": 344.607,
          "end": 345.063,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "one",
          "start": 345.063,
          "end": 345.519,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Hadith",
          "start": 345.519,
          "end": 345.976,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "goes",
          "start": 345.976,
          "end": 346.432,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "like",
