          "speaker": "Dr. Khalifa"
        },
        {
          "word": "didn't",
          "start": 656.77,
          "end": 656.982,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wanna",
          "start": 656.982,
          "end": 657.194,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "come",
          "start": 657.194,
          "end": 657.406,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "here.\"",
          "start": 657.406,
          "end": 657.618,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because they don't understand why we are here.",
      "start": 658.565,
      "end": 660.621,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Because",
          "start": 658.565,
          "end": 658.822,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 658.822,
          "end": 659.079,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "don't",
