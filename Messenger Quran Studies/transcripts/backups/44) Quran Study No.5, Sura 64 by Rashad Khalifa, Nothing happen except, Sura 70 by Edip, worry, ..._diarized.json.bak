          "speaker": "Dr. Khalifa"
        },
        {
          "word": "here.",
          "start": 724.074,
          "end": 724.294,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We did not uphold God's absolute authority.",
      "start": 725.021,
      "end": 727.987,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "We",
          "start": 725.021,
          "end": 725.445,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "did",
          "start": 725.445,
          "end": 725.868,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "not",
          "start": 725.868,
          "end": 726.292,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "uphold",
          "start": 726.292,
          "end": 726.716,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God's",
          "start": 726.716,
          "end": 727.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "absolute",
          "start": 727.14,
          "end": 727.563,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "authority.",
          "start": 727.563,
          "end": 727.987,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is why we have that tendency to idolize saints and prophets.",
      "start": 728.934,
      "end": 733.309,
      "speaker": "Dr. Khalifa",
      "words": [
