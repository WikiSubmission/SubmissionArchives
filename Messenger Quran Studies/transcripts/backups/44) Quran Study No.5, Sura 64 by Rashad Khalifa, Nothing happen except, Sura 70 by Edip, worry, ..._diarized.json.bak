        },
        {
          "word": "God",
          "start": 3424.178,
          "end": 3424.597,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "gives",
          "start": 3424.597,
          "end": 3425.017,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "us",
          "start": 3425.017,
          "end": 3425.436,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3425.436,
          "end": 3425.856,
          "speaker": "Dr. Khalifa"
        },
