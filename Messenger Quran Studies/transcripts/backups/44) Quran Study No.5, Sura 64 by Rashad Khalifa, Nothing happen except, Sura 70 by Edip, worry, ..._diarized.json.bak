          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Right. Also,...",
      "start": 3587.341,
      "end": 3588.931,
      "speaker": "Hamid",
      "words": [
        {
          "word": "Right.",
          "start": 3587.341,
