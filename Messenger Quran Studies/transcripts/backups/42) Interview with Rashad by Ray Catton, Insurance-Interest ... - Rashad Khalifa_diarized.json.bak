          "speaker": "A man"
        }
      ]
    },
    {
      "text": "This is what Allah Subhanahu Wa Ta'ala teaches us in Quran.",
      "start": 1186.514,
      "end": 1189.104,
      "speaker": "A man",
      "words": [
