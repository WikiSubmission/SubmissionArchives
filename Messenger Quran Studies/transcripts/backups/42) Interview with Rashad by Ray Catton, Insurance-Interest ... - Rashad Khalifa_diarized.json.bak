        },
        {
          "word": "Ta'ala,",
          "start": 834.586,
          "end": 834.932,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 834.932,
          "end": 835.277,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "become",
