    },
    {
      "text": "(9:31) \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u062d\u0652\u0628\u064e\u0627\u0631\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u0631\u064f\u0647\u0652\u0628\u064e\u0640\u0670\u0646\u064e\u0647\u064f\u0645\u0652 \u0623\u064e\u0631\u0652\u0628\u064e\u0627\u0628\u064b\u06ed\u0627 \u0645\u0651\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650",
      "start": 359.801,
