    {
      "text": "\u0648\u064e\u0628\u064e\u062f\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e\u0646\u064e\u0627 \u0648\u064e\u0628\u064e\u064a\u0652\u0646\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u0652\u0639\u064e\u062f\u064e\u0670\u0648\u064e\u0629\u064f \u0648\u064e\u0671\u0644\u0652\u0628\u064e\u063a\u0652\u0636\u064e\u0627\u0653\u0621\u064f \u0623\u064e\u0628\u064e\u062f\u064b\u0627 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u062a\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0627\u06df \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650  (60:4) \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f\u06e5\u0653",
