        },
        {
          "word": "\u0623\u064e\u0643\u0650\u0646\u0651\u064e\u0629\u064b",
          "start": 1022.224,
          "end": 1022.658,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0623\u064e\u0646",
          "start": 1022.658,
          "end": 1023.092,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u064a\u064e\u0641\u0652\u0642\u064e\u0647\u064f\u0648\u0647\u064f",
          "start": 1023.092,
          "end": 1023.526,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
