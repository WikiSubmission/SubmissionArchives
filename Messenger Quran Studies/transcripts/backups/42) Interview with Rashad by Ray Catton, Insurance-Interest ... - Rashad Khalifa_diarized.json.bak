        },
        {
          "word": "see",
          "start": 437.038,
          "end": 437.284,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "it.",
          "start": 437.284,
          "end": 437.529,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
