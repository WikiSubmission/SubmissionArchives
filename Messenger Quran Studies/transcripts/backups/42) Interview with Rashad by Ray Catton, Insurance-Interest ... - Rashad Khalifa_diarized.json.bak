          "end": 2338.08,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 2338.08,
          "end": 2338.56,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "given",
          "start": 2338.56,
          "end": 2339.04,
          "speaker": "Dr. Khalifa"
        },
