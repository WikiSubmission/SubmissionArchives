          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I'm asking myself.",
      "start": 781.521,
      "end": 782.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "I'm",
          "start": 781.521,
