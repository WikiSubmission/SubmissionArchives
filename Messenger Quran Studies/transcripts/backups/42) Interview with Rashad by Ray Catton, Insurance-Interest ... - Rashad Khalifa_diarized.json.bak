          "end": 2326.136,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 2326.136,
          "end": 2326.466,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran.",
          "start": 2326.466,
          "end": 2326.795,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because among the things revealed before Quran was the practical scripture given to Ibrahim.",
      "start": 2327.267,
      "end": 2333.845,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Because",
          "start": 2327.267,
          "end": 2327.737,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "among",
          "start": 2327.737,
          "end": 2328.207,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 2328.207,
          "end": 2328.677,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "things",
          "start": 2328.677,
          "end": 2329.146,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "revealed",
          "start": 2329.146,
          "end": 2329.616,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "before",
          "start": 2329.616,
          "end": 2330.086,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran",
          "start": 2330.086,
          "end": 2330.556,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 2330.556,
          "end": 2331.026,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 2331.026,
          "end": 2331.496,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "practical",
          "start": 2331.496,
          "end": 2331.966,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "scripture",
          "start": 2331.966,
          "end": 2332.435,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "given",
          "start": 2332.435,
          "end": 2332.905,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 2332.905,
          "end": 2333.375,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Ibrahim.",
          "start": 2333.375,
          "end": 2333.845,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There was no reading or writing in Ibrahim's time.",
      "start": 2333.845,
      "end": 2337.119,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "There",
          "start": 2333.845,
          "end": 2334.209,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 2334.209,
          "end": 2334.573,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "no",
          "start": 2334.573,
          "end": 2334.936,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "reading",
          "start": 2334.936,
          "end": 2335.3,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "or",
          "start": 2335.3,
          "end": 2335.664,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "writing",
          "start": 2335.664,
          "end": 2336.028,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 2336.028,
          "end": 2336.391,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Ibrahim's",
          "start": 2336.391,
          "end": 2336.755,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "time.",
          "start": 2336.755,
          "end": 2337.119,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And he was given a practical, mostly practical, scripture consisting of the duties that we practice now in Islam.",
      "start": 2337.119,
      "end": 2346.246,
      "speaker": "Dr. Khalifa",
      "words": [
