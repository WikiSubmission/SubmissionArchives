          "end": 941.024,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(40:12) \u0648\u064e\u0625\u0650\u0646 \u064a\u064f\u0634\u0652\u0631\u064e\u0643\u0652 \u0628\u0650\u0647\u0650\u06e6 \u062a\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0627\u06df",
