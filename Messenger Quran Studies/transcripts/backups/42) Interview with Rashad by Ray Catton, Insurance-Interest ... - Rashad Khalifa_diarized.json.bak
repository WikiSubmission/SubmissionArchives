          "speaker": "A man"
        },
        {
          "word": "worshipper",
          "start": 1144.105,
          "end": 1144.325,
          "speaker": "A man"
        },
        {
          "word": "or",
          "start": 1144.325,
          "end": 1144.544,
          "speaker": "A man"
        },
        {
          "word": "not.",
          "start": 1144.544,
