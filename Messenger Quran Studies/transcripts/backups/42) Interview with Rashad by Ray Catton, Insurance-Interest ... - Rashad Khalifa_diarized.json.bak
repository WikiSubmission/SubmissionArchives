          "speaker": "Dr. Khalifa"
        },
        {
          "word": "instead",
          "start": 226.814,
          "end": 227.196,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 227.196,
          "end": 227.578,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "fighting",
          "start": 227.578,
          "end": 227.96,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "with",
          "start": 227.96,
          "end": 228.342,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "each",
          "start": 228.342,
          "end": 228.724,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "other.",
          "start": 228.724,
          "end": 229.106,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And this archenemy, that is your enemy and my enemy, is called Iblis (Satan).",
      "start": 229.106,
      "end": 234.386,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 229.106,
          "end": 229.483,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this",
          "start": 229.483,
          "end": 229.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "archenemy,",
          "start": 229.86,
          "end": 230.237,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 230.237,
          "end": 230.615,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 230.615,
          "end": 230.992,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "your",
          "start": 230.992,
          "end": 231.369,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "enemy",
          "start": 231.369,
          "end": 231.746,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 231.746,
          "end": 232.123,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "my",
          "start": 232.123,
