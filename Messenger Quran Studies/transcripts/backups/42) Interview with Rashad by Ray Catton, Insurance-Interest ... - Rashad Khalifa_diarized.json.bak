          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\u0634\u064e\u0647\u0650\u064a\u062f\u064c\u06e2 \u0628\u064e\u064a\u0652\u0646\u0650\u0649 \u0648\u064e\u0628\u064e\u064a\u0652\u0646\u064e\u0643\u064f\u0645\u0652",
