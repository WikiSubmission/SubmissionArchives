          "speaker": "Dr. Khalifa"
        },
        {
          "word": "course,",
          "start": 424.843,
          "end": 425.043,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 425.043,
          "end": 425.243,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "are",
          "start": 425.243,
          "end": 425.442,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wrong.",
          "start": 425.442,
          "end": 425.642,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And it's because of Iblis.",
      "start": 425.925,
      "end": 427.311,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 425.925,
