          "speaker": "Dr. Khalifa"
        },
        {
          "word": "one",
          "start": 840.599,
          "end": 840.898,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "criterion.",
          "start": 840.898,
          "end": 841.198,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The worship must be devoted to Allah Subhanahu Wa Ta'ala alone, without the necessity of adding",
