        },
        {
          "word": "prophets.",
          "start": 350.048,
          "end": 350.278,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They have absolutely no respect for them.",
      "start": 350.703,
      "end": 352.703,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "They",
          "start": 350.703,
          "end": 350.989,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "have",
          "start": 350.989,
          "end": 351.274,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "absolutely",
          "start": 351.274,
          "end": 351.56,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "no",
          "start": 351.56,
          "end": 351.846,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "respect",
          "start": 351.846,
          "end": 352.132,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "for",
          "start": 352.132,
          "end": 352.417,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "them.",
          "start": 352.417,
          "end": 352.703,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But Satan, Iblis, turned around and he made them reverence and worship their scholars.",
