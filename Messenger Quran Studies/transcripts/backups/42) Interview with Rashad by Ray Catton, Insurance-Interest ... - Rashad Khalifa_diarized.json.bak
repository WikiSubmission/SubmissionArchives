          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They become content.",
      "start": 837.337,
      "end": 838.629,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "They",
          "start": 837.337,
