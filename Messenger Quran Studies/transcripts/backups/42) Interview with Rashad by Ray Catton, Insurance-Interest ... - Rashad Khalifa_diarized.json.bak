          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And you see the results.",
      "start": 330.0,
      "end": 331.528,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 330.0,
          "end": 330.306,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "you",
          "start": 330.306,
          "end": 330.611,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "see",
          "start": 330.611,
          "end": 330.917,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 330.917,
          "end": 331.222,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "results.",
          "start": 331.222,
          "end": 331.528,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You and I agree on the results of what happened to the Christians.",
      "start": 331.764,
      "end": 334.85,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "You",
          "start": 331.764,
          "end": 332.001,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 332.001,
          "end": 332.239,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 332.239,
          "end": 332.476,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "agree",
          "start": 332.476,
          "end": 332.714,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "on",
