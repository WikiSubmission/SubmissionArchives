        },
        {
          "word": "content.",
          "start": 838.198,
          "end": 838.629,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is one criterion.",
      "start": 840.0,
      "end": 841.198,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 840.0,
