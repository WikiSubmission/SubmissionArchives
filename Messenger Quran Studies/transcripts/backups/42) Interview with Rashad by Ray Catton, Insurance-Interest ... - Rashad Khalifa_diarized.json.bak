          "speaker": "Dr. Khalifa"
        },
        {
          "word": "asking",
          "start": 781.967,
          "end": 782.414,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "myself.",
          "start": 782.414,
          "end": 782.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
