        },
        {
          "word": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627",
          "start": 1140.767,
          "end": 1141.149,
          "speaker": "A man"
        },
        {
          "word": "\u0630\u064e\u0643\u064e\u0631\u0652\u062a\u064e",
          "start": 1141.149,
          "end": 1141.531,
          "speaker": "A man"
        },
        {
          "word": "\u0631\u064e\u0628\u0651\u064e\u0643\u064e",
          "start": 1141.531,
          "end": 1141.913,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "I'm trying to find out if I am an idol worshipper or not.",
      "start": 1141.913,
      "end": 1144.763,
      "speaker": "A man",
      "words": [
