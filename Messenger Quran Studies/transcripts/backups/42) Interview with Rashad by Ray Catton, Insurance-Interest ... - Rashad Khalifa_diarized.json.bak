    {
      "text": "Their hearts are denying.",
      "start": 762.732,
      "end": 764.024,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Their",
          "start": 762.732,
          "end": 763.055,
          "speaker": "Dr. Khalifa"
        },
        {
