        },
        {
          "word": "Arraheem",
          "start": 123.42,
          "end": 123.837,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Alhamdu Lillah",
      "start": 125.536,
      "end": 126.781,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Alhamdu",
          "start": 125.536,
          "end": 126.159,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Lillah",
          "start": 126.159,
          "end": 126.781,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In the name of God, Most Gracious, Most Merciful",
      "start": 128.781,
      "end": 131.536,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "In",
          "start": 128.781,
          "end": 129.087,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 129.087,
          "end": 129.393,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "name",
          "start": 129.393,
          "end": 129.699,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 129.699,
          "end": 130.005,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God,",
          "start": 130.005,
          "end": 130.312,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Most",
          "start": 130.312,
          "end": 130.618,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Gracious,",
          "start": 130.618,
          "end": 130.924,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Most",
          "start": 130.924,
          "end": 131.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Merciful",
          "start": 131.23,
          "end": 131.536,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Praise be to God.",
      "start": 131.536,
      "end": 132.922,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Praise",
          "start": 131.536,
          "end": 131.882,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "be",
          "start": 131.882,
          "end": 132.229,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 132.229,
          "end": 132.575,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God.",
          "start": 132.575,
          "end": 132.922,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Wa Ash-hadu Alla Elaha Ella Allah.",
      "start": 133.205,
      "end": 135.205,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Wa",
          "start": 133.205,
          "end": 133.538,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Ash-hadu",
          "start": 133.538,
          "end": 133.872,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Alla",
          "start": 133.872,
          "end": 134.205,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Elaha",
          "start": 134.205,
          "end": 134.538,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Ella",
          "start": 134.538,
          "end": 134.872,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Allah.",
          "start": 134.872,
          "end": 135.205,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And I bear witness that there is no  god except the One God.",
      "start": 135.488,
      "end": 138.904,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 135.488,
          "end": 135.751,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 135.751,
          "end": 136.014,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "bear",
          "start": 136.014,
          "end": 136.276,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "witness",
          "start": 136.276,
          "end": 136.539,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 136.539,
          "end": 136.802,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "there",
          "start": 136.802,
          "end": 137.065,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 137.065,
          "end": 137.327,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "no",
          "start": 137.327,
          "end": 137.59,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "god",
          "start": 137.59,
          "end": 137.853,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "except",
          "start": 137.853,
          "end": 138.116,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 138.116,
          "end": 138.378,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "One",
          "start": 138.378,
          "end": 138.641,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God.",
          "start": 138.641,
          "end": 138.904,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Wahdahu La Shareeka Lah",
      "start": 138.904,
      "end": 140.574,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Wahdahu",
          "start": 138.904,
          "end": 139.322,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "La",
          "start": 139.322,
          "end": 139.739,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Shareeka",
          "start": 139.739,
          "end": 140.157,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Lah",
          "start": 140.157,
          "end": 140.574,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He alone is God. He has no partners.",
      "start": 140.574,
      "end": 142.81,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "He",
          "start": 140.574,
          "end": 140.853,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone",
          "start": 140.853,
          "end": 141.133,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 141.133,
          "end": 141.412,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God.",
          "start": 141.412,
          "end": 141.692,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "He",
          "start": 141.692,
          "end": 141.971,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "has",
          "start": 141.971,
          "end": 142.251,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "no",
          "start": 142.251,
          "end": 142.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "partners.",
          "start": 142.53,
          "end": 142.81,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Our topic this morning is, why...",
      "start": 143.612,
      "end": 147.311,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Our",
          "start": 143.612,
          "end": 144.228,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "topic",
          "start": 144.228,
          "end": 144.845,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this",
          "start": 144.845,
          "end": 145.462,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "morning",
          "start": 145.462,
          "end": 146.078,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is,",
          "start": 146.078,
          "end": 146.695,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "why...",
          "start": 146.695,
          "end": 147.311,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is Canada, North America, the folks say anything they want.",
      "start": 148.585,
      "end": 151.718,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 148.585,
          "end": 148.87,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 148.87,
          "end": 149.155,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Canada,",
          "start": 149.155,
          "end": 149.439,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "North",
          "start": 149.439,
          "end": 149.724,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "America,",
          "start": 149.724,
          "end": 150.009,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 150.009,
          "end": 150.294,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "folks",
          "start": 150.294,
          "end": 150.579,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "say",
          "start": 150.579,
          "end": 150.864,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "anything",
          "start": 150.864,
          "end": 151.148,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 151.148,
          "end": 151.433,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "want.",
          "start": 151.433,
          "end": 151.718,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is not Egypt or Iraq, or any other place.",
      "start": 153.37,
      "end": 156.739,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 153.37,
          "end": 153.707,
          "speaker": "Dr. Khalifa"
