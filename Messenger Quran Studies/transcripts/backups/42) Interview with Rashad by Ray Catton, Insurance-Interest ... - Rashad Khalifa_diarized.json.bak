          "word": "says,",
          "start": 994.852,
          "end": 995.191,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(17:45) \u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064e\u0631\u064e\u0623\u0652\u062a\u064e \u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u064e",
