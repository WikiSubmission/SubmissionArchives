          "word": "(17:45)",
          "start": 1006.512,
          "end": 1007.037,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062d\u0650\u062c\u064e\u0627\u0628\u064b\u06ed\u0627",
          "start": 1007.037,
          "end": 1007.562,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u0651\u064e\u0633\u0652\u062a\u064f\u0648\u0631\u064b\u06ed\u0627",
          "start": 1007.562,
          "end": 1008.087,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "An invisible wall.",
      "start": 1008.087,
      "end": 1009.332,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "An",
          "start": 1008.087,
          "end": 1008.502,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "invisible",
