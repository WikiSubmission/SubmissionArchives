          "end": 946.204,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(40:12) \u0641\u064e\u0671\u0644\u0652\u062d\u064f\u0643\u0652\u0645\u064f \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0652\u0639\u064e\u0644\u0650\u0649\u0651\u0650 \u0671\u0644\u0652\u0643\u064e\u0628\u0650\u064a\u0631\u0650",
