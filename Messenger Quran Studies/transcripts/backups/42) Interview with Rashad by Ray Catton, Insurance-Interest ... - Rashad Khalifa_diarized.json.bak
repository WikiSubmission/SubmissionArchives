    },
    {
      "text": "\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0646\u0650\u0649 \u0628\u064e\u0631\u0650\u0649\u0653\u0621\u064c\u06ed \u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u062a\u064f\u0634\u0652\u0631\u0650\u0643\u064f\u0648\u0646\u064e",
