    {
      "text": "(17:45) \u062d\u0650\u062c\u064e\u0627\u0628\u064b\u06ed\u0627 \u0645\u0651\u064e\u0633\u0652\u062a\u064f\u0648\u0631\u064b\u06ed\u0627",
      "start": 1006.512,
