          "word": "enemy,",
          "start": 232.5,
          "end": 232.877,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 232.877,
          "end": 233.255,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "called",
          "start": 233.255,
          "end": 233.632,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Iblis",
          "start": 233.632,
          "end": 234.009,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "(Satan).",
          "start": 234.009,
          "end": 234.386,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He swore by God's Majesty.",
      "start": 234.699,
      "end": 236.605,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "He",
          "start": 234.699,
          "end": 235.08,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "swore",
          "start": 235.08,
          "end": 235.461,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "by",
          "start": 235.461,
          "end": 235.843,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God's",
          "start": 235.843,
          "end": 236.224,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Majesty.",
          "start": 236.224,
          "end": 236.605,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(38:82) \u0641\u064e\u0628\u0650\u0639\u0650\u0632\u0651\u064e\u062a\u0650\u0643\u064e \u0644\u064e\u0623\u064f\u063a\u0652\u0648\u0650\u064a\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u0623\u064e\u062c\u0652\u0645\u064e\u0639\u0650\u064a\u0646\u064e",
      "start": 236.888,
      "end": 239.171,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "(38:82)",
          "start": 236.888,
          "end": 237.459,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0641\u064e\u0628\u0650\u0639\u0650\u0632\u0651\u064e\u062a\u0650\u0643\u064e",
          "start": 237.459,
          "end": 238.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0644\u064e\u0623\u064f\u063a\u0652\u0648\u0650\u064a\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652",
          "start": 238.03,
          "end": 238.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0623\u064e\u062c\u0652\u0645\u064e\u0639\u0650\u064a\u0646\u064e",
          "start": 238.6,
          "end": 239.171,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"I swear by Your Majesty, I will deceive them all.\"",
      "start": 239.596,
      "end": 242.823,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"I",
          "start": 239.596,
          "end": 239.919,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "swear",
          "start": 239.919,
          "end": 240.241,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "by",
          "start": 240.241,
          "end": 240.564,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Your",
          "start": 240.564,
          "end": 240.887,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Majesty,",
          "start": 240.887,
          "end": 241.209,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 241.209,
          "end": 241.532,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "will",
          "start": 241.532,
          "end": 241.855,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "deceive",
          "start": 241.855,
          "end": 242.178,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "them",
          "start": 242.178,
          "end": 242.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "all.\"",
          "start": 242.5,
          "end": 242.823,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(38:83) \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u0650\u0628\u064e\u0627\u062f\u064e\u0643\u064e \u0645\u0650\u0646\u0652\u0647\u064f\u0645\u064f \u0671\u0644\u0652\u0645\u064f\u062e\u0652\u0644\u064e\u0635\u0650\u064a\u0646\u064e",
      "start": 243.059,
      "end": 245.059,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "(38:83)",
          "start": 243.059,
          "end": 243.459,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0625\u0650\u0644\u0651\u064e\u0627",
          "start": 243.459,
          "end": 243.859,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0639\u0650\u0628\u064e\u0627\u062f\u064e\u0643\u064e",
          "start": 243.859,
          "end": 244.259,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u0650\u0646\u0652\u0647\u064f\u0645\u064f",
          "start": 244.259,
          "end": 244.659,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0652\u0645\u064f\u062e\u0652\u0644\u064e\u0635\u0650\u064a\u0646\u064e",
          "start": 244.659,
          "end": 245.059,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The only people who can escape the grip of Iblis (Satan) are the people who are totally devoted Allah Subhanahu Wa Ta'ala.",
