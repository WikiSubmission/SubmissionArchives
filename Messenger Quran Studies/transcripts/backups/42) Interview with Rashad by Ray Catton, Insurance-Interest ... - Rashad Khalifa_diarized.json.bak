    },
    {
      "text": "Shirk",
      "start": 433.293,
      "end": 434.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Shirk",
          "start": 433.293,
          "end": 434.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "If there's an ant crawling in there, you will not see it.",
      "start": 434.585,
      "end": 437.529,
      "speaker": "Dr. Khalifa",
      "words": [
        {
