      "text": "(6:22) \u0648\u064e\u064a\u064e\u0648\u0652\u0645\u064e \u0646\u064e\u062d\u0652\u0634\u064f\u0631\u064f\u0647\u064f\u0645\u0652 \u062c\u064e\u0645\u0650\u064a\u0639\u064b\u06ed\u0627",
