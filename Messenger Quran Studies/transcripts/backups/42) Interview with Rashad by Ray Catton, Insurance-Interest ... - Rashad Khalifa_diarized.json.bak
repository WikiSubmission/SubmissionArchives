        },
        {
          "word": "right?\"",
          "start": 422.635,
          "end": 422.869,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You can say that.",
      "start": 423.105,
      "end": 424.208,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "You",
          "start": 423.105,
