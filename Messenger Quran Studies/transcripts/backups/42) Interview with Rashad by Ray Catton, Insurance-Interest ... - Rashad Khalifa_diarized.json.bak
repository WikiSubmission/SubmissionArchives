          "speaker": "A man"
        }
      ]
    },
    {
      "text": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0630\u064e\u0643\u064e\u0631\u0652\u062a\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0641\u0650\u0649 \u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u0650",
      "start": 1195.95,
      "end": 1198.516,
      "speaker": "A man",
      "words": [
        {
          "word": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627",
          "start": 1195.95,
          "end": 1196.463,
          "speaker": "A man"
        },
        {
          "word": "\u0630\u064e\u0643\u064e\u0631\u0652\u062a\u064e",
          "start": 1196.463,
          "end": 1196.976,
          "speaker": "A man"
        },
        {
          "word": "\u0631\u064e\u0628\u0651\u064e\u0643\u064e",
          "start": 1196.976,
          "end": 1197.49,
          "speaker": "A man"
        },
        {
          "word": "\u0641\u0650\u0649",
          "start": 1197.49,
          "end": 1198.003,
          "speaker": "A man"
        },
        {
          "word": "\u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u0650",
          "start": 1198.003,
          "end": 1198.516,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "which is mans\u016bb (\u0645\u0646\u0635\u0648\u0628)",
      "start": 1198.516,
      "end": 1199.478,
      "speaker": "A man",
      "words": [
        {
          "word": "which",
          "start": 1198.516,
          "end": 1198.756,
          "speaker": "A man"
        },
        {
          "word": "is",
          "start": 1198.756,
          "end": 1198.997,
          "speaker": "A man"
        },
        {
          "word": "mans\u016bb",
          "start": 1198.997,
          "end": 1199.237,
          "speaker": "A man"
        },
        {
          "word": "(\u0645\u0646\u0635\u0648\u0628)",
          "start": 1199.237,
          "end": 1199.478,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "Wahdahu (\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f) which is mans\u016bb (\u0645\u0646\u0635\u0648\u0628)",
      "start": 1199.478,
      "end": 1201.289,
      "speaker": "A man",
      "words": [
        {
          "word": "Wahdahu",
          "start": 1199.478,
          "end": 1199.78,
          "speaker": "A man"
        },
        {
          "word": "(\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f)",
          "start": 1199.78,
          "end": 1200.082,
          "speaker": "A man"
        },
        {
          "word": "which",
          "start": 1200.082,
          "end": 1200.384,
          "speaker": "A man"
        },
        {
          "word": "is",
          "start": 1200.384,
          "end": 1200.685,
          "speaker": "A man"
        },
        {
          "word": "mans\u016bb",
          "start": 1200.685,
          "end": 1200.987,
          "speaker": "A man"
        },
        {
          "word": "(\u0645\u0646\u0635\u0648\u0628)",
          "start": 1200.987,
          "end": 1201.289,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "This means Wahdahu (\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f) refers to the Zakar (\u0630\u064e\u0643\u064e\u0631\u0652).",
      "start": 1201.289,
      "end": 1203.478,
      "speaker": "A man",
      "words": [
        {
          "word": "This",
          "start": 1201.289,
          "end": 1201.532,
          "speaker": "A man"
        },
        {
          "word": "means",
          "start": 1201.532,
          "end": 1201.775,
          "speaker": "A man"
        },
        {
          "word": "Wahdahu",
          "start": 1201.775,
          "end": 1202.019,
          "speaker": "A man"
        },
        {
          "word": "(\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f)",
          "start": 1202.019,
          "end": 1202.262,
          "speaker": "A man"
        },
        {
          "word": "refers",
          "start": 1202.262,
          "end": 1202.505,
          "speaker": "A man"
        },
        {
          "word": "to",
          "start": 1202.505,
          "end": 1202.748,
          "speaker": "A man"
        },
        {
          "word": "the",
          "start": 1202.748,
          "end": 1202.992,
          "speaker": "A man"
        },
        {
          "word": "Zakar",
          "start": 1202.992,
          "end": 1203.235,
          "speaker": "A man"
        },
        {
          "word": "(\u0630\u064e\u0643\u064e\u0631\u0652).",
          "start": 1203.235,
          "end": 1203.478,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "But we see in Sura number 60, we see in Sura 60, verse 3 and 4,",
      "start": 1203.79,
      "end": 1214.615,
      "speaker": "A man",
