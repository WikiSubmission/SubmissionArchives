        {
          "word": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627",
          "start": 746.738,
          "end": 747.238,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0630\u064f\u0643\u0650\u0631\u064e",
          "start": 747.238,
          "end": 747.738,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0644\u0651\u064e\u0647\u064f",
          "start": 747.738,
          "end": 748.238,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f",
          "start": 748.238,
          "end": 748.738,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "When God alone is mentioned,",
