        },
        {
          "word": "any",
          "start": 917.329,
          "end": 917.681,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "way",
          "start": 917.681,
          "end": 918.034,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "out?\"",
          "start": 918.034,
          "end": 918.387,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Is there any way out of Hell?",
