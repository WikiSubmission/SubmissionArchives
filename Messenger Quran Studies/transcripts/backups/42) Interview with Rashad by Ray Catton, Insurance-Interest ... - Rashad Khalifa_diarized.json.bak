          "start": 353.531,
          "end": 353.98,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Iblis,",
          "start": 353.98,
          "end": 354.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "turned",
