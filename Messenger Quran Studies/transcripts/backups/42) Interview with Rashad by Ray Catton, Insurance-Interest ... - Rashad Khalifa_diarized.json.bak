          "end": 224.139,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "enemy",
          "start": 224.139,
          "end": 224.521,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 224.521,
          "end": 224.903,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 224.903,
          "end": 225.285,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "must",
          "start": 225.285,
          "end": 225.668,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "band",
          "start": 225.668,
          "end": 226.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "together",
          "start": 226.05,
          "end": 226.432,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "against,",
          "start": 226.432,
