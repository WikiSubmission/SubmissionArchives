          "start": 769.643,
          "end": 770.0,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "When God alone is mentioned, they become upset.",
      "start": 770.0,
      "end": 772.33,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "When",
          "start": 770.0,
          "end": 770.291,
          "speaker": "Dr. Khalifa"
