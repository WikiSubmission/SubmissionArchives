          "start": 546.306,
          "end": 546.781,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0642\u064f\u0644\u064f\u0648\u0628\u064f\u0647\u064f\u0645",
          "start": 546.781,
          "end": 547.255,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u0651\u064f\u0646\u0643\u0650\u0631\u064e\u0629\u064c\u06ed",
