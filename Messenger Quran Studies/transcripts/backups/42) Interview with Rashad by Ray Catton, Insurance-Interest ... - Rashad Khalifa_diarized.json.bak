          "end": 2296.802,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0642\u064e\u0628\u0652\u0644\u064f",
          "start": 2296.802,
          "end": 2297.2,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is verse 78 of Sura 22.",
      "start": 2297.2,
      "end": 2300.0,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 2297.2,
          "end": 2297.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 2297.6,
          "end": 2298.0,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "verse",
          "start": 2298.0,
          "end": 2298.4,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "78",
          "start": 2298.4,
          "end": 2298.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 2298.8,
          "end": 2299.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Sura",
          "start": 2299.2,
          "end": 2299.6,
