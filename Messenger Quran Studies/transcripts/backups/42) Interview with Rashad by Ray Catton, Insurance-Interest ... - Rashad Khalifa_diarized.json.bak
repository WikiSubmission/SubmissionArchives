        },
        {
          "word": "\u0645\u064f\u0641\u064e\u0635\u0651\u064e\u0644\u064b\u06ed\u0627",
          "start": 1765.69,
          "end": 1765.954,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
