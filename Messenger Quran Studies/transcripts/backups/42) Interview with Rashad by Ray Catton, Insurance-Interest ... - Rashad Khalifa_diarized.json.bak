    {
      "text": "\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u062a\u064e\u064a\u0652\u0646\u064e\u0640\u0670\u0647\u064f\u0645\u064f \u0671\u0644\u0652\u0643\u0650\u062a\u064e\u0640\u0670\u0628\u064e \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0645\u064f\u0646\u064e\u0632\u0651\u064e\u0644\u064c\u06ed \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064e \u0628\u0650\u0671\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u06d6 \u0641\u064e\u0644\u064e\u0627  (6:114) \u062a\u064e\u0643\u064f\u0648\u0646\u064e\u0646\u0651\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u0652\u0645\u064f\u0645\u0652\u062a\u064e\u0631\u0650\u064a\u0646\u064e",
