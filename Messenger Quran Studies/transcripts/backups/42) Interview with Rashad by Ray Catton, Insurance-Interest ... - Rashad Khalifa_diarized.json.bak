          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0639\u064e\u0644\u064e\u0649\u0670\u0653",
          "start": 499.701,
          "end": 500.081,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0647\u0650\u0645\u0652",
          "start": 500.081,
          "end": 500.462,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I mean, I can lie to somebody, I can lie to other people, but lying to myself!?",
