    },
    {
      "text": "Rasool (\u0631\u0633\u0648\u0644).",
      "start": 1498.105,
      "end": 1499.103,
      "speaker": "A man",
      "words": [
        {
          "word": "Rasool",
          "start": 1498.105,
          "end": 1498.604,
          "speaker": "A man"
        },
        {
          "word": "(\u0631\u0633\u0648\u0644).",
          "start": 1498.604,
          "end": 1499.103,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "Anyone who disobeys God and His messenger, the prophet Muhammad, cannot go to Heaven.",
      "start": 1499.103,
      "end": 1504.549,
      "speaker": "Dr. Khalifa",
      "words": [
