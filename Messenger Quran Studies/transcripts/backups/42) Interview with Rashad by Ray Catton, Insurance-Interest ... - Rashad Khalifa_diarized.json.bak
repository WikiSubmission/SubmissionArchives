          "end": 984.12,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "person",
          "start": 984.12,
          "end": 984.426,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 984.426,
          "end": 984.732,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "upset.",
          "start": 984.732,
          "end": 985.038,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is in verse 45 of Sura 39.",
