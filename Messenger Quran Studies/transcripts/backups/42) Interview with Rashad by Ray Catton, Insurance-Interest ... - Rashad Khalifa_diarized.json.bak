          "speaker": "Dr. Khalifa"
        },
        {
          "word": "detailed,",
          "start": 1762.533,
          "end": 1762.85,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\u0645\u064f\u0641\u064e\u0635\u0651\u064e\u0644\u064b\u06ed\u0627",
      "start": 1762.85,
      "end": 1763.576,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\u0645\u064f\u0641\u064e\u0635\u0651\u064e\u0644\u064b\u06ed\u0627",
          "start": 1762.85,
          "end": 1763.576,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There is no other translation for the word \u0645\u064f\u0641\u064e\u0635\u0651\u064e\u0644\u064b\u06ed\u0627",
