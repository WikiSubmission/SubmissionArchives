          "end": 982.283,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "When God alone is mentioned, the person is upset.",
      "start": 982.283,
      "end": 985.038,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "When",
          "start": 982.283,
          "end": 982.589,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 982.589,
          "end": 982.895,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone",
