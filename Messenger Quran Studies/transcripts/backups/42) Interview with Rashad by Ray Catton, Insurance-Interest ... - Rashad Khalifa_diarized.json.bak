          "speaker": "Dr. Khalifa"
        },
        {
          "word": "sends",
          "start": 1760.317,
          "end": 1760.633,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "down",
          "start": 1760.633,
          "end": 1760.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
