          "end": 333.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "happened",
          "start": 333.9,
          "end": 334.138,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 334.138,
          "end": 334.375,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 334.375,
          "end": 334.613,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Christians.",
          "start": 334.613,
          "end": 334.85,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You and I agree on what happened to the Jews.",
      "start": 335.605,
      "end": 338.077,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "You",
          "start": 335.605,
          "end": 335.852,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 335.852,
          "end": 336.099,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 336.099,
          "end": 336.347,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "agree",
          "start": 336.347,
          "end": 336.594,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "on",
          "start": 336.594,
          "end": 336.841,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "what",
          "start": 336.841,
          "end": 337.088,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "happened",
          "start": 337.088,
          "end": 337.335,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 337.335,
          "end": 337.583,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 337.583,
          "end": 337.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Jews.",
          "start": 337.83,
          "end": 338.077,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "First, he made them disrespect their prophets.",
      "start": 338.643,
      "end": 341.257,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "First,",
          "start": 338.643,
          "end": 339.016,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "he",
          "start": 339.016,
          "end": 339.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "made",
          "start": 339.39,
          "end": 339.763,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "them",
          "start": 339.763,
          "end": 340.137,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "disrespect",
          "start": 340.137,
          "end": 340.51,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "their",
          "start": 340.51,
          "end": 340.884,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "prophets.",
          "start": 340.884,
          "end": 341.257,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They killed their prophets.",
      "start": 341.493,
      "end": 343.068,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "They",
          "start": 341.493,
          "end": 341.887,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "killed",
          "start": 341.887,
          "end": 342.281,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "their",
          "start": 342.281,
          "end": 342.674,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "prophets.",
          "start": 342.674,
          "end": 343.068,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They have no respect for Moses.",
      "start": 343.304,
      "end": 345.068,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "They",
          "start": 343.304,
          "end": 343.598,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "have",
          "start": 343.598,
          "end": 343.892,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "no",
          "start": 343.892,
          "end": 344.186,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "respect",
          "start": 344.186,
          "end": 344.48,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "for",
          "start": 344.48,
          "end": 344.774,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Moses.",
          "start": 344.774,
          "end": 345.068,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They have no respect for any of the prophets. And historically, as recorded in the Quran, the Jews killed their prophets.",
