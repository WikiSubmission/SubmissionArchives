          "start": 995.978,
          "end": 996.372,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u064e",
          "start": 996.372,
          "end": 996.766,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
