        },
        {
          "word": "\u0671\u0644\u0644\u0651\u064e\u0647\u064f",
          "start": 932.563,
          "end": 933.143,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f\u06e5",
          "start": 933.143,
          "end": 933.724,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0643\u064e\u0641\u064e\u0631\u0652\u062a\u064f\u0645\u0652",
          "start": 933.724,
          "end": 934.304,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "That is because when God alone is advocated, you disbelieved.",
