          "start": 763.055,
          "end": 763.378,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "are",
          "start": 763.378,
          "end": 763.701,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "denying.",
          "start": 763.701,
          "end": 764.024,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The hearts of those who do not believe in the Hereafter become upset. They become upset.",
