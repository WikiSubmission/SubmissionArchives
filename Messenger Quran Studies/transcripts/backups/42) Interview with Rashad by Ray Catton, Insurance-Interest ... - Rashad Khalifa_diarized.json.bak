          "end": 1116.716,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone,...",
          "start": 1116.716,
          "end": 1117.038,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(unintelligible)",
      "start": 1117.038,
      "end": 1123.191,
      "speaker": "A man",
      "words": [
        {
          "word": "(unintelligible)",
