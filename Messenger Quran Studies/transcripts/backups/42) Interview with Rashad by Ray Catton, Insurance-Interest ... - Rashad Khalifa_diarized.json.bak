    {
      "text": "\u0623\u064e\u062e\u0652\u0641\u064e\u0649 \u0645\u0650\u0646\u0652 \u062f\u064e\u0628\u0650\u064a\u0628\u0650 \u0627\u0644\u0646\u0651\u064e\u0645\u0652\u0644\u0650",
