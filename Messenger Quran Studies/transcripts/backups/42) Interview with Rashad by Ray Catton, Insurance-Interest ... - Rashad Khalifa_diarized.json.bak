          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 824.038,
          "end": 824.391,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "half",
          "start": 824.391,
          "end": 824.743,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 824.743,
          "end": 825.096,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "criterion.",
          "start": 825.096,
          "end": 825.449,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The second half says,",
      "start": 826.015,
      "end": 827.732,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 826.015,
