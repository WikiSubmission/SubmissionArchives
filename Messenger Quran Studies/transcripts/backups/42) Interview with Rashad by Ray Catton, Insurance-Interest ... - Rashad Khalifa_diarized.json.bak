          "end": 426.479,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "because",
          "start": 426.479,
          "end": 426.757,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 426.757,
          "end": 427.034,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Iblis.",
          "start": 427.034,
          "end": 427.311,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And because idol worship is very subtle.",
