        },
        {
          "word": "this",
          "start": 2762.22,
          "end": 2762.798,
          "speaker": "Ray Caton"
        },
        {
          "word": "allowable?",
          "start": 2762.798,
          "end": 2763.377,
          "speaker": "Ray Caton"
        }
      ]
    },
    {
      "text": "If you write down a project that you want to build apartment complex or invest in something, and to do this you have to have a loan of some kind,",
