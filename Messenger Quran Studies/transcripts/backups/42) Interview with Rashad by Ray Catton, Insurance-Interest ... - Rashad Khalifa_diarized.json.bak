          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is half the criterion.",
      "start": 823.685,
      "end": 825.449,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 823.685,
