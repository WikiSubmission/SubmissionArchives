          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says,",
          "start": 827.303,
          "end": 827.732,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(39:45) \u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0630\u064f\u0643\u0650\u0631\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0645\u0650\u0646 \u062f\u064f\u0648\u0646\u0650\u0647\u0650\u06e6\u0653 \u0625\u0650\u0630\u064e\u0627 \u0647\u064f\u0645\u0652 \u064a\u064e\u0633\u0652\u062a\u064e\u0628\u0652\u0634\u0650\u0631\u064f\u0648\u0646\u064e",
      "start": 827.732,
      "end": 831.478,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "(39:45)",
          "start": 827.732,
          "end": 828.148,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627",
          "start": 828.148,
          "end": 828.564,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0630\u064f\u0643\u0650\u0631\u064e",
          "start": 828.564,
          "end": 828.981,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e",
          "start": 828.981,
          "end": 829.397,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u0650\u0646",
          "start": 829.397,
          "end": 829.813,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062f\u064f\u0648\u0646\u0650\u0647\u0650\u06e6\u0653",
          "start": 829.813,
          "end": 830.229,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0625\u0650\u0630\u064e\u0627",
          "start": 830.229,
          "end": 830.646,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0647\u064f\u0645\u0652",
          "start": 830.646,
          "end": 831.062,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u064a\u064e\u0633\u0652\u062a\u064e\u0628\u0652\u0634\u0650\u0631\u064f\u0648\u0646\u064e",
          "start": 831.062,
          "end": 831.478,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "When someone else is mentioned with Allah Subhanahu Wa Ta'ala, they become happy.",
      "start": 831.478,
      "end": 835.968,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "When",
          "start": 831.478,
          "end": 831.823,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "someone",
          "start": 831.823,
