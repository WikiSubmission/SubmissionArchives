          "speaker": "Dr. Khalifa"
        },
        {
          "word": "criterion.",
          "start": 952.009,
          "end": 952.328,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"That when God alone is mentioned, I become upset.\"",
      "start": 952.847,
      "end": 956.216,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"That",
          "start": 952.847,
          "end": 953.221,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "when",
          "start": 953.221,
          "end": 953.596,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 953.596,
          "end": 953.97,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone",
          "start": 953.97,
          "end": 954.344,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 954.344,
          "end": 954.719,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "mentioned,",
          "start": 954.719,
          "end": 955.093,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 955.093,
          "end": 955.467,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "become",
          "start": 955.467,
          "end": 955.842,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "upset.\"",
          "start": 955.842,
          "end": 956.216,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This would tell me right away that I am an idol worshipper.",
      "start": 956.452,
      "end": 959.396,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 956.452,
          "end": 956.697,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "would",
          "start": 956.697,
          "end": 956.943,
          "speaker": "Dr. Khalifa"
