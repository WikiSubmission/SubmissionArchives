          "word": "when",
          "start": 1151.209,
          "end": 1151.579,
          "speaker": "A man"
        },
        {
          "word": "you",
          "start": 1151.579,
          "end": 1151.949,
          "speaker": "A man"
        },
        {
          "word": "preach",
          "start": 1151.949,
          "end": 1152.319,
          "speaker": "A man"
        },
        {
          "word": "your",
