          "word": "and",
          "start": 207.373,
          "end": 207.733,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 207.733,
          "end": 208.093,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "jinns",
          "start": 208.093,
          "end": 208.453,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "except",
          "start": 208.453,
          "end": 208.813,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 208.813,
          "end": 209.172,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "worship",
          "start": 209.172,
          "end": 209.532,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Me",
          "start": 209.532,
          "end": 209.892,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone.",
          "start": 209.892,
          "end": 210.252,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "That's what Allah Subhanahu Wa Ta'ala said.",
      "start": 210.252,
      "end": 211.775,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "That's",
          "start": 210.252,
          "end": 210.47,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "what",
          "start": 210.47,
          "end": 210.687,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Allah",
          "start": 210.687,
          "end": 210.905,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Subhanahu",
          "start": 210.905,
          "end": 211.122,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Wa",
          "start": 211.122,
          "end": 211.34,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Ta'ala",
          "start": 211.34,
          "end": 211.557,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "said.",
          "start": 211.557,
          "end": 211.775,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, that is the purpose of, of us being here.",
      "start": 211.775,
      "end": 214.801,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "So,",
          "start": 211.775,
          "end": 212.078,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 212.078,
          "end": 212.38,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 212.38,
          "end": 212.683,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 212.683,
          "end": 212.985,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "purpose",
          "start": 212.985,
          "end": 213.288,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of,",
          "start": 213.288,
          "end": 213.591,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 213.591,
          "end": 213.893,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "us",
          "start": 213.893,
          "end": 214.196,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "being",
          "start": 214.196,
          "end": 214.498,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "here.",
          "start": 214.498,
          "end": 214.801,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But what we forget to remember is that we have an archenemy.",
      "start": 215.603,
      "end": 221.054,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "But",
          "start": 215.603,
          "end": 216.057,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "what",
          "start": 216.057,
          "end": 216.512,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 216.512,
          "end": 216.966,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "forget",
          "start": 216.966,
          "end": 217.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 217.42,
          "end": 217.874,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "remember",
          "start": 217.874,
          "end": 218.329,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 218.329,
          "end": 218.783,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 218.783,
          "end": 219.237,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 219.237,
          "end": 219.691,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "have",
          "start": 219.691,
          "end": 220.146,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "an",
          "start": 220.146,
          "end": 220.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "archenemy.",
          "start": 220.6,
          "end": 221.054,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You and I have a common enemy that we must band together against, instead of fighting with each other.",
      "start": 221.847,
      "end": 229.106,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "You",
          "start": 221.847,
          "end": 222.229,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 222.229,
          "end": 222.611,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 222.611,
          "end": 222.993,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "have",
          "start": 222.993,
          "end": 223.375,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 223.375,
          "end": 223.757,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "common",
