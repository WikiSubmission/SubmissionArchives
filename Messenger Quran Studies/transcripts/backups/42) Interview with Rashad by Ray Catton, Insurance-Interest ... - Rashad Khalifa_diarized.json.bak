          "end": 1161.13,
          "speaker": "A man"
        },
        {
          "word": "refers",
          "start": 1161.13,
          "end": 1161.418,
          "speaker": "A man"
        },
        {
          "word": "to",
          "start": 1161.418,
          "end": 1161.707,
          "speaker": "A man"
        },
        {
          "word": "Rabbaka",
          "start": 1161.707,
          "end": 1161.995,
          "speaker": "A man"
        },
        {
          "word": "(\u0631\u064e\u0628\u0651\u064e\u0643\u064e)",
          "start": 1161.995,
          "end": 1162.284,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "(17:46) \u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0630\u064e\u0643\u064e\u0631\u0652\u062a\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0641\u0650\u0649 \u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u0650 \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f\u06e5 \u0648\u064e\u0644\u0651\u064e\u0648\u0652\u0627\u06df \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u062f\u0652\u0628\u064e\u0640\u0670\u0631\u0650\u0647\u0650\u0645\u0652 \u0646\u064f\u0641\u064f\u0648\u0631\u064b\u06ed\u0627",
      "start": 1162.284,
      "end": 1167.305,
      "speaker": "A man",
      "words": [
        {
          "word": "(17:46)",
          "start": 1162.284,
          "end": 1162.74,
          "speaker": "A man"
        },
        {
          "word": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627",
          "start": 1162.74,
          "end": 1163.197,
          "speaker": "A man"
        },
        {
          "word": "\u0630\u064e\u0643\u064e\u0631\u0652\u062a\u064e",
          "start": 1163.197,
          "end": 1163.653,
          "speaker": "A man"
        },
        {
          "word": "\u0631\u064e\u0628\u0651\u064e\u0643\u064e",
          "start": 1163.653,
          "end": 1164.11,
          "speaker": "A man"
        },
        {
          "word": "\u0641\u0650\u0649",
          "start": 1164.11,
          "end": 1164.566,
          "speaker": "A man"
        },
        {
          "word": "\u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u0650",
          "start": 1164.566,
          "end": 1165.023,
          "speaker": "A man"
        },
        {
          "word": "\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f\u06e5",
          "start": 1165.023,
          "end": 1165.479,
          "speaker": "A man"
        },
        {
          "word": "\u0648\u064e\u0644\u0651\u064e\u0648\u0652\u0627\u06df",
          "start": 1165.479,
          "end": 1165.936,
          "speaker": "A man"
        },
        {
          "word": "\u0639\u064e\u0644\u064e\u0649\u0670\u0653",
          "start": 1165.936,
          "end": 1166.392,
          "speaker": "A man"
        },
        {
          "word": "\u0623\u064e\u062f\u0652\u0628\u064e\u0640\u0670\u0631\u0650\u0647\u0650\u0645\u0652",
          "start": 1166.392,
          "end": 1166.849,
          "speaker": "A man"
        },
        {
          "word": "\u0646\u064f\u0641\u064f\u0648\u0631\u064b\u06ed\u0627",
          "start": 1166.849,
          "end": 1167.305,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "If you preach your Lord alone, in the Quran alone, without anything else besides the Quran, they turn away in aversion. They don't like it.",
      "start": 1167.966,
      "end": 1175.205,
      "speaker": "A man",
      "words": [
        {
          "word": "If",
          "start": 1167.966,
          "end": 1168.256,
          "speaker": "A man"
        },
