          "end": 1432.141,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f",
          "start": 1432.141,
          "end": 1432.615,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0628\u0650\u0671\u0644\u0652\u063a\u064e\u0645\u064e\u0640\u0670\u0645\u0650",
          "start": 1432.615,
          "end": 1433.089,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0648\u064e\u0646\u064f\u0632\u0651\u0650\u0644\u064e",
          "start": 1433.089,
          "end": 1433.563,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0652\u0645\u064e\u0644\u064e\u0640\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f",
          "start": 1433.563,
          "end": 1434.038,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u064b\u0627",
          "start": 1434.038,
          "end": 1434.512,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is obviously the Day of Judgement,",
      "start": 1434.512,
      "end": 1436.04,
      "speaker": "Dr. Khalifa",
      "words": [
