          "end": 1153.058,
          "speaker": "A man"
        },
        {
          "word": "using",
          "start": 1153.058,
          "end": 1153.428,
          "speaker": "A man"
        },
        {
          "word": "the",
          "start": 1153.428,
          "end": 1153.798,
          "speaker": "A man"
        },
        {
          "word": "Quran",
          "start": 1153.798,
          "end": 1154.168,
          "speaker": "A man"
        },
        {
          "word": "alone,",
          "start": 1154.168,
          "end": 1154.538,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "(17:46) \u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u0650 \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f\u06e5 \u0648\u064e\u0644\u0651\u064e\u0648\u0652\u0627\u06df \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u062f\u0652\u0628\u064e\u0640\u0670\u0631\u0650\u0647\u0650\u0645\u0652 \u0646\u064f\u0641\u064f\u0648\u0631\u064b\u06ed\u0627",
      "start": 1154.538,
      "end": 1157.246,
      "speaker": "A man",
      "words": [
        {
          "word": "(17:46)",
          "start": 1154.538,
          "end": 1154.925,
          "speaker": "A man"
        },
        {
          "word": "\u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u0650",
          "start": 1154.925,
          "end": 1155.312,
          "speaker": "A man"
        },
        {
          "word": "\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f\u06e5",
          "start": 1155.312,
          "end": 1155.699,
          "speaker": "A man"
        },
        {
          "word": "\u0648\u064e\u0644\u0651\u064e\u0648\u0652\u0627\u06df",
          "start": 1155.699,
          "end": 1156.085,
          "speaker": "A man"
        },
        {
          "word": "\u0639\u064e\u0644\u064e\u0649\u0670\u0653",
          "start": 1156.085,
          "end": 1156.472,
          "speaker": "A man"
        },
        {
          "word": "\u0623\u064e\u062f\u0652\u0628\u064e\u0640\u0670\u0631\u0650\u0647\u0650\u0645\u0652",
          "start": 1156.472,
          "end": 1156.859,
          "speaker": "A man"
        },
        {
          "word": "\u0646\u064f\u0641\u064f\u0648\u0631\u064b\u06ed\u0627",
          "start": 1156.859,
          "end": 1157.246,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "They turn away in aversion.",
      "start": 1157.246,
      "end": 1158.821,
      "speaker": "A man",
      "words": [
        {
          "word": "They",
          "start": 1157.246,
          "end": 1157.561,
          "speaker": "A man"
        },
        {
          "word": "turn",
          "start": 1157.561,
          "end": 1157.876,
          "speaker": "A man"
        },
        {
          "word": "away",
          "start": 1157.876,
          "end": 1158.191,
          "speaker": "A man"
        },
        {
          "word": "in",
          "start": 1158.191,
          "end": 1158.506,
          "speaker": "A man"
        },
        {
          "word": "aversion.",
          "start": 1158.506,
          "end": 1158.821,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "Some people believe that the word Wadahu (\u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f) refers to Rabbaka (\u0631\u064e\u0628\u0651\u064e\u0643\u064e)",
      "start": 1158.821,
      "end": 1162.284,
      "speaker": "A man",
      "words": [
        {
          "word": "Some",
          "start": 1158.821,
          "end": 1159.11,
          "speaker": "A man"
        },
        {
          "word": "people",
          "start": 1159.11,
          "end": 1159.398,
          "speaker": "A man"
        },
        {
          "word": "believe",
          "start": 1159.398,
          "end": 1159.687,
          "speaker": "A man"
        },
        {
          "word": "that",
