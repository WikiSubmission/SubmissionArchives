    {
      "text": "\u0648\u064e\u0644\u064e\u0648\u0652 \u0634\u064e\u0627\u0653\u0621\u064e \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0645\u064e\u0627 \u0641\u064e\u0639\u064e\u0644\u064f\u0648\u0647\u064f",
