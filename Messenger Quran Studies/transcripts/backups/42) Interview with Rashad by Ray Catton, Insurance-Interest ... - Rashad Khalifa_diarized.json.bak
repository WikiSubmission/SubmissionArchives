          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "When you preach your Lord using the Quran alone,...",
      "start": 1114.141,
      "end": 1117.038,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "When",
