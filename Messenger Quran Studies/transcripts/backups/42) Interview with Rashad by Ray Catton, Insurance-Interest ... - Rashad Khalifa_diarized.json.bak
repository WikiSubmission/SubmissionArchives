          "end": 2199.025,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran,",
          "start": 2199.025,
          "end": 2199.274,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 2199.274,
          "end": 2199.522,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "course.",
          "start": 2199.522,
          "end": 2199.771,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
