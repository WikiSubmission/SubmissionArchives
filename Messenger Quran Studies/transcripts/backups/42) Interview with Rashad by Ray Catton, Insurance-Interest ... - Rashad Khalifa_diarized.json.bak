          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"by God, our Lord, we are not idol worshipers.\"",
      "start": 521.837,
      "end": 524.734,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"by",
          "start": 521.837,
          "end": 522.159,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God,",
          "start": 522.159,
          "end": 522.481,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "our",
          "start": 522.481,
          "end": 522.803,
