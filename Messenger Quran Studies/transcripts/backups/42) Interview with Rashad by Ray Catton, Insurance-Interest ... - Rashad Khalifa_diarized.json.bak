        {
          "word": "\u0623\u064e\u0631\u0652\u0628\u064e\u0627\u0628\u064b\u06ed\u0627",
          "start": 399.591,
          "end": 399.977,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u0651\u0650\u0646",
