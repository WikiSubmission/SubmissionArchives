          "end": 1751.578,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(6:114) \u0623\u064e\u0641\u064e\u063a\u064e\u064a\u0652\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u0628\u0652\u062a\u064e\u063a\u0650\u0649 \u062d\u064e\u0643\u064e\u0645\u064b\u06ed\u0627",
      "start": 1751.861,
