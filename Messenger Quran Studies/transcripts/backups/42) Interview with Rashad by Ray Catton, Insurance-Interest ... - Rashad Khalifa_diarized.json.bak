    },
    {
      "text": "This is my story.",
      "start": 1175.205,
      "end": 1175.978,
      "speaker": "A man",
      "words": [
        {
          "word": "This",
          "start": 1175.205,
          "end": 1175.398,
          "speaker": "A man"
        },
        {
          "word": "is",
          "start": 1175.398,
          "end": 1175.591,
          "speaker": "A man"
        },
        {
          "word": "my",
          "start": 1175.591,
          "end": 1175.785,
          "speaker": "A man"
        },
        {
          "word": "story.",
          "start": 1175.785,
          "end": 1175.978,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "If I, I don't like somebody preaching God to me using the Quran alone,",
