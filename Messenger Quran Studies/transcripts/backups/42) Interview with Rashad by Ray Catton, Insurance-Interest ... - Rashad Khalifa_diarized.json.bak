        {
          "word": "\u0639\u064e\u0646\u0652\u0647\u064f",
          "start": 2088.24,
          "end": 2088.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062d\u064e\u0640\u0670\u062c\u0650\u0632\u0650\u064a\u0646\u064e",
