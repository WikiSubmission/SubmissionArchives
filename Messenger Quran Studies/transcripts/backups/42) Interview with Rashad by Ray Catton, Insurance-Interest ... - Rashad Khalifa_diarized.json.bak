        }
      ]
    },
    {
      "text": "\u0671\u0634\u0652\u0645\u064e\u0623\u064e\u0632\u0651\u064e\u062a\u0652 \u0642\u064f\u0644\u064f\u0648\u0628\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u0652\u0640\u0654\u064e\u0627\u062e\u0650\u0631\u064e\u0629\u0650",
