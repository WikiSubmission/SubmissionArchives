          "start": 256.169,
          "end": 256.427,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "swore",
          "start": 256.427,
          "end": 256.685,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 256.685,
          "end": 256.943,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "he",
          "start": 256.943,
          "end": 257.201,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "will",
          "start": 257.201,
          "end": 257.459,
          "speaker": "Dr. Khalifa"
        },
