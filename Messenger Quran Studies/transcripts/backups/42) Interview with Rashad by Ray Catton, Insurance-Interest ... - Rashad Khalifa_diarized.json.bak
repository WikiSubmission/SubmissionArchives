          "end": 1114.463,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "you",
          "start": 1114.463,
          "end": 1114.785,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "preach",
          "start": 1114.785,
          "end": 1115.107,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "your",
          "start": 1115.107,
          "end": 1115.429,
