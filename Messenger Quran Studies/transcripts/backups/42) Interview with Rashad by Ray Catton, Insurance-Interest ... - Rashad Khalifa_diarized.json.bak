          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064f\u0648\u0653\u0627\u06df",
          "start": 360.263,
          "end": 360.726,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0623\u064e\u062d\u0652\u0628\u064e\u0627\u0631\u064e\u0647\u064f\u0645\u0652",
