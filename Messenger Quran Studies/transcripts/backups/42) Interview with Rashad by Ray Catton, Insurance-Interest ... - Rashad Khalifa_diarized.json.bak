    {
      "text": "\u064a\u064f\u0648\u062d\u0650\u0649 \u0628\u064e\u0639\u0652\u0636\u064f\u0647\u064f\u0645\u0652 \u0625\u0650\u0644\u064e\u0649\u0670 \u0628\u064e\u0639\u0652\u0636\u064d\u06e2 \u0632\u064f\u062e\u0652\u0631\u064f\u0641\u064e \u0671\u0644\u0652\u0642\u064e\u0648\u0652\u0644\u0650 \u063a\u064f\u0631\u064f\u0648\u0631\u064b\u06ed\u0627",
