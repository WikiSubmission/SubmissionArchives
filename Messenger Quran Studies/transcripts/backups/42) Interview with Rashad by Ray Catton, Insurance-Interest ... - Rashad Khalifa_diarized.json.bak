          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0644\u0651\u064e\u0647\u0650",
          "start": 1752.567,
          "end": 1752.919,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0623\u064e\u0628\u0652\u062a\u064e\u063a\u0650\u0649",
          "start": 1752.919,
          "end": 1753.272,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062d\u064e\u0643\u064e\u0645\u064b\u06ed\u0627",
