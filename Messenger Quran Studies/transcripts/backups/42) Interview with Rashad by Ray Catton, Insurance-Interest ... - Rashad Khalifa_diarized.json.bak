    {
      "text": "\u0648\u064e\u0623\u064f\u0648\u062d\u0650\u0649\u064e \u0625\u0650\u0644\u064e\u0649\u0651\u064e \u0647\u064e\u0640\u0670\u0630\u064e\u0627 \u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u064f",
