          "speaker": "Dr. Khalifa"
        },
        {
          "word": " was",
          "start": 4776.47,
          "end": 4776.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " on",
          "start": 4776.57,
          "end": 4776.73,
          "speaker": "Dr. Khalifa"
        },
        {
