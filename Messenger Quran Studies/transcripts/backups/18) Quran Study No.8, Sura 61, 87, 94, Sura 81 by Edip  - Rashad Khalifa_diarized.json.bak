          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It is not the person.",
      "start": 4563.89,
      "end": 4565.43,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " It",
          "start": 4563.89,
