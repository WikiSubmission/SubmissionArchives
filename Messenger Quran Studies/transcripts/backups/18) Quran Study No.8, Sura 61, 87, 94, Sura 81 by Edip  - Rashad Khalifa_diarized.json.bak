          "end": 3832.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3832.11,
          "end": 3832.47,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " ordered...",
          "start": 3832.47,
          "end": 3833.37,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "No, no, excuse me.",
      "start": 3833.69,
      "end": 3834.49,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " No,",
          "start": 3833.69,
          "end": 3833.89,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " no,",
          "start": 3833.89,
          "end": 3833.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " excuse",
          "start": 3834.07,
          "end": 3834.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " me.",
          "start": 3834.15,
          "end": 3834.49,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In Pakistan, a judge ordered the execution of six people, because of sex crimes.",
      "start": 3834.49,
      "end": 3841.11,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " In",
          "start": 3834.49,
          "end": 3834.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Pakistan,",
          "start": 3834.83,
          "end": 3835.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3835.83,
          "end": 3835.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " judge",
          "start": 3835.85,
          "end": 3835.97,
          "speaker": "Dr. Khalifa"
        },
