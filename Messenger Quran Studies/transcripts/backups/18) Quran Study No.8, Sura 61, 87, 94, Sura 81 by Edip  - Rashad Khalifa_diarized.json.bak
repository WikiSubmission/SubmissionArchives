        },
        {
          "word": " death,",
          "start": 3891.93,
          "end": 3892.51,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " because",
          "start": 3893.19,
          "end": 3893.37,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3893.37,
          "end": 3893.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " knew",
          "start": 3893.57,
          "end": 3893.71,
