          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I mean, this is the least...",
      "start": 2523.87,
      "end": 2524.82,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I",
