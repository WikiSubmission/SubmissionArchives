          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " food",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " bank.",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In Tucson, there's a food bank.",
      "start": 2472.01,
      "end": 2472.01,
      "speaker": "Dr. Khalifa",
      "words": [
