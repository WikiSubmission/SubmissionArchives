          "end": 2508.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " commandment.",
          "start": 2521.31,
          "end": 2522.11,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Right. Right.",
      "start": 2522.11,
      "end": 2523.69,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Right.",
          "start": 2522.11,
