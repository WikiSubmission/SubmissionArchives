        },
        {
          "word": " this,",
          "start": 4781.49,
          "end": 4781.63,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " out",
          "start": 4782.05,
          "end": 4782.19,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 4782.19,
