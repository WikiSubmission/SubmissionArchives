        }
      ]
    },
    {
      "text": "I forget where it is exactly.",
      "start": 4614.47,
      "end": 4615.4,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I",
          "start": 4614.47,
          "end": 4614.47,
