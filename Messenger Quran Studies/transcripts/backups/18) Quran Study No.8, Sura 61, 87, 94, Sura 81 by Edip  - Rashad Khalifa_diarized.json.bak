          "end": 4614.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 4614.85,
          "end": 4614.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 4614.99,
          "end": 4615.05,
