        },
        {
          "word": " God.",
          "start": 546.99,
          "end": 548.09,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "That's your part.",
      "start": 549.59,
      "end": 551.01,
      "speaker": "Dr. Khalifa",
      "words": [
