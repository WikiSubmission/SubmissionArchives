        },
        {
          "word": " woman,",
          "start": 3859.73,
          "end": 3860.08,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " according",
          "start": 3860.49,
          "end": 3860.79,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3860.79,
          "end": 3861.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3861.03,
          "end": 3861.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " so-called",
          "start": 3861.23,
          "end": 3861.91,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Islamic",
          "start": 3861.91,
          "end": 3862.35,
