          "end": 2701.55,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because it's applicable for everybody.",
      "start": 2703.05,
      "end": 2704.87,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Because",
          "start": 2703.05,
          "end": 2703.37,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it's",
          "start": 2703.37,
          "end": 2703.61,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " applicable",
          "start": 2703.61,
          "end": 2703.89,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " for",
          "start": 2703.89,
          "end": 2704.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " everybody.",
          "start": 2704.17,
          "end": 2704.87,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "If they want to apply it...",
