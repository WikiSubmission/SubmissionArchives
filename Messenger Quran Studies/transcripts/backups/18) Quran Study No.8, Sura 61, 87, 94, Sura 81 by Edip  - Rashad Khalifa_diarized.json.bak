          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "[93:8]  He found you poor, and He made you rich.",
      "start": 2698.65,
      "end": 2701.55,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " [93:8]",
