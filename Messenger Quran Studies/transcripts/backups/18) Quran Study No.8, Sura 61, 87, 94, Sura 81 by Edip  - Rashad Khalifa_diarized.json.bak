          "end": 3894.41,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I have this on my desk. If you don't believe it, you can read it later.",
      "start": 3895.51,
      "end": 3898.95,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I",
