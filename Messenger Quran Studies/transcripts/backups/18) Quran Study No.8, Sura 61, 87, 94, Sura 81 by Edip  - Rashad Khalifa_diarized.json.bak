          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 2664.05,
          "end": 2664.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " lot",
          "start": 2664.11,
          "end": 2664.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 2664.21,
          "end": 2664.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " funny",
