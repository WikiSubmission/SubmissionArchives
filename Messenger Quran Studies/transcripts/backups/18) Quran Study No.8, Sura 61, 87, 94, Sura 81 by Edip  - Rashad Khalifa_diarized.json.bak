          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 3590.49,
          "end": 3590.63,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3590.63,
          "end": 3590.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " while",
          "start": 3590.67,
          "end": 3590.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " who",
          "start": 3590.83,
          "end": 3591.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " prefer",
          "start": 3591.11,
          "end": 3592.47,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3592.47,
          "end": 3592.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " have",
          "start": 3592.69,
          "end": 3592.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3592.83,
          "end": 3592.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " son",
          "start": 3592.95,
          "end": 3593.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " over",
          "start": 3593.17,
          "end": 3593.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3593.49,
          "end": 3593.63,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " daughter.",
          "start": 3593.63,
          "end": 3594.09,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And I really sock it to them when they come up with that.",
      "start": 3595.19,
      "end": 3599.63,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 3595.19,
          "end": 3595.59,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I",
          "start": 3595.59,
          "end": 3595.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " really",
          "start": 3595.69,
          "end": 3595.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " sock",
          "start": 3595.93,
          "end": 3596.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 3596.43,
          "end": 3596.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
