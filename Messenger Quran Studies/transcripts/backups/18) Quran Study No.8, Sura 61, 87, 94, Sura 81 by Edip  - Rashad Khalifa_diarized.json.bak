        },
        {
          "word": " after",
          "start": 4671.21,
          "end": 4671.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 4671.69,
          "end": 4671.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " age",
          "start": 4671.85,
          "end": 4671.95,
          "speaker": "Dr. Khalifa"
        },
