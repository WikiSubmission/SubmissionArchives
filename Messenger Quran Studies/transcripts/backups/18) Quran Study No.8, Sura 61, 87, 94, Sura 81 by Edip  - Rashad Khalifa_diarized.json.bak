          "end": 4672.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " 40.",
          "start": 4672.13,
          "end": 4672.69,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This has been consistent except for the Prophet Jesus for special reasons.",
