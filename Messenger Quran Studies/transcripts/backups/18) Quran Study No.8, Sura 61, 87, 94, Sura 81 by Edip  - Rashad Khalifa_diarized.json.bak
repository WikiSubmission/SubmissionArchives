          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " meet",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " these",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " people",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
