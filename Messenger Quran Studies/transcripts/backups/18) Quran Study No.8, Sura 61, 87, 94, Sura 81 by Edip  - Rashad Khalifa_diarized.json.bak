      "end": 3951.65,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I'm",
          "start": 3948.53,
          "end": 3948.63,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " telling",
