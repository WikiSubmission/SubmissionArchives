          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " street.",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They come to your door.",
      "start": 2472.01,
      "end": 2472.01,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " They",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " come",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " your",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " door.",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You have to act.",
      "start": 2472.01,
      "end": 2472.01,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " have",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " act.",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There's a commandment here not to reprimand the beggar.",
