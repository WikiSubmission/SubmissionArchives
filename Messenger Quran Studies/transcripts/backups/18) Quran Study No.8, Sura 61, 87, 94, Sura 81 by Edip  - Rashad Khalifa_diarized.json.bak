        },
        {
          "word": " \"ok\"",
          "start": 2672.03,
          "end": 2673.25,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"So, he was astray.\"",
      "start": 2673.25,
      "end": 2674.61,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"So,",
          "start": 2673.25,
          "end": 2673.35,
          "speaker": "Dr. Khalifa"
        },
