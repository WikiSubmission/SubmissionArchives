          "end": 4585.37,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " everything",
          "start": 4585.37,
          "end": 4585.77,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that",
          "start": 4585.77,
          "end": 4586.03,
          "speaker": "Dr. Khalifa"
        },
