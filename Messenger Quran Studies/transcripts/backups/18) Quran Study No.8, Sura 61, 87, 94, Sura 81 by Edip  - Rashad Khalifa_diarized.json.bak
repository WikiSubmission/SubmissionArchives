          "word": " if",
          "start": 4716.25,
          "end": 4716.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you...If",
          "start": 4716.49,
          "end": 4717.37,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 4717.37,
