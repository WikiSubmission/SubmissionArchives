        },
        {
          "word": " his",
          "start": 2675.85,
          "end": 2676.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mind.",
          "start": 2676.05,
          "end": 2676.55,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, we...",
      "start": 2677.71,
      "end": 2679.03,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " So,",
          "start": 2677.71,
