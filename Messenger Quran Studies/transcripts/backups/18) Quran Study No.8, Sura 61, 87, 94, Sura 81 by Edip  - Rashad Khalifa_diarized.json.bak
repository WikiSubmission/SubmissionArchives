        },
        {
          "word": " call",
          "start": 4699.85,
          "end": 4699.97,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " me",
          "start": 4699.97,
          "end": 4700.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " crazy",
          "start": 4700.11,
          "end": 4700.37,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " now?\"",
          "start": 4700.37,
          "end": 4701.37,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Wait to examine what I'm saying. Yes.",
      "start": 4701.39,
      "end": 4704.17,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Wait",
          "start": 4701.39,
