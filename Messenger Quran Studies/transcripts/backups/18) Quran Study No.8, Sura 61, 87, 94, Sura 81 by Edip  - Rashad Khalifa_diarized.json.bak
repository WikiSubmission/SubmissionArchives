          "speaker": "Dr. Khalifa"
        },
        {
          "word": " special",
          "start": 4676.71,
          "end": 4677.29,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " reasons.",
          "start": 4677.29,
          "end": 4678.14,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But every messenger was appointed after the age of 40.",
      "start": 4678.87,
      "end": 4680.97,
      "speaker": "Dr. Khalifa",
