          "end": 3572.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " commit",
          "start": 3572.53,
          "end": 3572.77,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " this",
          "start": 3572.77,
          "end": 3573.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " horrendous",
          "start": 3573.01,
          "end": 3573.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " crime.",
          "start": 3575.25,
          "end": 3575.35,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's a demonstration of stupidity.",
      "start": 3576.29,
      "end": 3579.26,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " It's",
          "start": 3576.29,
          "end": 3577.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3577.17,
          "end": 3577.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " demonstration",
          "start": 3577.21,
          "end": 3577.71,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 3577.71,
          "end": 3578.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " stupidity.",
          "start": 3578.01,
          "end": 3579.26,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, believers don't have that.",
      "start": 3583.39,
      "end": 3585.35,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " So,",
          "start": 3583.39,
          "end": 3584.19,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " believers",
          "start": 3584.37,
          "end": 3584.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " don't",
          "start": 3584.41,
          "end": 3584.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " have",
          "start": 3584.73,
          "end": 3584.91,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that.",
          "start": 3584.91,
          "end": 3585.35,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I come across believers once in a while who prefer to have a son over a daughter.",
      "start": 3589.07,
      "end": 3594.09,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I",
          "start": 3589.07,
          "end": 3589.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " come",
          "start": 3589.13,
          "end": 3589.29,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " across",
          "start": 3589.29,
          "end": 3589.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " believers",
          "start": 3589.57,
          "end": 3589.99,
          "speaker": "Dr. Khalifa"
        },
