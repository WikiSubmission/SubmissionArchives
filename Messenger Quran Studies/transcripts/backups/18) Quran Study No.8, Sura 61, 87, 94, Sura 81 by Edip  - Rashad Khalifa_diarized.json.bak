          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In other words, this is a quotation in the Quran, do you remember it?",
      "start": 4610.91,
      "end": 4614.11,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " In",
