          "word": " he",
          "start": 2673.35,
          "end": 2673.35,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " was",
          "start": 2673.35,
          "end": 2673.55,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " astray.\"",
          "start": 2673.55,
          "end": 2674.61,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And then five minutes later he changed his mind.",
