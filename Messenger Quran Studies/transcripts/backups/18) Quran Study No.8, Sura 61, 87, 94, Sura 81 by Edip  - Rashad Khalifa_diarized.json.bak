          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "She doesn't know where he is.",
      "start": 3959.41,
      "end": 3960.47,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " She",
          "start": 3959.41,
