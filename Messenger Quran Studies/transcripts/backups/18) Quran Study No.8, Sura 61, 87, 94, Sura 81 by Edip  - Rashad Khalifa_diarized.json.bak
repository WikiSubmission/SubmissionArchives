          "speaker": "Dr. Khalifa"
        },
        {
          "word": " may",
          "start": 649.71,
          "end": 649.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " say",
          "start": 649.93,
          "end": 650.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"Robert",
          "start": 650.21,
          "end": 650.71,
