          "end": 3567.84,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And of course the hint is for those who commit this horrendous crime.",
      "start": 3570.19,
      "end": 3575.35,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
