          "word": " Tucson,",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " there's",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " food",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " bank.",
          "start": 2472.01,
          "end": 2472.01,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But, sometimes you meet these people in the street.",
