        },
        {
          "word": " it.",
          "start": 2661.67,
          "end": 2662.21,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We had a lot of funny encounters.",
      "start": 2663.85,
      "end": 2664.95,
      "speaker": "Dr. Khalifa",
      "words": [
        {
