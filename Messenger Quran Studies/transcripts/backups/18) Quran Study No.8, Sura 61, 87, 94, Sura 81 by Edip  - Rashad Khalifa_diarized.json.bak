          "end": 3837.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " six",
          "start": 3837.49,
          "end": 3837.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " people,",
          "start": 3837.67,
          "end": 3838.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " because",
          "start": 3839.55,
          "end": 3839.81,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 3839.81,
          "end": 3840.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " sex",
          "start": 3840.15,
          "end": 3840.51,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " crimes.",
          "start": 3840.51,
          "end": 3841.11,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is the headline.",
      "start": 3841.11,
      "end": 3842.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " This",
          "start": 3841.11,
          "end": 3841.19,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3841.19,
          "end": 3841.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3841.31,
          "end": 3841.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " headline.",
          "start": 3841.57,
          "end": 3842.22,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And when you read the article, you find out that this lady didn't like her husband, so she left him.",
