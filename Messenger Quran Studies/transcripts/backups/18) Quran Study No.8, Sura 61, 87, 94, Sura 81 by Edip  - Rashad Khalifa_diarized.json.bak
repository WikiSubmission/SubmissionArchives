        },
        {
          "word": " years",
          "start": 3868.57,
          "end": 3868.71,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " later,",
          "start": 3868.71,
          "end": 3869.26,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " she",
          "start": 3869.29,
          "end": 3869.35,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " married",
          "start": 3869.35,
          "end": 3869.55,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " somebody",
          "start": 3869.55,
          "end": 3869.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " else.",
          "start": 3869.93,
          "end": 3870.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Now, her former husband complained, and they ruled that she and her new husband have committed adultery.",
      "start": 3871.59,
      "end": 3884.33,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Now,",
          "start": 3871.59,
          "end": 3871.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " her",
          "start": 3871.85,
          "end": 3872.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " former",
          "start": 3872.41,
          "end": 3874.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " husband",
