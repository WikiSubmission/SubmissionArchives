          "speaker": "Dr. Khalifa"
        },
        {
          "word": " destroy",
          "start": 652.75,
          "end": 652.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " his",
          "start": 652.75,
          "end": 652.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " car",
