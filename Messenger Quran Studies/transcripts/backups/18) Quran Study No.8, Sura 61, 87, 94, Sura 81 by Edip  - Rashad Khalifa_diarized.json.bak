        },
        {
          "word": " of",
          "start": 3570.79,
          "end": 3570.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " course",
          "start": 3570.93,
          "end": 3571.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
