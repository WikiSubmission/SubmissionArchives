          "word": " doesn't",
          "start": 3959.43,
          "end": 3959.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " know",
          "start": 3959.69,
          "end": 3959.79,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " where",
          "start": 3959.79,
          "end": 3959.91,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " he",
          "start": 3959.91,
          "end": 3960.07,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is.",
          "start": 3960.07,
          "end": 3960.47,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "She's grounded in the apartment or the house or the place that's assigned for her.",
