          "end": 2705.63,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " want",
          "start": 2705.63,
          "end": 2705.77,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 2705.77,
