        },
        {
          "word": " them",
          "start": 3596.73,
          "end": 3596.87,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " when",
          "start": 3596.87,
          "end": 3598.59,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3598.59,
          "end": 3598.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " come",
          "start": 3598.73,
          "end": 3598.89,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " up",
          "start": 3598.95,
          "end": 3599.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " with",
          "start": 3599.11,
          "end": 3599.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that.",
          "start": 3599.23,
          "end": 3599.63,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because there is no preference whatsoever, I mean, as far as God is concerned.",
      "start": 3599.83,
      "end": 3606.76,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Because",
          "start": 3599.83,
          "end": 3599.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " there",
          "start": 3599.83,
          "end": 3601.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3601.67,
          "end": 3601.81,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " no",
          "start": 3601.81,
          "end": 3602.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " preference",
          "start": 3603.05,
          "end": 3603.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " whatsoever,",
          "start": 3603.21,
          "end": 3604.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I",
          "start": 3604.93,
          "end": 3604.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mean,",
          "start": 3604.93,
          "end": 3605.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " as",
          "start": 3605.27,
          "end": 3605.27,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " far",
          "start": 3605.27,
          "end": 3605.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " as",
          "start": 3605.39,
          "end": 3605.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 3605.65,
          "end": 3606.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3606.01,
          "end": 3606.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " concerned.",
          "start": 3606.21,
          "end": 3606.76,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It may even be the other way around.",
      "start": 3608.97,
      "end": 3610.18,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " It",
          "start": 3608.97,
          "end": 3608.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " may",
          "start": 3608.99,
          "end": 3609.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " even",
          "start": 3609.05,
          "end": 3609.27,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 3609.27,
          "end": 3609.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3609.43,
          "end": 3609.55,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " other",
          "start": 3609.55,
          "end": 3609.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " way",
          "start": 3609.69,
          "end": 3609.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " around.",
          "start": 3609.83,
          "end": 3610.18,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In fact, there are sayings, I think here in the States maybe, even other countries also,",
      "start": 3611.89,
      "end": 3620.71,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " In",
