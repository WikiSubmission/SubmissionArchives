          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because he's...",
      "start": 464.33,
      "end": 465.63,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Because",
          "start": 464.33,
