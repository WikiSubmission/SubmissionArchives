        }
      ]
    },
    {
      "text": "In almost all the Tafseers and interpretations, they interpret this Sura as if God is talking to Muhammad only person.",
      "start": 2715.91,
      "end": 2721.77,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " In",
          "start": 2715.91,
          "end": 2715.91,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " almost",
          "start": 2715.91,
          "end": 2716.09,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " all",
          "start": 2716.09,
          "end": 2716.47,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2716.47,
          "end": 2716.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Tafseers",
          "start": 2716.67,
          "end": 2717.09,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 2717.09,
          "end": 2717.27,
          "speaker": "Dr. Khalifa"
