        },
        {
          "word": " rule.",
          "start": 3086.9,
          "end": 3087.45,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "If the guy has only left hand...",
      "start": 3089.52,
      "end": 3090.58,
      "speaker": "Dr. Khalifa",
