        },
        {
          "word": " funny",
          "start": 3079.92,
          "end": 3080.36,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " things",
          "start": 3080.36,
          "end": 3080.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that...",
          "start": 3080.66,
