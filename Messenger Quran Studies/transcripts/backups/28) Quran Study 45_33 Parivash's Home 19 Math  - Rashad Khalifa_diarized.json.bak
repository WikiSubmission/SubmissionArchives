          "end": 3090.08,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " left",
          "start": 3090.08,
          "end": 3090.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " hand...",
          "start": 3090.28,
          "end": 3090.58,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Yes.",
      "start": 3091.62,
      "end": 3092.12,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 3091.62,
          "end": 3092.12,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There's a rule about how to go to bathroom",
      "start": 3092.14,
      "end": 3093.1,
      "speaker": "A man",
      "words": [
