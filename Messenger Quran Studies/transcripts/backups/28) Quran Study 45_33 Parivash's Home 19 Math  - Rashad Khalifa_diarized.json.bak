          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Quran?",
          "start": 3271.94,
          "end": 3272.34,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "How many people actually believe in this?",
      "start": 3272.62,
      "end": 3274.97,
      "speaker": "A man",
      "words": [
        {
          "word": " How",
          "start": 3272.62,
