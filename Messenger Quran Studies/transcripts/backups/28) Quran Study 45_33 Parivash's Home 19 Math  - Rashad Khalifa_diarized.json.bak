        },
        {
          "word": " that?",
          "start": 3264.46,
          "end": 3264.66,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "Yes.",
      "start": 3265.16,
      "end": 3265.4,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 3265.16,
          "end": 3265.4,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
