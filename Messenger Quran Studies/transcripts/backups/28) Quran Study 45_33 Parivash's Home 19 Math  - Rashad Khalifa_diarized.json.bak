          "speaker": "Dr. Khalifa"
        },
        {
          "word": " were",
          "start": 724.44,
          "end": 724.64,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " completely",
          "start": 724.64,
          "end": 725.06,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 725.06,
          "end": 725.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " utterly",
          "start": 725.44,
          "end": 725.72,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " wrong.",
          "start": 725.72,
          "end": 726.18,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"It is all gross falsehood, because there are only 19 times\" Now notice the number 19.",
      "start": 726.78,
      "end": 732.0,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"It",
          "start": 726.78,
          "end": 726.8,
