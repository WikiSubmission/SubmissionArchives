          "word": " turns",
          "start": 3083.04,
          "end": 3083.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " out",
          "start": 3083.14,
          "end": 3083.3,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3083.3,
          "end": 3083.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 3083.44,
          "end": 3083.56,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3083.56,
          "end": 3083.7,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " rule.",
          "start": 3083.7,
          "end": 3084.05,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They make up this difficult rule.",
      "start": 3085.82,
      "end": 3087.45,
