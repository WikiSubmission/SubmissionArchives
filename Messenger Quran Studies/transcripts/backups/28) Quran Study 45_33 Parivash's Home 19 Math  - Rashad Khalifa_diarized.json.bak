      "end": 1840.56,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " He",
          "start": 1837.0,
          "end": 1837.08,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 1837.08,
