          "start": 731.66,
          "end": 732.0,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"There are only 19 times that the Holy Name is mentioned, in that portion of the morning prayer.",
      "start": 732.72,
      "end": 737.28,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"There",
          "start": 732.72,
          "end": 732.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
          "start": 732.74,
          "end": 732.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " only",
