        },
        {
          "word": " guy",
          "start": 3089.72,
          "end": 3089.84,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " has",
          "start": 3089.84,
          "end": 3089.98,
          "speaker": "Dr. Khalifa"
        },
