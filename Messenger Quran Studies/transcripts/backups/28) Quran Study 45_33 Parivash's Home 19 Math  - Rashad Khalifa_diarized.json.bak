      ]
    },
    {
      "text": "\"And our Rabbi the Pious, of blessed memory, wrote that they were completely and utterly wrong.",
      "start": 720.94,
      "end": 726.18,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"And",
          "start": 720.94,
          "end": 721.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " our",
          "start": 721.04,
          "end": 721.26,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Rabbi",
          "start": 721.26,
          "end": 721.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 721.6,
          "end": 721.84,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Pious,",
          "start": 721.84,
          "end": 722.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 722.76,
          "end": 722.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " blessed",
          "start": 722.76,
          "end": 723.0,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " memory,",
          "start": 723.0,
          "end": 723.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " wrote",
