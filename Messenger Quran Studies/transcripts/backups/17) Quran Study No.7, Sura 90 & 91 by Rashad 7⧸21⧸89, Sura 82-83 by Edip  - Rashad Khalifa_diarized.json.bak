        },
        {
          "word": " fun.",
          "start": 4837.24,
          "end": 4837.68,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "[83:31]  When they got together with their people, they used to joke.",
      "start": 4838.54,
      "end": 4841.58,
      "speaker": "Edip",
      "words": [
        {
          "word": " [83:31]",
