          "start": 4852.98,
          "end": 4853.78,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "[83:35]  On luxurious furnishings they watch.",
      "start": 4855.04,
      "end": 4858.9,
      "speaker": "Edip",
      "words": [
        {
