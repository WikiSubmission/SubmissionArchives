          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "[83:28]  From a spring that is reserved for those close to Me.",
      "start": 4826.28,
      "end": 4829.92,
      "speaker": "Edip",
      "words": [
        {
          "word": " [83:28]",
