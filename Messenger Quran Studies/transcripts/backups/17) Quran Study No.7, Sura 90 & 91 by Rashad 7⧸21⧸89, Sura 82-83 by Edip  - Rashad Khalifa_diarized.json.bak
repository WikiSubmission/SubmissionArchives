          "end": 4846.7,
          "speaker": "Edip"
        },
        {
          "word": " have",
          "start": 4846.7,
          "end": 4846.86,
          "speaker": "Edip"
        },
        {
          "word": " no",
          "start": 4846.86,
          "end": 4847.06,
          "speaker": "Edip"
        },
