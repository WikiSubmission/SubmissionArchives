        },
        {
          "word": " said,",
          "start": 4843.68,
          "end": 4844.38,
          "speaker": "Edip"
        },
        {
          "word": " \"These",
          "start": 4844.6,
          "end": 4844.72,
          "speaker": "Edip"
        },
        {
          "word": " people",
          "start": 4844.72,
          "end": 4844.98,
          "speaker": "Edip"
        },
        {
          "word": " are",
          "start": 4844.98,
          "end": 4845.18,
          "speaker": "Edip"
        },
        {
          "word": " far",
          "start": 4845.18,
          "end": 4845.42,
          "speaker": "Edip"
        },
        {
          "word": " astray!",
          "start": 4845.42,
          "end": 4846.54,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "[83:33]  \"They have no such thing as (invisible) guards.\"",
      "start": 4846.6,
      "end": 4850.02,
      "speaker": "Edip",
      "words": [
        {
          "word": " [83:33]",
          "start": 4846.6,
          "end": 4846.62,
          "speaker": "Edip"
        },
        {
          "word": "  \"They",
