    },
    {
      "text": "Yes.",
      "start": 2230.53,
      "end": 2233.25,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 2230.53,
          "end": 2233.25,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Right.",
