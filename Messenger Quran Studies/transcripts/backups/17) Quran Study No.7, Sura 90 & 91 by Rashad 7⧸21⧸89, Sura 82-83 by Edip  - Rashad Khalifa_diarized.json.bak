          "start": 4833.84,
          "end": 4834.92,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "[83:30]  When they passed by them, they used to poke fun.",
      "start": 4835.04,
      "end": 4837.68,
      "speaker": "Edip",
      "words": [
        {
          "word": " [83:30]",
