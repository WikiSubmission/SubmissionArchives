          "start": 4841.24,
          "end": 4841.58,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "[83:32]  Whenever they saw them, they said, \"These people are far astray!",
      "start": 4842.56,
      "end": 4846.54,
      "speaker": "Edip",
      "words": [
        {
          "word": " [83:32]",
          "start": 4842.56,
          "end": 4842.56,
          "speaker": "Edip"
        },
        {
          "word": "  Whenever",
          "start": 4842.56,
          "end": 4842.56,
          "speaker": "Edip"
        },
        {
          "word": " they",
          "start": 4842.56,
          "end": 4842.94,
          "speaker": "Edip"
        },
        {
          "word": " saw",
          "start": 4842.94,
          "end": 4843.22,
          "speaker": "Edip"
        },
        {
          "word": " them,",
          "start": 4843.22,
