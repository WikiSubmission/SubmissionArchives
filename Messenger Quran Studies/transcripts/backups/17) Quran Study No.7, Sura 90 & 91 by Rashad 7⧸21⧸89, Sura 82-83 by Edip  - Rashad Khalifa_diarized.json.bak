          "speaker": "Dr. Khalifa"
        },
        {
          "word": " ourselves.",
          "start": 666.27,
          "end": 667.61,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Go back to God's kingdom where we were.",
      "start": 667.85,
      "end": 669.8,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Go",
