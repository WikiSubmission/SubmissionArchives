        }
      ]
    },
    {
      "text": "[83:1]  Woe to the cheaters.",
      "start": 4467.5,
      "end": 4469.33,
      "speaker": "Edip",
      "words": [
        {
          "word": " [83:1]",
          "start": 4467.5,
          "end": 4467.72,
