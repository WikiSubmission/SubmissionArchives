          "end": 4849.62,
          "speaker": "Edip"
        },
        {
          "word": " guards.\"",
          "start": 4849.84,
          "end": 4850.02,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "[83:34]  Today, those who believed are laughing at the disbelievers.",
      "start": 4850.86,
      "end": 4853.78,
      "speaker": "Edip",
      "words": [
        {
          "word": " [83:34]",
          "start": 4850.86,
