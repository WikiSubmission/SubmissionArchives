      "end": 2235.45,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Right.",
          "start": 2233.25,
          "end": 2235.45,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
