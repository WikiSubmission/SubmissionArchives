        },
        {
          "word": " are",
          "start": 373.88,
          "end": 374.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " disbelievers.",
          "start": 374.14,
          "end": 374.64,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I should put it this way. Half are believers.",
