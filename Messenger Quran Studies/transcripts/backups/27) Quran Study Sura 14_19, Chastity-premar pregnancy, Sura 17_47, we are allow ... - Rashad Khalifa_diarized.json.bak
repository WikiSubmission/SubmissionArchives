          "end": 4899.61,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 4899.61,
          "end": 4900.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Creator.",
          "start": 4900.15,
          "end": 4901.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " As",
          "start": 4901.31,
          "end": 4901.45,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "As far as God is concerned, there is no time.",
      "start": 4901.51,
      "end": 4913.23,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " far",
          "start": 4901.51,
