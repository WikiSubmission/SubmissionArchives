          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 4920.51,
          "end": 4920.51,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "God already knows about this. So, are they created yet?",
      "start": 4920.63,
      "end": 4940.99,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " already",
          "start": 4920.63,
