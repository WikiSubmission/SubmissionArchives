          "word": " mean?",
          "start": 345.18,
          "end": 345.3,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "But you see, my mother was not actively preaching, not continuously.",
      "start": 345.42,
      "end": 350.3,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " But",
