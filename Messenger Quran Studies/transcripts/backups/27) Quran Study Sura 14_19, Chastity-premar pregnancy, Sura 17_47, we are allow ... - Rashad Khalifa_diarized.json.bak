          "end": 4918.89,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 4918.89,
          "end": 4918.89,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " people",
          "start": 4918.93,
