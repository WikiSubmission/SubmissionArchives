          "end": 360.84,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " must",
          "start": 360.88,
          "end": 361.0,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " trust",
          "start": 361.0,
          "end": 361.26,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 361.26,
          "end": 361.46,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 361.48,
          "end": 361.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone,",
          "start": 361.58,
          "end": 362.02,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " nobody",
          "start": 362.06,
          "end": 362.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " else.\"",
          "start": 362.28,
          "end": 362.48,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And she kind of gave up because we all ganged up on her, with my father.",
