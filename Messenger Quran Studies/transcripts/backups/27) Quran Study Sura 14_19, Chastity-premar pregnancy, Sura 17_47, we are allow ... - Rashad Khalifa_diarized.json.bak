        },
        {
          "word": " Did",
          "start": 3936.87,
          "end": 3936.87,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3936.87,
          "end": 3936.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " divorce?",
