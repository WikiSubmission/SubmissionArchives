          "word": " \u0631\u064e\u062d\u0652\u0645\u064e\u0629\u064b\u06ed",
          "start": 5324.87,
          "end": 5326.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0644\u0651\u0650\u0644\u0652\u0639\u064e\u0640\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e",
