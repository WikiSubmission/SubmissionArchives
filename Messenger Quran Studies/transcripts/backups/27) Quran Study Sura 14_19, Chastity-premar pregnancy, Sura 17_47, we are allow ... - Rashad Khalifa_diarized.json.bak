          "end": 5012.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " We",
          "start": 5012.33,
          "end": 5012.33,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We should understand that God created the earth and the heavens.",
      "start": 5012.33,
      "end": 5019.23,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " should",
          "start": 5012.33,
          "end": 5012.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " understand",
          "start": 5012.33,
          "end": 5012.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that",
          "start": 5015.11,
          "end": 5015.35,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 5015.35,
          "end": 5017.93,
