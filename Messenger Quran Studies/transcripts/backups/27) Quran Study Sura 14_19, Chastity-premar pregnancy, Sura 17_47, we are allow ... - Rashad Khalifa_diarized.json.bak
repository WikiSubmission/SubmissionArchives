          "speaker": "Dr. Khalifa"
        },
        {
          "word": " yesterday.",
          "start": 3109.37,
          "end": 3109.82,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Many people, especially secular people, they think that David wrote the Psalms.",
      "start": 3112.69,
      "end": 3117.73,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Many",
          "start": 3112.69,
          "end": 3112.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " people,",
          "start": 3112.69,
