          "speaker": "Dr. Khalifa"
        },
        {
          "word": " as",
          "start": 350.96,
          "end": 351.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " educated",
          "start": 351.32,
          "end": 351.64,
