        },
        {
          "word": " you",
          "start": 345.42,
          "end": 345.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " see,",
          "start": 345.9,
          "end": 346.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " my",
          "start": 346.22,
          "end": 346.24,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mother",
