          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, whatever God reveals is wisdom.",
      "start": 3560.35,
      "end": 3561.61,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " So,",
