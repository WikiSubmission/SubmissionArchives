          "end": 5011.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " We",
          "start": 5011.23,
          "end": 5011.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " shouldn't",
          "start": 5011.23,
