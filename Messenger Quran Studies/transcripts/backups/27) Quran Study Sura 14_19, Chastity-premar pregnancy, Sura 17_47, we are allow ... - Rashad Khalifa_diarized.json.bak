          "end": 349.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " continuously.",
          "start": 349.9,
          "end": 350.3,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "She was not as educated as she wished to be.",
      "start": 350.54,
      "end": 353.26,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " She",
          "start": 350.54,
          "end": 350.64,
