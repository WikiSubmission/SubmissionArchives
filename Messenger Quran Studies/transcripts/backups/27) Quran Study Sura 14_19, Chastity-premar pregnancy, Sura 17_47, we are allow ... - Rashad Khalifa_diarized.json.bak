          "speaker": "Dr. Khalifa"
        },
        {
          "word": " applies",
          "start": 4895.11,
          "end": 4895.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 4895.11,
          "end": 4895.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 4895.95,
          "end": 4896.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " creatures,",
