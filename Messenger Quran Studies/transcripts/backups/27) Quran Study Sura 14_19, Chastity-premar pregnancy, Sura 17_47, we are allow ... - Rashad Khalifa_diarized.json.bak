        },
        {
          "word": " as",
          "start": 351.64,
          "end": 352.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " she",
          "start": 352.1,
          "end": 352.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " wished",
          "start": 352.2,
          "end": 352.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 352.44,
          "end": 352.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be.",
          "start": 352.66,
          "end": 353.26,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But she was just telling us always \"God alone, God alone, the saints and the prophets are dead.\"",
      "start": 353.7,
      "end": 360.06,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " But",
          "start": 353.7,
          "end": 353.72,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " she",
          "start": 353.72,
          "end": 353.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " was",
          "start": 353.88,
          "end": 354.0,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " just",
          "start": 354.0,
          "end": 354.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " telling",
          "start": 354.14,
          "end": 354.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " us",
          "start": 354.58,
          "end": 354.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " always",
          "start": 354.82,
          "end": 355.3,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"God",
          "start": 355.3,
          "end": 357.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone,",
          "start": 357.6,
          "end": 358.1,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 358.16,
          "end": 358.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone,",
          "start": 358.2,
          "end": 358.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 358.58,
          "end": 358.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " saints",
          "start": 358.68,
          "end": 358.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 358.82,
          "end": 359.12,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 359.12,
          "end": 359.26,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " prophets",
          "start": 359.26,
          "end": 359.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
          "start": 359.5,
          "end": 359.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " dead.\"",
          "start": 359.74,
          "end": 360.06,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"You must trust in God alone, nobody else.\"",
      "start": 360.72,
      "end": 362.48,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"You",
