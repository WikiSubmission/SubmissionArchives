          "speaker": "Parivash"
        },
        {
          "word": " Khalifa:",
          "start": 5010.49,
          "end": 5010.49,
          "speaker": "Parivash"
        },
        {
          "word": " created.",
          "start": 5010.55,
          "end": 5010.69,
          "speaker": "Parivash"
        },
        {
          "word": " It",
          "start": 5010.75,
          "end": 5010.75,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "It doesn't matter. We shouldn't pick on these little things.",
      "start": 5010.75,
      "end": 5012.33,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " doesn't",
