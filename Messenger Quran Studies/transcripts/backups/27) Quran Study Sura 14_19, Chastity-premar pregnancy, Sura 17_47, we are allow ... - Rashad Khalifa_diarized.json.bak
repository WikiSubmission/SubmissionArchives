          "speaker": "Parivash"
        },
        {
          "word": " an",
          "start": 5019.23,
          "end": 5019.23,
          "speaker": "Parivash"
        },
        {
          "word": " answer",
          "start": 5019.23,
          "end": 5019.23,
          "speaker": "Parivash"
        },
        {
          "word": " for",
          "start": 5019.23,
          "end": 5020.31,
          "speaker": "Parivash"
        },
        {
          "word": " that.",
          "start": 5020.31,
          "end": 5020.61,
          "speaker": "Parivash"
        },
        {
          "word": " Well,",
          "start": 5021.29,
          "end": 5021.39,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "Well, this is the answer. Say \"why is it relevant to you whether the earth came first or Jupiter came first?\"",
      "start": 5021.79,
      "end": 5031.15,
      "speaker": "Dr. Khalifa",
      "words": [
        {
