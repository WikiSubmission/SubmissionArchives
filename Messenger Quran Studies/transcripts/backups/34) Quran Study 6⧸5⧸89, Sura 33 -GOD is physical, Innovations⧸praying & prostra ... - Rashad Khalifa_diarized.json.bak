          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He said \"okay, don't do just five prayers. Do twenty.\"",
      "start": 5430.15,
      "end": 5430.15,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " He",
