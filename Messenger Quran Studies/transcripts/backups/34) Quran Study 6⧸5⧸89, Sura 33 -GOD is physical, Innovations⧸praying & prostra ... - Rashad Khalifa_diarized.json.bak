          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "What do you think?",
      "start": 804.14,
      "end": 804.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " What",
          "start": 804.14,
          "end": 804.26,
