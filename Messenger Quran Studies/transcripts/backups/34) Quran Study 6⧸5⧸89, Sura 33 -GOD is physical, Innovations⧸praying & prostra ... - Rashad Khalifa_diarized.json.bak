          "speaker": "Dr. Khalifa"
        },
        {
          "word": " 53.",
          "start": 5430.15,
          "end": 5430.15,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He'll move closer.",
      "start": 5430.15,
      "end": 5430.15,
      "speaker": "Edip",
      "words": [
        {
          "word": " He'll",
          "start": 5430.15,
          "end": 5430.15,
