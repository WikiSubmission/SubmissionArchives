          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"If",
          "start": 742.74,
          "end": 742.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 742.94,
          "end": 743.16,
          "speaker": "Dr. Khalifa"
        },
