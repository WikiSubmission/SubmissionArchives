      "end": 272.4,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " We",
          "start": 268.12,
          "end": 268.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
          "start": 268.14,
          "end": 268.24,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " going",
          "start": 268.24,
          "end": 268.4,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " out",
          "start": 268.4,
          "end": 268.6,
