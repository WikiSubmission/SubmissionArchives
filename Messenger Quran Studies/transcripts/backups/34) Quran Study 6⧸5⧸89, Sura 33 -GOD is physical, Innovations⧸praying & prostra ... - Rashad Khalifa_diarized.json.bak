      "end": 718.44,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " It",
          "start": 713.22,
          "end": 713.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " says",
          "start": 713.22,
          "end": 713.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"Seek",
          "start": 713.42,
          "end": 714.1,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God's",
          "start": 714.1,
          "end": 714.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " kingship",
