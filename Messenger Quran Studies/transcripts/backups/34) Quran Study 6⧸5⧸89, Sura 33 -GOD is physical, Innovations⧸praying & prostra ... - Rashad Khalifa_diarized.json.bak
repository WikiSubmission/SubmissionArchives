        }
      ]
    },
    {
      "text": "(49:10) \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0625\u0650\u062e\u0652\u0648\u064e\u0629\u064c\u06ed The believers are brothers and sisters.",
      "start": 414.5,
      "end": 416.2,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " (49:10)",
          "start": 414.5,
          "end": 414.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627",
