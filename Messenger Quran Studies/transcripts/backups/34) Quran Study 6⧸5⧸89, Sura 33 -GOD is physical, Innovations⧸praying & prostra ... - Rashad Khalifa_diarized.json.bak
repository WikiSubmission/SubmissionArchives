    },
    {
      "text": "However, God says \"messengers.\"",
      "start": 2109.94,
      "end": 2111.6,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " However,",
          "start": 2109.94,
          "end": 2110.06,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
