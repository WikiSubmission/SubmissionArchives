        },
        {
          "word": " is",
          "start": 386.16,
          "end": 386.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " omniscient\"",
          "start": 386.32,
          "end": 386.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mean?",
          "start": 386.98,
          "end": 387.43,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In Arabic, 'Alim (\u0639\u064e\u0644\u0650\u064a\u0645).",
