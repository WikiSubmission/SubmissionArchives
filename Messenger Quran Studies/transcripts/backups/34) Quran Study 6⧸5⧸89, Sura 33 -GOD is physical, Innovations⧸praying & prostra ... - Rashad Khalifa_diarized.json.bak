          "start": 5430.15,
          "end": 5430.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 5430.15,
          "end": 5430.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " took",
