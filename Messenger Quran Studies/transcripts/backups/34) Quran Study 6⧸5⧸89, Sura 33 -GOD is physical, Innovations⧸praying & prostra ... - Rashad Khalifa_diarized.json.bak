          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Rabb,",
          "start": 818.7,
          "end": 819.3,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 819.4,
          "end": 819.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Lord,",
          "start": 819.42,
          "end": 819.84,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 820.04,
          "end": 820.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " rabb",
          "start": 820.04,
          "end": 820.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " means",
          "start": 820.2,
          "end": 820.7,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " father.",
          "start": 820.7,
          "end": 821.64,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I don't know how it is in Iran, but in Arabic, the head of the family is called rabbi Al-Usra.",
