          "end": 2154.64,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Arabic",
          "start": 2154.64,
          "end": 2154.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " word",
          "start": 2154.82,
          "end": 2155.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Nabi",
          "start": 2155.16,
          "end": 2155.46,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " (\u0646\u0651\u064e\u0628\u0650\u0649).",
          "start": 2155.46,
          "end": 2155.91,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because the English usage of the word prophet is not the same as Nabi (\u0646\u0651\u064e\u0628\u0650\u0649).",
