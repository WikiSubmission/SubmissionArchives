          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I'm saying what God says in Sura 53.",
      "start": 5430.15,
      "end": 5430.15,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I'm",
