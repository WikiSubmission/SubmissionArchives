        }
      ]
    },
    {
      "text": "Yes.",
      "start": 2133.47,
      "end": 2134.12,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 2133.47,
          "end": 2134.12,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Yes. The prophet brings a new scripture, a new message.",
      "start": 2137.34,
      "end": 2140.73,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 2137.34,
          "end": 2137.34,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " The",
          "start": 2137.34,
          "end": 2137.34,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " prophet",
          "start": 2137.34,
          "end": 2137.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " brings",
          "start": 2137.6,
          "end": 2139.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 2139.14,
          "end": 2139.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " new",
          "start": 2139.32,
          "end": 2139.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " scripture,",
          "start": 2139.42,
          "end": 2140.07,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 2140.34,
          "end": 2140.38,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " new",
          "start": 2140.38,
          "end": 2140.48,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " message.",
          "start": 2140.48,
          "end": 2140.73,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "A messenger confirms existing scriptures, preaches existing scriptures. He does not bring anything new.",
      "start": 2141.6,
      "end": 2147.88,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " A",
          "start": 2141.6,
          "end": 2141.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " messenger",
          "start": 2141.6,
          "end": 2141.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " confirms",
          "start": 2141.88,
          "end": 2143.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " existing",
          "start": 2143.32,
          "end": 2143.98,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " scriptures,",
          "start": 2143.98,
          "end": 2144.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " preaches",
          "start": 2144.84,
          "end": 2145.0,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " existing",
          "start": 2145.0,
          "end": 2145.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " scriptures.",
          "start": 2145.44,
          "end": 2146.12,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " He",
          "start": 2146.14,
          "end": 2146.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " does",
          "start": 2146.14,
          "end": 2146.26,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 2146.26,
          "end": 2146.36,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " bring",
          "start": 2146.36,
          "end": 2146.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " anything",
          "start": 2146.6,
          "end": 2147.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " new.",
          "start": 2147.28,
          "end": 2147.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Every prophet brings a new scripture.",
      "start": 2149.5,
      "end": 2152.89,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Every",
          "start": 2149.5,
          "end": 2149.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " prophet",
          "start": 2149.66,
          "end": 2150.0,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " brings",
          "start": 2150.0,
          "end": 2151.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 2151.74,
          "end": 2151.96,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " new",
          "start": 2151.96,
          "end": 2152.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " scripture.",
          "start": 2152.04,
          "end": 2152.89,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We're using the word prophet for the Arabic word Nabi (\u0646\u0651\u064e\u0628\u0650\u0649).",
      "start": 2153.64,
      "end": 2155.91,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " We're",
          "start": 2153.64,
          "end": 2153.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " using",
          "start": 2153.82,
          "end": 2153.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2153.82,
          "end": 2153.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " word",
