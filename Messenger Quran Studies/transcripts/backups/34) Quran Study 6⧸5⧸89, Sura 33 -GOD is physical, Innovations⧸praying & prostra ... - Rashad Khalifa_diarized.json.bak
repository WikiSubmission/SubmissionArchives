          "end": 5430.15,
          "speaker": "Chester"
        },
        {
          "word": " minute!",
          "start": 5430.15,
          "end": 5430.15,
          "speaker": "Chester"
        }
      ]
    },
    {
      "text": "Just saying that He is not infinite.",
