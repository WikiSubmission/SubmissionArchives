        },
        {
          "word": " move",
          "start": 5430.15,
          "end": 5430.15,
          "speaker": "Edip"
        },
        {
          "word": " closer.",
          "start": 5430.15,
          "end": 5430.15,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "God says, God took Muhammad from the planet earth, that He took him somewhere in the universe.",
      "start": 5430.15,
      "end": 5430.15,
      "speaker": "Dr. Khalifa",
      "words": [
        {
