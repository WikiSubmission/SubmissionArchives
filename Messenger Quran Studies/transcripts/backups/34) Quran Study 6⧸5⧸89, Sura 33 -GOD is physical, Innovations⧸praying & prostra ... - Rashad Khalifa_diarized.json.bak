          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone.",
          "start": 695.32,
          "end": 695.82,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You don't have two hearts in your chest.",
