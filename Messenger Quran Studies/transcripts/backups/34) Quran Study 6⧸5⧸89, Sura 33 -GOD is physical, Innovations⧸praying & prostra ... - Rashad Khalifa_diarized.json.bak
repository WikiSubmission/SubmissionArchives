        },
        {
          "word": " idols,",
          "start": 270.98,
          "end": 271.64,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 271.7,
          "end": 271.7,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 271.7,
