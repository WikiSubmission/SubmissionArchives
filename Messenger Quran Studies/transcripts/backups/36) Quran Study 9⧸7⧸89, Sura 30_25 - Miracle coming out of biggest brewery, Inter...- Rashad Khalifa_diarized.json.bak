          "word": " He",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " used",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " word",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " against",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Kazzab.\" What is Kazzab? What is Kazzab? I'm telling you to worship God alone. \"You're a liar. You're Kazzab.\"",
      "start": 5558.88,
      "end": 5558.88,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " me.",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"Kazzab.\"",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " What",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 5558.88,
