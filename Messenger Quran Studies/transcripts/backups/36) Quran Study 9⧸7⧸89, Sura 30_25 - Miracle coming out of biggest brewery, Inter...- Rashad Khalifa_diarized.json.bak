    },
    {
      "text": "People come, look at the message, examine it.",
      "start": 5558.88,
      "end": 5558.88,
      "speaker": "Following the Parents Blindly",
      "words": [
        {
          "word": " believers.",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Following the Parents Blindly"
        },
        {
          "word": " People",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Following the Parents Blindly"
        },
        {
          "word": " come,",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Following the Parents Blindly"
        },
        {
          "word": " look",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Following the Parents Blindly"
        },
        {
