          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " seems",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " like",
