        }
      ]
    },
    {
      "text": "If I'm intelligent.",
      "start": 5558.46,
      "end": 5558.46,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " If",
          "start": 5558.46,
          "end": 5558.46,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I'm",
          "start": 5558.46,
          "end": 5558.46,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " intelligent.",
          "start": 5558.46,
          "end": 5558.46,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "If I'm stupid, I will say \"who are you to tell me that? You're telling me I'm wrong?\"",
      "start": 5558.46,
      "end": 5558.48,
      "speaker": "Dr. Khalifa",
      "words": [
