          "word": " liar.\"",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"Kazzab",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " (\u0643\u064e\u0640\u0670\u0630\u0628)",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Same word, Kazzab (\u0643\u064e\u0640\u0670\u0630\u0628) (liar).",
      "start": 5558.88,
      "end": 5558.88,
      "speaker": "A man",
      "words": [
        {
          "word": " (liar)\"",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "A man"
        },
        {
          "word": " Same",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "A man"
        },
        {
          "word": " word,",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "A man"
        },
        {
          "word": " Kazzab",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "A man"
        },
        {
          "word": " (\u0643\u064e\u0640\u0670\u0630\u0628)",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "Yes.",
      "start": 5558.88,
      "end": 5558.88,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " (liar).",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's amazing, you know. He used the word against me.",
      "start": 5558.88,
      "end": 5558.88,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " It's",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " amazing,",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " know.",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
