          "speaker": "Dr. Khalifa"
        },
        {
          "word": " idol",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "When you raise somebody over the truth, then that's idol worship.",
      "start": 5558.88,
      "end": 5558.88,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " worship.",
