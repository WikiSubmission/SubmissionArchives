          "speaker": "Dr. Khalifa"
        },
        {
          "word": " enough",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's an egotistic statement,",
