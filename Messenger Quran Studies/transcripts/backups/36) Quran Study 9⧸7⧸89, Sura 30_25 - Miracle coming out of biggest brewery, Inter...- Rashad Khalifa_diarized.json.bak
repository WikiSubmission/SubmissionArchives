        },
        {
          "word": " then",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that's",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " idol",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
