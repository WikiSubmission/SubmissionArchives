          "speaker": "Following the Parents Blindly"
        },
        {
          "word": " Well,",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Following the Parents Blindly"
        },
        {
          "word": " they",
          "start": 5558.88,
