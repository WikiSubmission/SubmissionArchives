          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "You take any book from the library.",
      "start": 2287.68,
      "end": 2290.04,
      "speaker": "A woman",
      "words": [
        {
          "word": " You",
          "start": 2287.68,
