          "word": " god,",
          "start": 5558.88,
          "end": 5558.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"I have enough power.\"",
      "start": 5558.88,
      "end": 5558.88,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " too.\"",
