          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Muhammad",
          "start": 1330.965,
          "end": 1331.345,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "scrupulously",
          "start": 1331.345,
          "end": 1331.725,
          "speaker": "Dr. Khalifa"
        },
