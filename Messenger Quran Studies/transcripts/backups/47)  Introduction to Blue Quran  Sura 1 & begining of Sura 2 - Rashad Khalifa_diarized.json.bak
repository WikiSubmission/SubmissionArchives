          "end": 1573.076,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "thoughts",
          "start": 1573.076,
          "end": 1573.436,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 1573.436,
          "end": 1573.795,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "he",
          "start": 1573.795,
          "end": 1574.155,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "could",
          "start": 1574.155,
          "end": 1574.514,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "be",
          "start": 1574.514,
          "end": 1574.874,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 1574.874,
          "end": 1575.233,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "god",
          "start": 1575.233,
          "end": 1575.593,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "besides",
          "start": 1575.593,
          "end": 1575.952,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God.",
          "start": 1575.952,
          "end": 1576.312,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"This challenge to God's absolute authority was not only blasphemous, it was totally erroneous.",
      "start": 1576.312,
      "end": 1582.283,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"This",
          "start": 1576.312,
          "end": 1576.738,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "challenge",
          "start": 1576.738,
          "end": 1577.165,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 1577.165,
          "end": 1577.591,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God's",
          "start": 1577.591,
          "end": 1578.018,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "absolute",
          "start": 1578.018,
          "end": 1578.445,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "authority",
          "start": 1578.445,
          "end": 1578.871,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 1578.871,
          "end": 1579.298,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "not",
          "start": 1579.298,
          "end": 1579.724,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "only",
          "start": 1579.724,
          "end": 1580.151,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "blasphemous,",
          "start": 1580.151,
          "end": 1580.577,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "it",
          "start": 1580.577,
          "end": 1581.004,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 1581.004,
          "end": 1581.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "totally",
          "start": 1581.43,
          "end": 1581.857,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "erroneous.",
          "start": 1581.857,
          "end": 1582.283,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Satan was ignorant of the fact that God alone possesses the power and qualifications to a god,",
      "start": 1582.283,
      "end": 1587.948,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"Satan",
          "start": 1582.283,
          "end": 1582.616,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 1582.616,
          "end": 1582.949,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "ignorant",
          "start": 1582.949,
          "end": 1583.283,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 1583.283,
          "end": 1583.616,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 1583.616,
          "end": 1583.949,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "fact",
          "start": 1583.949,
          "end": 1584.282,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 1584.282,
          "end": 1584.616,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 1584.616,
          "end": 1584.949,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone",
          "start": 1584.949,
          "end": 1585.282,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "possesses",
          "start": 1585.282,
          "end": 1585.615,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 1585.615,
          "end": 1585.949,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "power",
          "start": 1585.949,
          "end": 1586.282,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 1586.282,
          "end": 1586.615,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "qualifications",
          "start": 1586.615,
          "end": 1586.948,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
