        },
        {
          "word": "Hereafter.",
          "start": 3578.013,
          "end": 3578.337,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"As expected from the Creator's final message, one of the prominent themes in the Quran",
      "start": 3578.337,
      "end": 3583.392,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"As",
