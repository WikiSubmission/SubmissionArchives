          "word": "months",
          "start": 2820.269,
          "end": 2820.565,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "before",
          "start": 2820.565,
          "end": 2820.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "his",
          "start": 2820.86,
          "end": 2821.156,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "40th",
          "start": 2821.156,
          "end": 2821.451,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "birthday.",
          "start": 2821.451,
          "end": 2821.747,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "God knew, and his grave stone says \"Thank God Almighty, free at last.\"",
      "start": 2822.419,
      "end": 2828.268,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "God",
          "start": 2822.419,
          "end": 2822.869,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "knew,",
          "start": 2822.869,
          "end": 2823.319,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 2823.319,
          "end": 2823.769,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "his",
