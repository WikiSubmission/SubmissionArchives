    {
      "text": "It says \"Lo, I am sending My messenger\", so obviously this is God speaking.",
      "start": 807.449,
      "end": 811.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "It",
          "start": 807.449,
          "end": 807.714,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says",
          "start": 807.714,
          "end": 807.979,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"Lo,",
          "start": 807.979,
          "end": 808.244,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 808.244,
          "end": 808.509,
          "speaker": "Dr. Khalifa"
        },
        {
