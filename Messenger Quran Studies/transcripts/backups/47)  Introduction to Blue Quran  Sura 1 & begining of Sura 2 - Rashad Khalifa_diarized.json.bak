          "speaker": "Dr. Khalifa"
        },
        {
          "word": "yet",
          "start": 1483.895,
          "end": 1484.198,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 1484.198,
          "end": 1484.501,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "come",
          "start": 1484.501,
          "end": 1484.805,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 1484.805,
          "end": 1485.108,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this",
          "start": 1485.108,
          "end": 1485.412,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "world.",
          "start": 1485.412,
          "end": 1485.715,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"God's purified and consolidated message therefore is destined to reach the vast majority of humans.\"",
      "start": 1485.715,
      "end": 1491.393,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"God's",
          "start": 1485.715,
          "end": 1486.094,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "purified",
          "start": 1486.094,
          "end": 1486.472,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
