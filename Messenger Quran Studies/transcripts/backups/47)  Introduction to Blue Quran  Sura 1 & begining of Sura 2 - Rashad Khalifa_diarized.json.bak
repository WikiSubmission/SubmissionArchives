          "speaker": "Kathryn"
        },
        {
          "word": "see",
          "start": 3866.504,
          "end": 3867.087,
          "speaker": "Kathryn"
        },
        {
          "word": "appendix",
          "start": 3867.087,
          "end": 3867.669,
          "speaker": "Kathryn"
        },
        {
          "word": "29",
          "start": 3867.669,
          "end": 3868.252,
          "speaker": "Kathryn"
        },
        {
          "word": "and",
          "start": 3868.252,
          "end": 3868.835,
          "speaker": "Kathryn"
        },
        {
          "word": "footnote",
          "start": 3868.835,
          "end": 3869.417,
          "speaker": "Kathryn"
        },
        {
          "word": "27:30.",
          "start": 3869.417,
          "end": 3870.0,
          "speaker": "Kathryn"
        }
      ]
    },
    {
      "text": "Thus, the count of all Basmalahs is restored to 114 (19 x 6).",
