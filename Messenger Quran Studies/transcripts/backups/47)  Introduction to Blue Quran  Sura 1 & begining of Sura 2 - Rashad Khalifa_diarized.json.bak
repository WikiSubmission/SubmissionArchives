          "speaker": "Dr. Khalifa"
        },
        {
          "word": "authority.\"",
          "start": 2795.497,
          "end": 2795.909,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Anyone who dies before the age of 40 is chosen by God for redemption due to circumstances known only to God.\"",
      "start": 2795.909,
      "end": 2802.674,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"Anyone",
          "start": 2795.909,
          "end": 2796.231,
          "speaker": "Dr. Khalifa"
        },
