        },
        {
          "word": "billion.",
          "start": 1480.783,
          "end": 1481.164,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"In other words, the vast majority of people are yet to come to this world.",
      "start": 1481.164,
      "end": 1485.715,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"In",
          "start": 1481.164,
          "end": 1481.467,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "other",
          "start": 1481.467,
          "end": 1481.771,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "words,",
          "start": 1481.771,
          "end": 1482.074,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 1482.074,
          "end": 1482.378,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "vast",
