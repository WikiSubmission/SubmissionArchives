        },
        {
          "word": "Basmalah",
          "start": 3859.65,
          "end": 3860.178,
          "speaker": "Kathryn"
        },
        {
          "word": "is",
          "start": 3860.178,
          "end": 3860.707,
          "speaker": "Kathryn"
        },
        {
          "word": "compensated",
          "start": 3860.707,
          "end": 3861.235,
          "speaker": "Kathryn"
        },
        {
          "word": "for,",
          "start": 3861.235,
          "end": 3861.763,
          "speaker": "Kathryn"
        },
        {
          "word": "19",
          "start": 3861.763,
          "end": 3862.291,
          "speaker": "Kathryn"
        },
        {
          "word": "Suras",
          "start": 3862.291,
          "end": 3862.819,
          "speaker": "Kathryn"
        },
        {
          "word": "later.",
          "start": 3862.819,
          "end": 3863.347,
          "speaker": "Kathryn"
        }
      ]
    },
    {
      "text": "Sura 27 contains two Basmalahs, see appendix 29 and footnote 27:30.",
      "start": 3863.591,
      "end": 3870.0,
      "speaker": "Kathryn",
      "words": [
        {
          "word": "Sura",
          "start": 3863.591,
          "end": 3864.174,
          "speaker": "Kathryn"
        },
        {
          "word": "27",
          "start": 3864.174,
          "end": 3864.756,
          "speaker": "Kathryn"
        },
        {
          "word": "contains",
          "start": 3864.756,
          "end": 3865.339,
          "speaker": "Kathryn"
        },
        {
          "word": "two",
          "start": 3865.339,
          "end": 3865.922,
          "speaker": "Kathryn"
        },
        {
          "word": "Basmalahs,",
