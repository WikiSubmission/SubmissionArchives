          "start": 1680.0,
          "end": 1680.421,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Heavenly",
          "start": 1680.421,
          "end": 1680.841,
          "speaker": "Dr. Khalifa"
        },
        {
