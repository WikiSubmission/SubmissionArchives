        },
        {
          "word": "authority.",
          "start": 1690.398,
          "end": 1690.899,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"They knew that God alone possessed the power to be a god.",
      "start": 1690.899,
      "end": 1695.0,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"They",
