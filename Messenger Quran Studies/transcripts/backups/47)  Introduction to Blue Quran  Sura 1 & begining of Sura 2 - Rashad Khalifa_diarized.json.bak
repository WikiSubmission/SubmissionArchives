          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3272.389,
          "end": 3272.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "word",
          "start": 3272.78,
          "end": 3273.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"Quran.\"",
          "start": 3273.17,
          "end": 3273.561,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"We find that the \"Quran\" is mentioned 58 times in the Quran.",
      "start": 3273.561,
      "end": 3276.6,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"We",
          "start": 3273.561,
          "end": 3273.814,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "find",
          "start": 3273.814,
          "end": 3274.068,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 3274.068,
          "end": 3274.321,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3274.321,
          "end": 3274.574,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"Quran\"",
          "start": 3274.574,
          "end": 3274.827,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 3274.827,
          "end": 3275.08,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "mentioned",
          "start": 3275.08,
          "end": 3275.334,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "58",
          "start": 3275.334,
          "end": 3275.587,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "times",
          "start": 3275.587,
          "end": 3275.84,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 3275.84,
          "end": 3276.093,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3276.093,
          "end": 3276.347,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran.",
          "start": 3276.347,
          "end": 3276.6,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"However, verse 10:15 refers to a Quran other than this, and therefore cannot be counted.",
      "start": 3276.6,
      "end": 3282.204,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"However,",
          "start": 3276.6,
          "end": 3276.974,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "verse",
          "start": 3276.974,
          "end": 3277.347,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "10:15",
          "start": 3277.347,
          "end": 3277.721,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "refers",
          "start": 3277.721,
          "end": 3278.094,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 3278.094,
          "end": 3278.468,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 3278.468,
          "end": 3278.842,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran",
          "start": 3278.842,
          "end": 3279.215,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "other",
          "start": 3279.215,
          "end": 3279.589,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "than",
          "start": 3279.589,
          "end": 3279.962,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this,",
          "start": 3279.962,
          "end": 3280.336,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 3280.336,
          "end": 3280.71,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "therefore",
          "start": 3280.71,
          "end": 3281.083,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "cannot",
          "start": 3281.083,
          "end": 3281.457,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "be",
          "start": 3281.457,
          "end": 3281.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "counted.",
          "start": 3281.83,
          "end": 3282.204,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Thus, \"this Quran\" is mentioned in the Quran 57 times, 19 x 3.",
      "start": 3282.204,
      "end": 3286.77,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"Thus,",
          "start": 3282.204,
          "end": 3282.555,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"this",
          "start": 3282.555,
          "end": 3282.906,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran\"",
          "start": 3282.906,
          "end": 3283.258,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 3283.258,
          "end": 3283.609,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "mentioned",
          "start": 3283.609,
          "end": 3283.96,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 3283.96,
