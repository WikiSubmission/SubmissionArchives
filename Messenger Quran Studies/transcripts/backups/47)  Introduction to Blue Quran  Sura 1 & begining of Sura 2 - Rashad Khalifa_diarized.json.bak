        {
          "word": "Oh,",
          "start": 3246.272,
          "end": 3246.711,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3246.711,
          "end": 3247.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "third",
          "start": 3247.15,
          "end": 3247.589,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "paragraph.",
          "start": 3247.589,
          "end": 3248.028,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"This simple physical fact is easily verifiable by the reader and shows the existence of a superhuman system within the Quran.",
