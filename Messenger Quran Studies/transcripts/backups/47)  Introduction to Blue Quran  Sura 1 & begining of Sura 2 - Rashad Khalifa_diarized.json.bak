          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 1587.282,
          "end": 1587.615,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "god,",
          "start": 1587.615,
          "end": 1587.948,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"and that there is much more to godhood than he could have ever imagined.",
      "start": 1587.948,
      "end": 1592.147,
      "speaker": "Dr. Khalifa",
      "words": [
        {
