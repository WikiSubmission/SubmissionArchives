        }
      ]
    },
    {
      "text": "\"it is estimated that the world population will exceed 75 billion.",
      "start": 1476.968,
      "end": 1481.164,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"it",
