          "speaker": "Dr. Khalifa"
        },
        {
          "word": "said",
          "start": 1550.879,
          "end": 1551.107,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"what",
          "start": 1551.107,
          "end": 1551.336,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "about",
          "start": 1551.336,
          "end": 1551.564,
          "speaker": "Dr. Khalifa"
        },
        {
