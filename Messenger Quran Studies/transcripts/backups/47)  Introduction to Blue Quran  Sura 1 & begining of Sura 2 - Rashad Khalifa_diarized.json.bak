          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 1555.221,
          "end": 1555.449,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that?\"",
          "start": 1555.449,
          "end": 1555.678,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And Moses said the right answer.",
      "start": 1557.148,
      "end": 1559.508,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 1557.148,
          "end": 1557.541,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Moses",
          "start": 1557.541,
          "end": 1557.935,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "said",
          "start": 1557.935,
          "end": 1558.328,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 1558.328,
          "end": 1558.721,
          "speaker": "Dr. Khalifa"
        },
        {
