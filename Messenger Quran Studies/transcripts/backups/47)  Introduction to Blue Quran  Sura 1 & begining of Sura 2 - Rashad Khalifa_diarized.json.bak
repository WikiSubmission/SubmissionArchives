          "word": "a...",
          "start": 2515.352,
          "end": 2515.955,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There is another creature in your body.",
      "start": 2518.338,
      "end": 2520.0,
      "speaker": "Dr. Khalifa",
      "words": [
