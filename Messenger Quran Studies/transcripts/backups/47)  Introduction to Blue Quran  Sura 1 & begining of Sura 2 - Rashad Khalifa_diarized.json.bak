          "start": 2788.565,
          "end": 2788.9,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"before making this most important decision, to uphold Satan's point of view or uphold God's absolute authority.\"",
      "start": 2788.9,
      "end": 2795.909,
      "speaker": "Dr. Khalifa",
      "words": [
