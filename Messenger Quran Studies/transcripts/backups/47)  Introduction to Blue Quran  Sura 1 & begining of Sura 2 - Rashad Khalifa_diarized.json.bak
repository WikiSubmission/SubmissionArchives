          "end": 3640.001,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Today's corrupted religions, including Judaism, Christianity, and Islam, will simply die out",
      "start": 3640.001,
      "end": 3645.3,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"Today's",
          "start": 3640.001,
          "end": 3640.443,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "corrupted",
          "start": 3640.443,
          "end": 3640.884,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "religions,",
          "start": 3640.884,
          "end": 3641.326,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "including",
