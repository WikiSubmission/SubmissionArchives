          "speaker": "Dr. Khalifa"
        },
        {
          "word": "different",
          "start": 1685.049,
          "end": 1685.469,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "categories.",
          "start": 1685.469,
          "end": 1685.89,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Number one, angels, creatures who never questioned God's absolute authority.",
      "start": 1685.89,
      "end": 1690.899,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"Number",
          "start": 1685.89,
          "end": 1686.391,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "one,",
          "start": 1686.391,
          "end": 1686.892,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "angels,",
          "start": 1686.892,
