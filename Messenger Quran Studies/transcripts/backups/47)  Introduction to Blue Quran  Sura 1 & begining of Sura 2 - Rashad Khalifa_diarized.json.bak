          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3284.311,
          "end": 3284.663,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran",
          "start": 3284.663,
          "end": 3285.014,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "57",
          "start": 3285.014,
          "end": 3285.365,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "times,",
          "start": 3285.365,
          "end": 3285.716,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "19",
          "start": 3285.716,
          "end": 3286.068,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "x",
