        },
        {
          "word": "questioned",
          "start": 1688.895,
          "end": 1689.396,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God's",
          "start": 1689.396,
          "end": 1689.897,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "absolute",
          "start": 1689.897,
          "end": 1690.398,
