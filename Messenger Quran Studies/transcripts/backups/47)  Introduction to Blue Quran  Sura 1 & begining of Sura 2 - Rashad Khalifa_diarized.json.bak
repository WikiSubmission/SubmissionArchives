          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Their matter is with God in a record.\"",
      "start": 1560.424,
      "end": 1563.03,
      "speaker": "Dr. Khalifa",
      "words": [
        {
