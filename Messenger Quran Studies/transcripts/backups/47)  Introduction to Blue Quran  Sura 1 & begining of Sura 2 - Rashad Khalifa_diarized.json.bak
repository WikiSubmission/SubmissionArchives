          "end": 1482.681,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "majority",
          "start": 1482.681,
          "end": 1482.984,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 1482.984,
