          "end": 3856.531,
          "speaker": "Kathryn"
        },
        {
          "word": "verse.",
          "start": 3856.531,
          "end": 3857.01,
          "speaker": "Kathryn"
        }
      ]
    },
    {
      "text": "For example, the absence of Basmalah is compensated for, 19 Suras later.",
      "start": 3857.01,
      "end": 3863.347,
      "speaker": "Kathryn",
      "words": [
        {
          "word": "For",
          "start": 3857.01,
          "end": 3857.538,
          "speaker": "Kathryn"
        },
        {
          "word": "example,",
          "start": 3857.538,
          "end": 3858.066,
          "speaker": "Kathryn"
        },
        {
          "word": "the",
          "start": 3858.066,
          "end": 3858.594,
          "speaker": "Kathryn"
        },
        {
          "word": "absence",
          "start": 3858.594,
          "end": 3859.122,
          "speaker": "Kathryn"
        },
        {
          "word": "of",
