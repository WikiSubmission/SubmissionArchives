          "end": 1588.248,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 1588.248,
          "end": 1588.548,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "there",
          "start": 1588.548,
          "end": 1588.848,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 1588.848,
          "end": 1589.148,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "much",
          "start": 1589.148,
          "end": 1589.448,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "more",
          "start": 1589.448,
          "end": 1589.748,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 1589.748,
