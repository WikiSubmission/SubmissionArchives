          "speaker": "Dr. Khalifa"
        },
        {
          "word": "than",
          "start": 1590.347,
          "end": 1590.647,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "he",
          "start": 1590.647,
          "end": 1590.947,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "could",
          "start": 1590.947,
          "end": 1591.247,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "have",
          "start": 1591.247,
          "end": 1591.547,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "ever",
          "start": 1591.547,
          "end": 1591.847,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "imagined.",
          "start": 1591.847,
          "end": 1592.147,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"It was ignorance coupled with pride that led Satan to believe that he could take care of a dominion",
      "start": 1592.147,
      "end": 1597.446,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"It",
          "start": 1592.147,
          "end": 1592.426,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 1592.426,
          "end": 1592.705,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "ignorance",
          "start": 1592.705,
          "end": 1592.984,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "coupled",
          "start": 1592.984,
          "end": 1593.263,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "with",
          "start": 1593.263,
          "end": 1593.541,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "pride",
