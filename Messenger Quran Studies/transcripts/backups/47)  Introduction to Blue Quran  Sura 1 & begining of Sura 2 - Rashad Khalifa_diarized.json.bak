        },
        {
          "word": "mean",
          "start": 1216.933,
          "end": 1217.133,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"Alone\"",
          "start": 1217.133,
          "end": 1217.333,
          "speaker": "Dr. Khalifa"
        },
