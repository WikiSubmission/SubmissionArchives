          "end": 1545.749,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 1545.749,
          "end": 1546.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wrong?",
          "start": 1546.13,
          "end": 1546.512,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "What",
          "start": 1546.512,
          "end": 1546.894,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "happens",
          "start": 1546.894,
          "end": 1547.276,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 1547.276,
          "end": 1547.657,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "them?\"",
          "start": 1547.657,
          "end": 1548.039,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The same question was asked of Moses, remember?",
      "start": 1548.467,
      "end": 1550.65,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 1548.467,
          "end": 1548.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "same",
          "start": 1548.74,
          "end": 1549.013,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "question",
          "start": 1549.013,
          "end": 1549.286,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 1549.286,
          "end": 1549.559,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "asked",
          "start": 1549.559,
          "end": 1549.831,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 1549.831,
          "end": 1550.104,
          "speaker": "Dr. Khalifa"
        },
