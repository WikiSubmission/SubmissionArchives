          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There's a...",
      "start": 2514.749,
      "end": 2515.955,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "There's",
