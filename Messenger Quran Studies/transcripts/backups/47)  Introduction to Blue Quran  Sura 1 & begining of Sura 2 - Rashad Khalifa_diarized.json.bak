          "speaker": "Kathryn"
        },
        {
          "word": "phenomena",
          "start": 3854.135,
          "end": 3854.614,
          "speaker": "Kathryn"
        },
        {
          "word": "are",
          "start": 3854.614,
          "end": 3855.093,
          "speaker": "Kathryn"
        },
        {
          "word": "connected",
          "start": 3855.093,
