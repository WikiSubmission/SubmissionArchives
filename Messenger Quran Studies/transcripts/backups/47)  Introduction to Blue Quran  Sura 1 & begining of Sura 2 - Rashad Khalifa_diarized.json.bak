        }
      ]
    },
    {
      "text": "Numerous mathematical phenomena are connected with this verse.",
      "start": 3853.177,
      "end": 3857.01,
      "speaker": "Kathryn",
      "words": [
        {
          "word": "Numerous",
          "start": 3853.177,
          "end": 3853.656,
          "speaker": "Kathryn"
        },
        {
          "word": "mathematical",
