          "speaker": "Dr. Khalifa"
        },
        {
          "word": "god.",
          "start": 1694.658,
          "end": 1695.0,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Number two, jinns, the creatures who decided that Satan was capable of being a god.",
      "start": 1695.0,
      "end": 1700.346,
      "speaker": "Dr. Khalifa",
      "words": [
