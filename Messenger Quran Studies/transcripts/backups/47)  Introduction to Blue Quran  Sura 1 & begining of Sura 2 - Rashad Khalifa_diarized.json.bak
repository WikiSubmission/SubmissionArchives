          "start": 2817.609,
          "end": 2817.905,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "you",
          "start": 2817.905,
          "end": 2818.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "know,",
          "start": 2818.2,
          "end": 2818.496,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Martin",
