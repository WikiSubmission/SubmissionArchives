          "speaker": "Dr. Khalifa"
        },
        {
          "word": "3.",
          "start": 3286.419,
          "end": 3286.77,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"The Suras where the word \"Quran\" in all its grammatical forms is mentioned are 38 (19 x 2).",
      "start": 3286.77,
      "end": 3294.329,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"The",
          "start": 3286.77,
          "end": 3287.19,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Suras",
          "start": 3287.19,
          "end": 3287.61,
          "speaker": "Dr. Khalifa"
        },
        {
