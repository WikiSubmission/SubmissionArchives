          "end": 1567.354,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "all",
          "start": 1567.354,
          "end": 1567.712,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "began",
          "start": 1567.712,
          "end": 1568.069,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 1568.069,
          "end": 1568.426,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "few",
          "start": 1568.426,
          "end": 1568.784,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "billion",
          "start": 1568.784,
          "end": 1569.141,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "years",
          "start": 1569.141,
          "end": 1569.498,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "ago",
          "start": 1569.498,
          "end": 1569.856,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "when",
          "start": 1569.856,
          "end": 1570.213,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "one",
          "start": 1570.213,
          "end": 1570.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 1570.57,
          "end": 1570.928,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God's",
          "start": 1570.928,
          "end": 1571.285,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "high-ranking",
          "start": 1571.285,
          "end": 1571.642,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "creatures,",
          "start": 1571.642,
          "end": 1572.0,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Satan,",
          "start": 1572.0,
          "end": 1572.357,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"developed supercilious thoughts that he could be a god besides God.",
      "start": 1572.357,
      "end": 1576.312,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"developed",
          "start": 1572.357,
          "end": 1572.717,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "supercilious",
