    },
    {
      "text": "\"Another quick illustration of the Quran's mathematical composition involves the word \"Quran.\"",
      "start": 3268.873,
      "end": 3273.561,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"Another",
          "start": 3268.873,
          "end": 3269.264,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "quick",
          "start": 3269.264,
          "end": 3269.654,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "illustration",
          "start": 3269.654,
          "end": 3270.045,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 3270.045,
          "end": 3270.436,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3270.436,
          "end": 3270.826,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran's",
          "start": 3270.826,
          "end": 3271.217,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "mathematical",
          "start": 3271.217,
          "end": 3271.608,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "composition",
          "start": 3271.608,
          "end": 3271.998,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "involves",
          "start": 3271.998,
