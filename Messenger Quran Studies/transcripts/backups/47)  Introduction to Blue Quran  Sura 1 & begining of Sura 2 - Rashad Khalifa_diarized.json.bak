          "word": "was",
          "start": 1308.681,
          "end": 1309.054,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "summoned",
          "start": 1309.054,
          "end": 1309.427,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 1309.427,
          "end": 1309.801,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 1309.801,
          "end": 1310.174,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "highest",
          "start": 1310.174,
          "end": 1310.547,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "possible",
          "start": 1310.547,
          "end": 1310.921,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "point,",
          "start": 1310.921,
          "end": 1311.294,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"millions of light years from the planet Earth, and this Quran was placed into his heart.\"",
