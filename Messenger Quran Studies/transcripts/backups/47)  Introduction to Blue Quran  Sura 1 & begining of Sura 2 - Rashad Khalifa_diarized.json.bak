          "start": 1469.932,
          "end": 1470.276,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"From now to the end of the world, reported here as 2280 AD (see Appendix 25),",
      "start": 1470.276,
      "end": 1476.968,
      "speaker": "Dr. Khalifa",
      "words": [
