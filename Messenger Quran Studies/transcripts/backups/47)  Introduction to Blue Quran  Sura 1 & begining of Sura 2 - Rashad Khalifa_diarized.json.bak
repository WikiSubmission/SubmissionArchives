    {
      "text": "He did not say \"when God alone is mentioned.\" He said \"when God the One and Only is mentioned.\"",
      "start": 1210.822,
      "end": 1215.0,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "He",
          "start": 1210.822,
          "end": 1211.042,
