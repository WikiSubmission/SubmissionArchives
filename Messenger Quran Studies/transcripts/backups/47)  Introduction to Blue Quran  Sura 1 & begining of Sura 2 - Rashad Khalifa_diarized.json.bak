          "speaker": "Dr. Khalifa"
        },
        {
          "word": "heart.\"",
          "start": 1316.376,
          "end": 1316.715,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We have the verses.",
      "start": 1316.959,
      "end": 1318.104,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "We",
          "start": 1316.959,
          "end": 1317.245,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "have",
          "start": 1317.245,
          "end": 1317.532,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 1317.532,
          "end": 1317.818,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "verses.",
          "start": 1317.818,
          "end": 1318.104,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Subsequently, the Quran was released into Muhammad\u2019s memory, with Gabriel\u2019s mediation, over a period of 23 years, from 610 to 632 A.D.\"",
      "start": 1318.593,
      "end": 1327.374,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"Subsequently,",
          "start": 1318.593,
          "end": 1318.992,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 1318.992,
          "end": 1319.391,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran",
          "start": 1319.391,
          "end": 1319.79,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 1319.79,
