          "speaker": "Dr. Khalifa"
        },
        {
          "word": "misguided",
          "start": 3607.161,
          "end": 3607.615,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "believers.\"",
          "start": 3607.615,
          "end": 3608.069,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"A guided believer is devoted to God alone and rejoices in seeing any other believer",
      "start": 3608.436,
      "end": 3613.857,
      "speaker": "Dr. Khalifa",
      "words": [
        {
