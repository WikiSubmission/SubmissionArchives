          "start": 1324.979,
          "end": 1325.378,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "from",
          "start": 1325.378,
          "end": 1325.777,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "610",
