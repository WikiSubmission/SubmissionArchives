        },
        {
          "word": "mentioned.\"",
          "start": 1214.78,
          "end": 1215.0,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The \"One and Only\" does not mean \"Alone\" at all.",
      "start": 1215.733,
      "end": 1217.733,
      "speaker": "Dr. Khalifa",
      "words": [
