        }
      ]
    },
    {
      "text": "Unfortunately.",
      "start": 493.24,
      "end": 493.34,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Unfortunately.",
          "start": 493.24,
          "end": 493.34,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because they only believe in the physical.",
