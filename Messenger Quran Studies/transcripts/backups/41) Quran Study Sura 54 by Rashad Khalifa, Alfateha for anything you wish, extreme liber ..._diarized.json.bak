          "end": 2420.63,
          "speaker": "Dr. Sabahi"
        },
        {
          "word": " amino",
          "start": 2420.85,
          "end": 2421.71,
          "speaker": "Dr. Sabahi"
        },
        {
          "word": " acids",
          "start": 2421.71,
