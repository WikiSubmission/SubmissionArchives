          "speaker": "Dr. Sabahi"
        },
        {
          "word": " in",
          "start": 2422.11,
          "end": 2422.81,
          "speaker": "Dr. Sabahi"
        },
        {
          "word": " for...",
          "start": 2422.81,
          "end": 2423.37,
          "speaker": "Dr. Sabahi"
        }
      ]
    },
    {
      "text": "RNA does not have any amino acids in. RNA are nucleic acids, adenosine, guanine, and all four bases.",
