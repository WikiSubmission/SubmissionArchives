        }
      ]
    },
    {
      "text": "\u0644\u064e\u0627 \u062a\u064e\u062e\u064e\u0627\u0641\u0650\u0649 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u062d\u0652\u0632\u064e\u0646\u0650\u0649\u0653 \u06d6 \u0625\u0650\u0646\u0651\u064e\u0627 \u0631\u064e\u0627\u0653\u062f\u0651\u064f\u0648\u0647\u064f \u0625\u0650\u0644\u064e\u064a\u0652\u0643\u0650 \u0648\u064e\u062c\u064e\u0627\u0639\u0650\u0644\u064f\u0648\u0647\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u0652\u0645\u064f\u0631\u0652\u0633\u064e\u0644\u0650\u064a\u0646\u064e (28:7)",
