        },
        {
          "word": " \u0644\u064e\u0627",
          "start": 604.1,
          "end": 604.18,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u064a\u064e\u0623\u0652\u0645\u064f\u0631\u064f",
          "start": 604.18,
          "end": 604.48,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0628\u0650\u0671\u0644\u0652\u0641\u064e\u062d\u0652\u0634\u064e\u0627\u0653\u0621\u0650",
          "start": 604.48,
          "end": 605.04,
          "speaker": "Dr. Khalifa"
        },
