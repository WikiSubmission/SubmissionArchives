          "end": 598.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Because",
          "start": 598.6,
          "end": 598.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 598.66,
          "end": 598.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 598.84,
          "end": 598.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " law.",
          "start": 598.94,
          "end": 599.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 599.34,
          "end": 599.36,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " says",
          "start": 599.36,
          "end": 599.6,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "God does not advocate...",
      "start": 599.6,
      "end": 601.2,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " God",
          "start": 599.6,
          "end": 600.24,
          "speaker": "Dr. Khalifa"
        },
