          "word": " Wallahi,",
          "start": 640.77,
          "end": 641.02,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " I'm",
          "start": 641.12,
          "end": 641.12,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " not",
          "start": 641.12,
          "end": 641.14,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " memorizing,",
          "start": 641.14,
          "end": 641.7,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " just",
          "start": 642.02,
          "end": 642.02,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " this",
          "start": 642.22,
          "end": 642.32,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " one.",
          "start": 642.32,
          "end": 642.57,
          "speaker": "Ismail Barakat"
        }
      ]
    },
    {
      "text": "Right. This is what I'm saying.",
