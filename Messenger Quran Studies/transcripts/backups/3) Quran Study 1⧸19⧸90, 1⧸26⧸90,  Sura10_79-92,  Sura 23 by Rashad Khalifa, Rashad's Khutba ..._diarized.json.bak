          "end": 607.1,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that.",
          "start": 607.1,
          "end": 607.55,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Say, get away you, Satan you.",
