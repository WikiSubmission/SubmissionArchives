          "end": 605.38,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " advocate",
          "start": 605.68,
          "end": 605.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " things",
          "start": 605.78,
          "end": 606.92,
          "speaker": "Dr. Khalifa"
        },
