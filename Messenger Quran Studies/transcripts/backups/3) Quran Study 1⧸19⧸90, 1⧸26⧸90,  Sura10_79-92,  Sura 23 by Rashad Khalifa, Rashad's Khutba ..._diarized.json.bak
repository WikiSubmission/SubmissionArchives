        }
      ]
    },
    {
      "text": "Yes.",
      "start": 640.76,
      "end": 640.76,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 640.76,
          "end": 640.76,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Hey, you're memorizing the Quran now.",
      "start": 640.76,
      "end": 640.76,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Hey,",
          "start": 640.76,
          "end": 640.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you're",
          "start": 640.76,
          "end": 640.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " memorizing",
          "start": 640.76,
          "end": 640.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 640.76,
          "end": 640.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Quran",
          "start": 640.76,
          "end": 640.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " now.",
          "start": 640.76,
          "end": 640.76,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Wallahi, I'm not memorizing, just this one.",
      "start": 640.77,
      "end": 642.57,
      "speaker": "Ismail Barakat",
      "words": [
