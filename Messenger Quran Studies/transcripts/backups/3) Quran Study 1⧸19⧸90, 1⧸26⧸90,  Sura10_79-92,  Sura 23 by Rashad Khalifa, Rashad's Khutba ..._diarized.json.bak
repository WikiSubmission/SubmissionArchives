        {
          "word": " He",
          "start": 629.6,
          "end": 629.7,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " said...",
          "start": 629.7,
          "end": 631.16,
          "speaker": "Ismail Barakat"
        }
      ]
    },
    {
      "text": "We will make him a messenger.",
      "start": 631.16,
      "end": 631.97,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " We",
