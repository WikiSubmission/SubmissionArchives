          "word": " does",
          "start": 600.24,
          "end": 600.46,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 600.46,
          "end": 600.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " advocate...",
          "start": 600.6,
          "end": 601.2,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Al-Fahsha (\u0671\u0644\u0652\u0641\u064e\u062d\u0652\u0634\u064e\u0627\u0653\u0621\u0650)",
      "start": 602.48,
      "end": 602.9,
      "speaker": "Ismail Barakat",
      "words": [
        {
          "word": " Al-Fahsha",
          "start": 602.48,
          "end": 602.64,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " (\u0671\u0644\u0652\u0641\u064e\u062d\u0652\u0634\u064e\u0627\u0653\u0621\u0650)",
          "start": 602.64,
          "end": 602.9,
          "speaker": "Ismail Barakat"
        }
      ]
    },
    {
      "text": " \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0644\u064e\u0627 \u064a\u064e\u0623\u0652\u0645\u064f\u0631\u064f \u0628\u0650\u0671\u0644\u0652\u0641\u064e\u062d\u0652\u0634\u064e\u0627\u0653\u0621\u0650 (7:28)",
      "start": 603.72,
      "end": 605.26,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "  \u0625\u0650\u0646\u0651\u064e",
          "start": 603.72,
          "end": 603.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0671\u0644\u0644\u0651\u064e\u0647\u064e",
          "start": 603.8,
          "end": 604.1,
