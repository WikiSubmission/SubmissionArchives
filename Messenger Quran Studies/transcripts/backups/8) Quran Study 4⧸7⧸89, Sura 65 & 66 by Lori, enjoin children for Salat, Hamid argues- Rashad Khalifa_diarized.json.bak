          "end": 3275.2,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Don't lose your Quran now. For the next time, we're gonna start at 67. Next week, our teacher will be Gatut.",
      "start": 3275.2,
      "end": 3282.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Don't",
          "start": 3275.2,
          "end": 3277.44,
          "speaker": "Dr. Khalifa"
        },
