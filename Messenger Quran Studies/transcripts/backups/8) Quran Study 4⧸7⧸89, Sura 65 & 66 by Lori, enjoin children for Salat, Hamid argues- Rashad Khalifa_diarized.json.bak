          "end": 1553.08,
          "speaker": "Lori"
        },
        {
          "word": " you",
          "start": 1553.08,
          "end": 1553.1,
          "speaker": "Lori"
        },
        {
          "word": " know,",
          "start": 1553.1,
          "end": 1553.32,
          "speaker": "Lori"
        },
        {
          "word": " who",
          "start": 1553.34,
          "end": 1553.34,
          "speaker": "Lori"
        },
        {
          "word": " worshipped",
          "start": 1553.34,
          "end": 1553.76,
          "speaker": "Lori"
        },
