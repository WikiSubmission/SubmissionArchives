          "speaker": "Lori"
        }
      ]
    },
    {
      "text": "He knows that we break His commandments.",
      "start": 2674.87,
      "end": 2677.28,
      "speaker": "Lori",
      "words": [
        {
          "word": " He",
          "start": 2674.87,
