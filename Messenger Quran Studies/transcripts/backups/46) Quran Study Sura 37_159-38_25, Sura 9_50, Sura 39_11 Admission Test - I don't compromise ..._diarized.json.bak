          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And it's inevitable.",
      "start": 1264.297,
      "end": 1265.559,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 1264.297,
