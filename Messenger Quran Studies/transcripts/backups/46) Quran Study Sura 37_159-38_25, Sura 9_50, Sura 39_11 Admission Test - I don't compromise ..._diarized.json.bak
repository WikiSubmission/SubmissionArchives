          "speaker": "Dr. Khalifa"
        },
        {
          "word": "your",
          "start": 2637.896,
          "end": 2638.223,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "parents",
          "start": 2638.223,
          "end": 2638.549,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "first.",
          "start": 2638.549,
          "end": 2638.876,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They have to be poor.",
