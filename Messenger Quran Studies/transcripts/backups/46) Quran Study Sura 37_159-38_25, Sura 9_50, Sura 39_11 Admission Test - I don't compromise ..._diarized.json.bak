          "start": 653.386,
          "end": 653.843,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "power,",
          "start": 653.843,
          "end": 654.301,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "fame,",
