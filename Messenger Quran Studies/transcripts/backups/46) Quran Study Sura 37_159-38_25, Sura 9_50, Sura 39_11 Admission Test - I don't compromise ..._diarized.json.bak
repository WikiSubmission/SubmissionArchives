          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 650.582,
          "end": 650.875,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "think",
          "start": 650.875,
          "end": 651.169,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this",
          "start": 651.169,
