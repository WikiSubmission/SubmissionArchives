          "speaker": "Dr. Khalifa"
        },
        {
          "word": "established,",
          "start": 652.635,
          "end": 652.928,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "that money, power, fame, good looks do not guarantee happiness at all.",
      "start": 652.928,
      "end": 658.419,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "that",
