      "end": 1297.555,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "In",
          "start": 1292.655,
          "end": 1292.961,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Sura",
          "start": 1292.961,
          "end": 1293.268,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "17,",
          "start": 1293.268,
          "end": 1293.574,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 1293.574,
          "end": 1293.88,
          "speaker": "Dr. Khalifa"
