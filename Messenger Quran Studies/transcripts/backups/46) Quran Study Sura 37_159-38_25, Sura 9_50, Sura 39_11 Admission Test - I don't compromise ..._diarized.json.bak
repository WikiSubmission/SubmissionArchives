          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is their problem.",
      "start": 396.692,
      "end": 397.935,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 396.692,
          "end": 397.003,
          "speaker": "Dr. Khalifa"
        },
        {
