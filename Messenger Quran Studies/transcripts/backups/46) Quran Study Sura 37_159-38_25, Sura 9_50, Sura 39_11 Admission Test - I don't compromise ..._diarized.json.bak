          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "God controls everything with all He gives.",
      "start": 701.556,
      "end": 704.548,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "God",
          "start": 701.556,
          "end": 701.983,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "controls",
          "start": 701.983,
          "end": 702.411,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "everything",
          "start": 702.411,
          "end": 702.838,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "with",
          "start": 702.838,
          "end": 703.266,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "all",
          "start": 703.266,
          "end": 703.693,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "He",
          "start": 703.693,
          "end": 704.121,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "gives.",
          "start": 704.121,
          "end": 704.548,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"The more you thank Me, the more I give you\", God says.",
      "start": 705.771,
      "end": 708.237,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\"The",
          "start": 705.771,
          "end": 705.976,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "more",
          "start": 705.976,
          "end": 706.182,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "you",
          "start": 706.182,
          "end": 706.388,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "thank",
          "start": 706.388,
          "end": 706.593,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Me,",
          "start": 706.593,
          "end": 706.799,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 706.799,
          "end": 707.004,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "more",
          "start": 707.004,
          "end": 707.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 707.21,
          "end": 707.415,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "give",
          "start": 707.415,
          "end": 707.621,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "you\",",
          "start": 707.621,
          "end": 707.826,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 707.826,
          "end": 708.032,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says.",
          "start": 708.032,
          "end": 708.237,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "What does this mean?",
      "start": 708.237,
      "end": 709.305,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "What",
          "start": 708.237,
          "end": 708.504,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "does",
          "start": 708.504,
          "end": 708.771,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this",
          "start": 708.771,
          "end": 709.038,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "mean?",
          "start": 709.038,
          "end": 709.305,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The more we are appreciative, the more God will give us.",
      "start": 709.305,
      "end": 713.2,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 709.305,
          "end": 709.659,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "more",
          "start": 709.659,
          "end": 710.013,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 710.013,
          "end": 710.367,
          "speaker": "Dr. Khalifa"
        },
        {
