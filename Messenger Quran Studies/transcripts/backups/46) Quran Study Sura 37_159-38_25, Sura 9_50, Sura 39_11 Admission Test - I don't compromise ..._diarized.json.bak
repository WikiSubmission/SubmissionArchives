        }
      ]
    },
    {
      "text": "So in Zakat, it says your parents first.",
      "start": 2636.262,
      "end": 2638.876,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "So",
          "start": 2636.262,
          "end": 2636.589,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 2636.589,
          "end": 2636.916,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Zakat,",
          "start": 2636.916,
          "end": 2637.242,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "it",
          "start": 2637.242,
          "end": 2637.569,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says",
