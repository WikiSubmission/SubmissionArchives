          "end": 657.046,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "happiness",
          "start": 657.046,
          "end": 657.504,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "at",
          "start": 657.504,
          "end": 657.961,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "all.",
          "start": 657.961,
          "end": 658.419,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There's a statement in Quran that says \"all happiness is in God's hand.\"",
      "start": 665.755,
      "end": 669.054,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "There's",
          "start": 665.755,
          "end": 666.009,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 666.009,
          "end": 666.263,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "statement",
          "start": 666.263,
          "end": 666.516,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 666.516,
          "end": 666.77,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran",
          "start": 666.77,
          "end": 667.024,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 667.024,
          "end": 667.278,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says",
          "start": 667.278,
          "end": 667.531,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"all",
          "start": 667.531,
          "end": 667.785,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "happiness",
          "start": 667.785,
          "end": 668.039,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 668.039,
          "end": 668.293,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 668.293,
          "end": 668.546,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God's",
          "start": 668.546,
          "end": 668.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "hand.\"",
          "start": 668.8,
          "end": 669.054,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "All dignity, happiness is in God's hand. All of it.",
      "start": 669.054,
      "end": 672.356,
      "speaker": "Dr. Khalifa",
      "words": [
