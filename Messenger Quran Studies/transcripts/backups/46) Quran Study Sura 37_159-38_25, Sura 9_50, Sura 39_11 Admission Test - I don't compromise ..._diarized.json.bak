          "word": "They",
          "start": 2639.4,
          "end": 2639.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "have",
          "start": 2639.73,
          "end": 2640.06,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 2640.06,
          "end": 2640.391,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "be",
          "start": 2640.391,
          "end": 2640.721,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "poor.",
          "start": 2640.721,
          "end": 2641.051,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
