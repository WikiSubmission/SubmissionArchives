          "end": 397.624,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "problem.",
          "start": 397.624,
          "end": 397.935,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And repeatedly the Quran says \"follow God's revelation.\" They say \"No, we follow what our parents taught us.\"",
      "start": 397.935,
      "end": 403.137,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 397.935,
          "end": 398.224,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "repeatedly",
          "start": 398.224,
          "end": 398.513,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 398.513,
          "end": 398.802,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran",
          "start": 398.802,
          "end": 399.091,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says",
          "start": 399.091,
          "end": 399.38,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"follow",
          "start": 399.38,
          "end": 399.669,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God's",
          "start": 399.669,
          "end": 399.958,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "revelation.\"",
          "start": 399.958,
          "end": 400.247,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "They",
          "start": 400.247,
          "end": 400.536,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "say",
          "start": 400.536,
          "end": 400.825,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"No,",
          "start": 400.825,
