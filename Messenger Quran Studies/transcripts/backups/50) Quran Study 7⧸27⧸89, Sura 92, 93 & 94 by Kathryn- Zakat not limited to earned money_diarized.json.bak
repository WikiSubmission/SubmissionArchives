          "end": 3334.601,
          "speaker": "Catherine"
        },
        {
          "word": "mistreated.",
          "start": 3334.601,
          "end": 3334.951,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "It took me a couple of hours to get rid of what amounted to anger.",
      "start": 3335.602,
      "end": 3340.0,
      "speaker": "Catherine",
      "words": [
        {
          "word": "It",
          "start": 3335.602,
