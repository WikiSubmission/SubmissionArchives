          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "Be careful how we speak of God. It came to mind because Rashad talked to us one day about",
      "start": 2212.758,
      "end": 2220.0,
      "speaker": "A woman",
      "words": [
        {
          "word": "Be",
          "start": 2212.758,
