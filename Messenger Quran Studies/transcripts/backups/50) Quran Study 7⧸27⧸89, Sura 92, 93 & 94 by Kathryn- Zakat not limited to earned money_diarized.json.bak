          "speaker": "Catherine"
        },
        {
          "word": "happy",
          "start": 3364.339,
          "end": 3364.68,
          "speaker": "Catherine"
        },
        {
          "word": "where",
          "start": 3364.68,
          "end": 3365.022,
          "speaker": "Catherine"
        },
        {
          "word": "they",
          "start": 3365.022,
          "end": 3365.364,
          "speaker": "Catherine"
        },
        {
          "word": "are,",
          "start": 3365.364,
          "end": 3365.705,
          "speaker": "Catherine"
        },
        {
          "word": "and",
          "start": 3365.705,
          "end": 3366.047,
          "speaker": "Catherine"
        },
        {
          "word": "perfectly",
          "start": 3366.047,
          "end": 3366.388,
          "speaker": "Catherine"
        },
        {
          "word": "well-provided.",
          "start": 3366.388,
          "end": 3366.73,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "And in fact, they're still there.",
      "start": 3367.732,
      "end": 3369.732,
      "speaker": "Catherine",
      "words": [
        {
          "word": "And",
          "start": 3367.732,
          "end": 3368.065,
          "speaker": "Catherine"
        },
        {
          "word": "in",
          "start": 3368.065,
          "end": 3368.399,
          "speaker": "Catherine"
        },
        {
          "word": "fact,",
          "start": 3368.399,
          "end": 3368.732,
          "speaker": "Catherine"
        },
        {
          "word": "they're",
          "start": 3368.732,
          "end": 3369.065,
          "speaker": "Catherine"
        },
        {
          "word": "still",
          "start": 3369.065,
          "end": 3369.399,
          "speaker": "Catherine"
        },
        {
          "word": "there.",
          "start": 3369.399,
          "end": 3369.732,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "So, again, we keep learning these lessons.",
      "start": 3369.732,
      "end": 3372.734,
      "speaker": "Catherine",
      "words": [
        {
          "word": "So,",
          "start": 3369.732,
          "end": 3370.161,
          "speaker": "Catherine"
        },
        {
          "word": "again,",
          "start": 3370.161,
          "end": 3370.59,
          "speaker": "Catherine"
        },
        {
          "word": "we",
          "start": 3370.59,
          "end": 3371.019,
          "speaker": "Catherine"
        },
        {
          "word": "keep",
          "start": 3371.019,
          "end": 3371.447,
          "speaker": "Catherine"
        },
        {
          "word": "learning",
          "start": 3371.447,
          "end": 3371.876,
          "speaker": "Catherine"
        },
        {
          "word": "these",
          "start": 3371.876,
          "end": 3372.305,
          "speaker": "Catherine"
        },
        {
          "word": "lessons.",
          "start": 3372.305,
          "end": 3372.734,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I wasted a lot of energy, and you can bet that not once during that two hours was I thinking about God.",
