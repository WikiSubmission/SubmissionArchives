        },
        {
          "word": "is",
          "start": 3439.765,
          "end": 3440.275,
          "speaker": "Catherine"
        },
        {
          "word": "an",
          "start": 3440.275,
          "end": 3440.786,
          "speaker": "Catherine"
        },
        {
          "word": "honorable",
          "start": 3440.786,
          "end": 3441.296,
          "speaker": "Catherine"
        },
        {
          "word": "position.",
          "start": 3441.296,
          "end": 3441.806,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "Sitting on this floor every Friday night is the most honorable position I've ever been in, in my life.",
