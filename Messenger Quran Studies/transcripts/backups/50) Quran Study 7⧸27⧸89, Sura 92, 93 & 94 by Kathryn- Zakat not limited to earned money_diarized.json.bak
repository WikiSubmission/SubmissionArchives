          "speaker": "Dr. Khalifa"
        },
        {
          "word": "get",
          "start": 3149.89,
          "end": 3150.125,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "angry.",
          "start": 3150.125,
          "end": 3150.36,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There's nothing in this world that is worth getting angry at.",
