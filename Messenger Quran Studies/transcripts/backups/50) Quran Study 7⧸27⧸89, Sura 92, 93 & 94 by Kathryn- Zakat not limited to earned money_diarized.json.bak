          "speaker": "Catherine"
        },
        {
          "word": "rid",
          "start": 3338.241,
          "end": 3338.534,
          "speaker": "Catherine"
        },
        {
          "word": "of",
          "start": 3338.534,
          "end": 3338.827,
          "speaker": "Catherine"
        },
        {
          "word": "what",
          "start": 3338.827,
          "end": 3339.12,
          "speaker": "Catherine"
        },
        {
          "word": "amounted",
          "start": 3339.12,
          "end": 3339.414,
          "speaker": "Catherine"
        },
        {
          "word": "to",
          "start": 3339.414,
          "end": 3339.707,
          "speaker": "Catherine"
        },
        {
          "word": "anger.",
          "start": 3339.707,
          "end": 3340.0,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I was furious that this person, who is poor, who cannot fend for himself, has been totally disregarded.",
      "start": 3340.0,
      "end": 3346.057,
      "speaker": "Catherine",
      "words": [
        {
          "word": "I",
          "start": 3340.0,
          "end": 3340.336,
          "speaker": "Catherine"
        },
        {
          "word": "was",
