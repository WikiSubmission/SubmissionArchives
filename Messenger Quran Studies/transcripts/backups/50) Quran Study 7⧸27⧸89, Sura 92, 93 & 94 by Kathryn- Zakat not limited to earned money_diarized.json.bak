        },
        {
          "word": "to",
          "start": 3358.673,
          "end": 3358.994,
          "speaker": "Catherine"
        },
        {
          "word": "God's",
          "start": 3358.994,
          "end": 3359.316,
          "speaker": "Catherine"
        },
        {
          "word": "will",
          "start": 3359.316,
          "end": 3359.637,
          "speaker": "Catherine"
        },
        {
          "word": "and",
          "start": 3359.637,
          "end": 3359.959,
          "speaker": "Catherine"
        },
        {
          "word": "for",
          "start": 3359.959,
          "end": 3360.28,
          "speaker": "Catherine"
        },
        {
          "word": "a",
          "start": 3360.28,
          "end": 3360.602,
          "speaker": "Catherine"
        },
        {
          "word": "reason.",
          "start": 3360.602,
          "end": 3360.923,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "And the person that I was angry for is perfectly happy where they are, and perfectly well-provided.",
      "start": 3360.923,
      "end": 3366.73,
      "speaker": "Catherine",
      "words": [
