        },
        {
          "word": "how",
          "start": 3449.801,
          "end": 3450.044,
          "speaker": "Catherine"
        },
        {
          "word": "I",
          "start": 3450.044,
          "end": 3450.287,
          "speaker": "Catherine"
        },
        {
          "word": "read",
          "start": 3450.287,
