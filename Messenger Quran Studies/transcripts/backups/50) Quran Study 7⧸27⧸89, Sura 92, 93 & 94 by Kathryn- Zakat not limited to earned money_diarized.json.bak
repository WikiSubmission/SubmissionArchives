          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3596.457,
          "end": 3596.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "same",
          "start": 3596.83,
          "end": 3597.203,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "time.",
          "start": 3597.203,
          "end": 3597.576,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And then, we were the fastest creatures on earth to finish the Prayer.",
      "start": 3598.227,
      "end": 3602.681,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
