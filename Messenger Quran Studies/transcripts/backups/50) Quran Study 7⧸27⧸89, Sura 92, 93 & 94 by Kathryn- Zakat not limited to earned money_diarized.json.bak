        },
        {
          "word": "the",
          "start": 3361.265,
          "end": 3361.606,
          "speaker": "Catherine"
        },
        {
          "word": "person",
          "start": 3361.606,
          "end": 3361.948,
          "speaker": "Catherine"
        },
        {
          "word": "that",
          "start": 3361.948,
          "end": 3362.289,
          "speaker": "Catherine"
        },
        {
          "word": "I",
          "start": 3362.289,
          "end": 3362.631,
          "speaker": "Catherine"
        },
        {
          "word": "was",
          "start": 3362.631,
          "end": 3362.973,
          "speaker": "Catherine"
        },
        {
          "word": "angry",
