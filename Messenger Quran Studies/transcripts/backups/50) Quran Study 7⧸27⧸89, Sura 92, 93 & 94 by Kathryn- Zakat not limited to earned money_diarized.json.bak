        },
        {
          "word": "was",
          "start": 3353.781,
          "end": 3353.988,
          "speaker": "Catherine"
        },
        {
          "word": "gonna",
          "start": 3353.988,
          "end": 3354.195,
          "speaker": "Catherine"
        },
        {
          "word": "go",
          "start": 3354.195,
          "end": 3354.402,
          "speaker": "Catherine"
        },
        {
          "word": "through",
          "start": 3354.402,
          "end": 3354.609,
          "speaker": "Catherine"
        },
        {
          "word": "it.",
          "start": 3354.609,
          "end": 3354.816,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I'd wasted two hours being angry at something that is happening according to God's will and for a reason.",
      "start": 3354.816,
      "end": 3360.923,
      "speaker": "Catherine",
      "words": [
        {
          "word": "I'd",
          "start": 3354.816,
          "end": 3355.137,
          "speaker": "Catherine"
        },
        {
          "word": "wasted",
          "start": 3355.137,
          "end": 3355.459,
          "speaker": "Catherine"
        },
        {
          "word": "two",
          "start": 3355.459,
          "end": 3355.78,
          "speaker": "Catherine"
        },
        {
          "word": "hours",
          "start": 3355.78,
          "end": 3356.102,
          "speaker": "Catherine"
        },
        {
          "word": "being",
