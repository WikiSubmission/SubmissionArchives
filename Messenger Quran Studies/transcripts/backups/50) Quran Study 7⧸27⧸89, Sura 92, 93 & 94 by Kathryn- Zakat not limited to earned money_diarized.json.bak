          "speaker": "Catherine"
        },
        {
          "word": "back.",
          "start": 3321.559,
          "end": 3321.839,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I was so incensed at what had happened.",
      "start": 3321.839,
      "end": 3324.39,
      "speaker": "Catherine",
      "words": [
        {
          "word": "I",
          "start": 3321.839,
          "end": 3322.158,
          "speaker": "Catherine"
        },
        {
          "word": "was",
          "start": 3322.158,
          "end": 3322.477,
          "speaker": "Catherine"
        },
        {
          "word": "so",
          "start": 3322.477,
          "end": 3322.796,
          "speaker": "Catherine"
        },
        {
          "word": "incensed",
          "start": 3322.796,
          "end": 3323.114,
          "speaker": "Catherine"
        },
        {
          "word": "at",
          "start": 3323.114,
          "end": 3323.433,
          "speaker": "Catherine"
        },
        {
          "word": "what",
          "start": 3323.433,
          "end": 3323.752,
          "speaker": "Catherine"
        },
        {
          "word": "had",
          "start": 3323.752,
          "end": 3324.071,
          "speaker": "Catherine"
        },
        {
          "word": "happened.",
          "start": 3324.071,
          "end": 3324.39,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I was so incensed at the dishonesty, at the manipulation that I had, had witnessed and heard,",
      "start": 3324.64,
      "end": 3331.799,
      "speaker": "Catherine",
      "words": [
        {
          "word": "I",
          "start": 3324.64,
          "end": 3325.061,
          "speaker": "Catherine"
        },
        {
          "word": "was",
          "start": 3325.061,
          "end": 3325.482,
          "speaker": "Catherine"
        },
        {
          "word": "so",
          "start": 3325.482,
          "end": 3325.903,
          "speaker": "Catherine"
        },
        {
          "word": "incensed",
          "start": 3325.903,
          "end": 3326.324,
          "speaker": "Catherine"
        },
        {
          "word": "at",
          "start": 3326.324,
          "end": 3326.746,
          "speaker": "Catherine"
        },
        {
          "word": "the",
          "start": 3326.746,
          "end": 3327.167,
          "speaker": "Catherine"
        },
        {
          "word": "dishonesty,",
          "start": 3327.167,
          "end": 3327.588,
          "speaker": "Catherine"
        },
        {
          "word": "at",
          "start": 3327.588,
          "end": 3328.009,
          "speaker": "Catherine"
        },
        {
          "word": "the",
          "start": 3328.009,
          "end": 3328.43,
          "speaker": "Catherine"
        },
        {
          "word": "manipulation",
          "start": 3328.43,
          "end": 3328.851,
          "speaker": "Catherine"
        },
        {
          "word": "that",
          "start": 3328.851,
          "end": 3329.272,
          "speaker": "Catherine"
        },
        {
          "word": "I",
          "start": 3329.272,
          "end": 3329.693,
          "speaker": "Catherine"
        },
        {
          "word": "had,",
          "start": 3329.693,
          "end": 3330.115,
          "speaker": "Catherine"
        },
        {
          "word": "had",
          "start": 3330.115,
          "end": 3330.536,
          "speaker": "Catherine"
        },
        {
          "word": "witnessed",
          "start": 3330.536,
          "end": 3330.957,
          "speaker": "Catherine"
        },
        {
          "word": "and",
          "start": 3330.957,
          "end": 3331.378,
          "speaker": "Catherine"
        },
        {
          "word": "heard,",
          "start": 3331.378,
          "end": 3331.799,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "and that this person could be so badly mistreated.",
