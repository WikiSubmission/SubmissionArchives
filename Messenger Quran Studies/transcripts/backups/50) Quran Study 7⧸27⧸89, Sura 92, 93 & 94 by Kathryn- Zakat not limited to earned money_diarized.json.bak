          "start": 3372.734,
          "end": 3373.023,
          "speaker": "Catherine"
        },
        {
          "word": "wasted",
          "start": 3373.023,
          "end": 3373.312,
          "speaker": "Catherine"
        },
        {
          "word": "a",
          "start": 3373.312,
          "end": 3373.601,
          "speaker": "Catherine"
        },
        {
          "word": "lot",
          "start": 3373.601,
          "end": 3373.89,
          "speaker": "Catherine"
        },
        {
          "word": "of",
          "start": 3373.89,
          "end": 3374.179,
          "speaker": "Catherine"
        },
        {
          "word": "energy,",
          "start": 3374.179,
          "end": 3374.468,
          "speaker": "Catherine"
        },
        {
          "word": "and",
          "start": 3374.468,
          "end": 3374.757,
