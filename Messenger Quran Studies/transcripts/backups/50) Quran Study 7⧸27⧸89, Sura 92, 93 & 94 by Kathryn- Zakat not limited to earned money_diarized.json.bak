          "speaker": "Catherine"
        },
        {
          "word": "himself,",
          "start": 3344.374,
          "end": 3344.711,
          "speaker": "Catherine"
        },
        {
          "word": "has",
          "start": 3344.711,
          "end": 3345.047,
          "speaker": "Catherine"
        },
        {
          "word": "been",
          "start": 3345.047,
          "end": 3345.384,
          "speaker": "Catherine"
        },
        {
          "word": "totally",
          "start": 3345.384,
          "end": 3345.72,
          "speaker": "Catherine"
        },
        {
          "word": "disregarded.",
          "start": 3345.72,
          "end": 3346.057,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "And by the time the two hours was over, I thought,",
      "start": 3347.359,
      "end": 3350.261,
      "speaker": "Catherine",
      "words": [
        {
          "word": "And",
          "start": 3347.359,
          "end": 3347.623,
          "speaker": "Catherine"
        },
        {
          "word": "by",
          "start": 3347.623,
          "end": 3347.887,
          "speaker": "Catherine"
        },
        {
          "word": "the",
          "start": 3347.887,
          "end": 3348.15,
          "speaker": "Catherine"
        },
        {
          "word": "time",
          "start": 3348.15,
          "end": 3348.414,
          "speaker": "Catherine"
        },
        {
          "word": "the",
          "start": 3348.414,
          "end": 3348.678,
          "speaker": "Catherine"
        },
        {
          "word": "two",
          "start": 3348.678,
          "end": 3348.942,
          "speaker": "Catherine"
        },
        {
          "word": "hours",
          "start": 3348.942,
          "end": 3349.206,
          "speaker": "Catherine"
        },
        {
          "word": "was",
          "start": 3349.206,
          "end": 3349.47,
          "speaker": "Catherine"
        },
        {
          "word": "over,",
          "start": 3349.47,
          "end": 3349.733,
          "speaker": "Catherine"
        },
        {
          "word": "I",
          "start": 3349.733,
          "end": 3349.997,
          "speaker": "Catherine"
        },
        {
          "word": "thought,",
          "start": 3349.997,
          "end": 3350.261,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "I started looking around, cause I was sure the (unintelligible) floor was gonna open up and I was gonna go through it.",
      "start": 3350.261,
      "end": 3354.816,
      "speaker": "Catherine",
      "words": [
        {
