        },
        {
          "word": "was",
          "start": 3377.647,
          "end": 3377.936,
          "speaker": "Catherine"
        },
        {
          "word": "I",
          "start": 3377.936,
          "end": 3378.225,
          "speaker": "Catherine"
        },
        {
          "word": "thinking",
          "start": 3378.225,
          "end": 3378.514,
          "speaker": "Catherine"
        },
        {
          "word": "about",
          "start": 3378.514,
          "end": 3378.803,
          "speaker": "Catherine"
        },
        {
          "word": "God.",
          "start": 3378.803,
          "end": 3379.092,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "It wasn't until I did think about God that the whole thing went away.",
      "start": 3379.342,
