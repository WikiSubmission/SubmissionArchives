          "end": 3336.188,
          "speaker": "Catherine"
        },
        {
          "word": "me",
          "start": 3336.188,
          "end": 3336.482,
          "speaker": "Catherine"
        },
        {
          "word": "a",
          "start": 3336.482,
          "end": 3336.775,
          "speaker": "Catherine"
        },
        {
