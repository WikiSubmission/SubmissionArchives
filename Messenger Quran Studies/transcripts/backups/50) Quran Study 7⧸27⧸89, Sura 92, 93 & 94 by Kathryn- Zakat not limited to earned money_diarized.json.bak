          "start": 3304.053,
          "end": 3304.387,
          "speaker": "Catherine"
        },
        {
          "word": "we",
          "start": 3304.387,
          "end": 3304.72,
          "speaker": "Catherine"
        },
        {
          "word": "best",
          "start": 3304.72,
          "end": 3305.053,
