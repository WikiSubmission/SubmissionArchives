          "end": 2477.89,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " those",
          "start": 2478.13,
          "end": 2478.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " have",
          "start": 2478.13,
          "end": 2478.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 2478.49,
          "end": 2478.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " have",
          "start": 2478.73,
