          "speaker": "Dr. Khalifa"
        },
        {
          "word": " world.\"",
          "start": 3297.39,
          "end": 3297.64,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But I discovered that I'm naive, that the human being is really bad.",
      "start": 3299.15,
      "end": 3302.41,
      "speaker": "Dr. Khalifa",
      "words": [
