          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "Not that every doctor is bad or anything like that. But the power has a lot of times led to trouble.",
      "start": 1667.26,
      "end": 1673.82,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " Not",
          "start": 1667.26,
          "end": 1667.4,
          "speaker": "Naghmeh"
