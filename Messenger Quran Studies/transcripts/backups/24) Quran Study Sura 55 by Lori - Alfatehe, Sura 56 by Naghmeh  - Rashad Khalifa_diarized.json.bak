          "word": " Dr.",
          "start": 4450.63,
          "end": 4450.63,
          "speaker": "Naghmeh"
        },
        {
          "word": " Khalifa:",
          "start": 4450.63,
          "end": 4450.63,
          "speaker": "Naghmeh"
        },
        {
          "word": " God",
          "start": 4450.77,
          "end": 4450.87,
          "speaker": "Naghmeh"
