        }
      ]
    },
    {
      "text": "IN SHAA ALLAH",
      "start": 1574.4,
      "end": 1574.88,
      "speaker": "Audience",
      "words": [
        {
          "word": " IN",
          "start": 1574.4,
          "end": 1574.4,
          "speaker": "Audience"
        },
        {
          "word": " SHAA",
          "start": 1574.4,
          "end": 1574.4,
          "speaker": "Audience"
        },
        {
          "word": " ALLAH",
          "start": 1574.4,
          "end": 1574.88,
          "speaker": "Audience"
        }
      ]
    },
    {
      "text": "From far ahead.",
      "start": 1587.78,
      "end": 1589.02,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " From",
          "start": 1587.78,
          "end": 1588.48,
          "speaker": "Naghmeh"
        },
        {
          "word": " far",
          "start": 1588.64,
          "end": 1588.74,
          "speaker": "Naghmeh"
        },
        {
          "word": " ahead.",
          "start": 1588.74,
          "end": 1589.02,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "Okay.",
      "start": 1591.96,
      "end": 1592.72,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " Okay.",
          "start": 1591.96,
          "end": 1592.72,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "We know...",
      "start": 1593.4,
      "end": 1593.8,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " We",
          "start": 1593.4,
          "end": 1593.4,
          "speaker": "Naghmeh"
        },
        {
          "word": " know...",
          "start": 1593.4,
          "end": 1593.8,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "Really, should I repeat this?",
      "start": 1594.58,
      "end": 1595.66,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " Really,",
          "start": 1594.58,
          "end": 1594.8,
          "speaker": "Naghmeh"
        },
        {
          "word": " should",
          "start": 1594.88,
          "end": 1594.88,
          "speaker": "Naghmeh"
        },
        {
          "word": " I",
          "start": 1594.88,
          "end": 1594.96,
          "speaker": "Naghmeh"
        },
        {
          "word": " repeat",
          "start": 1594.96,
          "end": 1595.16,
          "speaker": "Naghmeh"
        },
        {
          "word": " this?",
          "start": 1595.16,
          "end": 1595.66,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "Yes.",
      "start": 1595.8,
      "end": 1596.4,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 1595.8,
          "end": 1596.4,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Oh, Okay.",
      "start": 1596.52,
      "end": 1597.08,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " Oh,",
          "start": 1596.52,
          "end": 1596.62,
          "speaker": "Naghmeh"
        },
        {
          "word": " Okay.",
          "start": 1596.72,
          "end": 1597.08,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "Okay, God says \"and those who are far ahead will be far ahead.\"",
      "start": 1597.88,
      "end": 1603.44,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " Okay,",
          "start": 1597.88,
          "end": 1600.42,
          "speaker": "Naghmeh"
        },
        {
          "word": " God",
          "start": 1600.44,
          "end": 1600.56,
          "speaker": "Naghmeh"
        },
        {
          "word": " says",
          "start": 1600.56,
          "end": 1600.8,
          "speaker": "Naghmeh"
        },
        {
          "word": " \"and",
          "start": 1600.8,
          "end": 1601.06,
          "speaker": "Naghmeh"
        },
        {
          "word": " those",
          "start": 1601.06,
          "end": 1601.28,
          "speaker": "Naghmeh"
        },
        {
          "word": " who",
          "start": 1601.28,
          "end": 1601.5,
          "speaker": "Naghmeh"
        },
        {
          "word": " are",
          "start": 1601.5,
          "end": 1601.62,
          "speaker": "Naghmeh"
        },
        {
          "word": " far",
          "start": 1601.62,
          "end": 1601.9,
          "speaker": "Naghmeh"
        },
        {
          "word": " ahead",
          "start": 1601.9,
          "end": 1602.24,
          "speaker": "Naghmeh"
        },
        {
          "word": " will",
          "start": 1602.24,
          "end": 1602.52,
          "speaker": "Naghmeh"
        },
        {
          "word": " be",
          "start": 1602.52,
          "end": 1602.7,
          "speaker": "Naghmeh"
        },
        {
          "word": " far",
          "start": 1602.9,
          "end": 1603.0,
          "speaker": "Naghmeh"
        },
        {
          "word": " ahead.\"",
          "start": 1603.0,
          "end": 1603.44,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "And they will be closest to God.",
      "start": 1604.46,
      "end": 1605.88,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " And",
          "start": 1604.46,
          "end": 1604.56,
          "speaker": "Naghmeh"
        },
        {
          "word": " they",
          "start": 1604.56,
          "end": 1604.7,
          "speaker": "Naghmeh"
        },
        {
          "word": " will",
          "start": 1604.7,
          "end": 1604.8,
          "speaker": "Naghmeh"
        },
        {
          "word": " be",
          "start": 1604.8,
          "end": 1604.92,
          "speaker": "Naghmeh"
        },
        {
          "word": " closest",
          "start": 1605.1,
          "end": 1605.28,
          "speaker": "Naghmeh"
        },
        {
          "word": " to",
          "start": 1605.28,
          "end": 1605.56,
          "speaker": "Naghmeh"
        },
        {
          "word": " God.",
          "start": 1605.56,
          "end": 1605.88,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "And far ahead is, of course, the Highest Heaven.",
      "start": 1606.48,
      "end": 1608.38,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " And",
          "start": 1606.48,
          "end": 1606.58,
          "speaker": "Naghmeh"
        },
        {
          "word": " far",
          "start": 1606.7,
          "end": 1606.8,
          "speaker": "Naghmeh"
        },
        {
          "word": " ahead",
          "start": 1606.8,
          "end": 1607.08,
          "speaker": "Naghmeh"
        },
        {
          "word": " is,",
          "start": 1607.08,
          "end": 1607.18,
          "speaker": "Naghmeh"
        },
        {
          "word": " of",
          "start": 1607.4,
          "end": 1607.4,
          "speaker": "Naghmeh"
        },
        {
          "word": " course,",
          "start": 1607.4,
          "end": 1607.54,
          "speaker": "Naghmeh"
        },
        {
          "word": " the",
          "start": 1607.7,
          "end": 1607.76,
          "speaker": "Naghmeh"
        },
        {
          "word": " Highest",
          "start": 1607.82,
          "end": 1608.12,
          "speaker": "Naghmeh"
        },
        {
          "word": " Heaven.",
          "start": 1608.12,
          "end": 1608.38,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "Then, and we know that far ahead doesn't mean how much money you have or what looks you have",
      "start": 1609.24,
      "end": 1617.18,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " Then,",
          "start": 1609.24,
          "end": 1609.66,
          "speaker": "Naghmeh"
        },
        {
          "word": " and",
          "start": 1610.24,
          "end": 1610.38,
          "speaker": "Naghmeh"
        },
        {
          "word": " we",
          "start": 1610.38,
          "end": 1610.54,
          "speaker": "Naghmeh"
        },
        {
          "word": " know",
          "start": 1610.54,
          "end": 1610.78,
          "speaker": "Naghmeh"
        },
        {
          "word": " that",
          "start": 1610.78,
          "end": 1611.24,
          "speaker": "Naghmeh"
        },
        {
          "word": " far",
          "start": 1611.24,
          "end": 1612.96,
          "speaker": "Naghmeh"
        },
        {
          "word": " ahead",
          "start": 1612.96,
          "end": 1613.3,
          "speaker": "Naghmeh"
        },
        {
          "word": " doesn't",
          "start": 1613.3,
          "end": 1613.78,
          "speaker": "Naghmeh"
        },
        {
