          "end": 3307.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Egypt.",
          "start": 3307.11,
          "end": 3308.35,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And he said \"I'm the only one in Egypt.\"",
      "start": 3308.37,
      "end": 3309.66,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 3308.37,
