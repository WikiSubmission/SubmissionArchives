          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "The Prayers, the Prayers are meals. When they say \"one Prayer maybe but not five\", this means, it's like saying, I just have breakfast.",
      "start": 4498.97,
      "end": 4504.93,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " The",
          "start": 4498.97,
          "end": 4498.97,
          "speaker": "Dr. Khalifa"
        },
