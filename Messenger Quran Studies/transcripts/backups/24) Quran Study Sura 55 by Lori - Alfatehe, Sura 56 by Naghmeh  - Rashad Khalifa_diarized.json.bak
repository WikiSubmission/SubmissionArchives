          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I was talking to my nephew, Sharif, in Egypt.",
      "start": 3304.75,
      "end": 3308.35,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I",
