          "end": 2650.35,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muslims",
          "start": 2650.35,
          "end": 2650.71,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " walked",
          "start": 2650.71,
          "end": 2651.05,
