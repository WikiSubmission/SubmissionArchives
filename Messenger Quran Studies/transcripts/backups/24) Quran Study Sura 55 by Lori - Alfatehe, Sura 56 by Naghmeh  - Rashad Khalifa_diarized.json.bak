          "speaker": "Dr. Khalifa"
        },
        {
          "word": " those",
          "start": 2473.81,
          "end": 2474.37,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " people",
          "start": 2474.37,
          "end": 2474.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " were",
