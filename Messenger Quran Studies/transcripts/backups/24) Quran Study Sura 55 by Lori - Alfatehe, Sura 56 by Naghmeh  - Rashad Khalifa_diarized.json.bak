        },
        {
          "word": " they",
          "start": 2456.33,
          "end": 2456.35,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " banished",
          "start": 2456.35,
          "end": 2456.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " them",
          "start": 2456.71,
          "end": 2457.01,
          "speaker": "Dr. Khalifa"
        },
