          "word": " severely.",
          "start": 2448.15,
          "end": 2449.05,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They threw on them all kinds of dirt and thorns.",
      "start": 2450.17,
      "end": 2454.71,
      "speaker": "Dr. Khalifa",
      "words": [
