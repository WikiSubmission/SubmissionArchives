          "speaker": "Naghmeh"
        },
        {
          "word": " back.",
          "start": 5011.05,
          "end": 5011.2,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "I said \"thank you, God.\"",
      "start": 5013.04,
      "end": 5015.67,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " I",
