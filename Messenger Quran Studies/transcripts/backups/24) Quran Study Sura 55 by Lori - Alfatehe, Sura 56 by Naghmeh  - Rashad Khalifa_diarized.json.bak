          "end": 2481.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Heaven.",
          "start": 2481.43,
          "end": 2482.19,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They went against the current.",
      "start": 2482.79,
      "end": 2484.44,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " They",
          "start": 2482.79,
          "end": 2482.89,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " went",
          "start": 2482.89,
          "end": 2483.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " against",
          "start": 2483.05,
          "end": 2483.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2483.53,
          "end": 2483.79,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " current.",
          "start": 2483.79,
          "end": 2484.44,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They were worshipping God alone in an ocean of idolatry.",
