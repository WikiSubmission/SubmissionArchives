          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I take that back.",
      "start": 5010.85,
      "end": 5011.2,
      "speaker": "Naghmeh",
      "words": [
        {
          "word": " I",
          "start": 5010.85,
          "end": 5010.85,
          "speaker": "Naghmeh"
        },
        {
