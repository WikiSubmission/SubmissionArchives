          "start": 374.62,
          "end": 374.88,
          "speaker": "Laurie"
        },
        {
          "word": " back.",
          "start": 374.88,
          "end": 375.53,
          "speaker": "Laurie"
        }
      ]
    },
    {
      "text": "And every time there's something new.",
      "start": 375.72,
      "end": 377.53,
      "speaker": "Laurie",
      "words": [
