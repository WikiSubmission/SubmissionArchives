          "speaker": "Muhtesem"
        },
        {
          "word": " Suras",
          "start": 2879.85,
          "end": 2880.37,
          "speaker": "Muhtesem"
        },
        {
          "word": " are",
          "start": 2880.37,
          "end": 2880.47,
          "speaker": "Muhtesem"
        },
        {
          "word": " in",
          "start": 2880.47,
          "end": 2880.95,
          "speaker": "Muhtesem"
        },
        {
          "word": " the",
          "start": 2880.95,
          "end": 2880.95,
          "speaker": "Muhtesem"
        },
        {
          "word": " Quran?\"",
          "start": 2880.95,
          "end": 2880.99,
          "speaker": "Muhtesem"
        }
      ]
    },
    {
      "text": "What? They don't know?",
      "start": 2880.99,
      "end": 2884.35,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " What?",
          "start": 2880.99,
          "end": 2881.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " They",
          "start": 2883.69,
          "end": 2883.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " don't",
          "start": 2883.75,
          "end": 2883.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " know?",
          "start": 2883.93,
          "end": 2884.35,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
