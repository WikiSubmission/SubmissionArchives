          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And our teacher tonight will be Laurie, right?",
      "start": 19.3,
      "end": 21.9,
      "speaker": "Dr. Khalifa",
      "words": [
        {
