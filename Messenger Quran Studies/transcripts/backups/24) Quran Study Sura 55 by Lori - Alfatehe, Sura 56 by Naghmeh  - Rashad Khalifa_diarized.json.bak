          "start": 4498.97,
          "end": 4499.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 4499.45,
          "end": 4499.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Prayers",
          "start": 4499.45,
          "end": 4499.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
