          "end": 2657.15,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He said \"yes.\"",
      "start": 2658.11,
      "end": 2658.95,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " He",
          "start": 2658.11,
          "end": 2658.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 2658.11,
          "end": 2658.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"yes.\"",
          "start": 2658.41,
          "end": 2658.95,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They said \"how come we don't see you at the mosque?\"",
      "start": 2659.11,
      "end": 2660.73,
      "speaker": "Dr. Khalifa",
      "words": [
