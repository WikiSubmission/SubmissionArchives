          "word": " said",
          "start": 2656.67,
          "end": 2656.77,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"are",
          "start": 2656.77,
          "end": 2656.87,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 2656.87,
          "end": 2657.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
