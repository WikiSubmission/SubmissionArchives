          "end": 2444.74,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And Muhammad and his company were persecuted severely.",
      "start": 2445.97,
      "end": 2449.05,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 2445.97,
          "end": 2446.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muhammad",
          "start": 2446.03,
          "end": 2446.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 2446.31,
          "end": 2446.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " his",
          "start": 2446.57,
          "end": 2446.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " company",
