          "speaker": "Dr. Khalifa"
        },
        {
          "word": " then",
          "start": 2434.89,
          "end": 2435.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 2435.13,
          "end": 2436.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " renewed",
          "start": 2436.03,
          "end": 2436.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2436.41,
          "end": 2436.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " message,",
