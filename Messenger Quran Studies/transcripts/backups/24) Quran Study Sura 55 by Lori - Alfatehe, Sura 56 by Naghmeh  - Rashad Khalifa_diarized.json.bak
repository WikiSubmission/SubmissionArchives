          "end": 2647.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " working",
          "start": 2647.71,
          "end": 2647.97,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2647.97,
          "end": 2648.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " other",
