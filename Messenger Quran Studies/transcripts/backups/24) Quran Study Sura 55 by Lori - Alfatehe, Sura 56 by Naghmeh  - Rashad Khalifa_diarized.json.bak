          "end": 2647.15,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Mahmoud was working the other night.",
      "start": 2647.29,
      "end": 2648.99,
      "speaker": "Dr. Khalifa",
