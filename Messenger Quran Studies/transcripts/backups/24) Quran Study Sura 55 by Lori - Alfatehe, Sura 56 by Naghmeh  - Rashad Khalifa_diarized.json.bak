          "end": 2484.71,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " worshipping",
          "start": 2484.71,
          "end": 2485.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 2485.13,
