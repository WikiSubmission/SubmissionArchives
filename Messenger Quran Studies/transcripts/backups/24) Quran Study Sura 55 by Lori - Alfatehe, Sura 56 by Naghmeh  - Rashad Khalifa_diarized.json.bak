    {
      "text": "Well, I asked them \"how many Suras are in the Quran?\"",
      "start": 2878.61,
      "end": 2880.99,
      "speaker": "Muhtesem",
      "words": [
        {
          "word": " Well,",
          "start": 2878.61,
          "end": 2878.91,
          "speaker": "Muhtesem"
        },
        {
          "word": " I",
          "start": 2879.05,
          "end": 2879.05,
          "speaker": "Muhtesem"
        },
        {
          "word": " asked",
          "start": 2879.05,
          "end": 2879.07,
          "speaker": "Muhtesem"
        },
        {
          "word": " them",
          "start": 2879.07,
          "end": 2879.39,
          "speaker": "Muhtesem"
        },
        {
          "word": " \"how",
