          "word": " thorns.",
          "start": 2453.61,
          "end": 2454.71,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Then, they banished them when they grew.",
      "start": 2456.01,
      "end": 2458.19,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Then,",
          "start": 2456.01,
          "end": 2456.33,
