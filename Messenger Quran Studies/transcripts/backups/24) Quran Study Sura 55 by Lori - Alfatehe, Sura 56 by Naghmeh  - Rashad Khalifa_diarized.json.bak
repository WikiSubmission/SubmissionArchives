          "start": 2314.57,
          "end": 2314.65,
          "speaker": "A woman"
        },
        {
          "word": " they",
          "start": 2314.65,
          "end": 2314.81,
          "speaker": "A woman"
        },
        {
          "word": " say",
          "start": 2314.81,
          "end": 2314.93,
          "speaker": "A woman"
        },
