    {
      "text": "\"Worship God alone.\" Say \"La Elaha Ella Allah.\"",
      "start": 2539.61,
      "end": 2541.75,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"Worship",
          "start": 2539.61,
          "end": 2539.63,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 2539.63,
          "end": 2539.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone.\"",
          "start": 2539.85,
          "end": 2540.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Say",
          "start": 2540.49,
          "end": 2540.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"La",
          "start": 2540.49,
          "end": 2540.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Elaha",
          "start": 2540.67,
          "end": 2540.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Ella",
          "start": 2540.85,
          "end": 2541.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Allah.\"",
          "start": 2541.13,
          "end": 2541.75,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "NOT \"La Elaha Ella Allah, Muhammad Rasulallah.\"",
      "start": 2541.87,
      "end": 2543.37,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " NOT",
          "start": 2541.87,
