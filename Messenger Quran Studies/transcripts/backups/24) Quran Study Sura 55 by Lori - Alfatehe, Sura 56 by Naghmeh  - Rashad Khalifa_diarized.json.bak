          "speaker": "Naghmeh"
        },
        {
          "word": " said",
          "start": 5013.69,
          "end": 5014.85,
          "speaker": "Naghmeh"
        },
        {
          "word": " \"thank",
          "start": 5015.03,
          "end": 5015.17,
          "speaker": "Naghmeh"
        },
        {
          "word": " you,",
          "start": 5015.17,
          "end": 5015.27,
          "speaker": "Naghmeh"
        },
        {
          "word": " God.\"",
          "start": 5015.41,
          "end": 5015.67,
          "speaker": "Naghmeh"
        }
      ]
    },
    {
      "text": "Right.",
      "start": 5016.73,
      "end": 5016.91,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Right.",
          "start": 5016.73,
          "end": 5016.91,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "How can I say thank you?",
