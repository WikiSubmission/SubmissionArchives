        {
          "word": "said",
          "start": 1008.702,
          "end": 1009.084,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"$14,000.\"",
          "start": 1009.084,
          "end": 1009.467,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He said \"we'll give you $24,000.\"",
      "start": 1009.467,
      "end": 1010.672,
      "speaker": "Dr. Khalifa",
