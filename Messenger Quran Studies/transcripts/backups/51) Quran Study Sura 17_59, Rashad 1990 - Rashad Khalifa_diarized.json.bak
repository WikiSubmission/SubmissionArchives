          "end": 1007.349,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I said \"$14,000.\"",
      "start": 1008.319,
      "end": 1009.467,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "I",
