          "start": 3010.53,
          "end": 3010.65,
          "speaker": "A woman and a group of children"
        }
      ]
    },
    {
      "text": "To plan something tomorrow, say \"IN SHAA ALLAH.\"",
      "start": 3011.01,
      "end": 3015.23,
      "speaker": "A woman and a group of children",
      "words": [
        {
          "word": " something",
          "start": 3011.01,
          "end": 3011.11,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " tomorrow,",
          "start": 3011.11,
          "end": 3012.25,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " say",
          "start": 3012.43,
          "end": 3012.43,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " \"IN",
          "start": 3012.43,
          "end": 3013.13,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " SHAA",
          "start": 3013.17,
          "end": 3013.67,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " ALLAH.\"",
          "start": 3013.67,
          "end": 3014.11,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " Before",
          "start": 3014.79,
          "end": 3014.89,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " you",
          "start": 3014.89,
          "end": 3015.23,
          "speaker": "A woman and a group of children"
        }
      ]
    },
    {
      "text": "Before you start at anything, say \"Bismillah.\"",
      "start": 3015.39,
      "end": 3019.87,
      "speaker": "A woman and a group of children",
      "words": [
        {
          "word": " start",
          "start": 3015.39,
          "end": 3015.53,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " at",
          "start": 3015.53,
          "end": 3015.89,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " anything,",
          "start": 3015.89,
          "end": 3015.99,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " say",
          "start": 3017.75,
          "end": 3017.87,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " \"Bismillah.\"",
          "start": 3017.87,
          "end": 3019.03,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " In",
          "start": 3019.03,
          "end": 3019.25,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " everything",
          "start": 3019.25,
          "end": 3019.87,
          "speaker": "A woman and a group of children"
        }
      ]
    },
    {
      "text": "In everything you try to think, say \"Alhamdu Lillah.\"",
      "start": 3019.87,
      "end": 3031.49,
      "speaker": "A woman and a group of children",
      "words": [
        {
          "word": " you",
          "start": 3019.87,
          "end": 3020.29,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " try",
          "start": 3020.29,
          "end": 3020.73,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " to",
          "start": 3020.73,
          "end": 3020.93,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " think,",
          "start": 3020.93,
          "end": 3022.03,
