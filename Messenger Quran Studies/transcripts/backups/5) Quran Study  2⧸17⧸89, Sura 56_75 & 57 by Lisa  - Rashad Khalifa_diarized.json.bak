        }
      ]
    },
    {
      "text": "So, when you see a flower, say \"M\u00e3 Sh\u00e3 All\u00e3h.\"",
      "start": 2801.55,
      "end": 2805.81,
      "speaker": "A woman and a group of children",
      "words": [
        {
          "word": " you",
          "start": 2801.55,
          "end": 2801.85,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " see",
          "start": 2801.85,
          "end": 2802.15,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " a",
          "start": 2802.25,
          "end": 2802.37,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " flower,",
          "start": 2802.37,
          "end": 2802.75,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " say",
          "start": 2803.31,
