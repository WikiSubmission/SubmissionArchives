          "start": 2770.27,
          "end": 2771.89,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "This helps.",
      "start": 2776.19,
      "end": 2778.11,
      "speaker": "The messenger",
      "words": [
        {
          "word": "  As",
          "start": 2776.19,
          "end": 2777.21,
          "speaker": "The messenger"
        },
        {
          "word": " each",
          "start": 2777.21,
          "end": 2778.11,
          "speaker": "The messenger"
        }
      ]
    },
    {
      "text": " As each little rabbit had each last bag, remembering God should be first on our mind.",
