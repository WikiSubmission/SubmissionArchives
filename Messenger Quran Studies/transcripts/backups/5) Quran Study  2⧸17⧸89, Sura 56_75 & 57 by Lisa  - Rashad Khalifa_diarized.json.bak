          "end": 3022.39,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " Lillah.\"",
          "start": 3030.89,
          "end": 3030.99,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " And",
          "start": 3031.33,
          "end": 3031.33,
          "speaker": "A woman and a group of children"
        },
        {
