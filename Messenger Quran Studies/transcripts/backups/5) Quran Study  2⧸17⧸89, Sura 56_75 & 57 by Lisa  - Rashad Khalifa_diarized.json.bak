          "speaker": "A woman and a group of children"
        },
        {
          "word": " \"M\u00e3",
          "start": 2803.31,
          "end": 2803.73,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " Sh\u00e3",
          "start": 2803.73,
          "end": 2804.35,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " All\u00e3h.\"",
          "start": 2804.35,
          "end": 2805.07,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " To",
          "start": 2805.53,
          "end": 2805.53,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " plan",
          "start": 2805.53,
          "end": 2805.81,
          "speaker": "A woman and a group of children"
        }
      ]
    },
    {
      "text": "To plan something tomorrow, say \"IN SHAA ALLAH.\"",
      "start": 2806.15,
      "end": 2810.33,
      "speaker": "A woman and a group of children",
      "words": [
        {
          "word": " something",
          "start": 2806.15,
          "end": 2806.25,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " tomorrow,",
          "start": 2806.25,
          "end": 2807.3,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " say",
          "start": 2807.47,
          "end": 2807.47,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " \"IN",
          "start": 2807.47,
          "end": 2808.05,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " SHAA",
          "start": 2808.05,
          "end": 2808.77,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " ALLAH.\"",
          "start": 2808.77,
          "end": 2809.27,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " Before",
          "start": 2809.85,
          "end": 2810.03,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " you",
          "start": 2810.03,
          "end": 2810.33,
          "speaker": "A woman and a group of children"
        }
      ]
    },
    {
      "text": "Before you start at anything, say \"Bismillah.\"",
      "start": 2810.33,
      "end": 2814.85,
      "speaker": "A woman and a group of children",
      "words": [
        {
          "word": " start",
          "start": 2810.33,
          "end": 2810.65,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " at",
          "start": 2810.65,
          "end": 2811.05,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " anything,",
          "start": 2811.05,
          "end": 2811.77,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " say",
          "start": 2811.99,
          "end": 2811.99,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " \"Bismillah.\"",
          "start": 2811.99,
          "end": 2813.59,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " In",
          "start": 2814.03,
          "end": 2814.21,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " everything",
          "start": 2814.21,
          "end": 2814.85,
          "speaker": "A woman and a group of children"
        }
      ]
    },
    {
      "text": "In everything you try to think, say \"Alhamdu Lillah.\"",
      "start": 2814.85,
      "end": 2820.77,
      "speaker": "A woman and a group of children",
      "words": [
        {
          "word": " you",
          "start": 2814.85,
          "end": 2815.27,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " try",
          "start": 2815.27,
          "end": 2815.57,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " to",
          "start": 2815.57,
          "end": 2815.83,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " think,",
          "start": 2815.83,
          "end": 2816.15,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " say",
          "start": 2816.39,
          "end": 2816.39,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " \"Alhamdu",
          "start": 2816.39,
          "end": 2817.25,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " Lillah.\"",
          "start": 2817.25,
          "end": 2818.33,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " Think",
          "start": 2820.17,
          "end": 2820.17,
          "speaker": "A woman and a group of children"
        },
        {
          "word": " of",
          "start": 2820.19,
          "end": 2820.77,
          "speaker": "A woman and a group of children"
        }
      ]
    },
    {
      "text": "Think of God as you go through each day, appreciate His Power, or His Mercy and Grace.",
