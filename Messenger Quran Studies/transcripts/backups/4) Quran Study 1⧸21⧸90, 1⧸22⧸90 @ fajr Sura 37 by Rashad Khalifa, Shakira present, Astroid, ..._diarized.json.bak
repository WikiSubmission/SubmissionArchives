          "speaker": "Dr. Sabahi"
        }
      ]
    },
    {
      "text": "I have a comment.",
      "start": 5496.82,
      "end": 5496.82,
      "speaker": "Abdullah",
      "words": [
        {
          "word": " think.",
          "start": 5496.82,
