          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Parivash"
        },
        {
          "word": " \u0635\u064e\u0644\u0650\u0651",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Parivash"
        },
