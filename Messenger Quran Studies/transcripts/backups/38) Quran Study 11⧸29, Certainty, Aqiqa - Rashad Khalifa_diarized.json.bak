          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " enough,",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " beat",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " yourself",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " until",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I mean, they had to die.",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " cry.",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mean,",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " had",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Everybody dies. They didn't die one second too early or one second too late.",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " die.",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Everybody",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " dies.",
