          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's so clear.",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \u0623\u064e\u062d\u064e\u062f\u064b\u06ed\u0627",
