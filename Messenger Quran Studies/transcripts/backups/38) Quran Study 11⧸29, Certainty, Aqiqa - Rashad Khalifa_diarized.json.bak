          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"My",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God,",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And this is what kind of shocked me.",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Sujud?\"",
