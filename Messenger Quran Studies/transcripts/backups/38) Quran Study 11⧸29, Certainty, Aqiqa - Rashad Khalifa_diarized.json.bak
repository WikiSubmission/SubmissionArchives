          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(unintelligible)",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "A woman",
      "words": [
        {
          "word": " them.",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "Yeah, the fact is that the Quran was there that the prophet wrote himself.",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " (unintelligible)",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Yeah,",
          "start": 3907.5,
