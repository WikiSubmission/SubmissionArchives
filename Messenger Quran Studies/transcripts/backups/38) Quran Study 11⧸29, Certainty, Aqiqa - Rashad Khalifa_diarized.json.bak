          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Why",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mention",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muhammad,",
