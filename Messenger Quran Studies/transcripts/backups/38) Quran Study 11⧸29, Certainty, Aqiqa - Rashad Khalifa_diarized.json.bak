          "end": 1432.68,
          "speaker": "Kathy"
        },
        {
          "word": " another.",
          "start": 1432.68,
          "end": 1432.84,
          "speaker": "Kathy"
        }
      ]
    },
    {
      "text": "We're supposed to treat each other nicely.",
