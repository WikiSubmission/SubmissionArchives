          "speaker": "Parivash"
        },
        {
          "word": " so",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "I don't know why they resist that.",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "Dr. Khalifa",
      "words": [
