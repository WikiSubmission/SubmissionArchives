          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " don't",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " know",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " why",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
