          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I said \"My God, in Sujud?\"",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Ali.\"",
