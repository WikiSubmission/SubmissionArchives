    },
    {
      "text": "\u0628\u0650\u0671\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0631\u064e\u0621\u064f\u0648\u0641\u064c\u06ed \u0631\u0651\u064e\u062d\u0650\u064a\u0645\u064c\u06ed",
