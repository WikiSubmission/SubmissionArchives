          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mean,",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it's",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " all",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But this is according to them.",
      "start": 3907.5,
      "end": 3907.5,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " nonsense.",
          "start": 3907.5,
