          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " He",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"oh,",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, he asked questions on religion.",
