          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Hussein",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 3907.5,
