        },
        {
          "word": " see.",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Azhar Khan"
        },
        {
          "word": " Dr.",
          "start": 3907.5,
          "end": 3907.5,
          "speaker": "Azhar Khan"
        },
        {
          "word": " Khalifa:",
