          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You can see it everywhere, especially in this country, which is so rich. You see it more and more.",
      "start": 610.72,
      "end": 617.2,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 610.72,
          "end": 610.88,
