          "end": 604.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it?",
          "start": 604.76,
          "end": 604.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Where",
          "start": 605.1,
