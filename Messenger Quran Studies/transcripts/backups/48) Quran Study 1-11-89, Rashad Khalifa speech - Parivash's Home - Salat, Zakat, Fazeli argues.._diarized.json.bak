        }
      ]
    },
    {
      "text": "Now, this destroys the Shahadah.",
      "start": 2485.134,
      "end": 2486.827,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Now,",
          "start": 2485.134,
          "end": 2485.473,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this",
          "start": 2485.473,
          "end": 2485.811,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "destroys",
          "start": 2485.811,
          "end": 2486.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 2486.15,
          "end": 2486.488,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Shahadah.",
          "start": 2486.488,
          "end": 2486.827,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The first commandment in the Bible, the Old Testament, the New Testament, the Quran is \"La Elaha Ella Allah.\"",
      "start": 2487.441,
      "end": 2494.044,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 2487.441,
          "end": 2487.789,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "first",
          "start": 2487.789,
          "end": 2488.136,
          "speaker": "Dr. Khalifa"
        },
