          "end": 2118.767,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 2118.767,
          "end": 2119.307,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "another",
          "start": 2119.307,
          "end": 2119.847,
          "speaker": "Dr. Khalifa"
        },
        {
