        {
          "word": "\u0648\u064e\u0625\u0650\u0630\u064e\u0627",
          "start": 4050.377,
          "end": 4050.755,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062d\u064f\u0634\u0650\u0631\u064e",
          "start": 4050.755,
          "end": 4051.132,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0646\u0651\u064e\u0627\u0633\u064f",
          "start": 4051.132,
          "end": 4051.509,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And when the Day of Judgment comes, the Day of Summoning,",
      "start": 4051.509,
      "end": 4053.816,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 4051.509,
          "end": 4051.719,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "when",
          "start": 4051.719,
          "end": 4051.928,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 4051.928,
          "end": 4052.138,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Day",
          "start": 4052.138,
          "end": 4052.348,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 4052.348,
          "end": 4052.558,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Judgment",
          "start": 4052.558,
          "end": 4052.767,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "comes,",
          "start": 4052.767,
          "end": 4052.977,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 4052.977,
          "end": 4053.187,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Day",
