          "end": 552.409,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wrong.",
          "start": 552.409,
          "end": 552.727,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They are not chores.",
      "start": 554.506,
      "end": 556.056,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "They",
          "start": 554.506,
