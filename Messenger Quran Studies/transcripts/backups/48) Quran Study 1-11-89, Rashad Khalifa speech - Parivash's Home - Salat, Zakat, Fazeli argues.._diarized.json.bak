          "end": 4057.702,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "prophet",
          "start": 4057.702,
          "end": 4058.017,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Muhammad,",
          "start": 4058.017,
          "end": 4058.333,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "right",
          "start": 4058.333,
          "end": 4058.649,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "now,",
          "start": 4058.649,
          "end": 4058.965,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 4058.965,
          "end": 4059.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "dead.",
          "start": 4059.28,
          "end": 4059.596,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "As",
          "start": 4059.596,
          "end": 4059.912,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 4059.912,
          "end": 4060.228,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran",
          "start": 4060.228,
          "end": 4060.543,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says,",
          "start": 4060.543,
          "end": 4060.859,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(39:30) \u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0645\u064e\u064a\u0651\u0650\u062a\u064c\u06ed \u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645 \u0645\u0651\u064e\u064a\u0651\u0650\u062a\u064f\u0648\u0646\u064e",
