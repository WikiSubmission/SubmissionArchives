        },
        {
          "word": "The",
          "start": 2362.856,
          "end": 2363.107,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Fasting",
          "start": 2363.107,
          "end": 2363.359,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 2363.359,
