        }
      ]
    },
    {
      "text": "(2:111) \u0642\u064f\u0644\u0652 \u0647\u064e\u0627\u062a\u064f\u0648\u0627\u06df \u0628\u064f\u0631\u0652\u0647\u064e\u0670\u0646\u064e\u0643\u064f\u0645\u0652",
      "start": 3850.204,
