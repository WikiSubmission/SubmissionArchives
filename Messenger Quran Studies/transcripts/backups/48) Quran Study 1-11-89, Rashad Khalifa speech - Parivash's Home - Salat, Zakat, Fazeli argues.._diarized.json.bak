    {
      "text": "(21:73) \u0648\u064e\u0623\u064e\u0648\u0652\u062d\u064e\u064a\u0652\u0646\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0641\u0650\u0639\u0652\u0644\u064e \u0671\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064e\u0670\u062a\u0650 \u0648\u064e\u0625\u0650\u0642\u064e\u0627\u0645\u064e \u0671\u0644\u0635\u0651\u064e\u0644\u064e\u0648\u0670\u0629\u0650 \u0648\u064e\u0625\u0650\u064a\u062a\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0632\u0651\u064e\u0643\u064e\u0648\u0670\u0629\u0650",
      "start": 5472.249,
