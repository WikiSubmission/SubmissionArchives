          "end": 2493.001,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Elaha",
          "start": 2493.001,
          "end": 2493.349,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Ella",
          "start": 2493.349,
          "end": 2493.696,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Allah.\"",
          "start": 2493.696,
          "end": 2494.044,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "When you add another name, it's not what Muhammad wants.",
      "start": 2494.903,
      "end": 2498.314,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "When",
          "start": 2494.903,
          "end": 2495.244,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "you",
          "start": 2495.244,
          "end": 2495.585,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "add",
          "start": 2495.585,
          "end": 2495.926,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "another",
          "start": 2495.926,
          "end": 2496.267,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "name,",
          "start": 2496.267,
          "end": 2496.609,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "it's",
          "start": 2496.609,
          "end": 2496.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "not",
          "start": 2496.95,
          "end": 2497.291,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "what",
          "start": 2497.291,
          "end": 2497.632,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Muhammad",
          "start": 2497.632,
          "end": 2497.973,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wants.",
          "start": 2497.973,
          "end": 2498.314,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's what Sheytan (Satan) wants.",
      "start": 2500.314,
      "end": 2501.516,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "It's",
          "start": 2500.314,
          "end": 2500.554,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "what",
          "start": 2500.554,
          "end": 2500.795,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Sheytan",
          "start": 2500.795,
          "end": 2501.035,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "(Satan)",
          "start": 2501.035,
          "end": 2501.276,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wants.",
          "start": 2501.276,
          "end": 2501.516,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And as a matter of fact, the Quran says that only the hypocrites will say \"Ash-hadu Alla Elaha Ella Allah Wa Ash-hadu Anna Muhammadan Rasulallah.\"",
      "start": 2502.927,
      "end": 2510.082,
      "speaker": "Dr. Khalifa",
      "words": [
        {
