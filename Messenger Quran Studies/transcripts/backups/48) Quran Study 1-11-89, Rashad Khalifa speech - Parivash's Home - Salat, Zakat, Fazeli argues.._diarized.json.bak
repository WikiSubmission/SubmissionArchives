        {
          "word": "\u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u0652",
          "start": 4238.119,
          "end": 4238.54,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "We don't know where.",
