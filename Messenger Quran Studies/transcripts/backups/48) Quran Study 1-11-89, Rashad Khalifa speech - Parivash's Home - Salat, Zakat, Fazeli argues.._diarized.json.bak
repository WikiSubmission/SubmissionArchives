          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(3:81) \u062b\u064f\u0645\u0651\u064e \u062c\u064e\u0627\u0653\u0621\u064e\u0643\u064f\u0645\u0652 \u0631\u064e\u0633\u064f\u0648\u0644\u064c\u06ed \u0645\u0651\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064c\u06ed \u0644\u0651\u0650\u0645\u064e\u0627 \u0645\u064e\u0639\u064e\u0643\u064f\u0645\u0652",
      "start": 3517.527,
      "end": 3520.202,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "(3:81)",
          "start": 3517.527,
          "end": 3517.909,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062b\u064f\u0645\u0651\u064e",
          "start": 3517.909,
          "end": 3518.291,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062c\u064e\u0627\u0653\u0621\u064e\u0643\u064f\u0645\u0652",
          "start": 3518.291,
          "end": 3518.673,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0631\u064e\u0633\u064f\u0648\u0644\u064c\u06ed",
          "start": 3518.673,
          "end": 3519.056,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u0651\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064c\u06ed",
          "start": 3519.056,
          "end": 3519.438,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0644\u0651\u0650\u0645\u064e\u0627",
          "start": 3519.438,
          "end": 3519.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u064e\u0639\u064e\u0643\u064f\u0645\u0652",
          "start": 3519.82,
          "end": 3520.202,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "For the messenger confirms existing scriptures and does not bring a new scripture.",
      "start": 3520.202,
      "end": 3525.455,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "For",
          "start": 3520.202,
          "end": 3520.606,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3520.606,
          "end": 3521.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "messenger",
          "start": 3521.01,
          "end": 3521.414,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "confirms",
          "start": 3521.414,
          "end": 3521.818,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "existing",
          "start": 3521.818,
          "end": 3522.222,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "scriptures",
          "start": 3522.222,
          "end": 3522.626,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "and",
          "start": 3522.626,
          "end": 3523.031,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "does",
          "start": 3523.031,
          "end": 3523.435,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "not",
          "start": 3523.435,
          "end": 3523.839,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "bring",
          "start": 3523.839,
          "end": 3524.243,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 3524.243,
          "end": 3524.647,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "new",
          "start": 3524.647,
          "end": 3525.051,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "scripture.",
          "start": 3525.051,
          "end": 3525.455,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And the Summa (\u062b\u064f\u0645\u0651\u064e) means afterwards.",
      "start": 3525.946,
      "end": 3528.13,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "And",
          "start": 3525.946,
          "end": 3526.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3526.31,
          "end": 3526.674,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Summa",
          "start": 3526.674,
          "end": 3527.038,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "(\u062b\u064f\u0645\u0651\u064e)",
          "start": 3527.038,
          "end": 3527.402,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "means",
          "start": 3527.402,
          "end": 3527.766,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "afterwards.",
          "start": 3527.766,
          "end": 3528.13,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, after all the prophets have come, including the prophet Muhammad, as we see in 33:7,",
      "start": 3528.682,
      "end": 3533.935,
      "speaker": "Dr. Khalifa",
      "words": [
