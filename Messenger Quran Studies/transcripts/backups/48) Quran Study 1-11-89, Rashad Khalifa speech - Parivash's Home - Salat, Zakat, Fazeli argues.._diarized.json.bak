          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The ego is another god, Sura 25.",
      "start": 2117.687,
      "end": 2121.467,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 2117.687,
