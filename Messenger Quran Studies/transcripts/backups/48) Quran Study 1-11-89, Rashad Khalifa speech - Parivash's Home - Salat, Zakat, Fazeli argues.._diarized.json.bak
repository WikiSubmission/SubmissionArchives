          "end": 2344.608,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 2344.608,
          "end": 2345.041,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "our",
          "start": 2345.041,
          "end": 2345.474,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "generation.",
          "start": 2345.474,
          "end": 2345.907,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We wouldn't know this 20 years ago if we were born 20 years earlier.",
