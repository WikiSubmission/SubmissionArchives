          "speaker": "A man"
        }
      ]
    },
    {
      "text": "So, who do we believe, our eyes or the Quran?",
      "start": 4201.566,
      "end": 4205.1,
      "speaker": "A man",
      "words": [
        {
          "word": "So,",
          "start": 4201.566,
          "end": 4201.919,
          "speaker": "A man"
        },
        {
          "word": "who",
          "start": 4201.919,
