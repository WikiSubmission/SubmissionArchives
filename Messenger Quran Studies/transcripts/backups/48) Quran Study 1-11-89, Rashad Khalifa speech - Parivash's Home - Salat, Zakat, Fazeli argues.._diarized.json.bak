          "speaker": "Dr. Khalifa"
        },
        {
          "word": "he",
          "start": 3765.331,
          "end": 3765.697,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "must",
          "start": 3765.697,
          "end": 3766.063,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "advocate",
          "start": 3766.063,
          "end": 3766.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3766.43,
          "end": 3766.796,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "worship",
          "start": 3766.796,
          "end": 3767.163,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 3767.163,
          "end": 3767.529,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 3767.529,
          "end": 3767.896,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone.",
          "start": 3767.896,
          "end": 3768.262,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because this is the first commandment in all the scriptures, in all the messages.",
