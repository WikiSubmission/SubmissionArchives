        },
        {
          "word": "very",
          "start": 1200.987,
          "end": 1201.263,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "good",
          "start": 1201.263,
          "end": 1201.539,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "for",
          "start": 1201.539,
          "end": 1201.815,
