          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Some truck driver was asking \"what do I do? I have arthritis.\"",
      "start": 1221.463,
      "end": 1225.243,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Some",
          "start": 1221.463,
          "end": 1221.778,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "truck",
          "start": 1221.778,
          "end": 1222.093,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "driver",
          "start": 1222.093,
          "end": 1222.408,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 1222.408,
