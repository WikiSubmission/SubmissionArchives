          "end": 721.112,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "times.",
          "start": 721.112,
          "end": 721.363,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They ask the people in Hell \"Why are you here?\"",
      "start": 722.284,
      "end": 724.24,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "They",
          "start": 722.284,
          "end": 722.48,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "ask",
          "start": 722.48,
          "end": 722.675,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 722.675,
          "end": 722.871,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "people",
          "start": 722.871,
          "end": 723.066,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 723.066,
          "end": 723.262,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Hell",
          "start": 723.262,
          "end": 723.458,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"Why",
          "start": 723.458,
          "end": 723.653,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "are",
          "start": 723.653,
          "end": 723.849,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "you",
          "start": 723.849,
          "end": 724.044,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "here?\"",
          "start": 724.044,
          "end": 724.24,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They say \"we didn't feed the poor.\"",
      "start": 724.24,
      "end": 725.93,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "They",
          "start": 724.24,
          "end": 724.481,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "say",
          "start": 724.481,
          "end": 724.723,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"we",
          "start": 724.723,
          "end": 724.964,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "didn't",
          "start": 724.964,
          "end": 725.206,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "feed",
          "start": 725.206,
          "end": 725.447,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 725.447,
          "end": 725.689,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "poor.\"",
          "start": 725.689,
          "end": 725.93,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "One of the answers.",
      "start": 727.219,
      "end": 728.421,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "One",
          "start": 727.219,
          "end": 727.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 727.52,
          "end": 727.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 727.82,
          "end": 728.121,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "answers.",
          "start": 728.121,
          "end": 728.421,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In fact, it is \"we didn't observe the Contact Prayer, and we didn't feed the poor.\"",
