          "start": 4180.227,
          "end": 4180.527,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "Yes.",
      "start": 4180.527,
      "end": 4181.361,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Yes.",
          "start": 4180.527,
          "end": 4181.361,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
