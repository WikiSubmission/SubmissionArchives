          "word": "Well,",
          "start": 3567.792,
          "end": 3567.987,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "every",
          "start": 3567.987,
          "end": 3568.183,
          "speaker": "Dr. Khalifa"
        },
