          "word": "say",
          "start": 2255.994,
          "end": 2256.379,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"Bismillah.\"",
          "start": 2256.379,
          "end": 2256.763,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
