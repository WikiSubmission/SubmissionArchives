        },
        {
          "word": "messenger.",
          "start": 3497.954,
          "end": 3498.295,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Muhammad was the last prophet because he brought the last scripture.",
      "start": 3498.295,
      "end": 3501.4,
      "speaker": "Dr. Khalifa",
      "words": [
        {
