          "speaker": "Dr. Khalifa"
        },
        {
          "word": "were",
          "start": 2348.219,
          "end": 2348.476,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "born",
          "start": 2348.476,
          "end": 2348.732,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "20",
          "start": 2348.732,
          "end": 2348.989,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "years",
          "start": 2348.989,
          "end": 2349.246,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "earlier.",
          "start": 2349.246,
          "end": 2349.503,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We wouldn't, we wouldn't know this.",
      "start": 2350.239,
      "end": 2351.809,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "We",
          "start": 2350.239,
          "end": 2350.501,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wouldn't,",
          "start": 2350.501,
          "end": 2350.762,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 2350.762,
          "end": 2351.024,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wouldn't",
          "start": 2351.024,
          "end": 2351.286,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "know",
