          "speaker": "Dr. Khalifa"
        },
        {
          "word": "sunrise.",
          "start": 1198.525,
          "end": 1198.865,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It is very good for you physically, also.",
      "start": 1200.435,
      "end": 1202.643,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "It",
          "start": 1200.435,
