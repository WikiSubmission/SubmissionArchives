          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "A lot. Frequently.",
      "start": 1567.588,
      "end": 1569.588,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "A",
          "start": 1567.588,
          "end": 1568.255,
