        },
        {
          "word": "\u0639\u0650\u0646\u062f\u064e",
          "start": 4240.184,
          "end": 4240.441,
          "speaker": "A man"
        },
        {
          "word": "\u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u0652",
          "start": 4240.441,
          "end": 4240.699,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "Rabbihim (\u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u0652) is everywhere.",
      "start": 4240.699,
      "end": 4242.085,
      "speaker": "A man",
      "words": [
