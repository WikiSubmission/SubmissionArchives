          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this.",
          "start": 2351.547,
          "end": 2351.809,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "God let us know that we were doing everything wrong.",
      "start": 2351.809,
      "end": 2354.545,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "God",
          "start": 2351.809,
          "end": 2352.083,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "let",
          "start": 2352.083,
          "end": 2352.356,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "us",
          "start": 2352.356,
          "end": 2352.63,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "know",
          "start": 2352.63,
          "end": 2352.903,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "that",
          "start": 2352.903,
          "end": 2353.177,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 2353.177,
          "end": 2353.451,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "were",
          "start": 2353.451,
          "end": 2353.724,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "doing",
          "start": 2353.724,
          "end": 2353.998,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "everything",
          "start": 2353.998,
          "end": 2354.271,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wrong.",
          "start": 2354.271,
          "end": 2354.545,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Everything we were doing, everything we grew up doing was wrong.",
      "start": 2357.061,
      "end": 2360.595,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Everything",
          "start": 2357.061,
          "end": 2357.382,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 2357.382,
          "end": 2357.704,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "were",
          "start": 2357.704,
          "end": 2358.025,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "doing,",
          "start": 2358.025,
          "end": 2358.346,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "everything",
          "start": 2358.346,
          "end": 2358.667,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we",
          "start": 2358.667,
          "end": 2358.989,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "grew",
          "start": 2358.989,
          "end": 2359.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "up",
          "start": 2359.31,
          "end": 2359.631,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "doing",
          "start": 2359.631,
          "end": 2359.952,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 2359.952,
          "end": 2360.274,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wrong.",
          "start": 2360.274,
          "end": 2360.595,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The NAMAZ (Salat) was wrong. The Zakat was wrong. The Fasting was wrong. The Hajj was wrong.",
      "start": 2360.595,
      "end": 2364.866,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 2360.595,
