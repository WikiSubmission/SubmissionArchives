          "word": "God",
          "start": 3847.063,
          "end": 3847.313,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says,",
          "start": 3847.313,
          "end": 3847.563,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 3847.563,
          "end": 3847.813,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3847.813,
          "end": 3848.063,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Quran,",
