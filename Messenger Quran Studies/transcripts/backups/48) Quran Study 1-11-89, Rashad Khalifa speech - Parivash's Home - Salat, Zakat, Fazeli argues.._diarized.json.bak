          "start": 2365.725,
          "end": 2366.125,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "neglected",
          "start": 2366.125,
          "end": 2366.525,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 2366.525,
          "end": 2366.925,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "ZIKR",
          "start": 2366.925,
          "end": 2367.325,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "(\u0630\u06a9\u0631).",
          "start": 2367.325,
          "end": 2367.725,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And God, out of His mercy and grace, He taught us the correct way to do it.",
