          "end": 2361.349,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 2361.349,
          "end": 2361.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wrong.",
          "start": 2361.6,
