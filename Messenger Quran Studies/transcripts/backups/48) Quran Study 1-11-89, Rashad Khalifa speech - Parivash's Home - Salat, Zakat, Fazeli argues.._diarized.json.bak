          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Shirk.",
          "start": 3350.336,
          "end": 3350.615,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Shirk means more than one.",
      "start": 3351.045,
      "end": 3353.045,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Shirk",
          "start": 3351.045,
