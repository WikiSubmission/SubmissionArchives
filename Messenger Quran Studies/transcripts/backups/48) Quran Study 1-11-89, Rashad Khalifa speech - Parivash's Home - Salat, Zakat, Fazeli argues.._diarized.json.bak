          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Nabi",
          "start": 3565.187,
          "end": 3565.536,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "(\u0646\u0628\u06cc)",
          "start": 3565.536,
          "end": 3565.885,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 3565.885,
