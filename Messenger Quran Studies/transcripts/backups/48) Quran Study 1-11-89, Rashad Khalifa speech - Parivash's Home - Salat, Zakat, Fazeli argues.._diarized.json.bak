          "end": 4683.505,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God?",
          "start": 4683.505,
          "end": 4683.807,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Muhammad",
          "start": 4683.807,
          "end": 4684.108,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
