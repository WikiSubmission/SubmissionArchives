          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He gave us a very sharp, clear picture to our generation.",
      "start": 2341.145,
      "end": 2345.907,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "He",
