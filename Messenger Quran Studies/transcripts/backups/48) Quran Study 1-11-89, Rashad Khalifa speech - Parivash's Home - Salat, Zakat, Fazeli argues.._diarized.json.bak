          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0625\u0650\u0646\u0651\u064e\u0643\u064e",
          "start": 4061.21,
          "end": 4061.561,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u064e\u064a\u0651\u0650\u062a\u064c\u06ed",
          "start": 4061.561,
          "end": 4061.911,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645",
          "start": 4061.911,
          "end": 4062.262,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u0651\u064e\u064a\u0651\u0650\u062a\u064f\u0648\u0646\u064e",
          "start": 4062.262,
          "end": 4062.613,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He is absolutely unaware of the people who are calling on him, which fits this description.",
