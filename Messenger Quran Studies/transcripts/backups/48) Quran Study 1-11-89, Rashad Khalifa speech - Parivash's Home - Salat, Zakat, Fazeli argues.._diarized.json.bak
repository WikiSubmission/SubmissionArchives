          "speaker": "Dr. Khalifa"
        },
        {
          "word": "any",
          "start": 3579.619,
          "end": 3579.843,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 3579.843,
          "end": 3580.068,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "your",
          "start": 3580.068,
          "end": 3580.292,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "man.",
          "start": 3580.292,
          "end": 3580.517,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u062e\u064e\u0627\u062a\u064e\u0645\u064e \u0671\u0644\u0646\u0651\u064e\u0628\u0650\u064a\u0651\u0650\u0646\u064e the last prophet.",
      "start": 3580.517,
      "end": 3583.315,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646",
          "start": 3580.517,
          "end": 3580.983,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u062e\u064e\u0627\u062a\u064e\u0645\u064e",
          "start": 3580.983,
          "end": 3581.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0646\u0651\u064e\u0628\u0650\u064a\u0651\u0650\u0646\u064e",
          "start": 3581.45,
          "end": 3581.916,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3581.916,
          "end": 3582.382,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "last",
          "start": 3582.382,
          "end": 3582.849,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "prophet.",
          "start": 3582.849,
          "end": 3583.315,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And this will cover all prophets and the messengers.",
      "start": 3583.315,
      "end": 3586.358,
      "speaker": "Dr. Khalifa",
      "words": [
        {
