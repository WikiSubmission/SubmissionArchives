          "word": "this",
          "start": 1621.428,
          "end": 1621.669,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 1621.669,
          "end": 1621.909,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "ZIKR",
          "start": 1621.909,
          "end": 1622.15,
