          "end": 2503.213,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "as",
          "start": 2503.213,
          "end": 2503.499,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
          "start": 2503.499,
          "end": 2503.786,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "matter",
