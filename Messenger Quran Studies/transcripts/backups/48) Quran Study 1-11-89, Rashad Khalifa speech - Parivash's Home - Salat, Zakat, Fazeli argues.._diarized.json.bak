          "end": 2132.233,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 2132.233,
          "end": 2132.764,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "order,",
          "start": 2132.764,
          "end": 2133.296,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
