    },
    {
      "text": "(33:40) \u0648\u064e\u062e\u064e\u0627\u062a\u064e\u0645\u064e \u0671\u0644\u0646\u0651\u064e\u0628\u0650\u064a\u0651\u0650\u0646\u064e",
