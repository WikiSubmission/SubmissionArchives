          "start": 4561.519,
          "end": 4561.833,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "HASANA (\u062d\u064e\u0633\u064e\u0646\u064e\u0647) means good deed. A woman: Yeah, Ok.",
      "start": 4561.833,
      "end": 4563.833,
      "speaker": "A man",
      "words": [
