          "word": "not",
          "start": 557.104,
          "end": 557.477,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "duties",
          "start": 557.477,
          "end": 557.849,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "or",
          "start": 557.849,
