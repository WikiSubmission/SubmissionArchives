        },
        {
          "word": "you",
          "start": 1201.815,
          "end": 1202.091,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "physically,",
          "start": 1202.091,
          "end": 1202.367,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "also.",
          "start": 1202.367,
          "end": 1202.643,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You will not develop arthritis if you do wake up every morning before sunrise.",
      "start": 1204.546,
      "end": 1207.958,
      "speaker": "Dr. Khalifa",
      "words": [
