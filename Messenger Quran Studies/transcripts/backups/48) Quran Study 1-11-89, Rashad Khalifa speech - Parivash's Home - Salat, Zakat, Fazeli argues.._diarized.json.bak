          "word": "25.",
          "start": 2120.927,
          "end": 2121.467,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The ego can stop you from being saved.",
      "start": 2122.019,
      "end": 2125.308,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 2122.019,
          "end": 2122.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "ego",
          "start": 2122.43,
          "end": 2122.841,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "can",
          "start": 2122.841,
          "end": 2123.252,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "stop",
          "start": 2123.252,
          "end": 2123.664,
          "speaker": "Dr. Khalifa"
        },
