        },
        {
          "word": "\u0625\u0650\u0644\u064e\u0670\u0647\u064d",
          "start": 3790.993,
          "end": 3791.242,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u063a\u064e\u064a\u0652\u0631\u064f\u0647\u064f",
          "start": 3791.242,
          "end": 3791.492,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The same expression for everyone of the messengers.",
      "start": 3791.492,
      "end": 3794.719,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 3791.492,
          "end": 3791.895,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "same",
          "start": 3791.895,
          "end": 3792.299,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "expression",
          "start": 3792.299,
          "end": 3792.702,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "for",
          "start": 3792.702,
          "end": 3793.105,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "everyone",
          "start": 3793.105,
          "end": 3793.509,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 3793.509,
          "end": 3793.912,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3793.912,
          "end": 3794.316,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "messengers.",
          "start": 3794.316,
          "end": 3794.719,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Therefore, this is the first criterion.",
      "start": 3795.0,
      "end": 3797.0,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Therefore,",
          "start": 3795.0,
          "end": 3795.333,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this",
          "start": 3795.333,
          "end": 3795.667,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 3795.667,
          "end": 3796.0,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3796.0,
          "end": 3796.333,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "first",
          "start": 3796.333,
          "end": 3796.667,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "criterion.",
          "start": 3796.667,
          "end": 3797.0,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The true messenger must advocate the worship of God alone.",
      "start": 3797.92,
      "end": 3800.945,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 3797.92,
          "end": 3798.222,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "true",
          "start": 3798.222,
          "end": 3798.525,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "messenger",
          "start": 3798.525,
          "end": 3798.827,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "must",
          "start": 3798.827,
          "end": 3799.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "advocate",
          "start": 3799.13,
          "end": 3799.432,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3799.432,
          "end": 3799.735,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "worship",
          "start": 3799.735,
          "end": 3800.037,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 3800.037,
          "end": 3800.34,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 3800.34,
          "end": 3800.642,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone.",
          "start": 3800.642,
          "end": 3800.945,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He must advocate the destruction of all idols and all idol worship.",
      "start": 3801.559,
      "end": 3805.198,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "He",
          "start": 3801.559,
          "end": 3801.862,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "must",
          "start": 3801.862,
          "end": 3802.166,
          "speaker": "Dr. Khalifa"
        },
