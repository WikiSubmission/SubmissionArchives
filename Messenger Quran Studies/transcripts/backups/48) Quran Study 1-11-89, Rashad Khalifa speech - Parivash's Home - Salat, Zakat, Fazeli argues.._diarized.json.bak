          "end": 3760.923,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Right.",
          "start": 3760.923,
          "end": 3761.291,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "A",
          "start": 3761.291,
          "end": 3761.659,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "man:",
          "start": 3761.659,
          "end": 3762.027,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Worship",
          "start": 3762.027,
          "end": 3762.396,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 3762.396,
          "end": 3762.764,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "alone.",
          "start": 3762.764,
          "end": 3763.132,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The criteria is, first of all, he must advocate the worship of God alone.",
      "start": 3763.132,
      "end": 3768.262,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "The",
          "start": 3763.132,
          "end": 3763.498,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "criteria",
          "start": 3763.498,
          "end": 3763.865,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is,",
          "start": 3763.865,
          "end": 3764.231,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "first",
          "start": 3764.231,
          "end": 3764.598,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
          "start": 3764.598,
