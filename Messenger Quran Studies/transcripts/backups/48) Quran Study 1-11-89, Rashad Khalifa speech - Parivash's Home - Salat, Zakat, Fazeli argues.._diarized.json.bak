          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because the minute you mention any other name, you have committed Shirk.",
      "start": 3347.265,
      "end": 3350.615,
      "speaker": "Dr. Khalifa",
      "words": [
        {
