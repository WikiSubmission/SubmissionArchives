          "end": 3577.269,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0623\u064e\u0628\u064e\u0627\u0653",
          "start": 3577.269,
          "end": 3577.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0623\u064e\u062d\u064e\u062f\u064d\u06e2",
          "start": 3577.52,
          "end": 3577.771,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0645\u0651\u0650\u0646",
          "start": 3577.771,
          "end": 3578.021,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0631\u0651\u0650\u062c\u064e\u0627\u0644\u0650\u0643\u064f\u0645\u0652",
          "start": 3578.021,
          "end": 3578.272,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Muhammad was not the father of any of your man.",
      "start": 3578.272,
      "end": 3580.517,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Muhammad",
          "start": 3578.272,
          "end": 3578.496,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 3578.496,
          "end": 3578.721,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "not",
          "start": 3578.721,
          "end": 3578.945,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 3578.945,
          "end": 3579.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "father",
          "start": 3579.17,
          "end": 3579.394,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "of",
