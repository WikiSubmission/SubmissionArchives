          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0643\u0650\u062a\u064e\u0670\u0628\u064d\u06e2",
          "start": 3512.942,
          "end": 3513.375,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0648\u064e\u062d\u0650\u0643\u0652\u0645\u064e\u0629\u064d\u06e2",
          "start": 3513.375,
          "end": 3513.808,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
