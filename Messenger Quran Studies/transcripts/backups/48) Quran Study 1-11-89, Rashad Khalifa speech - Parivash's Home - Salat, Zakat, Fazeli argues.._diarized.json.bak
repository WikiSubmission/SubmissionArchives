    },
    {
      "text": "[72:18]  The places of worship belong to GOD; do not call on anyone else besides GOD.",
      "start": 3373.892,
      "end": 3379.145,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "[72:18]",
          "start": 3373.892,
          "end": 3374.22,
          "speaker": "Dr. Khalifa"
