    {
      "text": "(9:54) \u0648\u064e\u0645\u064e\u0627 \u0645\u064e\u0646\u064e\u0639\u064e\u0647\u064f\u0645\u0652 \u0623\u064e\u0646 \u062a\u064f\u0642\u0652\u0628\u064e\u0644\u064e \u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0646\u064e\u0641\u064e\u0642\u064e\u0670\u062a\u064f\u0647\u064f\u0645\u0652",
