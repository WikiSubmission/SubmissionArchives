          "word": "\u062f\u064f\u0639\u064e\u0627\u0653\u0626\u0650\u0647\u0650\u0645\u0652",
          "start": 4045.51,
          "end": 4045.959,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u063a\u064e\u0670\u0641\u0650\u0644\u064f\u0648\u0646\u064e",
          "start": 4045.959,
          "end": 4046.408,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And they are completely unaware of their calling.",
