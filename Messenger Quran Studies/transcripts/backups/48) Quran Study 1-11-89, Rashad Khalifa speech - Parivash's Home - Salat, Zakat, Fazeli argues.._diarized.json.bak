          "end": 5474.728,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0635\u0651\u064e\u0644\u064e\u0648\u0670\u0629\u0650",
          "start": 5474.728,
          "end": 5475.141,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0648\u064e\u0625\u0650\u064a\u062a\u064e\u0627\u0653\u0621\u064e",
          "start": 5475.141,
          "end": 5475.554,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\u0671\u0644\u0632\u0651\u064e\u0643\u064e\u0648\u0670\u0629\u0650",
          "start": 5475.554,
          "end": 5475.967,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
