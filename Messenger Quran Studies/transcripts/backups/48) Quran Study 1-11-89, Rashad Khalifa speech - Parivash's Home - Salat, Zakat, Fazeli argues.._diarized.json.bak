    {
      "text": "If, as some people claim, every Nabi (\u0646\u0628\u06cc) was a messenger...",
      "start": 3563.092,
      "end": 3566.933,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "If,",
          "start": 3563.092,
          "end": 3563.441,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "as",
          "start": 3563.441,
          "end": 3563.79,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "some",
          "start": 3563.79,
          "end": 3564.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "people",
          "start": 3564.14,
          "end": 3564.489,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "claim,",
