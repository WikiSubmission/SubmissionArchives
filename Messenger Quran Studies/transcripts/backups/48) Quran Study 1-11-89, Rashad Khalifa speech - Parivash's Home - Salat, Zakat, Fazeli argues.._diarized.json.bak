    {
      "text": "(4:125) \u0648\u064e\u0645\u064e\u0646\u0652 \u0623\u064e\u062d\u0652\u0633\u064e\u0646\u064f \u062f\u0650\u064a\u0646\u064b\u06ed\u0627 \u0645\u0651\u0650\u0645\u0651\u064e\u0646\u0652 \u0623\u064e\u0633\u0652\u0644\u064e\u0645\u064e ... \u0645\u0650\u0644\u0651\u064e\u0629\u064e \u0625\u0650\u0628\u0652\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e",
