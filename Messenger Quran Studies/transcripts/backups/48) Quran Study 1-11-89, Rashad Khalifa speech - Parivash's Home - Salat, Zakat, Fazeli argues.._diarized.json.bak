    {
      "text": "\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u0648\u0652\u062d\u064e\u064a\u0652\u0646\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u064a\u0652\u0643\u064e \u0623\u064e\u0646\u0650 \u0671\u062a\u0651\u064e\u0628\u0650\u0639\u0652 \u0645\u0650\u0644\u0651\u064e\u0629\u064e \u0625\u0650\u0628\u0652\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u062d\u064e\u0646\u0650\u064a\u0641\u064b\u06ed\u0627 \u06d6 \u0648\u064e\u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e  (16:123) \u0671\u0644\u0652\u0645\u064f\u0634\u0652\u0631\u0650\u0643\u0650\u064a\u0646\u064e",
