    },
    {
      "text": "\u0645\u0651\u064e\u0627 \u0643\u064e\u0627\u0646\u064e \u0645\u064f\u062d\u064e\u0645\u0651\u064e\u062f\u064c \u0623\u064e\u0628\u064e\u0627\u0653 \u0623\u064e\u062d\u064e\u062f\u064d\u06e2 \u0645\u0651\u0650\u0646 \u0631\u0651\u0650\u062c\u064e\u0627\u0644\u0650\u0643\u064f\u0645\u0652",
      "start": 3576.517,
      "end": 3578.272,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "\u0645\u0651\u064e\u0627",
