    },
    {
      "text": "This is all wrong.",
      "start": 551.456,
      "end": 552.727,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 551.456,
          "end": 551.774,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 551.774,
          "end": 552.091,
