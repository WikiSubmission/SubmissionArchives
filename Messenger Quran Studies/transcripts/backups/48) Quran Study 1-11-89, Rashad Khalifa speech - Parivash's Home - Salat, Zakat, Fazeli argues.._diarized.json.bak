          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(46:6) \u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u062d\u064f\u0634\u0650\u0631\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0633\u064f",
