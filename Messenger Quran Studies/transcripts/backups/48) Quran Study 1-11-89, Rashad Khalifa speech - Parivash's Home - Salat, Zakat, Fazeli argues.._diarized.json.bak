          "speaker": "Dr. Khalifa"
        },
        {
          "word": "day.",
          "start": 4080.602,
          "end": 4080.861,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Muhammad is unaware.",
      "start": 4080.861,
      "end": 4082.493,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Muhammad",
