          "speaker": "Dr. Khalifa"
        },
        {
          "word": " says",
          "start": 3046.62,
          "end": 3047.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 3047.22,
          "end": 3047.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " all",
          "start": 3047.42,
          "end": 3047.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " right",
