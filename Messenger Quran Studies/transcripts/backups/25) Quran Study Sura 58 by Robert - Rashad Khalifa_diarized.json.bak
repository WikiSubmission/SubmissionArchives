          "start": 1749.4,
          "end": 1750.9,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"If it's from God, we'll do that.\"",
      "start": 1751.02,
      "end": 1752.32,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"If",
          "start": 1751.02,
          "end": 1751.08,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it's",
          "start": 1751.08,
          "end": 1751.18,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " from",
          "start": 1751.18,
          "end": 1751.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God,",
          "start": 1751.28,
          "end": 1751.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " we'll",
          "start": 1751.68,
