          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Exactly.",
      "start": 2401.28,
      "end": 2402.4,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Exactly.",
          "start": 2401.28,
          "end": 2402.4,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Be considerate to others. It's a general principle.",
      "start": 2402.64,
      "end": 2404.41,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Be",
          "start": 2402.64,
