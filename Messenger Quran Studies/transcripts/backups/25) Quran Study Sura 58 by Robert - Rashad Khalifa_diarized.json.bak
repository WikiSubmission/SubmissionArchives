          "end": 2704.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2704.9,
          "end": 2705.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Catholic",
          "start": 2705.2,
