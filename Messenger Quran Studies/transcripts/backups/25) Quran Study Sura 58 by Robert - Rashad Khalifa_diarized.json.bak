          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that.\"",
          "start": 1751.86,
          "end": 1752.32,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He said \"no, it's from me.\" They said \"this is a stupid idea.\"",
      "start": 1752.42,
      "end": 1754.59,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " He",
          "start": 1752.42,
          "end": 1752.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 1752.44,
          "end": 1752.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"no,",
          "start": 1752.58,
          "end": 1752.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it's",
          "start": 1752.9,
          "end": 1752.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " from",
