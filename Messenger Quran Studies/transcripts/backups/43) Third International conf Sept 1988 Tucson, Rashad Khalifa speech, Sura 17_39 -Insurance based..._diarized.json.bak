        },
        {
          "word": "Quran.",
          "start": 4880.881,
          "end": 4881.179,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "All their understanding was wrong.",
      "start": 4881.541,
      "end": 4883.93,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "All",
          "start": 4881.541,
          "end": 4882.019,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "their",
          "start": 4882.019,
          "end": 4882.497,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "understanding",
          "start": 4882.497,
          "end": 4882.974,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "was",
          "start": 4882.974,
          "end": 4883.452,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wrong.",
          "start": 4883.452,
