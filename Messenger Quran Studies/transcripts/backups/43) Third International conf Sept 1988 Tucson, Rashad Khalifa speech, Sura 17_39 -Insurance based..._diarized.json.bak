          "end": 1795.432,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "boy.",
          "start": 1795.432,
          "end": 1795.641,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is their wish.",
      "start": 1796.305,
      "end": 1797.286,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "This",
          "start": 1796.305,
          "end": 1796.55,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 1796.55,
          "end": 1796.795,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "their",
          "start": 1796.795,
          "end": 1797.041,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "wish.",
          "start": 1797.041,
          "end": 1797.286,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But at the risk of being prejudiced against boys, I say girls are better than boys.",
