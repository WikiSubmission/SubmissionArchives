    {
      "text": "Yusuf Ali, outright, refused to translate this verse correctly.",
      "start": 2239.872,
      "end": 2243.986,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "Yusuf",
          "start": 2239.872,
          "end": 2240.329,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Ali,",
          "start": 2240.329,
          "end": 2240.786,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "outright,",
          "start": 2240.786,
          "end": 2241.243,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "refused",
          "start": 2241.243,
          "end": 2241.7,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "to",
          "start": 2241.7,
          "end": 2242.158,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "translate",
          "start": 2242.158,
          "end": 2242.615,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "this",
          "start": 2242.615,
          "end": 2243.072,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "verse",
          "start": 2243.072,
          "end": 2243.529,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "correctly.",
          "start": 2243.529,
          "end": 2243.986,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
