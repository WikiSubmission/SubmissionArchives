          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 1794.803,
          "end": 1795.013,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "want",
          "start": 1795.013,
          "end": 1795.222,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "a",
