          "end": 5080.111,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 5080.111,
          "end": 5080.401,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "fell",
          "start": 5080.401,
