          "end": 1459.296,
          "speaker": "Parivash"
        },
        {
          "word": "\u0623\u064e\u0646\u062a\u064e",
          "start": 1459.296,
          "end": 1459.625,
          "speaker": "Parivash"
        },
        {
          "word": "\u0671\u0644\u0652\u0648\u064e\u0647\u0651\u064e\u0627\u0628\u064f",
          "start": 1459.625,
          "end": 1459.954,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "That means, our Lord, let not our hearts falter after being guided by You. And shower us with Your mercy. You are the Grantor.",
