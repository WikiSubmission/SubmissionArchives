          "end": 3429.09,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I said \"no way, I can't work for Anheuser-Busch.\"",
      "start": 3429.815,
      "end": 3432.721,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "I",
          "start": 3429.815,
          "end": 3430.138,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "said",
          "start": 3430.138,
