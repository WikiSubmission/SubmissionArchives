        },
        {
          "word": "were",
          "start": 235.413,
          "end": 235.999,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "committing",
          "start": 235.999,
          "end": 236.585,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "idolatry,",
          "start": 236.585,
