          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"no",
          "start": 3430.461,
          "end": 3430.784,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "way,",
          "start": 3430.784,
          "end": 3431.107,
          "speaker": "Dr. Khalifa"
        },
