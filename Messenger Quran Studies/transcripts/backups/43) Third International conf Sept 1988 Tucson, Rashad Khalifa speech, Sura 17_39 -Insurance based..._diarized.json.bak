          "speaker": "Dr. Khalifa"
        },
        {
          "word": "said",
          "start": 3436.171,
          "end": 3436.534,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"because",
          "start": 3436.534,
          "end": 3436.897,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I'm",
          "start": 3436.897,
