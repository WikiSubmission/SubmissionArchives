          "end": 3432.721,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He says \"why?\"",
      "start": 3433.748,
      "end": 3435.325,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "He",
          "start": 3433.748,
          "end": 3434.274,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "says",
