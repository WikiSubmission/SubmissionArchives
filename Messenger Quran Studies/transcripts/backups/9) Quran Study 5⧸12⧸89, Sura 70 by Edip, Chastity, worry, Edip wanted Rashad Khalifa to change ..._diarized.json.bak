          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God's",
          "start": 2720.56,
          "end": 2721.06,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " hand.",
          "start": 2721.06,
          "end": 2721.3,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You can't be with them every time.",
      "start": 2722.06,
      "end": 2723.36,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 2722.06,
