          "end": 2724.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " chaperones",
          "start": 2724.32,
          "end": 2725.1,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " your",
          "start": 2725.1,
          "end": 2725.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " children.",
