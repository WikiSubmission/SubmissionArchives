          "end": 2716.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " do",
          "start": 2716.04,
          "end": 2716.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " your",
          "start": 2716.32,
          "end": 2716.54,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " part.\"",
          "start": 2716.54,
          "end": 2716.64,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You must know that your children are in God's hand.",
      "start": 2718.66,
      "end": 2721.3,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 2718.66,
