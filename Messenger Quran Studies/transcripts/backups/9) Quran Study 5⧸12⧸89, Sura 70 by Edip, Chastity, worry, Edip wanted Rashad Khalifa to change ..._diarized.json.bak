        },
        {
          "word": " I",
          "start": 2714.54,
          "end": 2714.72,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 2714.72,
          "end": 2714.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"don't",
          "start": 2714.88,
          "end": 2715.34,
          "speaker": "Dr. Khalifa"
        },
