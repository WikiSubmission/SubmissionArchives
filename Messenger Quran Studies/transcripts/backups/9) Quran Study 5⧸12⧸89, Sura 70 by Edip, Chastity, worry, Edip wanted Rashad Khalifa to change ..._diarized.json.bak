          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Like I said \"don't worry. You just do your part.\"",
      "start": 2714.42,
      "end": 2716.64,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Like",
          "start": 2714.42,
          "end": 2714.54,
