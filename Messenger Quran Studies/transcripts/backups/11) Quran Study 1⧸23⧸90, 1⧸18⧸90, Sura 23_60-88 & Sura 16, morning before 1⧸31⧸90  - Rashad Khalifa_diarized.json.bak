          "speaker": "Dr. Khalifa"
        },
        {
          "word": " didn't",
          "start": 664.09,
          "end": 664.27,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " do",
          "start": 664.27,
          "end": 664.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 664.39,
          "end": 664.71,
          "speaker": "Dr. Khalifa"
        },
        {
