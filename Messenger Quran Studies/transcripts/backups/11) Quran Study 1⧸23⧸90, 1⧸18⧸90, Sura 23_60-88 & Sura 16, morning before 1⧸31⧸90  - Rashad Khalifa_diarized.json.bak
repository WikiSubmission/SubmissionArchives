          "end": 661.61,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 661.61,
          "end": 661.61,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " no",
          "start": 661.61,
          "end": 661.75,
          "speaker": "Dr. Khalifa"
        },
        {
