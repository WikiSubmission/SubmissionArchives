          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God's",
          "start": 659.41,
          "end": 659.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " work,",
          "start": 659.83,
          "end": 660.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " nobody",
          "start": 660.29,
          "end": 660.51,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " else's.",
