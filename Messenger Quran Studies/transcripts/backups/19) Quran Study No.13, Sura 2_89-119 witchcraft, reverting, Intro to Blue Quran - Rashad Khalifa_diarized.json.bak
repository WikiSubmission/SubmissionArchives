          "word": " much,",
          "start": 4510.05,
          "end": 4510.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " much",
          "start": 4510.05,
          "end": 4510.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " more",
          "start": 4510.05,
          "end": 4510.05,
          "speaker": "Dr. Khalifa"
        },
