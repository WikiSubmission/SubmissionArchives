    },
    {
      "text": "Congratulations. God bless you.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Congratulations.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " bless",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Very fortunate. You're a fortunate believer. M\u00e3 Sh\u00e3 All\u00e3h.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Very",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " fortunate.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " You're",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " fortunate",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " believer.",
          "start": 5346.86,
