          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Arabic.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Sorry about that.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Sorry",
          "start": 5346.86,
          "end": 5346.86,
