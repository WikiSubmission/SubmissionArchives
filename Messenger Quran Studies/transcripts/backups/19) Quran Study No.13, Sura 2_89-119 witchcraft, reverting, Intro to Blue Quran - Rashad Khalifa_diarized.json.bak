        },
        {
          "word": " is",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Divine.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And it is Bar\u00e3'ah (Ultimatum).",
