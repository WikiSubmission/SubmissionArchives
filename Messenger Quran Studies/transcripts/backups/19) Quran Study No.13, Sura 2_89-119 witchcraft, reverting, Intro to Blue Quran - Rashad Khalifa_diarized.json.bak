          "end": 3062.97,
          "speaker": "A man"
        },
        {
          "word": " are",
          "start": 3062.97,
          "end": 3062.97,
          "speaker": "A man"
        },
        {
          "word": " wise",
          "start": 3062.97,
          "end": 3062.97,
          "speaker": "A man"
        },
        {
          "word": " or",
          "start": 3062.97,
          "end": 3062.97,
          "speaker": "A man"
        },
        {
          "word": " intelligent,",
          "start": 3062.97,
          "end": 3062.97,
          "speaker": "A man"
        },
        {
          "word": " you",
