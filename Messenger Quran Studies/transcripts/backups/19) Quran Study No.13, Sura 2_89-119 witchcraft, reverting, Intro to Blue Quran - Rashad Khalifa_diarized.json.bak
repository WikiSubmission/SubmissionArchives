          "speaker": "A man"
        },
        {
          "word": " They",
          "start": 2932.99,
          "end": 2932.99,
          "speaker": "A man"
        },
        {
          "word": " will",
          "start": 2932.99,
          "end": 2932.99,
          "speaker": "A man"
        },
        {
          "word": " not",
          "start": 2932.99,
          "end": 2933.13,
          "speaker": "A man"
        },
        {
          "word": " save",
          "start": 2933.13,
          "end": 2933.13,
          "speaker": "A man"
        },
        {
