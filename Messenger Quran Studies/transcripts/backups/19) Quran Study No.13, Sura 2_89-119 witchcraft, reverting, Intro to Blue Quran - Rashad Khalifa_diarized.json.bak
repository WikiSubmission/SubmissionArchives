        },
        {
          "word": " and",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Tawbah,",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " but",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Tawbah",
