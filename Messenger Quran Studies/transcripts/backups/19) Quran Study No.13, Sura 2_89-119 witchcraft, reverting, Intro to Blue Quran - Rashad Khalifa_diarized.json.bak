          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Bism Allah Arrahman Arraheem",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Bism",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Allah",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Arrahman",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Arraheem",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In the name of GOD, Most Gracious, Most Merciful.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " In",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " name",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " GOD,",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Most",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Gracious,",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Most",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Merciful.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Congratulations for reading the Quran.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Congratulations",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " for",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " reading",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Quran.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And congratulations on starting with the new translation.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " congratulations",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " on",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " starting",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " with",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " new",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " translation.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And I want to tell you right now that this was made obsolete before it came out of the press.",
