          "word": " the...",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Yes, it is Divine.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
