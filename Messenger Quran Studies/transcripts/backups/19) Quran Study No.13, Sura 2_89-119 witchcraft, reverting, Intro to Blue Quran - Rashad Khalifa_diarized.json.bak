          "speaker": "A man"
        },
        {
          "word": " think.",
          "start": 2927.83,
          "end": 2928.07,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "The people will not put you in Heaven or Hell. They will not save you.",
      "start": 2929.73,
      "end": 2933.13,
      "speaker": "A man",
      "words": [
        {
          "word": " The",
          "start": 2929.73,
          "end": 2929.83,
