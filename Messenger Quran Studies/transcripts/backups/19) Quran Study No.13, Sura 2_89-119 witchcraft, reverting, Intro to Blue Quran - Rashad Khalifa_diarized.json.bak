          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Bar\u00e3'ah",
          "start": 5346.86,
