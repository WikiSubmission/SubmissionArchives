    },
    {
      "text": "Fast the month of Ramadan, regardless of what the people think.",
      "start": 2923.95,
      "end": 2928.07,
      "speaker": "A man",
      "words": [
        {
          "word": " Fast",
          "start": 2923.95,
          "end": 2924.01,
          "speaker": "A man"
        },
