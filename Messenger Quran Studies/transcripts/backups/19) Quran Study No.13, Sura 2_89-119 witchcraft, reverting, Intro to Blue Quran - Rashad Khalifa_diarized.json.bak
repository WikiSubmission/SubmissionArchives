        },
        {
          "word": " about",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Yes.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "In the next edition, I will change this Arabic name also to Bar\u00e3'ah.",
      "start": 5346.86,
      "end": 5346.86,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " In",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " next",
