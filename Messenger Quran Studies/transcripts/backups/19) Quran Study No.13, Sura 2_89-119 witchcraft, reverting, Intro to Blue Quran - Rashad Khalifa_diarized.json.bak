        },
        {
          "word": " witchcraft",
          "start": 4416.91,
          "end": 4416.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 4416.93,
          "end": 4417.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " magic?",
          "start": 4417.15,
          "end": 4417.2,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's using the jinns.",
      "start": 4417.75,
      "end": 4428.19,
      "speaker": "Dr. Khalifa",
      "words": [
