    {
      "text": "\"Miserable indeed,\" number 90, back to.",
      "start": 1047.28,
      "end": 1049.02,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"Miserable",
          "start": 1047.28,
          "end": 1047.28,
          "speaker": "Dr. Khalifa"
        },
