          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And who can stand when he appears?",
      "start": 258.12,
      "end": 259.64,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 258.12,
