          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "What is witchcraft and magic?",
      "start": 4416.91,
      "end": 4417.2,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " What",
          "start": 4416.91,
