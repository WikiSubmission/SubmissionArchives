          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Number 90,",
      "start": 440.84,
      "end": 441.22,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Number",
          "start": 440.84,
