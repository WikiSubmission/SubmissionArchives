          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 4426.05,
          "end": 4426.33,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " jinns.",
          "start": 4428.09,
          "end": 4428.19,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's no big deal, actually.",
      "start": 4429.71,
      "end": 4434.55,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " It's",
