          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " explain",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " when",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Apamea",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " here",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 5346.86,
          "end": 5346.86,
          "speaker": "Dr. Khalifa"
        },
        {
