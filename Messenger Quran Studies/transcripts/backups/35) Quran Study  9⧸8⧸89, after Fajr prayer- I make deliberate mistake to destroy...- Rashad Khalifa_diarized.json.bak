          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " out",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " here,",
          "start": 3481.16,
          "end": 3481.16,
