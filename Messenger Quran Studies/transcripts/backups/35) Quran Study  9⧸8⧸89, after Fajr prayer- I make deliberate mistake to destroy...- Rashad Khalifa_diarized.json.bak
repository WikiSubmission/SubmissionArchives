        },
        {
          "word": " first,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Ismail Barakat"
        }
      ]
    },
    {
      "text": "Yes, of course.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " though.",
          "start": 3481.16,
