          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, let us put this in practice.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Judgment.\"",
