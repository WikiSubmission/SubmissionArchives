          "end": 3481.16,
          "speaker": "Ismail Barakat"
        }
      ]
    },
    {
      "text": "(23:97) \u0631\u0651\u064e\u0628\u0651\u0650 \u0623\u064e\u0639\u064f\u0648\u0630\u064f \u0628\u0650\u0643\u064e \u0645\u0650\u0646\u0652 \u0647\u064e\u0645\u064e\u0632\u064e\u0670\u062a\u0650 \u0671\u0644\u0634\u0651\u064e\u064a\u064e\u0640\u0670\u0637\u0650\u064a\u0646\u0650 (23:98) \u0648\u064e\u0623\u064e\u0639\u064f\u0648\u0630\u064f \u0628\u0650\u0643\u064e \u0631\u064e\u0628\u0651\u0650 \u0623\u064e\u0646 \u064a\u064e\u062d\u0652\u0636\u064f\u0631\u064f\u0648\u0646\u0650",
