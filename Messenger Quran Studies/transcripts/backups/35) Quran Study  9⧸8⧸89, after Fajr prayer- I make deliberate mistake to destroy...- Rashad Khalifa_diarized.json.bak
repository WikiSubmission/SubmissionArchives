        },
        {
          "word": " is",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Any enzyme is a catalyst. It breaks up chemicals in an unusual manner.",
