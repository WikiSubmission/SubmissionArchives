        },
        {
          "word": " Oh,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muhammad,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
