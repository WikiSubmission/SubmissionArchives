          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Himself",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " has",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " sent",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " them",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
