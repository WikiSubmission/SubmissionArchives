          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I'm giving you an example of my own father, because I really loved him immensely.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
