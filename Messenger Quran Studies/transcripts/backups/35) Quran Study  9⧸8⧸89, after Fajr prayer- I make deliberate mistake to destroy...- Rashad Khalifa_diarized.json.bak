          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Let Hagia explain.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Ismail Barakat",
      "words": [
        {
          "word": " So...",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " Let",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Ismail Barakat"
        },
        {
          "word": " Hagia",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Ismail Barakat"
        }
      ]
    },
    {
      "text": "Yes, this is Ihsan's explanation.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
