    },
    {
      "text": "Okay, to make you understand this, they say \"Muhammad will intercede on the Day of Judgment.\"",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " understand.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Okay,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
