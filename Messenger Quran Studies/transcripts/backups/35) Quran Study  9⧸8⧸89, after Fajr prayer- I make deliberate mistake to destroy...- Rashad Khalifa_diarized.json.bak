          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " why",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
