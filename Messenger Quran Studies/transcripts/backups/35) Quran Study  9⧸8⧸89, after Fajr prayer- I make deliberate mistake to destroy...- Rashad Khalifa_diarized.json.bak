          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " go",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " sit",
          "start": 3481.16,
