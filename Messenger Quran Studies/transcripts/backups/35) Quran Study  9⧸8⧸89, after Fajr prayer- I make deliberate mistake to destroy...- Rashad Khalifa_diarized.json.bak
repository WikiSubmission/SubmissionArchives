        },
        {
          "word": " are",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But they made the choice first, though.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Ismail Barakat",
