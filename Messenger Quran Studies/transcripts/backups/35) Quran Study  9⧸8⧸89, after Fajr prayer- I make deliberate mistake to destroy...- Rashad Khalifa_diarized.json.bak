          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " And",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " was",
          "start": 3481.16,
