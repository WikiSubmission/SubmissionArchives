          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because God Himself has sent them astray.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " understand.",
