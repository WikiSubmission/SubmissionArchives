          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He wanted it.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "A man",
      "words": [
        {
          "word": " Hell.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "A man"
        },
        {
          "word": " He",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "A man"
        },
        {
          "word": " wanted",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "Yeah, he wanted it bad. I mean,",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " it.",
