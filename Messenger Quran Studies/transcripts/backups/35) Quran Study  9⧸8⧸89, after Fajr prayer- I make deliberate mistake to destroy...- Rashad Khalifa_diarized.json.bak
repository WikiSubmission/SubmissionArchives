          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " intercession,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Hani, go sit with Daddy, honey.",
