        },
        {
          "word": " to",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Yes.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Prayer).",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I said \"then, you cannot come in here because the idol worshippers are filth.\"",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I",
          "start": 3481.16,
          "end": 3481.16,
