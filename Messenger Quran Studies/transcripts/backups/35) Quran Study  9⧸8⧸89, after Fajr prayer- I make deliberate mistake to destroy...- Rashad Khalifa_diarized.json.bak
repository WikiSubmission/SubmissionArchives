          "speaker": "Dr. Khalifa"
        },
        {
          "word": " very",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " upset",
          "start": 3481.16,
          "end": 3481.16,
