        },
        {
          "word": " He",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " told",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " us",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " this",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Yes, they're all allegorical. There's no, it's not fire. It's mostly darkness, actually.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " allegorical.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Yes,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they're",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " all",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " allegorical.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " There's",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " no,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it's",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " fire.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " It's",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mostly",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " darkness,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Mostly darkness. Remember, \"we need some of your light.\"",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " actually.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Mostly",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " darkness.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Remember,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"we",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " need",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " some",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
