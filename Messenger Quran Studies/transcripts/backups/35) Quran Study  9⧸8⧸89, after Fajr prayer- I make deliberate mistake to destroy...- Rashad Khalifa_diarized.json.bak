          "word": " one.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " 18,",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " was",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sura",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's with a simple mix-up.",
      "start": 3481.16,
      "end": 3481.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " before.",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " It's",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " with",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " simple",
          "start": 3481.16,
          "end": 3481.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Let's go to 18, the Sura before.",
