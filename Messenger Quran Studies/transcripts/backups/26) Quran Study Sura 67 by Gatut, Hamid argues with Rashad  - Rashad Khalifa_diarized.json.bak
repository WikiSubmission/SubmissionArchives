        }
      ]
    },
    {
      "text": "That sequence throughout the Quran \"those who believe and work righteousness\",",
      "start": 3154.05,
      "end": 3154.05,
      "speaker": "Douglas",
      "words": [
        {
          "word": " That",
          "start": 3154.05,
          "end": 3154.05,
          "speaker": "Douglas"
        },
        {
          "word": " sequence",
