          "end": 250.98,
          "speaker": "Gatut"
        }
      ]
    },
    {
      "text": "He already knew.",
      "start": 251.14,
      "end": 251.62,
      "speaker": "Gatut",
      "words": [
        {
          "word": " He",
          "start": 251.14,
