          "speaker": "Gatut"
        },
        {
          "word": " run",
          "start": 768.96,
          "end": 769.06,
          "speaker": "Gatut"
        },
        {
          "word": " away",
          "start": 769.06,
          "end": 769.24,
          "speaker": "Gatut"
        },
        {
          "word": " from",
          "start": 769.24,
          "end": 769.4,
          "speaker": "Gatut"
        },
        {
          "word": " God.",
          "start": 769.4,
          "end": 769.76,
          "speaker": "Gatut"
        }
      ]
    },
    {
      "text": "They couldn't stand the presence of God. And",
      "start": 770.54,
      "end": 772.6,
      "speaker": "Gatut",
      "words": [
        {
          "word": " They",
          "start": 770.54,
          "end": 770.58,
          "speaker": "Gatut"
        },
        {
          "word": " couldn't",
