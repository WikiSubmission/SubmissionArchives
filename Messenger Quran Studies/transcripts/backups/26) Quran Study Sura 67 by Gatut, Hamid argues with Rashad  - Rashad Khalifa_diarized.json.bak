          "end": 767.6,
          "speaker": "Gatut"
        },
        {
          "word": " therefore",
          "start": 767.6,
          "end": 767.9,
          "speaker": "Gatut"
        },
        {
          "word": " on",
          "start": 767.9,
          "end": 768.1,
          "speaker": "Gatut"
        },
        {
          "word": " the",
          "start": 768.1,
