          "speaker": "Douglas"
        }
      ]
    },
    {
      "text": "Chester.",
      "start": 3154.05,
      "end": 3154.05,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Chester.",
          "start": 3154.05,
          "end": 3154.05,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
