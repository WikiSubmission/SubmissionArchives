        },
        {
          "word": " you...?\"",
          "start": 745.18,
          "end": 745.48,
          "speaker": "Gatut"
        }
      ]
    },
    {
      "text": "\"Can I have more?\"",
      "start": 746.72,
      "end": 747.48,
      "speaker": "Gatut",
      "words": [
        {
          "word": " \"Can",
          "start": 746.72,
          "end": 746.82,
          "speaker": "Gatut"
        },
        {
          "word": " I",
          "start": 746.82,
          "end": 746.94,
          "speaker": "Gatut"
        },
        {
          "word": " have",
          "start": 746.94,
          "end": 747.08,
          "speaker": "Gatut"
        },
        {
          "word": " more?\"",
          "start": 747.08,
          "end": 747.48,
          "speaker": "Gatut"
        }
      ]
    },
    {
      "text": "In some other verses in the Quran Hell says \"can I have more of these people?\"",
