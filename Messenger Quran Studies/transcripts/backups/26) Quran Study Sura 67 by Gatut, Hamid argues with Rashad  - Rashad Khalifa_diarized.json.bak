        },
        {
          "word": " our",
          "start": 1408.24,
          "end": 1408.46,
          "speaker": "Gatut"
        },
        {
          "word": " service.\"",
          "start": 1408.46,
          "end": 1408.78,
          "speaker": "Gatut"
        }
      ]
    },
    {
      "text": "Everything in this earth is actually put for our service.",
      "start": 1409.4,
      "end": 1412.05,
      "speaker": "Gatut",
      "words": [
