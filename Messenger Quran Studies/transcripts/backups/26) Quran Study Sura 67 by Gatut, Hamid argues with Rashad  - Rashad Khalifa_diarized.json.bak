          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And how does... Dr. Khalifa: Douglas.",
      "start": 3154.05,
      "end": 3154.05,
      "speaker": "A woman",
      "words": [
        {
          "word": " And",
          "start": 3154.05,
          "end": 3154.05,
          "speaker": "A woman"
        },
        {
