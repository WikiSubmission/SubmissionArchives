    {
      "text": "Sura... verse 15 says \"the earth is put for our service.\"",
      "start": 1405.02,
      "end": 1408.78,
      "speaker": "Gatut",
      "words": [
        {
          "word": " Sura...",
          "start": 1405.02,
          "end": 1405.26,
          "speaker": "Gatut"
        },
        {
          "word": " verse",
          "start": 1405.56,
          "end": 1405.62,
          "speaker": "Gatut"
        },
        {
          "word": " 15",
          "start": 1405.62,
          "end": 1405.88,
          "speaker": "Gatut"
        },
        {
          "word": " says",
          "start": 1406.0,
          "end": 1406.1,
          "speaker": "Gatut"
        },
        {
          "word": " \"the",
