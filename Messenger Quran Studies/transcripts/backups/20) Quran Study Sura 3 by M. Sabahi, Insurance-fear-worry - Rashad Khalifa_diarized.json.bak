          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because they're having these things.",
      "start": 3646.74,
      "end": 3649.6,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Because",
          "start": 3646.74,
