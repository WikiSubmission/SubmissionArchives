          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you.",
          "start": 3247.42,
          "end": 3247.42,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Don't let anybody or your companion tells you \"this is for somebody else.\"",
      "start": 3247.42,
      "end": 3270.12,
      "speaker": "Dr. Khalifa",
      "words": [
