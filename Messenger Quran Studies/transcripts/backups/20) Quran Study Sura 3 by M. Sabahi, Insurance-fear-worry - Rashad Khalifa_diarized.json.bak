        },
        {
          "word": " the",
          "start": 1188.37,
          "end": 1188.37,
          "speaker": "Douglas"
        },
        {
          "word": " reason",
          "start": 1188.37,
          "end": 1188.57,
          "speaker": "Douglas"
        },
