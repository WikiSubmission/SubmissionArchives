          "speaker": "Dr. Khalifa"
        },
        {
          "word": " no.",
          "start": 1173.39,
          "end": 1173.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " It's",
          "start": 1173.39,
          "end": 1173.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 1173.39,
          "end": 1173.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " very",
