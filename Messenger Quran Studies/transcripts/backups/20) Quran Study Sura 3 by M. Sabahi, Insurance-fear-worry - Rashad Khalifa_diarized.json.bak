          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And it seems to float over our heads.",
      "start": 3247.1,
      "end": 3247.1,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
