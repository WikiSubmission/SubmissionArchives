        },
        {
          "word": " saying",
          "start": 1178.83,
          "end": 1179.13,
          "speaker": "Douglas"
        },
        {
          "word": " that",
          "start": 1179.41,
          "end": 1179.51,
          "speaker": "Douglas"
        },
        {
          "word": " it",
          "start": 1179.51,
          "end": 1179.73,
          "speaker": "Douglas"
        },
        {
          "word": " was",
          "start": 1179.73,
          "end": 1179.75,
          "speaker": "Douglas"
        },
        {
          "word": " distorted.",
          "start": 1179.75,
          "end": 1180.0,
          "speaker": "Douglas"
        }
      ]
    },
    {
      "text": "What they do, what they do is they ignore the Wa (and).",
      "start": 1180.45,
      "end": 1183.89,
      "speaker": "Douglas",
      "words": [
        {
          "word": " What",
          "start": 1180.45,
          "end": 1180.49,
          "speaker": "Douglas"
        },
        {
          "word": " they",
          "start": 1180.49,
          "end": 1180.71,
          "speaker": "Douglas"
        },
        {
          "word": " do,",
          "start": 1180.71,
          "end": 1181.26,
          "speaker": "Douglas"
        },
        {
          "word": " what",
          "start": 1181.73,
          "end": 1181.79,
