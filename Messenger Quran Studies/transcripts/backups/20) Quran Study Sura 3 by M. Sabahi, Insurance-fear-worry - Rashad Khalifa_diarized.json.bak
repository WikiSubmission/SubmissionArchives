          "end": 1183.71,
          "speaker": "Douglas"
        },
        {
          "word": " (and).",
          "start": 1183.71,
          "end": 1183.89,
          "speaker": "Douglas"
        }
      ]
    },
    {
      "text": "Exactly. Douglas: They ignore the Wa (and).",
      "start": 1184.65,
      "end": 1185.83,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Exactly.",
          "start": 1184.65,
          "end": 1184.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Douglas:",
          "start": 1184.93,
          "end": 1184.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " They",
          "start": 1184.99,
