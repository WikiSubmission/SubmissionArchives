        },
        {
          "word": " me.",
          "start": 3382.6,
          "end": 3382.7,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I'm gonna repeat it.",
      "start": 3383.12,
      "end": 3386.0,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I'm",
          "start": 3383.12,
          "end": 3383.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " gonna",
          "start": 3383.8,
          "end": 3383.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " repeat",
