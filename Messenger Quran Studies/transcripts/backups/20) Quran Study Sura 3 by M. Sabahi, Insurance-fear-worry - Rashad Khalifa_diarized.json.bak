          "speaker": "Douglas"
        },
        {
          "word": " it's",
          "start": 1169.97,
          "end": 1170.15,
          "speaker": "Douglas"
        },
        {
          "word": " written",
          "start": 1170.17,
          "end": 1170.35,
          "speaker": "Douglas"
        },
        {
          "word": " very",
          "start": 1170.51,
          "end": 1170.73,
          "speaker": "Douglas"
        },
        {
          "word": " small.",
          "start": 1170.73,
          "end": 1171.28,
          "speaker": "Douglas"
        }
      ]
    },
    {
      "text": "No, no, no. It's not very small.",
      "start": 1173.15,
      "end": 1173.53,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " No,",
