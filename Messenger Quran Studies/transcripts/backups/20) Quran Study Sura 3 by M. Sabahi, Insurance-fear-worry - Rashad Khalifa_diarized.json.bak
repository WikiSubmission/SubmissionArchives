          "end": 1163.93,
          "speaker": "Dr. Sabahi"
        }
      ]
    },
    {
      "text": "In the Arabic text, there is a Wa, which means \"and.\"",
      "start": 1165.51,
      "end": 1169.71,
      "speaker": "Douglas",
      "words": [
        {
          "word": " In",
          "start": 1165.51,
          "end": 1165.61,
          "speaker": "Douglas"
        },
        {
          "word": " the",
          "start": 1165.61,
          "end": 1165.75,
          "speaker": "Douglas"
        },
        {
          "word": " Arabic",
          "start": 1165.75,
          "end": 1166.01,
          "speaker": "Douglas"
        },
        {
          "word": " text,",
          "start": 1166.01,
          "end": 1166.11,
          "speaker": "Douglas"
        },
        {
          "word": " there",
