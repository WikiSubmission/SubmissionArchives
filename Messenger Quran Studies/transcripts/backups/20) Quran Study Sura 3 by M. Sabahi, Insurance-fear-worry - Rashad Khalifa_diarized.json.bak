          "speaker": "Douglas"
        },
        {
          "word": " a",
          "start": 1167.37,
          "end": 1167.51,
          "speaker": "Douglas"
        },
        {
          "word": " Wa,",
          "start": 1167.51,
          "end": 1167.91,
          "speaker": "Douglas"
        },
        {
          "word": " which",
          "start": 1168.13,
          "end": 1168.27,
          "speaker": "Douglas"
        },
        {
          "word": " means",
          "start": 1168.27,
          "end": 1168.51,
          "speaker": "Douglas"
        },
        {
          "word": " \"and.\"",
          "start": 1168.51,
          "end": 1169.71,
          "speaker": "Douglas"
        }
      ]
    },
    {
      "text": "But it's written very small.",
      "start": 1169.87,
      "end": 1171.28,
      "speaker": "Douglas",
      "words": [
        {
          "word": " But",
          "start": 1169.87,
