          "speaker": "Dr. Khalifa"
        },
        {
          "word": " yourself.",
          "start": 3370.46,
          "end": 3370.46,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, ask yourself if you heard me.",
      "start": 3371.18,
      "end": 3382.7,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " So,",
          "start": 3371.18,
