          "speaker": "Douglas"
        },
        {
          "word": " (and)",
          "start": 1177.01,
          "end": 1177.37,
          "speaker": "Douglas"
        },
        {
          "word": " is",
          "start": 1177.37,
          "end": 1177.37,
          "speaker": "Douglas"
        },
        {
          "word": " there.",
          "start": 1177.37,
          "end": 1177.75,
          "speaker": "Douglas"
        }
      ]
    },
    {
      "text": "In other words, I'm not saying that it was distorted.",
      "start": 1178.11,
      "end": 1180.0,
      "speaker": "Douglas",
      "words": [
        {
          "word": " In",
          "start": 1178.11,
