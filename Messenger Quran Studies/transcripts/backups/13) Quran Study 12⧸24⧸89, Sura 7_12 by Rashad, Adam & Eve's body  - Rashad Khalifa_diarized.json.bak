          "speaker": "Parivash"
        },
        {
          "word": " the",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " God.",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " Dr.",
