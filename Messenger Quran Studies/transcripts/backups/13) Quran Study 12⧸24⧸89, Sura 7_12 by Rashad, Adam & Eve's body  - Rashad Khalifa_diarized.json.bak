        },
        {
          "word": " me",
          "start": 1638.78,
          "end": 1639.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " obedient.\"",
          "start": 1639.04,
          "end": 1639.49,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "God doesn't want robots.",
      "start": 1640.72,
      "end": 1641.76,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " God",
          "start": 1640.72,
