          "end": 5533.92,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "M\u00e3 Sh\u00e3 All\u00e3h. It's fantastic.",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " All\u00e3h.",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " M\u00e3",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sh\u00e3",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " All\u00e3h.",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " It's",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Cause \"Ash-hadu\" is witnessing.",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " fantastic.",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Cause",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"Ash-hadu\"",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(unintelligible).",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " witnessing.",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And when I was telling somebody, and he said \"no, because you can say of the Quran, is this Shahada enough?",
