          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " said",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " \"no,",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " because",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " you",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " can",
          "start": 5533.92,
          "end": 5533.92,
