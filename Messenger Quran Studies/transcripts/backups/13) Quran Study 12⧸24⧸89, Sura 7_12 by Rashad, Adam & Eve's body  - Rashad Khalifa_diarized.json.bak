          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " this",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " Shahada",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "\"Because Quran is the shahada.\" I said \"no.\"",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Parivash",
      "words": [
        {
          "word": " enough?",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " \"Because",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " Quran",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " is",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " the",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " shahada.\"",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " I",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " said",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "It's just imagine, if you go to the court, and you have to see something and say, yes, I saw it.",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Parivash",
      "words": [
        {
          "word": " \"no.\"",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " It's",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " just",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " imagine,",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
