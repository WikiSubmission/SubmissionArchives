          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"of the speed faster, we will have nothing.",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Dr. Khalifa",
      "words": [
