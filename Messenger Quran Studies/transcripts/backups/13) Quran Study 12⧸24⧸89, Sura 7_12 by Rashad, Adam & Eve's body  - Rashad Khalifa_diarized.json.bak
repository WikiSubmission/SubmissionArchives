          "speaker": "Dr. Khalifa"
        },
        {
          "word": " would",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " just",
