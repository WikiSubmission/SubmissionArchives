          "end": 5533.92,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "we saw the God. Dr. Khalifa: We witnessed God.",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Parivash",
      "words": [
        {
          "word": " 7:172,",
