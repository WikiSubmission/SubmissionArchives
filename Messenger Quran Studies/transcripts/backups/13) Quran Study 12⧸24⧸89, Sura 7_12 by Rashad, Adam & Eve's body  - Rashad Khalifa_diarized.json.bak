          "speaker": "Dr. Khalifa"
        },
        {
          "word": " have",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"It would be just space now.",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Dr. Khalifa",
      "words": [
