        {
          "word": " see",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " something",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " and",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " say,",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " yes,",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " I",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " saw",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        }
      ]
    },
    {
      "text": "But if you have the evidence, still you cannot say \"I am witness that this happened.\"",
      "start": 5533.92,
      "end": 5533.92,
      "speaker": "Parivash",
      "words": [
        {
          "word": " it.",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " But",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " if",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " you",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " have",
          "start": 5533.92,
