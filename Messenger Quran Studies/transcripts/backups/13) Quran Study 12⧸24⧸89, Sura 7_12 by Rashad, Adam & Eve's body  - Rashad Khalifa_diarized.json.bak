        },
        {
          "word": " the",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " court,",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " and",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " you",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Parivash"
        },
        {
          "word": " have",
          "start": 5533.92,
          "end": 5533.92,
