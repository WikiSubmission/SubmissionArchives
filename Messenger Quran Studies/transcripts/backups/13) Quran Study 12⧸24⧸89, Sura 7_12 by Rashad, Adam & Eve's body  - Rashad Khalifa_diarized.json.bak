        },
        {
          "word": " the",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " speed",
          "start": 5533.92,
          "end": 5533.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " faster,",
