          "end": 3324.5,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "According to Hadith and Sunnah, the majority of inhabitants of Hell are women.",
      "start": 3325.28,
      "end": 3328.54,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " According",
          "start": 3325.28,
          "end": 3325.36,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3325.36,
          "end": 3325.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Hadith",
          "start": 3325.58,
          "end": 3325.84,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 3325.84,
          "end": 3325.98,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sunnah,",
          "start": 3325.98,
          "end": 3326.4,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3326.48,
          "end": 3326.48,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " majority",
