    {
      "text": "[81:8]  The girl who was buried alive is asked: [81:9]  For what crime was she killed?",
      "start": 2966.16,
      "end": 2970.28,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " [81:8]",
