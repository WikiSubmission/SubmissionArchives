      "end": 3324.5,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 3319.2,
          "end": 3319.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " we",
          "start": 3319.9,
          "end": 3320.58,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " read",
          "start": 3320.58,
          "end": 3320.7,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 3320.7,
          "end": 3320.82,
