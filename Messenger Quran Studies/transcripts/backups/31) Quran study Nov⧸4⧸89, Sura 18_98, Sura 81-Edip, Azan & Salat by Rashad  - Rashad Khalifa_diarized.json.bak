    },
    {
      "text": "(15:9) \u0625\u0650\u0646\u0651\u064e\u0627 \u0646\u064e\u062d\u0652\u0646\u064f \u0646\u064e\u0632\u0651\u064e\u0644\u0652\u0646\u064e\u0627 \u0671\u0644\u0630\u0651\u0650\u0643\u0652\u0631\u064e \u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0640\u0670\u0641\u0650\u0638\u064f\u0648\u0646\u064e",
