          "speaker": "Dr. Khalifa"
        },
        {
          "word": " inhabitants",
          "start": 3327.12,
          "end": 3327.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 3327.6,
          "end": 3327.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Hell",
          "start": 3327.88,
          "end": 3328.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
          "start": 3328.04,
          "end": 3328.18,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " women.",
          "start": 3328.18,
          "end": 3328.54,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But I'm convinced that the opposite is true, because of the oppression that they undergo.",
      "start": 3329.94,
      "end": 3335.0,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " But",
          "start": 3329.94,
          "end": 3330.02,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I'm",
          "start": 3330.02,
          "end": 3330.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " convinced",
          "start": 3330.22,
          "end": 3330.5,
          "speaker": "Dr. Khalifa"
        },
        {
