        },
        {
          "word": " because",
          "start": 3296.64,
          "end": 3296.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3296.74,
          "end": 3296.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " knew",
          "start": 3296.94,
          "end": 3297.08,
          "speaker": "Dr. Khalifa"
        },
        {
