        },
        {
          "word": " according",
          "start": 3264.28,
          "end": 3264.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3264.28,
          "end": 3264.54,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3264.54,
          "end": 3264.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " so-called",
          "start": 3264.74,
          "end": 3265.4,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Islamic",
