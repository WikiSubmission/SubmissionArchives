        },
        {
          "word": " it",
          "start": 886.2,
          "end": 886.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " with",
          "start": 886.32,
          "end": 886.4,
          "speaker": "Dr. Khalifa"
        },
        {
