          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But it still...",
      "start": 2488.55,
      "end": 2488.69,
      "speaker": "A woman",
      "words": [
        {
          "word": " But",
          "start": 2488.55,
