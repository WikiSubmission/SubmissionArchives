          "speaker": "Dr. Khalifa"
        },
        {
          "word": " really",
          "start": 859.88,
          "end": 860.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " advanced",
          "start": 860.5,
          "end": 860.94,
          "speaker": "Dr. Khalifa"
        },
