          "end": 901.08,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " oxygen.",
          "start": 901.08,
          "end": 901.54,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The rest is nitrogen.",
      "start": 901.92,
      "end": 902.52,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " The",
          "start": 901.92,
