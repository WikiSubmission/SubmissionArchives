          "speaker": "Douglas"
        },
        {
          "word": " surrounded",
          "start": 1397.29,
          "end": 1397.77,
          "speaker": "Douglas"
        },
        {
          "word": " by",
          "start": 1397.77,
          "end": 1398.05,
          "speaker": "Douglas"
        },
        {
          "word": " warnings.",
          "start": 1398.05,
          "end": 1398.7,
          "speaker": "Douglas"
        }
      ]
    },
    {
      "text": "We don't take them all with the same degree of seriousness.",
