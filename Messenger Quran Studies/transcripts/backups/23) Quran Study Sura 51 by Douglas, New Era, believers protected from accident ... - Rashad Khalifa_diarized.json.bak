        },
        {
          "word": " is",
          "start": 897.28,
          "end": 897.38,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " why",
          "start": 897.38,
          "end": 897.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
