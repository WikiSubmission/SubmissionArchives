          "start": 888.68,
          "end": 888.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " spark.",
          "start": 888.86,
          "end": 889.16,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And everything will be combusted into ashes.",
