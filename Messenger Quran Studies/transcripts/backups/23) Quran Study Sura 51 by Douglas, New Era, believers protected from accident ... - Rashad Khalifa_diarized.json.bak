        },
        {
          "word": " way.",
          "start": 911.48,
          "end": 911.84,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, despite our...",
      "start": 913.28,
      "end": 916.04,
      "speaker": "Dr. Khalifa",
      "words": [
