          "speaker": "Dr. Khalifa"
        },
        {
          "word": " oxygen.",
          "start": 899.68,
          "end": 900.38,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We have 20% oxygen.",
      "start": 900.4,
      "end": 901.54,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " We",
          "start": 900.4,
