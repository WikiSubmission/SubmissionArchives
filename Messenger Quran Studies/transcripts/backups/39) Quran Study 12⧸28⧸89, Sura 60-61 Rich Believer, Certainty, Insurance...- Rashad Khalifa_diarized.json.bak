          "end": 1325.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " differences.",
          "start": 1325.8,
          "end": 1327.5,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We have to be one.",
