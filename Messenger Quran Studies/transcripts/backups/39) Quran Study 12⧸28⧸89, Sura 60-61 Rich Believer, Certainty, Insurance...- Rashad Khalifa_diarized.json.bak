          "end": 1332.3,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that",
          "start": 1332.3,
          "end": 1332.56,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 1332.56,
          "end": 1332.8,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " condemns",
          "start": 1332.8,
          "end": 1333.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " sectarianism.",
          "start": 1333.52,
          "end": 1334.12,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "God says, says \"those who divide the religion into sects do not belong to God or the prophet.\"",
