          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 1228.86,
          "end": 1228.98,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " rest",
          "start": 1228.98,
          "end": 1229.1,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 1229.1,
          "end": 1229.22,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 1229.22,
          "end": 1229.34,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " verse",
          "start": 1229.34,
          "end": 1229.54,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " here",
          "start": 1229.54,
          "end": 1229.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " says",
          "start": 1229.76,
          "end": 1230.02,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"we",
          "start": 1230.02,
          "end": 1230.36,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " do",
          "start": 1230.36,
          "end": 1230.48,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 1230.48,
          "end": 1230.6,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " understand",
          "start": 1230.6,
          "end": 1231.12,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " their",
          "start": 1231.12,
          "end": 1231.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " glorification.\"",
          "start": 1231.42,
          "end": 1232.98,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Right.",
      "start": 1232.98,
      "end": 1234.28,
      "speaker": "A man",
      "words": [
        {
          "word": " Right.",
          "start": 1232.98,
          "end": 1234.28,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "So, the disbelievers' bodies, disbelievers cannot control the heartbeats, or the lungs breathing.",
      "start": 1234.56,
      "end": 1241.75,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " So,",
          "start": 1234.56,
          "end": 1234.72,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 1234.94,
          "end": 1234.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " disbelievers'",
          "start": 1234.94,
          "end": 1235.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " bodies,",
