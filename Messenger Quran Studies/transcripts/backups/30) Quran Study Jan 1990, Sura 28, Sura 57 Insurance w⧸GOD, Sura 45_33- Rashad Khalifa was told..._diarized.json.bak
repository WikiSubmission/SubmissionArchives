          "word": " And",
          "start": 5331.36,
          "end": 5331.36,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And God said \"I know what you do not know.\"",
      "start": 5331.36,
      "end": 5333.74,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " God",
          "start": 5331.36,
          "end": 5331.5,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 5331.5,
          "end": 5331.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"I",
          "start": 5331.66,
          "end": 5331.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " know",
