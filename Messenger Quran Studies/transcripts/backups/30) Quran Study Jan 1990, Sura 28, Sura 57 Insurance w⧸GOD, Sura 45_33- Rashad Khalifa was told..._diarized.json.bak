          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And they died.",
      "start": 1550.54,
      "end": 1551.06,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 1550.54,
          "end": 1550.64,
