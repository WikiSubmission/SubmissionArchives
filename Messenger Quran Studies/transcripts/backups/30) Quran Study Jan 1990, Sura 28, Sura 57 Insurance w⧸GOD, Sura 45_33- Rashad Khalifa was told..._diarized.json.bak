          "end": 5055.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Adam",
          "start": 5063.74,
          "end": 5063.92,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Adam and Eve were in Heaven, or in Paradise, or Heaven, the same thing.",
