          "end": 5355.6,
          "speaker": "A man"
        },
        {
          "word": " would",
          "start": 5355.6,
          "end": 5355.76,
          "speaker": "A man"
        },
        {
          "word": " you",
          "start": 5355.76,
          "end": 5355.8,
          "speaker": "A man"
        },
        {
          "word": " like",
