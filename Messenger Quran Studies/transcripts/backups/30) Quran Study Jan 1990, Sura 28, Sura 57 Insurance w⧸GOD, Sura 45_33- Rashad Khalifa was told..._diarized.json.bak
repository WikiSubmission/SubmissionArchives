          "end": 695.82,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"Who are you?\"",
      "start": 697.96,
      "end": 699.1,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"Who",
          "start": 697.96,
