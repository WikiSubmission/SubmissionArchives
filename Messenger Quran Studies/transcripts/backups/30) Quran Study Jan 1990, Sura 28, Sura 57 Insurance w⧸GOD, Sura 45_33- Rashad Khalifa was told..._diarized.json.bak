          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sura",
          "start": 1081.8,
          "end": 1081.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " 3.",
          "start": 1081.94,
          "end": 1082.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"No",
          "start": 1082.46,
          "end": 1082.62,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " one",
          "start": 1082.62,
          "end": 1082.74,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " dies",
          "start": 1082.74,
          "end": 1083.02,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " without",
          "start": 1083.02,
          "end": 1083.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God's",
          "start": 1083.42,
          "end": 1083.82,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " personal",
          "start": 1086.1,
          "end": 1086.4,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " order.\"",
          "start": 1086.4,
          "end": 1086.92,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The angels do not know when anybody will die.",
