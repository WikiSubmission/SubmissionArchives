          "end": 1550.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " died.",
          "start": 1550.76,
          "end": 1551.06,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Then, God revived them.",
      "start": 1552.46,
      "end": 1553.28,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Then,",
          "start": 1552.46,
          "end": 1552.7,
