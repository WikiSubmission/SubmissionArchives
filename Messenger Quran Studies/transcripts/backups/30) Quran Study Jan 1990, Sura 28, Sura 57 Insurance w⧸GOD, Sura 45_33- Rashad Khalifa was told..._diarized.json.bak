          "end": 1090.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " die.",
          "start": 1090.28,
          "end": 1090.52,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Only God knows and decides.",
