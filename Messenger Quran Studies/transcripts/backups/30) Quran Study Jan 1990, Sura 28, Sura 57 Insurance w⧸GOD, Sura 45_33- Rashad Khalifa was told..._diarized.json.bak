          "speaker": "Dr. Khalifa"
        },
        {
          "word": " accident.",
          "start": 1375.66,
          "end": 1375.68,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Yes.",
          "start": 1375.68,
