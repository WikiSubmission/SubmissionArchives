          "start": 4221.96,
          "end": 4222.38,
          "speaker": "The people [Jews] in France made it a custom to add [in the morning prayer] the words"
        },
        {
          "word": " and",
          "start": 4223.28,
          "end": 4223.28,
          "speaker": "The people [Jews] in France made it a custom to add [in the morning prayer] the words"
        }
      ]
    },
    {
