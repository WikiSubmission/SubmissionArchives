          "start": 5357.72,
          "end": 5358.28,
          "speaker": "A man"
        },
        {
          "word": " with",
          "start": 5358.28,
          "end": 5358.5,
          "speaker": "A man"
        },
        {
          "word": " Satan?\"",
          "start": 5358.5,
          "end": 5358.9,
          "speaker": "A man"
        },
        {
          "word": " \"I'm",
          "start": 5360.08,
          "end": 5360.18,
          "speaker": "A man"
        }
      ]
    },
    {
      "text": "\"I'm going to give you a chance to submit outright. Or, you can go through an experiment where we put Satan to the test.\"",
      "start": 5360.18,
      "end": 5367.4,
      "speaker": "A man",
      "words": [
