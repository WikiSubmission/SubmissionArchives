          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"We",
          "start": 2683.54,
          "end": 2683.68,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " believe",
          "start": 2683.68,
