          "speaker": "Dr. Khalifa"
        },
        {
          "word": " son.\"",
          "start": 699.48,
          "end": 699.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"You're sure?\"",
