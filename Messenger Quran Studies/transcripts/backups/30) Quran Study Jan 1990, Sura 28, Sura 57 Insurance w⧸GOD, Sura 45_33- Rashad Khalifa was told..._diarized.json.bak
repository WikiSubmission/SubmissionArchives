          "end": 1077.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " without",
          "start": 1077.52,
          "end": 1077.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God's",
          "start": 1078.16,
          "end": 1078.26,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " permission.",
          "start": 1078.26,
          "end": 1078.56,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We have the law in Sura 3. \"No one dies without God's personal order.\"",
      "start": 1081.12,
      "end": 1086.92,
      "speaker": "Dr. Khalifa",
      "words": [
