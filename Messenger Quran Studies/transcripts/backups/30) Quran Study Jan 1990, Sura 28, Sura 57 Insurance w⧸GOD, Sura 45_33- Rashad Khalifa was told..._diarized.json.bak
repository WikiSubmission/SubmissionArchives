      "end": 2687.16,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 2680.46,
          "end": 2680.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " There",
          "start": 2681.44,
