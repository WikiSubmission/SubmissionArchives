          "speaker": "A woman"
        },
        {
          "word": " (Eve).",
          "start": 1724.52,
          "end": 1725.58,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "Yeah.",
      "start": 1726.32,
      "end": 1728.8,
      "speaker": "Dr. Khalifa",
      "words": [
