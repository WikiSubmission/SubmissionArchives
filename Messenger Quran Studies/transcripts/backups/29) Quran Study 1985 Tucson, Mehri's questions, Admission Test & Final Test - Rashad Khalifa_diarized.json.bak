        },
        {
          "word": " mud?\"",
          "start": 2920.74,
          "end": 2920.74,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And some angels agreed with him.",
      "start": 2920.82,
      "end": 2920.82,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 2920.82,
