        },
        {
          "word": " But",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Parivash"
        },
        {
          "word": " the",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Parivash"
        },
        {
          "word": " test",
