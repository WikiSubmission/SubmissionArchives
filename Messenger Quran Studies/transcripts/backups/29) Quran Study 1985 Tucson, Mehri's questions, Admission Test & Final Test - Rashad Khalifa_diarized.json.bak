    {
      "text": "\u0648\u064e\u0644\u064e\u0646\u064e\u0628\u0652\u0644\u064f\u0648\u064e\u0646\u0651\u064e\u0643\u064f\u0645 \u0628\u0650\u0634\u064e\u0649\u0652\u0621\u064d\u06e2 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0652\u062e\u064e\u0648\u0652\u0641\u0650 \u0648\u064e\u0671\u0644\u0652\u062c\u064f\u0648\u0639\u0650 \u0648\u064e\u0646\u064e\u0642\u0652\u0635\u064d\u06e2 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0652\u0623\u064e\u0645\u0652\u0648\u064e\u0670\u0644\u0650  (2:155) \u0648\u064e\u0671\u0644\u0652\u0623\u064e\u0646\u0641\u064f\u0633\u0650 \u0648\u064e\u0671\u0644\u062b\u0651\u064e\u0645\u064e\u0631\u064e\u0670\u062a\u0650",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Parivash",
      "words": [
        {
          "word": " yeah.",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Parivash"
        },
        {
          "word": " \u0648\u064e\u0644\u064e\u0646\u064e\u0628\u0652\u0644\u064f\u0648\u064e\u0646\u0651\u064e\u0643\u064f\u0645",
