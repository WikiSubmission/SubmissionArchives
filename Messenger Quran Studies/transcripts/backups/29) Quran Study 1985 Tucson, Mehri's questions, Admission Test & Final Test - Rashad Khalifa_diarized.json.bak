          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " This",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is...",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " okay,",
