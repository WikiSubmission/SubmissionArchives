          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " this",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3478.78,
          "end": 3478.78,
