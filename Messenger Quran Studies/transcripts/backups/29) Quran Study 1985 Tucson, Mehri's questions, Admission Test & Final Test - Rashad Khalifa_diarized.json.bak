          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " really",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
