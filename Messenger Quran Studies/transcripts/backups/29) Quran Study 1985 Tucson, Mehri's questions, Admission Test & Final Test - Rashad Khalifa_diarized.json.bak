          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " we",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " hold",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " You",
