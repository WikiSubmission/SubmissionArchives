          "end": 2920.82,
          "speaker": "A woman"
        },
        {
          "word": " angels",
          "start": 2920.82,
          "end": 2920.82,
          "speaker": "A woman"
        },
        {
          "word": " did?",
          "start": 2920.82,
          "end": 2920.82,
          "speaker": "A woman"
        },
        {
          "word": " Dr.",
          "start": 2920.82,
          "end": 2920.82,
          "speaker": "A woman"
        },
        {
          "word": " Khalifa:",
