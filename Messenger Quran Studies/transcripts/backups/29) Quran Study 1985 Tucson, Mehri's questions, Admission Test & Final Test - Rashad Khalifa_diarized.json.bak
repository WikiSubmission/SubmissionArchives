          "end": 2380.88,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " different.",
          "start": 2380.88,
          "end": 2380.88,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Every group of them, they want some name besides God, they are happy.",
      "start": 2380.88,
      "end": 2384.88,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Every",
