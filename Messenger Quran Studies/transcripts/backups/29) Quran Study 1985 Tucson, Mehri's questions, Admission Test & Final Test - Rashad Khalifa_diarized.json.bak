    },
    {
      "text": "When God alone is called upon, you refuse.",
      "start": 2340.12,
      "end": 2362.36,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " When",
          "start": 2340.12,
          "end": 2340.12,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 2351.69,
          "end": 2353.84,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone",
          "start": 2353.84,
          "end": 2354.7,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 2354.7,
          "end": 2355.96,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " called",
