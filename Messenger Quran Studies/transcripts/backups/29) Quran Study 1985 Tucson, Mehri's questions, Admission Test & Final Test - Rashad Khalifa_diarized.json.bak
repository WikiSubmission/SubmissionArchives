          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, God said,",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " issue.",
          "start": 3478.78,
