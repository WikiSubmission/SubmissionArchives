          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " have",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "\"And it's hard to choose.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "A woman",
      "words": [
        {
          "word": " God.",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " \"And",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " it's",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " hard",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " to",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "\"So, why do we call God is justice?",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "A woman",
      "words": [
        {
          "word": " choose.",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " \"So,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " why",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " do",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " we",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " call",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " God",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " is",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "That's a very good question.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " justice?",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " That's",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " very",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " good",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And it is perfectly...",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " question.",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " And",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "The rule is that God does not inflict an atom's weight of injustice.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " perfectly...",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " The",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " rule",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that",
