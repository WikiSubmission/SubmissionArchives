          "word": " else,",
          "start": 2368.9,
          "end": 2369.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " anybody",
          "start": 2369.9,
          "end": 2370.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " else,",
          "start": 2370.2,
          "end": 2370.3,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " then",
          "start": 2370.68,
          "end": 2370.68,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you're",
          "start": 2370.68,
          "end": 2370.68,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " happy.",
          "start": 2370.68,
          "end": 2370.68,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You know, different people.",
      "start": 2372.02,
      "end": 2372.44,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 2372.02,
          "end": 2372.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " know,",
          "start": 2372.32,
          "end": 2372.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " different",
          "start": 2372.44,
          "end": 2372.44,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " people.",
          "start": 2372.44,
          "end": 2372.44,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You know, with the Jews, it's different. The Christians are different. With the Sunnis, it's different. With the Shias, it's different.",
