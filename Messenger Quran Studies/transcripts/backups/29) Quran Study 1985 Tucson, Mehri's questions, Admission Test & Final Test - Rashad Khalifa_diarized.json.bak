        },
        {
          "word": " \"no,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muhammad",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " was",
          "start": 3478.78,
          "end": 3478.78,
