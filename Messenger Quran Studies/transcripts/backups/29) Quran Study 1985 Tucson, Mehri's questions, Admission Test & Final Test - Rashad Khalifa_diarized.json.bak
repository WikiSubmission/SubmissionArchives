          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"And if you make it, you come back here.\"",
      "start": 1816.72,
      "end": 1822.72,
      "speaker": "Dr. Khalifa",
      "words": [
        {
