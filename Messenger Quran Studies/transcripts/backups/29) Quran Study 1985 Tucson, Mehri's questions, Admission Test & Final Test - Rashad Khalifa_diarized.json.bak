          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " father,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " there",
          "start": 3478.78,
