          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " here",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sheikh",
