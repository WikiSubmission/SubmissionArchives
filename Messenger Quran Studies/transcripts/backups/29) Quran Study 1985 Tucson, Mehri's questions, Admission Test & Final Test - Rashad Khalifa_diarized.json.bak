          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And what was that? Dr. Khalifa: Ok.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "A woman",
      "words": [
        {
