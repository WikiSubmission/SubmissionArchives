        },
        {
          "word": " \u062e\u0627\u062a\u0645",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This is... okay, he is \u062e\u0627\u062a\u0645 \u0627\u0644\u0646\u0628\u06cc\u06cc\u0646",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
