          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " sacred.\"",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " A",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " woman:",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Now, the angels... when the angels said this, they were not accurate.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Exactly.",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Now,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " angels...",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
