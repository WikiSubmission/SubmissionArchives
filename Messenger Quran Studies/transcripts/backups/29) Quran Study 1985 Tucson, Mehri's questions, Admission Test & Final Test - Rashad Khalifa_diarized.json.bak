        },
        {
          "word": " he",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " repented",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "Of course.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
