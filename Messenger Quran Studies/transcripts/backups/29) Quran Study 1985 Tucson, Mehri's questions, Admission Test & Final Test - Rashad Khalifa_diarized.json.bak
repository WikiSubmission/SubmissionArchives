        },
        {
          "word": " Sheytan",
          "start": 1264.64,
          "end": 1264.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " refused,",
          "start": 1264.86,
          "end": 1265.3,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 1266.14,
          "end": 1266.18,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 1266.18,
          "end": 1268.52,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " angels...",
          "start": 1268.52,
          "end": 1269.6,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Now in the movie that I wrote, the script, all the angels are falling prostrate before Adam,",
