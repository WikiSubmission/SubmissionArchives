    },
    {
      "text": "You say \"La Elaha Ella Allah.\"",
      "start": 2385.04,
      "end": 2388.46,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 2385.04,
          "end": 2385.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " say",
          "start": 2385.04,
          "end": 2385.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"La",
          "start": 2385.06,
          "end": 2387.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Elaha",
          "start": 2387.76,
          "end": 2387.76,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Ella",
