          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " He",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " just",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " can't",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " help",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"There are too many people\", you know.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " it.\"",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"There",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " too",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " many",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " people\",",
