        },
        {
          "word": " want",
          "start": 1258.4,
          "end": 1258.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 1258.86,
          "end": 1259.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " make",
