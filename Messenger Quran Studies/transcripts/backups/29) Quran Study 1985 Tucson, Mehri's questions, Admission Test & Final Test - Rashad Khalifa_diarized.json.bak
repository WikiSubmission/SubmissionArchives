          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And Some angels did? Dr. Khalifa: Yes.",
      "start": 2920.82,
      "end": 2941.4,
      "speaker": "A woman",
      "words": [
        {
          "word": " And",
          "start": 2920.82,
          "end": 2920.82,
          "speaker": "A woman"
        },
        {
          "word": " Some",
