          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(12:106) \u0648\u064e\u0645\u064e\u0627 \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0623\u064e\u0643\u0652\u062b\u064e\u0631\u064f\u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0648\u064e\u0647\u064f\u0645 \u0645\u0651\u064f\u0634\u0652\u0631\u0650\u0643\u064f\u0648\u0646\u064e",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
