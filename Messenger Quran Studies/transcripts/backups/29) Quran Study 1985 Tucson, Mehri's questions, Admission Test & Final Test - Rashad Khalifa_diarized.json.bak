          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I wish.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "A woman",
      "words": [
        {
          "word": " Friday.",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " I",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "I was bragging about everybody in this mosque,",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " wish.",
