          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you're",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " praying,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
