      ]
    },
    {
      "text": "Except with other names with Allah.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \u0645\u0651\u064f\u0634\u0652\u0631\u0650\u0643\u064f\u0648\u0646\u064e",
