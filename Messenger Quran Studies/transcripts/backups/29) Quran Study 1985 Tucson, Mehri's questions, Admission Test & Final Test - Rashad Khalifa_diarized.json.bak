          "word": " \u0633\u06cc\u062f\u0646\u0627",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\u0648\u0639\u0644\u0649 \u0622\u0644\u0647 \u0648\u0635\u062d\u0628\u0647 \u0623\u062c\u0645\u0639\u064a\u0646",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
