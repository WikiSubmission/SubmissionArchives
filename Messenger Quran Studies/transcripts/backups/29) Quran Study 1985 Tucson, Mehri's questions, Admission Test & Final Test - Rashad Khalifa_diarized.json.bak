          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"And what you were hiding.\"",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
