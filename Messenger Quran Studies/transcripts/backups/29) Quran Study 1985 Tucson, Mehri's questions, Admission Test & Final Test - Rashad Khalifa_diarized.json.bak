          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It says in Quran.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "A woman",
      "words": [
        {
          "word": " Quran.",
          "start": 3478.78,
          "end": 3478.78,
