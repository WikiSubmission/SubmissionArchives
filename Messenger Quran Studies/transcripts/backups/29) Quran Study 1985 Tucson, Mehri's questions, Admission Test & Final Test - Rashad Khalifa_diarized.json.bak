          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(93:7) \u0648\u064e\u0648\u064e\u062c\u064e\u062f\u064e\u0643\u064e \u0636\u064e\u0627\u0653\u0644\u0651\u064b\u06ed\u0627 \u0641\u064e\u0647\u064e\u062f\u064e\u0649\u0670",
      "start": 3478.78,
