          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, to every person, this life is all for a test.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You.\"",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " So,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " every",
          "start": 3478.78,
