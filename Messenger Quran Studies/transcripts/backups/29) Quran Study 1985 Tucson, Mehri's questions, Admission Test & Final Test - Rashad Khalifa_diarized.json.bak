        },
        {
          "word": " Your",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\u0648\u064e\u0646\u064f\u0642\u064e\u062f\u0651\u0650\u0633\u064f \u0644\u064e\u0643\u064e",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Glory,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0648\u064e\u0646\u064f\u0642\u064e\u062f\u0651\u0650\u0633\u064f",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"and we hold You sacred.\" A woman: Exactly.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \u0644\u064e\u0643\u064e",
