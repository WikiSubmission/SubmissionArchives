          "speaker": "Dr. Khalifa"
        },
        {
          "word": " You",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " see,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " because",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " know",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " what",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They said,",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " said?",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " They",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\u0623\u064e\u062a\u064e\u062c\u0652\u0639\u064e\u0644\u064f \u0641\u0650\u064a\u0647\u064e\u0627 \u0645\u064e\u0646 \u064a\u064f\u0641\u0652\u0633\u0650\u062f\u064f \u0641\u0650\u064a\u0647\u064e\u0627 \u0648\u064e\u064a\u064e\u0633\u0652\u0641\u0650\u0643\u064f \u0671\u0644\u062f\u0651\u0650\u0645\u064e\u0627\u0653\u0621\u064e \u0648\u064e\u0646\u064e\u062d\u0652\u0646\u064f \u0646\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f  (2:30) \u0628\u0650\u062d\u064e\u0645\u0652\u062f\u0650\u0643\u064e \u0648\u064e\u0646\u064f\u0642\u064e\u062f\u0651\u0650\u0633\u064f \u0644\u064e\u0643\u064e",
      "start": 3478.78,
