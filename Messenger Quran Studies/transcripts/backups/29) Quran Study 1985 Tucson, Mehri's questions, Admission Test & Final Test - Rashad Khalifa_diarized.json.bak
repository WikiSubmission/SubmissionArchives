          "word": " couldn't.",
          "start": 1258.28,
          "end": 1258.4,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He didn't want to make Sujud.",
      "start": 1258.4,
      "end": 1259.28,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " He",
          "start": 1258.4,
          "end": 1258.4,
