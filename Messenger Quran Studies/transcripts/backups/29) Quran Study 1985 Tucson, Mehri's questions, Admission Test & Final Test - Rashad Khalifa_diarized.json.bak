          "speaker": "Dr. Khalifa"
        },
        {
          "word": " just...\"",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " because",
          "start": 3478.78,
