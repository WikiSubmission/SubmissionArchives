          "start": 1754.9,
          "end": 1755.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 1757.08,
          "end": 1759.34,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " repented.",
          "start": 1759.34,
          "end": 1760.94,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They asked God forgiveness and they made Tawbah.",
      "start": 1760.94,
      "end": 1766.34,
      "speaker": "Dr. Khalifa",
      "words": [
