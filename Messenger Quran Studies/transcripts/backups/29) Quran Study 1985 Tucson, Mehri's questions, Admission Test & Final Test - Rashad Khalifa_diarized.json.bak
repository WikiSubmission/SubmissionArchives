          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\"La Elaha Ella Allah, Muhammad Rasul Allah.\"",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
