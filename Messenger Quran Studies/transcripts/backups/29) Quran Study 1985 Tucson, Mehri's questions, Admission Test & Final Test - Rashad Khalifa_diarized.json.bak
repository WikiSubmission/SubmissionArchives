          "speaker": "Dr. Khalifa"
        },
        {
          "word": " will",
          "start": 1132.1,
          "end": 1132.1,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 1132.1,
          "end": 1132.1,
