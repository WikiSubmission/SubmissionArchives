          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Hawa",
          "start": 3118.32,
          "end": 3118.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " (Eve)",
          "start": 3118.32,
          "end": 3118.32,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " were",
