          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Okay.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " right.",
