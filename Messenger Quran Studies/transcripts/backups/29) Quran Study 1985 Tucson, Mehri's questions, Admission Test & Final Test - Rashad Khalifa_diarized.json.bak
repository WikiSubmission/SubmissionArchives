          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "(2:30) \u0625\u0650\u0646\u0651\u0650\u0649\u0653 \u0623\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e",
