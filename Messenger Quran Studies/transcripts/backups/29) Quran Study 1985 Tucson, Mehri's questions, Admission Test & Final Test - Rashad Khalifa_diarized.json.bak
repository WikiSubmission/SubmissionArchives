          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sha'rawi",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\u0627\u0634\u0631\u0641 \u0627\u0644\u0645\u0631\u0633\u0644\u06cc\u0646 \u0648 \u062e\u0627\u062a\u0645 \u0627\u0644\u0646\u0628\u06cc\u06cc\u0646",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " saying,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0627\u0634\u0631\u0641",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0627\u0644\u0645\u0631\u0633\u0644\u06cc\u0646",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0648",
          "start": 3478.78,
          "end": 3478.78,
