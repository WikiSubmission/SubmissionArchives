          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " And",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " turn",
          "start": 3478.78,
          "end": 3478.78,
