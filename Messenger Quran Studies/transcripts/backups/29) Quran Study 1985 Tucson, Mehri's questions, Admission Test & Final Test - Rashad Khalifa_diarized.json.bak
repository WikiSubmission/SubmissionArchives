          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Because",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " every",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " action",
          "start": 3478.78,
