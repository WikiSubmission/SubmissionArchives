          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Where are you going?",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Okay.",
          "start": 3478.78,
          "end": 3478.78,
