          "speaker": "Dr. Khalifa"
        },
        {
          "word": " rasulullah.\"",
          "start": 2390.02,
          "end": 2390.38,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You say \"I don't wanna...\"",
