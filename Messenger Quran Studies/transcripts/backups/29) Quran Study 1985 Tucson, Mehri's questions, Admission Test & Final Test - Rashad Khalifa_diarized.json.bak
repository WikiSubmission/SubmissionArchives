          "speaker": "Dr. Khalifa"
        },
        {
          "word": " cannot",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " touch",
          "start": 3478.78,
