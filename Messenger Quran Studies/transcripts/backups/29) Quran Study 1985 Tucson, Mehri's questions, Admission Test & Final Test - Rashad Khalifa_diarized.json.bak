          "end": 2358.84,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " refuse.",
          "start": 2360.42,
          "end": 2362.36,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But when God and somebody else, anybody else, then you're happy.",
      "start": 2362.88,
      "end": 2370.68,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " But",
          "start": 2362.88,
          "end": 2363.94,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " when",
          "start": 2365.02,
          "end": 2365.3,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 2365.3,
          "end": 2365.48,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 2365.48,
