          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Yes.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "A woman",
      "words": [
        {
          "word": " \u0628\u0650\u062d\u064e\u0645\u0652\u062f\u0650\u0643\u064e",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "\"we glorify You, we praise Your Glory,",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Yes.",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"we",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " glorify",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " You,",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
