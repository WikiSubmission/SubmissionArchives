          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0633\u06cc\u062f\u0646\u0627",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " our",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "\u0633\u06cc\u062f\u0646\u0627 \u0645\u062d\u0645\u062f",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " master",
