          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sheikh",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And this is how he begins his speeches.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
