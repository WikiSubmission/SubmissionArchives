        },
        {
          "word": " is",
          "start": 768.81,
          "end": 768.81,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 768.81,
          "end": 768.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " an",
