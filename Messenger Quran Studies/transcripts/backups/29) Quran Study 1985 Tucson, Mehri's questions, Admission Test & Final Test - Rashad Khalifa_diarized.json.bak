        },
        {
          "word": " Why",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " it",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because God said \"I do not forgive the idol worshipper.\"",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " wrong?",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Because",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"I",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " do",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " forgive",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " idol",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And you turn around and you say \"please God, forgive this idol worshipper.\"",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " worshipper.\"",
