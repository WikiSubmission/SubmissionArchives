          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " what",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " was",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " that?",
