          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " we",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " have",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
