          "speaker": "Dr. Khalifa"
        },
        {
          "word": " so",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I have a question which they ask me all the time.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "A woman",
      "words": [
        {
          "word": " forth.",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " I",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " have",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " a",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "A woman"
        },
        {
          "word": " question",
