          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Every",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " single",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
