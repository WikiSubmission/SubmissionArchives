        }
      ]
    },
    {
      "text": "\u0648\u064e\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u0652 \u062a\u064e\u0643\u0652\u062a\u064f\u0645\u064f\u0648\u0646\u064e",
