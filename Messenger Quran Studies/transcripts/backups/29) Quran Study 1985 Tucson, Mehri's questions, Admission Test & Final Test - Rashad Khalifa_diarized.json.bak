          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "the Prophet, you cannot accuse me of being Mushrik, of putting something besides Allah.",
      "start": 3478.78,
      "end": 3478.78,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " disrespecting",
