          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \u0625\u0650\u0644\u0651\u064e\u0627",
          "start": 3478.78,
          "end": 3478.78,
          "speaker": "Dr. Khalifa"
        },
