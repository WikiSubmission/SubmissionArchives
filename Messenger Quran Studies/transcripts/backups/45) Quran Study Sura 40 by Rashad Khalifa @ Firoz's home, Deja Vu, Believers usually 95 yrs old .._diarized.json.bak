        },
        {
          "word": "lie",
          "start": 450.013,
          "end": 450.435,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "after",
          "start": 450.435,
          "end": 450.856,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "lie",
          "start": 450.856,
          "end": 451.278,
