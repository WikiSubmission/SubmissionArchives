        },
        {
          "word": "up",
          "start": 447.145,
          "end": 447.395,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "with.",
          "start": 447.395,
          "end": 447.645,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Lie after lie after lie after lie.",
