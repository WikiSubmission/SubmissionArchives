          "end": 443.245,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "falsehood.",
          "start": 443.245,
          "end": 443.645,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's amazing the things they come up with.",
      "start": 445.645,
      "end": 447.645,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "It's",
          "start": 445.645,
          "end": 445.895,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "amazing",
          "start": 445.895,
          "end": 446.145,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "the",
          "start": 446.145,
          "end": 446.395,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "things",
          "start": 446.395,
          "end": 446.645,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "they",
          "start": 446.645,
          "end": 446.895,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "come",
          "start": 446.895,
          "end": 447.145,
