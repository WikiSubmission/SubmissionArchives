        },
        {
          "word": "God",
          "start": 2315.679,
          "end": 2316.076,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "is",
          "start": 2316.076,
          "end": 2316.472,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "generous.",
