          "end": 3013.202,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And they refuse.",
      "start": 3014.113,
      "end": 3015.445,
      "speaker": "Dr. Khalifa",
      "words": [
