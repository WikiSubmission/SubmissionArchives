          "end": 4738.572,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "example,",
          "start": 4738.572,
          "end": 4738.842,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 4738.842,
          "end": 4739.111,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Wudu,",
          "start": 4739.111,
          "end": 4739.381,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "God",
          "start": 4739.381,
