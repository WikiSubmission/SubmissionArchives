          "speaker": "Dr. Khalifa"
        },
        {
          "word": "gave",
          "start": 4739.65,
          "end": 4739.92,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "us",
          "start": 4739.92,
          "end": 4740.189,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "four",
