          "end": 5269.431,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "'Ale",
          "start": 5269.431,
          "end": 5269.756,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "Muhammad,",
          "start": 5269.756,
