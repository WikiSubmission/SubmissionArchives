        },
        {
          "word": "know,",
          "start": 4825.181,
          "end": 4825.393,
          "speaker": "Ismail Barakat"
        },
        {
          "word": "I'll",
          "start": 4825.393,
          "end": 4825.604,
          "speaker": "Ismail Barakat"
        },
        {
          "word": "tell",
          "start": 4825.604,
          "end": 4825.816,
          "speaker": "Ismail Barakat"
        },
        {
          "word": "you",
