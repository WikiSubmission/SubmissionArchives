      "text": "(unintelligible) \"Now, I know we're in Heaven.\"",
      "start": 3954.909,
      "end": 3957.213,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "(unintelligible)",
          "start": 3954.909,
          "end": 3955.238,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "\"Now,",
          "start": 3955.238,
          "end": 3955.567,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "I",
          "start": 3955.567,
          "end": 3955.896,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "know",
          "start": 3955.896,
          "end": 3956.226,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "we're",
          "start": 3956.226,
          "end": 3956.555,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "in",
          "start": 3956.555,
