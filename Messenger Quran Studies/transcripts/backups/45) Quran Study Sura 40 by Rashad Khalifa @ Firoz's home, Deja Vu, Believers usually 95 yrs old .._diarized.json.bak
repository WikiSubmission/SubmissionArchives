          "end": 5272.03,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We find out in the Quran, God says \"don't mention anybody's name except the name of God.\"",
      "start": 5272.372,
      "end": 5276.651,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": "We",
          "start": 5272.372,
          "end": 5272.624,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": "find",
          "start": 5272.624,
