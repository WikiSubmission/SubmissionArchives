          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "Your soul is growing too fast.",
      "start": 4744.99,
      "end": 4744.99,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " think...",
          "start": 4744.99,
