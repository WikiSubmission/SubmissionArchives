          "speaker": "Dr. Khalifa"
        },
        {
          "word": " any",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Not sure you'd notice.",
      "start": 4744.99,
      "end": 4744.99,
      "speaker": "Catherine",
      "words": [
        {
          "word": " case...",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        },
        {
          "word": " Not",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        },
        {
          "word": " sure",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        },
        {
          "word": " you'd",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "In any case, this is a really good metaphor for what will happen.",
