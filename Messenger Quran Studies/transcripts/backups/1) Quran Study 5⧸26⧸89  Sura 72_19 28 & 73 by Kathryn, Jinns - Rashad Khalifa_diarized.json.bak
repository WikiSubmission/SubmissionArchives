          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Your",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " soul",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " growing",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " too",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I hope so. I desperately hope so.",
      "start": 4744.99,
      "end": 4744.99,
      "speaker": "Catherine",
      "words": [
        {
          "word": " fast.",
          "start": 4744.99,
