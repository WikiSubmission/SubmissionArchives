    },
    {
      "text": "\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0636\u0652\u062d\u064e\u0643\u064e \u0648\u064e\u0623\u064e\u0628\u0652\u0643\u064e\u0649\u0670 (53:43)",
