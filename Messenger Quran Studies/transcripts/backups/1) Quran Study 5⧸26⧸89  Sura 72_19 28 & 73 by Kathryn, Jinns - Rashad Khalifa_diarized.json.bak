          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " like",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " weightless.",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Catherine:",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Dr. Khalifa"
        },
