          "word": " I",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        },
        {
          "word": " hope",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        },
        {
          "word": " so.",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        },
        {
          "word": " I",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        },
        {
          "word": " desperately",
