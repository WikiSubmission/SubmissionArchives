        },
        {
          "word": " hope",
          "start": 4744.99,
          "end": 4744.99,
          "speaker": "Catherine"
        }
      ]
    },
    {
      "text": "You're like weightless. Catherine: In any case...",
      "start": 4744.99,
      "end": 4744.99,
      "speaker": "Dr. Khalifa",
      "words": [
