          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 3555.59,
          "end": 3555.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " apply",
          "start": 3555.75,
          "end": 3556.09,
