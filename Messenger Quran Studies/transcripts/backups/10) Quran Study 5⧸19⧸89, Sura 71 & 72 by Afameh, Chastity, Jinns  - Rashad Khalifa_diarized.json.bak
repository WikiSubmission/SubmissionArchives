          "speaker": "Apamea"
        },
        {
          "word": " the",
          "start": 2993.61,
          "end": 2993.61,
          "speaker": "Apamea"
        },
        {
          "word": " Mohammedans,",
          "start": 2993.61,
          "end": 2994.53,
          "speaker": "Apamea"
        },
        {
          "word": " we",
          "start": 2994.61,
          "end": 2994.61,
          "speaker": "Apamea"
        },
        {
          "word": " know.",
          "start": 2994.61,
          "end": 2995.23,
          "speaker": "Apamea"
        }
      ]
    },
    {
