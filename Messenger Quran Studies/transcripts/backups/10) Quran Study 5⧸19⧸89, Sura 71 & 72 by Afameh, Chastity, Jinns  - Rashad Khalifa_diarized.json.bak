        }
      ]
    },
    {
      "text": "I can't afford to be subtle about it anymore.",
      "start": 3543.91,
      "end": 3546.63,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I",
          "start": 3543.91,
