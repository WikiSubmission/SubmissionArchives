        {
          "word": " gives",
          "start": 2777.43,
          "end": 2777.69,
          "speaker": "Apamea"
        },
        {
          "word": " life.",
          "start": 2777.69,
          "end": 2778.34,
          "speaker": "Apamea"
        },
        {
          "word": " Water",
          "start": 2778.69,
          "end": 2778.69,
