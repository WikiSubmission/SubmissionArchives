          "end": 3549.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3549.65,
          "end": 3549.77,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " prophet",
          "start": 3549.77,
          "end": 3549.97,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muhammad's",
          "start": 3549.97,
          "end": 3550.59,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " time.",
          "start": 3550.59,
          "end": 3551.24,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Did you know that?",
      "start": 3552.01,
      "end": 3552.66,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Did",
          "start": 3552.01,
          "end": 3552.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 3552.15,
          "end": 3552.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " know",
          "start": 3552.21,
          "end": 3552.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that?",
          "start": 3552.31,
          "end": 3552.66,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Therefore, this does not apply to that time.",
      "start": 3554.63,
      "end": 3557.23,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Therefore,",
