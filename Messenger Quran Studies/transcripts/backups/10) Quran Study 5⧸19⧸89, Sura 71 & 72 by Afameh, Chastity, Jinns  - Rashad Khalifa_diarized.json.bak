          "speaker": "Apamea"
        },
        {
          "word": " problems",
          "start": 2625.47,
          "end": 2625.89,
          "speaker": "Apamea"
        },
        {
          "word": " happened",
          "start": 2625.89,
          "end": 2626.89,
          "speaker": "Apamea"
        },
        {
          "word": " with",
          "start": 2626.89,
          "end": 2627.13,
          "speaker": "Apamea"
        },
