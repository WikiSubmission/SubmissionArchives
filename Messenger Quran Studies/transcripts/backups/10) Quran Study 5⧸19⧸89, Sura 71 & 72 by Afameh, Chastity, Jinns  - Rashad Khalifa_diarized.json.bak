        }
      ]
    },
    {
      "text": "The Quran did not exist during the prophet Muhammad's time.",
      "start": 3548.29,
      "end": 3551.24,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " The",
          "start": 3548.29,
          "end": 3548.29,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Quran",
          "start": 3548.29,
          "end": 3548.55,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " did",
          "start": 3548.55,
          "end": 3548.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 3548.75,
