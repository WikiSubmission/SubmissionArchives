          "end": 1326.86,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They held it in their hands, in their gloves, excuse me, and they said \"it's quite reflective.\"",
      "start": 1328.01,
      "end": 1333.75,
      "speaker": "Dr. Khalifa",
      "words": [
