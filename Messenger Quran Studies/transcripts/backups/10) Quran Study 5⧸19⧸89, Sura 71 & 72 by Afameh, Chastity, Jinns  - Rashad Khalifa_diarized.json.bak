          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "This Sura has the root name \"Rashada\" four times, more than any other Sura.",
      "start": 3583.75,
      "end": 3587.71,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " This",
          "start": 3583.75,
          "end": 3584.07,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sura",
          "start": 3584.07,
          "end": 3584.37,
          "speaker": "Dr. Khalifa"
