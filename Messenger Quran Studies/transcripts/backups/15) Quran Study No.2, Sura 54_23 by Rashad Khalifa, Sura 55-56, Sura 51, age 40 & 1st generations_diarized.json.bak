        }
      ]
    },
    {
      "text": "[55:41]  The guilty will be recognized by their looks;...",
      "start": 2717.99,
      "end": 2719.75,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " [55:41]",
