          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Allah.\"",
          "start": 3203.95,
          "end": 3205.41,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And guess what they said?",
      "start": 3205.43,
      "end": 3206.48,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 3205.43,
          "end": 3205.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " guess",
          "start": 3205.53,
          "end": 3205.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " what",
          "start": 3205.67,
          "end": 3205.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " they",
          "start": 3205.85,
          "end": 3206.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said?",
          "start": 3206.03,
          "end": 3206.48,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They said \"Tasneem went to the dogs.\"",
      "start": 3206.89,
      "end": 3209.73,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " They",
          "start": 3206.89,
          "end": 3206.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " said",
          "start": 3206.95,
          "end": 3207.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"Tasneem",
          "start": 3207.01,
          "end": 3207.43,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " went",
          "start": 3207.43,
          "end": 3207.55,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3207.55,
          "end": 3207.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3207.75,
          "end": 3207.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " dogs.\"",
          "start": 3207.85,
          "end": 3209.73,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "She's worshiping God alone.",
      "start": 3209.81,
      "end": 3211.63,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " She's",
          "start": 3209.81,
          "end": 3210.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " worshiping",
          "start": 3210.53,
          "end": 3210.97,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 3210.97,
          "end": 3211.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone.",
          "start": 3211.13,
          "end": 3211.63,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I mean, this is ridicule, right? They ridiculed her.",
      "start": 3212.13,
      "end": 3216.11,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " I",
          "start": 3212.13,
          "end": 3212.13,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " mean,",
          "start": 3212.13,
          "end": 3213.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " this",
          "start": 3213.07,
          "end": 3213.09,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is",
          "start": 3213.09,
          "end": 3213.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " ridicule,",
          "start": 3213.17,
          "end": 3213.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " right?",
          "start": 3213.83,
          "end": 3214.47,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " They",
          "start": 3214.49,
          "end": 3214.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " ridiculed",
          "start": 3214.57,
          "end": 3215.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " her.",
          "start": 3215.01,
          "end": 3216.11,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You know, you're saying \"La Elaha Ella Allah.\" You're saying \"worship God alone.\"",
      "start": 3216.97,
      "end": 3220.27,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 3216.97,
          "end": 3217.09,
          "speaker": "Dr. Khalifa"
        },
