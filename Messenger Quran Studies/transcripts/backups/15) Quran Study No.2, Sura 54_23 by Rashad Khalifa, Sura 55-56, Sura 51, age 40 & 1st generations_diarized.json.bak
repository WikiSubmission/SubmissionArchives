          "end": 3031.38,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Now, Muhammad and his company were persecuted severely.",
      "start": 3032.79,
      "end": 3035.53,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Now,",
          "start": 3032.79,
          "end": 3032.79,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muhammad",
          "start": 3033.05,
          "end": 3033.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 3033.05,
          "end": 3033.25,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " his",
          "start": 3033.25,
          "end": 3033.37,
          "speaker": "Dr. Khalifa"
        },
