          "end": 5284.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " But",
          "start": 5285.93,
          "end": 5285.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that's",
          "start": 5285.93,
