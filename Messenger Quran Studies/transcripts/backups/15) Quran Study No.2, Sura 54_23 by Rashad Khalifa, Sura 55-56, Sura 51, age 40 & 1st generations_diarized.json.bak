      "end": 3775.59,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 3774.51,
          "end": 3774.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " hear",
          "start": 3774.57,
          "end": 3774.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " that,",
          "start": 3774.65,
          "end": 3775.01,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Iman?",
          "start": 3775.03,
          "end": 3775.59,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You're asking about Satan and the Hereafter?",
