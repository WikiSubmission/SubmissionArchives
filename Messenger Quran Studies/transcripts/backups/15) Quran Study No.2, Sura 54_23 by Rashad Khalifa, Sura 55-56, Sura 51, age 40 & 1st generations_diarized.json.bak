        },
        {
          "word": " example.",
          "start": 3402.33,
          "end": 3402.93,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "Muhtesem went to a grocery store to buy some Middle Eastern stuff.",
      "start": 3403.15,
      "end": 3406.44,
      "speaker": "A woman",
      "words": [
        {
          "word": " Muhtesem",
          "start": 3403.15,
          "end": 3403.49,
          "speaker": "A woman"
        },
        {
          "word": " went",
          "start": 3403.49,
          "end": 3403.63,
          "speaker": "A woman"
        },
        {
          "word": " to",
          "start": 3403.63,
          "end": 3403.87,
          "speaker": "A woman"
        },
        {
          "word": " a",
