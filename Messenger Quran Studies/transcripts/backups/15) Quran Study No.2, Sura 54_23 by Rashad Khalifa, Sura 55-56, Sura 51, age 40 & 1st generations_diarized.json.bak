          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "You think this shook Mahmood?",
      "start": 3394.61,
      "end": 3395.79,
      "speaker": "A woman",
      "words": [
        {
          "word": " You",
          "start": 3394.61,
          "end": 3394.75,
          "speaker": "A woman"
        },
        {
          "word": " think",
          "start": 3394.75,
          "end": 3394.89,
          "speaker": "A woman"
        },
        {
          "word": " this",
          "start": 3394.89,
          "end": 3395.09,
          "speaker": "A woman"
        },
        {
          "word": " shook",
          "start": 3395.09,
          "end": 3395.29,
          "speaker": "A woman"
        },
        {
          "word": " Mahmood?",
          "start": 3395.29,
          "end": 3395.79,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "Not one hair.",
      "start": 3397.39,
      "end": 3398.59,
      "speaker": "A woman",
      "words": [
        {
          "word": " Not",
          "start": 3397.39,
          "end": 3397.67,
          "speaker": "A woman"
        },
        {
          "word": " one",
          "start": 3397.67,
          "end": 3397.89,
          "speaker": "A woman"
        },
        {
          "word": " hair.",
          "start": 3397.89,
          "end": 3398.59,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "And this is why he is very special.",
      "start": 3399.43,
      "end": 3400.42,
      "speaker": "A woman",
      "words": [
        {
          "word": " And",
          "start": 3399.43,
