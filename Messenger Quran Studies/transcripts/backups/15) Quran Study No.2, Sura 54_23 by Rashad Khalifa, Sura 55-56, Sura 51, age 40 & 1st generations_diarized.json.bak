        },
        {
          "word": " people",
          "start": 4481.69,
          "end": 4481.97,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " with",
          "start": 4481.97,
          "end": 4482.25,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " him.",
          "start": 4482.25,
          "end": 4482.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Those",
          "start": 4482.69,
          "end": 4482.69,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
          "start": 4482.69,
          "end": 4482.85,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Those are very special people. This is the first generation.",
