          "speaker": "Dr. Khalifa"
        },
        {
          "word": " undeveloped,",
          "start": 2732.77,
          "end": 2733.51,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " aborted.",
          "start": 2734.37,
          "end": 2735.47,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "But they'll be alive. They will (unintelligible).",
      "start": 2736.15,
      "end": 2738.05,
      "speaker": "Dr. Khalifa",
      "words": [
