          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 5031.05,
          "end": 5031.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 5031.21,
          "end": 5031.39,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " closed",
