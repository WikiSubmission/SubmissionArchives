          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, 41,",
      "start": 2716.11,
      "end": 2717.87,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " So,",
