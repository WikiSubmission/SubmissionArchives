          "speaker": "Dr. Khalifa"
        },
        {
          "word": " deep,",
          "start": 3772.21,
          "end": 3772.81,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " deep",
          "start": 3772.89,
          "end": 3772.97,
