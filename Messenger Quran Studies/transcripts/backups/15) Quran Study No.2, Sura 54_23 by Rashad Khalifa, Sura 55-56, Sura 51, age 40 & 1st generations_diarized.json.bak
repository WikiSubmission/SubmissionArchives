    },
    {
      "text": "(12:24) \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0645\u0650\u0646\u0652 \u0639\u0650\u0628\u064e\u0627\u062f\u0650\u0646\u064e\u0627 \u0671\u0644\u0652\u0645\u064f\u062e\u0652\u0644\u064e\u0635\u0650\u064a\u0646\u064e",
