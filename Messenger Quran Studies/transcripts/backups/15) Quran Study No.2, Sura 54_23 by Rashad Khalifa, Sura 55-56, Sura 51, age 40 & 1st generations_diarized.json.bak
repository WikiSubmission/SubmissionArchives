          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And he was secretly preaching.",
      "start": 4479.55,
      "end": 4481.61,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " was",
          "start": 4479.55,
