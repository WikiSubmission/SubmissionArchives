    {
      "text": "And she told them \"I'm devoting myself to God alone. I only say \"La Elaha Ella Allah.\"",
      "start": 3200.33,
      "end": 3205.41,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 3200.33,
          "end": 3200.47,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " she",
          "start": 3200.47,
          "end": 3200.65,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " told",
          "start": 3200.65,
          "end": 3200.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " them",
          "start": 3200.83,
          "end": 3201.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"I'm",
          "start": 3201.11,
          "end": 3201.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " devoting",
          "start": 3201.45,
          "end": 3201.79,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " myself",
          "start": 3201.79,
          "end": 3202.07,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3202.07,
          "end": 3202.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 3202.31,
          "end": 3202.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " alone.",
          "start": 3202.49,
          "end": 3202.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " I",
          "start": 3203.03,
          "end": 3203.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " only",
          "start": 3203.03,
          "end": 3203.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " say",
          "start": 3203.23,
          "end": 3203.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"La",
          "start": 3203.41,
          "end": 3203.57,
          "speaker": "Dr. Khalifa"
        },
