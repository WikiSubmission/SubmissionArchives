          "end": 5000.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " White,",
          "start": 5000.15,
          "end": 5000.71,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Ed White, Gus Grissom, and Roger Chaffee.",
