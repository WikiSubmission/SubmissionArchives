          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 3778.39,
          "end": 3778.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 3778.53,
          "end": 3778.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Heaven,",
