          "end": 5018.05,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " organic,",
          "start": 5018.05,
          "end": 5018.41,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Everything organic, that is.",
      "start": 5018.41,
      "end": 5022.21,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " that",
          "start": 5018.41,
          "end": 5018.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " is.",
          "start": 5018.67,
          "end": 5019.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " In",
