          "speaker": "Dr. Khalifa"
        },
        {
          "word": " will",
          "start": 3584.55,
          "end": 3584.67,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 3584.67,
          "end": 3584.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " following",
