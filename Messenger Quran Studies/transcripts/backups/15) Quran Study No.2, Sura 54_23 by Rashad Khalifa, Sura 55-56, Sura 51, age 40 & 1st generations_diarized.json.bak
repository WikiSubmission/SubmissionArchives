          "speaker": "Dr. Khalifa"
        },
        {
          "word": " have",
          "start": 1388.23,
          "end": 1388.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " some",
          "start": 1388.23,
          "end": 1388.23,
          "speaker": "Dr. Khalifa"
        },
