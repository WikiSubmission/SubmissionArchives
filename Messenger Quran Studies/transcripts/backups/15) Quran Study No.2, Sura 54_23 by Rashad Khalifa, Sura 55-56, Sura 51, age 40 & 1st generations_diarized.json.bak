          "end": 5030.03,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " You",
          "start": 5030.73,
          "end": 5030.77,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " put",
          "start": 5030.77,
          "end": 5030.91,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You put it in a closed thing there. You fill it with 100% oxygen.",
      "start": 5030.91,
      "end": 5036.39,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " it",
          "start": 5030.91,
