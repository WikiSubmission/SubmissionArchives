          "speaker": "Dr. Khalifa"
        },
        {
          "word": " looks;...",
          "start": 2719.25,
          "end": 2719.75,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They'll be undeveloped. They'll be shrunken.",
      "start": 2721.11,
      "end": 2722.35,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " They'll",
          "start": 2721.11,
          "end": 2721.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 2721.11,
          "end": 2721.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " undeveloped.",
          "start": 2721.21,
          "end": 2721.46,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " They'll",
          "start": 2722.07,
          "end": 2722.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 2722.15,
          "end": 2722.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " shrunken.",
          "start": 2722.15,
          "end": 2722.35,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It's like being born without arms and legs, deformed.",
      "start": 2723.99,
      "end": 2729.03,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " It's",
