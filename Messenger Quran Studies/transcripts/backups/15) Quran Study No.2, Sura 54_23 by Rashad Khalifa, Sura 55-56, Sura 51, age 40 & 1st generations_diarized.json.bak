          "end": 5003.97,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " not",
          "start": 5003.97,
          "end": 5004.09,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They're not with us today because of that.",
