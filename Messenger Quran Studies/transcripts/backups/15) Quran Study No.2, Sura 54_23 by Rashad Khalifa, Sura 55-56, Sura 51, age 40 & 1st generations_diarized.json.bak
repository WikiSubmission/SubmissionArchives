          "end": 5290.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " your",
          "start": 5290.53,
          "end": 5290.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " only",
          "start": 5290.75,
          "end": 5290.99,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " son,",
          "start": 5290.99,
          "end": 5291.49,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Isaac,....\"",
          "start": 5291.83,
          "end": 5292.55,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " So,",
