        },
        {
          "word": " Heaven.",
          "start": 2759.03,
          "end": 2759.53,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They'll find it worse than Hell, because they do not stand to come any closer to God.",
      "start": 2761.29,
      "end": 2768.19,
      "speaker": "Dr. Khalifa",
      "words": [
