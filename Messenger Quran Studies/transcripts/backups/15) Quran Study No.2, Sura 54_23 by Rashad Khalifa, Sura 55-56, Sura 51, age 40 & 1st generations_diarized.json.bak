        },
        {
          "word": " is",
          "start": 2694.55,
          "end": 2694.71,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " so",
          "start": 2694.71,
          "end": 2694.85,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " obvious.",
          "start": 2694.85,
          "end": 2695.25,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "There'll be no question.",
      "start": 2697.27,
      "end": 2697.97,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " There'll",
          "start": 2697.27,
          "end": 2697.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 2697.41,
          "end": 2697.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " no",
          "start": 2697.41,
          "end": 2697.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " question.",
          "start": 2697.57,
          "end": 2697.97,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Also in Sura 17, we're told that everybody will be the judge for him or herself for the sins.",
