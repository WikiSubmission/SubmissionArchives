          "end": 3776.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Satan",
          "start": 3776.17,
          "end": 3776.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 3776.45,
          "end": 3777.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 3777.45,
          "end": 3777.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Hereafter?",
          "start": 3777.53,
          "end": 3778.03,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "He will not be in Heaven, no.",
      "start": 3778.17,
      "end": 3779.42,
      "speaker": "Dr. Khalifa",
