          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They will sneak into the Lower Heaven.",
      "start": 2757.97,
      "end": 2759.53,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " They",
          "start": 2757.97,
