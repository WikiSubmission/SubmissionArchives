          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Hell.",
          "start": 3773.15,
          "end": 3773.6,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You hear that, Iman?",
