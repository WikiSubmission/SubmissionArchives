          "speaker": "Dr. Khalifa"
        },
        {
          "word": " right",
          "start": 5253.33,
          "end": 5253.59,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " there.",
          "start": 5253.71,
          "end": 5254.21,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " This",
