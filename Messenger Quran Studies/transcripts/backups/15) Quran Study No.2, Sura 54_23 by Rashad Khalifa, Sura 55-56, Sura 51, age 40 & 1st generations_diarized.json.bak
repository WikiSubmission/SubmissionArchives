          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "He knows they're ignorant.",
      "start": 3443.17,
      "end": 3444.03,
      "speaker": "A woman",
      "words": [
        {
          "word": " He",
          "start": 3443.17,
