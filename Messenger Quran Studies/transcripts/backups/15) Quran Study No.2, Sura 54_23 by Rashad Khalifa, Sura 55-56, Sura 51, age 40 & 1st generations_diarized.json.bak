          "end": 3030.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " So,",
          "start": 3030.75,
          "end": 3030.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " what",
          "start": 3030.93,
