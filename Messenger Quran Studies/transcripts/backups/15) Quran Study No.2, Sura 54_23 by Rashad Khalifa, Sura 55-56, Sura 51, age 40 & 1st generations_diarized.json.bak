          "speaker": "Dr. Khalifa"
        },
        {
          "word": " boo-boo",
          "start": 5294.09,
          "end": 5294.31,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " there,",
          "start": 5294.31,
          "end": 5294.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " because",
