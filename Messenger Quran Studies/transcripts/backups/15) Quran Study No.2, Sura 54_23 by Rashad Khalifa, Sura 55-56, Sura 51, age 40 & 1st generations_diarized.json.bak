          "end": 2724.11,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " like",
          "start": 2724.11,
          "end": 2724.15,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " being",
          "start": 2724.15,
          "end": 2724.57,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " born",
          "start": 2724.57,
          "end": 2724.87,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " without",
          "start": 2724.87,
          "end": 2725.27,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " arms",
          "start": 2725.27,
          "end": 2725.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " and",
          "start": 2725.75,
          "end": 2725.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " legs,",
          "start": 2725.93,
          "end": 2726.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " deformed.",
          "start": 2727.65,
          "end": 2729.03,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They will be born into the Hereafter deformed, undeveloped, aborted.",
      "start": 2729.09,
      "end": 2735.47,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " They",
          "start": 2729.09,
          "end": 2729.17,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " will",
          "start": 2729.17,
          "end": 2729.27,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " be",
          "start": 2729.27,
          "end": 2729.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " born",
          "start": 2729.45,
          "end": 2729.75,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " into",
          "start": 2729.75,
          "end": 2730.27,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
          "start": 2730.27,
          "end": 2730.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Hereafter",
          "start": 2730.45,
          "end": 2730.93,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " deformed,",
