          "end": 3405.49,
          "speaker": "A woman"
        },
        {
          "word": " Eastern",
          "start": 3405.49,
          "end": 3405.79,
          "speaker": "A woman"
        },
        {
          "word": " stuff.",
          "start": 3405.79,
          "end": 3406.44,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "And he met some Arabs there.",
      "start": 3407.63,
      "end": 3411.04,
      "speaker": "A woman",
      "words": [
        {
          "word": " And",
          "start": 3407.63,
          "end": 3407.83,
          "speaker": "A woman"
        },
        {
          "word": " he",
          "start": 3407.83,
          "end": 3408.33,
          "speaker": "A woman"
        },
        {
          "word": " met",
          "start": 3408.33,
          "end": 3408.53,
          "speaker": "A woman"
        },
        {
          "word": " some",
          "start": 3408.53,
          "end": 3408.87,
          "speaker": "A woman"
        },
        {
          "word": " Arabs",
          "start": 3408.87,
          "end": 3409.79,
          "speaker": "A woman"
        },
        {
          "word": " there.",
          "start": 3409.79,
          "end": 3411.04,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "They're just totally ignorant. They know nothing.",
      "start": 3412.73,
      "end": 3414.78,
      "speaker": "A woman",
      "words": [
        {
          "word": " They're",
          "start": 3412.73,
          "end": 3413.05,
          "speaker": "A woman"
        },
        {
          "word": " just",
          "start": 3413.05,
          "end": 3413.25,
          "speaker": "A woman"
        },
        {
          "word": " totally",
          "start": 3413.25,
          "end": 3413.87,
          "speaker": "A woman"
        },
        {
          "word": " ignorant.",
          "start": 3413.87,
          "end": 3414.51,
          "speaker": "A woman"
        },
        {
          "word": " They",
          "start": 3414.51,
          "end": 3414.57,
          "speaker": "A woman"
        },
        {
          "word": " know",
          "start": 3414.57,
          "end": 3414.63,
          "speaker": "A woman"
        },
        {
          "word": " nothing.",
          "start": 3414.63,
          "end": 3414.78,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "But he says \"yes, we saw too much in Tucson. We worship God alone.\"",
      "start": 3415.87,
      "end": 3420.81,
      "speaker": "A woman",
      "words": [
        {
          "word": " But",
          "start": 3415.87,
          "end": 3415.95,
          "speaker": "A woman"
        },
        {
          "word": " he",
          "start": 3415.95,
          "end": 3416.65,
          "speaker": "A woman"
        },
        {
          "word": " says",
          "start": 3416.65,
          "end": 3416.97,
          "speaker": "A woman"
        },
        {
          "word": " \"yes,",
          "start": 3416.97,
          "end": 3417.71,
          "speaker": "A woman"
        },
        {
          "word": " we",
          "start": 3417.81,
          "end": 3417.81,
          "speaker": "A woman"
        },
        {
          "word": " saw",
          "start": 3417.81,
          "end": 3418.01,
          "speaker": "A woman"
        },
        {
          "word": " too",
          "start": 3418.01,
          "end": 3418.15,
          "speaker": "A woman"
        },
        {
          "word": " much",
          "start": 3418.15,
          "end": 3418.33,
          "speaker": "A woman"
        },
        {
          "word": " in",
          "start": 3418.33,
          "end": 3418.47,
          "speaker": "A woman"
        },
        {
          "word": " Tucson.",
          "start": 3418.47,
          "end": 3418.91,
          "speaker": "A woman"
        },
        {
          "word": " We",
          "start": 3418.91,
          "end": 3418.95,
          "speaker": "A woman"
        },
        {
          "word": " worship",
          "start": 3418.95,
          "end": 3419.15,
          "speaker": "A woman"
        },
        {
          "word": " God",
          "start": 3419.15,
          "end": 3419.35,
          "speaker": "A woman"
        },
        {
          "word": " alone.\"",
          "start": 3419.35,
          "end": 3420.81,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "And they almost beat him up.",
      "start": 3420.81,
      "end": 3422.45,
      "speaker": "A woman",
      "words": [
        {
          "word": " And",
          "start": 3420.81,
          "end": 3420.93,
          "speaker": "A woman"
        },
        {
          "word": " they",
          "start": 3420.93,
          "end": 3421.11,
          "speaker": "A woman"
        },
        {
          "word": " almost",
          "start": 3421.11,
          "end": 3421.55,
          "speaker": "A woman"
        },
        {
          "word": " beat",
          "start": 3421.55,
          "end": 3421.79,
          "speaker": "A woman"
        },
        {
          "word": " him",
          "start": 3421.79,
          "end": 3421.95,
          "speaker": "A woman"
        },
        {
          "word": " up.",
          "start": 3421.95,
          "end": 3422.45,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "If he wasn't big enough and strong enough.",
      "start": 3423.07,
      "end": 3425.4,
      "speaker": "A woman",
      "words": [
        {
          "word": " If",
          "start": 3423.07,
          "end": 3423.21,
          "speaker": "A woman"
        },
        {
          "word": " he",
          "start": 3423.35,
          "end": 3423.45,
          "speaker": "A woman"
        },
        {
          "word": " wasn't",
          "start": 3423.45,
          "end": 3423.71,
          "speaker": "A woman"
        },
        {
          "word": " big",
          "start": 3423.71,
          "end": 3424.09,
          "speaker": "A woman"
        },
        {
          "word": " enough",
          "start": 3424.09,
          "end": 3424.33,
          "speaker": "A woman"
        },
        {
          "word": " and",
          "start": 3424.33,
          "end": 3424.59,
          "speaker": "A woman"
        },
        {
          "word": " strong",
          "start": 3424.59,
          "end": 3424.75,
          "speaker": "A woman"
        },
        {
          "word": " enough.",
          "start": 3424.75,
          "end": 3425.4,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "And a Turk.",
      "start": 3425.41,
      "end": 3428.35,
      "speaker": "A woman",
      "words": [
        {
          "word": " And",
          "start": 3425.41,
          "end": 3426.53,
          "speaker": "A woman"
        },
        {
          "word": " a",
          "start": 3426.53,
          "end": 3426.67,
          "speaker": "A woman"
        },
        {
          "word": " Turk.",
          "start": 3426.67,
          "end": 3428.35,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "He would have been beaten.",
      "start": 3428.81,
      "end": 3429.47,
      "speaker": "A woman",
      "words": [
        {
          "word": " He",
          "start": 3428.81,
          "end": 3428.85,
          "speaker": "A woman"
        },
        {
          "word": " would",
          "start": 3428.85,
          "end": 3428.91,
          "speaker": "A woman"
        },
        {
          "word": " have",
          "start": 3428.91,
          "end": 3429.03,
          "speaker": "A woman"
        },
        {
          "word": " been",
          "start": 3429.03,
          "end": 3429.17,
          "speaker": "A woman"
        },
        {
          "word": " beaten.",
          "start": 3429.17,
          "end": 3429.47,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "So, why do you have to take all this abuse?",
      "start": 3429.96,
      "end": 3432.18,
      "speaker": "A woman",
      "words": [
        {
          "word": " So,",
          "start": 3429.96,
          "end": 3430.41,
          "speaker": "A woman"
        },
        {
          "word": " why",
          "start": 3430.67,
          "end": 3430.67,
          "speaker": "A woman"
        },
        {
          "word": " do",
          "start": 3430.67,
          "end": 3430.85,
          "speaker": "A woman"
        },
        {
          "word": " you",
          "start": 3430.85,
          "end": 3430.89,
          "speaker": "A woman"
        },
        {
          "word": " have",
          "start": 3430.89,
          "end": 3431.01,
          "speaker": "A woman"
        },
        {
          "word": " to",
          "start": 3431.01,
          "end": 3431.17,
          "speaker": "A woman"
        },
        {
          "word": " take",
          "start": 3431.17,
          "end": 3431.35,
          "speaker": "A woman"
        },
        {
          "word": " all",
          "start": 3431.35,
          "end": 3431.53,
          "speaker": "A woman"
        },
        {
          "word": " this",
          "start": 3431.53,
          "end": 3431.73,
          "speaker": "A woman"
        },
        {
          "word": " abuse?",
          "start": 3431.73,
          "end": 3432.18,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "And all this ridicule. Do you think it shook him up? Did it affect his faith?",
      "start": 3433.49,
      "end": 3437.09,
      "speaker": "A woman",
      "words": [
        {
          "word": " And",
          "start": 3433.49,
          "end": 3433.49,
          "speaker": "A woman"
        },
        {
          "word": " all",
          "start": 3433.49,
          "end": 3433.57,
          "speaker": "A woman"
        },
        {
          "word": " this",
          "start": 3433.57,
          "end": 3433.71,
          "speaker": "A woman"
        },
        {
          "word": " ridicule.",
          "start": 3433.71,
          "end": 3434.06,
          "speaker": "A woman"
        },
        {
          "word": " Do",
          "start": 3434.43,
          "end": 3434.43,
          "speaker": "A woman"
