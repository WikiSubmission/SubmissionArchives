          "end": 3026.59,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muhammad",
          "start": 3026.59,
          "end": 3026.95,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " to",
          "start": 3026.95,
