        },
        {
          "word": " and",
          "start": 5001.35,
          "end": 5001.79,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Roger",
          "start": 5001.79,
          "end": 5002.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Chaffee.",
          "start": 5002.73,
          "end": 5003.91,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " They're",
