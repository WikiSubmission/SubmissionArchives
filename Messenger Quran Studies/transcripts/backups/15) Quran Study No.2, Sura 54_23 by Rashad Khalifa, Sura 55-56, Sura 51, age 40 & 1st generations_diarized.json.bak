          "speaker": "Lisa"
        }
      ]
    },
    {
      "text": "These verses again and again are saying absolutely what we've been saying that God does everything.",
      "start": 4623.25,
      "end": 4630.73,
      "speaker": "Lisa",
      "words": [
        {
          "word": " again",
          "start": 4623.25,
          "end": 4623.69,
          "speaker": "Lisa"
        },
