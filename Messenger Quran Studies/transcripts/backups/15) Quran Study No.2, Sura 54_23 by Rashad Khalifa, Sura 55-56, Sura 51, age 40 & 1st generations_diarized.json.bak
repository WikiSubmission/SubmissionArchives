          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And then, God renewed the message, sent the Quran to Muhammad,",
      "start": 3021.77,
      "end": 3025.87,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " And",
          "start": 3021.77,
          "end": 3021.91,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " then,",
          "start": 3021.91,
          "end": 3022.73,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " God",
          "start": 3023.07,
          "end": 3023.07,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " renewed",
          "start": 3023.07,
          "end": 3023.41,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " the",
