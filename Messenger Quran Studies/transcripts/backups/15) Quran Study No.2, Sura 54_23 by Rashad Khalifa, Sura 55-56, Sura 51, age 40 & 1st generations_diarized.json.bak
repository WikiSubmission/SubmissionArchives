          "speaker": "Dr. Khalifa"
        },
        {
          "word": " in",
          "start": 5009.47,
          "end": 5009.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " science.",
          "start": 5009.83,
          "end": 5010.83,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " But",
          "start": 5011.61,
