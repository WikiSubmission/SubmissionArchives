          "speaker": "Dr. Khalifa"
        },
        {
          "word": " preaching.",
          "start": 4480.13,
          "end": 4481.23,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " And",
          "start": 4481.53,
          "end": 4481.53,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " there",
          "start": 4481.53,
          "end": 4481.61,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "And there were people with him.",
      "start": 4481.61,
      "end": 4482.85,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " were",
          "start": 4481.61,
