          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "It is so obvious.",
      "start": 2694.45,
      "end": 2695.25,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " It",
          "start": 2694.45,
