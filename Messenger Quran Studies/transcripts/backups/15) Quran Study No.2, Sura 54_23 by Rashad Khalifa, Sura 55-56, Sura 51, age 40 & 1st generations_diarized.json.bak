          "speaker": "Dr. Khalifa"
        },
        {
          "word": " your",
          "start": 3767.81,
          "end": 3767.97,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " guts,",
          "start": 3767.97,
          "end": 3768.47,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " okay?",
          "start": 3768.69,
          "end": 3771.21,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Because it's going to be deep, deep in Hell.",
