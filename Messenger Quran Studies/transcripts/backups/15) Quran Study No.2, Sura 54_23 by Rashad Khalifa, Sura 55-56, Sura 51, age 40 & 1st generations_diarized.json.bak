          "end": 3399.57,
          "speaker": "A woman"
        },
        {
          "word": " is",
          "start": 3399.57,
          "end": 3399.63,
          "speaker": "A woman"
        },
        {
          "word": " why",
          "start": 3399.63,
          "end": 3399.73,
          "speaker": "A woman"
        },
        {
          "word": " he",
          "start": 3399.73,
          "end": 3399.91,
          "speaker": "A woman"
        },
        {
          "word": " is",
          "start": 3399.91,
          "end": 3399.91,
          "speaker": "A woman"
        },
        {
          "word": " very",
          "start": 3399.91,
          "end": 3400.07,
          "speaker": "A woman"
        },
        {
          "word": " special.",
          "start": 3400.07,
          "end": 3400.42,
          "speaker": "A woman"
        }
      ]
    },
    {
      "text": "I'm just using Mahmood as an example.",
      "start": 3401.09,
      "end": 3402.93,
      "speaker": "A woman",
      "words": [
        {
          "word": " I'm",
          "start": 3401.09,
          "end": 3401.11,
          "speaker": "A woman"
        },
        {
          "word": " just",
          "start": 3401.11,
          "end": 3401.25,
          "speaker": "A woman"
        },
        {
          "word": " using",
          "start": 3401.25,
          "end": 3401.49,
          "speaker": "A woman"
        },
        {
          "word": " Mahmood",
          "start": 3401.49,
          "end": 3401.77,
          "speaker": "A woman"
        },
        {
          "word": " as",
          "start": 3401.77,
          "end": 3401.99,
          "speaker": "A woman"
        },
        {
          "word": " an",
          "start": 3401.99,
