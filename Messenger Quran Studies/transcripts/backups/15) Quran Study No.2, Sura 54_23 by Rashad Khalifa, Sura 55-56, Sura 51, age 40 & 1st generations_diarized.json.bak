          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "We are so lucky.",
      "start": 3536.95,
      "end": 3538.59,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " We",
          "start": 3536.95,
