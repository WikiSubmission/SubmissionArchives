          "end": 612.86,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " By",
          "start": 613.38,
          "end": 613.38,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " their",
          "start": 613.38,
          "end": 613.52,
