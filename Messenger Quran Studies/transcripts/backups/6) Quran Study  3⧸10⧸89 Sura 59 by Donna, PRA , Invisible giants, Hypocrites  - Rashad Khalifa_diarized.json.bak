        }
      ]
    },
    {
      "text": "\"What are you?\" \"I'm a Shia.\"",
      "start": 621.1,
      "end": 622.05,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " \"What",
          "start": 621.1,
          "end": 621.16,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
          "start": 621.16,
          "end": 621.34,
