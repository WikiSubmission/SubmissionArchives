          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "They don't say Muslim.",
      "start": 622.84,
      "end": 624.98,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " They",
          "start": 622.84,
          "end": 624.04,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " don't",
          "start": 624.04,
          "end": 624.14,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " say",
          "start": 624.14,
          "end": 624.28,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Muslim.",
          "start": 624.28,
          "end": 624.98,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "So, both of them abuse these verses in this particular Sura.",
      "start": 626.5,
      "end": 631.72,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " So,",
          "start": 626.5,
          "end": 627.9,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " both",
          "start": 628.1,
          "end": 628.1,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " of",
          "start": 628.1,
          "end": 628.2,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " them",
          "start": 628.2,
          "end": 628.36,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " abuse",
          "start": 628.36,
