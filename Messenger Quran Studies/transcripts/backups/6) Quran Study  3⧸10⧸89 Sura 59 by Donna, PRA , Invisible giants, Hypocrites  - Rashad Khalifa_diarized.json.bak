          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You ask \"what are you?\" \"I'm a Sunni.\"",
      "start": 614.38,
      "end": 615.82,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " You",
          "start": 614.38,
          "end": 614.38,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " ask",
          "start": 614.38,
          "end": 614.38,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"what",
          "start": 614.38,
          "end": 614.78,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " are",
          "start": 614.78,
          "end": 614.96,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you?\"",
          "start": 614.96,
          "end": 615.12,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"I'm",
          "start": 615.24,
          "end": 615.4,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 615.4,
          "end": 615.42,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Sunni.\"",
          "start": 615.42,
          "end": 615.82,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "Who's gonna say that on the Day of Judgment?",
