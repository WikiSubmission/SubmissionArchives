        },
        {
          "word": " you?\"",
          "start": 621.34,
          "end": 621.56,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " \"I'm",
          "start": 621.56,
          "end": 621.66,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " a",
          "start": 621.66,
          "end": 621.7,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " Shia.\"",
          "start": 621.7,
