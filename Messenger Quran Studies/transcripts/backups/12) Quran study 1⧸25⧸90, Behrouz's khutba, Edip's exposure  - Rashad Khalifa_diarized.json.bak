        },
        {
          "word": " not.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " And",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " I'm",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " not",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " taking",
