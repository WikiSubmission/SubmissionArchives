          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " understand",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " he's",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " lying",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " now.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "No, I'm not lying. You said, you said, \"God...\", you said \"God create everything from nothing.\"",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Behrouz",
      "words": [
        {
          "word": " No,",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " I'm",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " not",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " lying.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " You",
