          "end": 5282.45,
          "speaker": "Apamea"
        }
      ]
    },
    {
      "text": "and hurt others.",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Apamea",
      "words": [
        {
          "word": " and",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
