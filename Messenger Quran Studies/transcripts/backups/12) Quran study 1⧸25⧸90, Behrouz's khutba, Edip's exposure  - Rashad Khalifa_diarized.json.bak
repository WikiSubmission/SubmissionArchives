    },
    {
      "text": "No, he said. From his face, you understand he's lying now.",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Edip",
      "words": [
        {
          "word": " No,",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " he",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " said.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " From",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " his",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        },
        {
          "word": " face,",
