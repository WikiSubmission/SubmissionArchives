          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " Yes.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        }
      ]
    },
    {
      "text": "He didn't say anything behind your back or his back.",
