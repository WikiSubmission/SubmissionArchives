          "word": " else.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        }
      ]
    },
    {
      "text": "He saw there was maybe something wrong and he just kind of stepped back and let it build up.",
      "start": 5282.45,
      "end": 5282.45,
