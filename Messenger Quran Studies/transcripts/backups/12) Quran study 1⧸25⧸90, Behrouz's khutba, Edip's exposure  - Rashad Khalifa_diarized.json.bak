          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "You don't wanna say you're wrong.",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Dr. Khalifa",
