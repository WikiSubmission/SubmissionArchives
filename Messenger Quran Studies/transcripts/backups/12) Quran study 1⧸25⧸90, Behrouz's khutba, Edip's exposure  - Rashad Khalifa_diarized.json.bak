          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " even",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " know",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " what",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
