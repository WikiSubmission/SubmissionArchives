          "end": 5282.45,
          "speaker": "Apamea"
        }
      ]
    },
    {
      "text": "And some people, because of the economic situation, could very much take advantage of that,",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Apamea",
      "words": [
        {
          "word": " And",
          "start": 5282.45,
          "end": 5282.45,
