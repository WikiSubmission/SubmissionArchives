    {
      "text": "This is exactly what God is telling us here.",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Apamea",
      "words": [
        {
          "word": " This",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " is",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " exactly",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " what",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " God",
          "start": 5282.45,
