          "speaker": "Apamea"
        },
        {
          "word": " others.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        }
      ]
    },
    {
      "text": "And God teaches us that that is evil.",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Apamea",
      "words": [
        {
          "word": " And",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " God",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " teaches",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " us",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
