          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " we",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " were",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " whispering?",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        }
