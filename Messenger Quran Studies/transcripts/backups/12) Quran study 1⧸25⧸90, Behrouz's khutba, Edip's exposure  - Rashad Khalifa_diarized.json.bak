          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " he",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " thought",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " there",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " was",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " something",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " wrong.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        }
      ]
    },
    {
      "text": "I don't know if it is or it's not. And I'm not taking sides.",
