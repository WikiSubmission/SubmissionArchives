          "speaker": "Apamea"
        },
        {
          "word": " very",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " much",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " take",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " advantage",
          "start": 5282.45,
