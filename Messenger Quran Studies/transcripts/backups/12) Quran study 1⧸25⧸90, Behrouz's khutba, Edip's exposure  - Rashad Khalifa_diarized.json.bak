        },
        {
          "word": " just",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " said",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " it",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " right",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " here.",
          "start": 5282.45,
