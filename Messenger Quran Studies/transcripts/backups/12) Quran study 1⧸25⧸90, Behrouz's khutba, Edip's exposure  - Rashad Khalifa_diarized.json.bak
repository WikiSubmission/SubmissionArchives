          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " know",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " if",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Ali"
        },
        {
          "word": " it",
          "start": 5282.45,
          "end": 5282.45,
