          "speaker": "Edip"
        },
        {
          "word": " but?",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Edip"
        }
      ]
    },
    {
      "text": "Ali.",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Dr. Khalifa",
      "words": [
        {
          "word": " Ali.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "I thought it was just something else.",
