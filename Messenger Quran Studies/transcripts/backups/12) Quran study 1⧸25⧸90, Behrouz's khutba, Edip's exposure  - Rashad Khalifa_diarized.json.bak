          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " here.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        }
      ]
    },
    {
      "text": "And we should realize what the difference is between trade and usury,",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Apamea",
      "words": [
        {
          "word": " And",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " we",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " should",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " realize",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " what",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " the",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " difference",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " is",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " between",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " trade",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " and",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        },
        {
          "word": " usury,",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Apamea"
        }
      ]
    },
    {
      "text": "where usury is lending money at excessive interest and taking advantage of the situation.",
