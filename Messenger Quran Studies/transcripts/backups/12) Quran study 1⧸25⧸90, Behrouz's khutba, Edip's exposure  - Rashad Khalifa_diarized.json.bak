          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " say",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " you're",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        },
        {
          "word": " wrong.",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Dr. Khalifa"
        }
      ]
    },
    {
      "text": "OK, I accept I'm wrong. Dr. Khalifa: Ali.",
      "start": 5282.45,
      "end": 5282.45,
      "speaker": "Edip",
      "words": [
