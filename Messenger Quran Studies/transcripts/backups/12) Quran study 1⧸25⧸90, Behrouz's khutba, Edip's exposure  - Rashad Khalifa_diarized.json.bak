          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " said,",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " you",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " said,",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " \"God...\",",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " you",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " said",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " \"God",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " create",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
          "word": " everything",
          "start": 5282.45,
          "end": 5282.45,
          "speaker": "Behrouz"
        },
        {
