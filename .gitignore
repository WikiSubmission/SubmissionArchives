# Media & Large Assets
# Video/audio play directly from YouTube; these extensions should stay out of the repository
*.mp3
*.mp4
*.m4a
*.wav
*.mov
*.avi
*.wmv
*.mkv
*.webm
*.flv
*.pdf
*.zip
*.tar.gz
*.iso
*.traineddata

# Specific Public Media Paths
public/content/**/*.mp3
public/content/**/*.mp4
public/content/**/*.m4a
public/content/**/*.wav
public/content/**/*.mov
public/content/**/*.avi
public/content/**/*.wmv
public/content/**/*.mkv
public/content/**/*.webm
public/content/**/*.flv

# Appendix/newsletter PDFs are local content, not caught by the blanket *.pdf rule above
!public/content/**/*.pdf

# Primary-source PDFs cited by editorials. These are the documents the footnotes
# point at, so they must travel with the article rather than being ignored as
# generic media. Video in the same tree stays ignored by the rules above.
!data/editorial-sources/**/*.pdf

