# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Media files (stored in R2)
../data/disorganized_sermons/*.mp4
../data/disorganized_sermons/*_diarized.json
../data/rk_video_programs/*.mp4
../data/rk_video_programs/*_diarized.json
../data/disorganized_sermons/*_temp.m4a
../data/rk_video_programs/*_temp.m4a

# All media files (audio/video)
*.mp3
*.mp4
*.m4a
*.wav
*.avi
*.mov
*.webm
*.flac

# Large data files
*.zip
*.tar.gz
*.rar
*.pdf

# Large Bible/reference files
public/data/eng-web.usfx.xml
public/data/web_nt.json

# Mega transcript files
ALL_QURAN_STUDIES_TRANSCRIPTS_MEGA.json
*_MEGA.json

# Recovery/temp output
recovery_output/

# Rclone config
rclone-config-template.conf
rclone.conf
