# Copy to .env.local and fill with local secrets. Never commit real values.

# Canonical public origin used by metadata, robots.txt, and sitemap.xml.
SITE_URL=https://archive.wikisubmission.org

# Ask the Archive (RAG)
MISTRAL_API_KEY=
DATABASE_URL=postgresql://rag:rag_dev_only@localhost:55433/ask_the_archive
MISTRAL_EMBED_MODEL=mistral-embed-2312
# Fallback chat model for every LLM task without a task-specific override.
MISTRAL_CHAT_MODEL=mistral-small-2603
# Optional per-task overrides. Expansion is high-volume and cheap; rerank and
# answer quality benefit most from a stronger model.
MISTRAL_EXPANSION_MODEL=mistral-small-2603
MISTRAL_RERANK_MODEL=mistral-medium-2604
MISTRAL_ANSWER_MODEL=mistral-medium-2604
RAG_EMBED_BATCH_SIZE=32
RAG_EMBED_DIMENSION=1024
RAG_RATE_LIMIT_PER_MINUTE=10

# Hybrid retrieval and answer context
RAG_QUERY_EXPANSION_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_MAX_QUERY_VARIANTS=8
RAG_TOP_K_RETRIEVAL=40
RAG_RERANK_CANDIDATES=24
RAG_TOP_N_CONTEXT=12

# Retrieval trace logging. When true, each /api/ask request appends a JSONL trace
# (intent, signals, rankings, degraded services) to reports/rag-traces/traces.jsonl.
RAG_TRACE_ENABLED=false

# Enrichment metadata retrieval. Metadata helps locate canonical evidence but is never quoted.
RAG_ENRICHMENT_ENABLED=true
RAG_ENRICHMENT_STATUSES=draft,approved
RAG_ENRICHMENT_TOP_K=30
RAG_ENRICHMENT_MAX_SECTIONS=24
