# Copy to .env.local and fill with local secrets. Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=submissionarchives
R2_EXPECTED_BUCKET_NAME=submissionarchives
R2_PUBLIC_BASE_URL=
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=
DEEPGRAM_API_KEY=

# Required in production for /tools, transcript write APIs, and admin server actions.
# Send as the x-admin-token header or store in an admin_token cookie.
ADMIN_API_TOKEN=

# Comma-separated HTTPS hosts that /api/proxy-media is allowed to fetch.
MEDIA_PROXY_ALLOWED_HOSTS=pub-cb3aaebc3d2f49698a10d5a2bca9b720.r2.dev
