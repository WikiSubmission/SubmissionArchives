# Copy to .env.local and fill with local secrets. Never commit real values.

# Canonical public origin used by metadata, robots.txt, and sitemap.xml.
SITE_URL=https://archive.wikisubmission.org

# Gemini API
GEMINI_API_KEY=your_key_here
# Shared secret for POST /api/revalidate (X-Revalidate-Token header).
# Called by CI after `npm run generate:catalog` so new content appears without a redeploy.
REVALIDATE_TOKEN=generate_a_long_random_value
